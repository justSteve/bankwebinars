<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <connectionStrings>
    <add name="TTSDataBase" connectionString="data source=PLAGUIS\SQLSERVER2012;initial catalog=ttsdatabase;integrated security=true;persist security info=True" />
    <add name="DefaultConnection" connectionString="Data Source=PLAGUIS\SQLSERVER2012;Initial Catalog=CUWebinars;Integrated Security=True;MultipleActiveResultSets=True" providerName="System.Data.SqlClient" />
    <add name="MembershipReboot" connectionString="Data Source=PLAGUIS\SQLSERVER2012;Initial Catalog=MembershipReboot;Integrated Security=True;MultipleActiveResultSets=True" providerName="System.Data.SqlClient" />
    <!--<add name="TTSDataBase" connectionString="Server=.;Initial Catalog=TTSDatabase;Integrated Security=True;MultipleActiveResultSets=True" providerName="System.Data.SqlClient" />
    <add name="DefaultConnection" connectionString="Data Source=.;Initial Catalog=CUWebinars;Integrated Security=True;MultipleActiveResultSets=True" providerName="System.Data.SqlClient" />
    <add name="MembershipReboot" connectionString="Data Source=.;Initial Catalog=MembershipReboot;Integrated Security=True;MultipleActiveResultSets=True" providerName="System.Data.SqlClient" />-->
  </connectionStrings>
  
  <appSettings>
    <add key="IeWebDriverPort" value="7654" />
    <add key="ChromeWebDriverPort" value="9999" />
    <add key="FirefoxBrowserPort" value="3538" />
    <add key="ChromeWebDriverPath" value="E:\IEDriverServer.exe" />
    <add key="IeWebDriverPath" value="e:\" />
    <add key="FirefoxExePath" value="C:\Program Files (x86)\Mozilla Firefox\firefox.exe" />
    <add key="Tenant" value="CUWebinars" />
    <add key="HomeUrl" value="http://localhost:3538" />
    <add key="MembershipNotificationsUrl" value="http://localhost:3538/MembershipNotificationOps/MembershipNotifications" />
    <add key="LoggedInUserEmail" value="testuser1@cuwebinars.com" />
    <add key="LoggedInUserPassword" value="Passw0rd1" />
  </appSettings>
  
  <system.diagnostics>
    <trace autoflush="true" />
    <sources>
      <source name="CUWebinars" switchValue="Verbose,Warning">
        <listeners>
          <add name="CUWebinarsTestListener" />
        </listeners>
      </source>
      <source name="MembershipReboot" switchValue="Verbose,Warning">
        <listeners>
          <add name="MembershipRebootTestListener" />
        </listeners>
      </source>
    </sources>
    <sharedListeners>
      <add name="CUWebinarsTestListener" type="System.Diagnostics.XmlWriterTraceListener, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" initializeData="e:\csv\csv\CUWebinarsTest.svclog" traceOutputOptions="Timestamp"></add>
      <add name="MembershipRebootTestListener" type="System.Diagnostics.XmlWriterTraceListener, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" initializeData="e:\csv\MembershipRebootTest.svclog" traceOutputOptions="Timestamp"></add>
    </sharedListeners>
  </system.diagnostics>

  <system.net>
    <defaultProxy>
      <proxy bypassonlocal="false" usesystemdefault="true" />
    </defaultProxy>
    <mailSettings>
      <smtp from="someimportantguy@cuwebinars.com">
        <network host="localhost" port="25" />
      </smtp>
    </mailSettings>
  </system.net>
