    var phone = "TBA";
    var code = "TBA";

    if (joinURL == null)
    {
        joinURL = webinar.CitrixRegisterUrl;
    }

    if (myRow.RegistrationType.ShowLiveNotifications == "No")
    {
        joinURL = "This order is currently OnDemand Playback Only. Please call 800-831-0678 ext 3 if you wish to upgrade.";
    }

    if (webinar.AccessCodeAttendee != null)
    {
        code = webinar.AccessCodeAttendee;
    }

    string DateTimeString = TtsTemplateHelperObject.FormatTimeWithDuration(webinar.Date, Model.WebUser.timeZone, true, webinar.Duration);
