          <Object Type="DbDacFx">
            <PreSource Path="Data Source=tcp:y1qylg6yd2.database.windows.net,1433;Initial Catalog=TTSDatabase;Integrated Security=False;User ID=Lab1@y1qylg6yd2;Password=pJ6Cic0EFPC5;Connect Timeout=30;Encrypt=True" includeData="False" />
            <Source Path="$(IntermediateOutputPath)AutoScripts\LoggerConnection_IncrementalSchemaOnly.dacpac" dacpacAction="Deploy" />
