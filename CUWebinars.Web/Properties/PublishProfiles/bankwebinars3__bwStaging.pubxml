          </Object>
        </ObjectGroup>
        <ObjectGroup Name="MembershipReboot" Order="2" Enabled="False">
          <Destination Path="" />
          <Object Type="DbDacFx">
            <PreSource Path="Data Source=tcp:y1qylg6yd2.database.windows.net,1433;Initial Catalog=MembershipReboot;Integrated Security=False;User ID=Lab1@y1qylg6yd2;Password=pJ6Cic0EFPC5;Connect Timeout=30;Encrypt=True" includeData="False" />
            <Source Path="$(IntermediateOutputPath)AutoScripts\MembershipReboot_IncrementalSchemaOnly.dacpac" dacpacAction="Deploy" />
          </Object>
          <UpdateFrom Type="Web.Config">
            <Source MatchValue="Server=tcp:y1qylg6yd2.database.windows.net,1433;Database=MembershipReboot;User ID=Lab1@y1qylg6yd2;Password=pJ6Cic0EFPC5;Trusted_Connection=False;Encrypt=True;Connection Timeout=30;" MatchAttributes="$(UpdateFromConnectionStringAttributes)" />
          </UpdateFrom>
        </ObjectGroup>
        <ObjectGroup Name="LoggerConnection" Order="3" Enabled="False">
