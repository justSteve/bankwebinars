<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>http://cuwebinarsstage.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>True</LaunchSiteAfterPublish>
    <ExcludeApp_Data>False</ExcludeApp_Data>
    <MSDeployServiceURL>waws-prod-blu-001.publish.azurewebsites.windows.net:443</MSDeployServiceURL>
    <DeployIisAppPath>cuwebinarsstage</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>True</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <EnableMSDeployBackup>True</EnableMSDeployBackup>
    <UserName>$cuwebinarsstage</UserName>
    <_SavePWD>True</_SavePWD>
    <PublishDatabaseSettings>
      <Objects xmlns="">
        <ObjectGroup Name="DefaultConnection" Order="1" Enabled="False">
          <Destination Path="Data Source=tcp:y1qylg6yd2.database.windows.net,1433;InitialCatalog=CUStaging;User ID=Lab1@y1qylg6yd2;Password=pJ6Cic0EFPC5" />
          <Object Type="DbCodeFirst">
            <Source Path="DBMigration" DbContext="TTSDataLayer.Models.TTSWebinarsContext, TTSDataLayer" MigrationConfiguration="TTSDataLayer.Migrations.Configuration, TTSDataLayer" Origin="Configuration" />
          </Object>
        </ObjectGroup>
        <ObjectGroup Name="LoggerConnection" Order="2" Enabled="False">
          <Destination Path="Data Source=tcp:y1qylg6yd2.database.windows.net,1433;InitialCatalog=TTSDatabase;Integrated Security=False;UserID=TTSOp@y1qylg6yd2;Password=..Brass$..;ConnectTimeout=30;Encrypt=True" />
          <Object Type="DbDacFx">
            <PreSource Path="Data Source=PLAGUIS\SQLSERVER2012;Initial Catalog=TTSWebinars;Integrated Security=True" includeData="False" />
            <Source Path="$(IntermediateOutputPath)AutoScripts\LoggerConnection_IncrementalSchemaOnly.dacpac" dacpacAction="Deploy" />
          </Object>
          <UpdateFrom Type="Web.Config">
            <Source MatchValue="Server=PLAGUIS\SQLSERVER2012;Initial Catalog=TTSWebinars;Integrated Security=True;MultipleActiveResultSets=True" MatchAttributes="$(UpdateFromConnectionStringAttributes)" />
          </UpdateFrom>
        </ObjectGroup>
        <ObjectGroup Name="elmah-sqlserver" Order="3" Enabled="False">
          <Destination Path="Data Source=tcp:y1qylg6yd2.database.windows.net,1433;InitialCatalog=TTSDatabase;Integrated Security=False;UserID=TTSOp@y1qylg6yd2;Password=..Brass$..;ConnectTimeout=30;Encrypt=True" />
          <Object Type="DbDacFx">
            <PreSource Path="Data Source=.;Initial Catalog=TTSDatabase;Integrated Security=True;Persist Security Info=True" includeData="False" />
            <Source Path="$(IntermediateOutputPath)AutoScripts\elmah-sqlserver_IncrementalSchemaOnly.dacpac" dacpacAction="Deploy" />
          </Object>
          <UpdateFrom Type="Web.Config">
            <Source MatchValue="data source=.;initial catalog=TTSDatabase;integrated security=true;persist security info=True;" MatchAttributes="$(UpdateFromConnectionStringAttributes)" />
          </UpdateFrom>
        </ObjectGroup>
      </Objects>
    </PublishDatabaseSettings>
  </PropertyGroup>
  <ItemGroup>
    <MSDeployParameterValue Include="$(DeployParameterPrefix)DefaultConnection-Web.config Connection String">
      <ParameterValue>Data Source=tcp:y1qylg6yd2.database.windows.net,1433;InitialCatalog=CUStaging;User ID=Lab1@y1qylg6yd2;Password=pJ6Cic0EFPC5</ParameterValue>
    </MSDeployParameterValue>
    <MSDeployParameterValue Include="$(DeployParameterPrefix)elmah-sqlserver-Web.config Connection String">
      <ParameterValue>Data Source=tcp:y1qylg6yd2.database.windows.net,1433;InitialCatalog=TTSDatabase;Integrated Security=False;UserID=TTSOp@y1qylg6yd2;Password=..Brass$..;ConnectTimeout=30;Encrypt=True</ParameterValue>
    </MSDeployParameterValue>
    <MSDeployParameterValue Include="$(DeployParameterPrefix)LoggerConnection-Web.config Connection String">
      <ParameterValue>data source=tcp:y1qylg6yd2.database.windows.net,1433;initialcatalog=TTSDatabase;integrated security=False;userid=TTSOp@y1qylg6yd2;password=..Brass$..;connecttimeout=30;encrypt=True;MultipleActiveResultSets=True</ParameterValue>
    </MSDeployParameterValue>
