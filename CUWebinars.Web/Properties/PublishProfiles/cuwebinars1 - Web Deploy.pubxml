    <_DestinationType>AzureWebSite</_DestinationType>
    <PublishDatabaseSettings>
      <Objects xmlns="">
        <ObjectGroup Name="LoggerConnection" Order="2" Enabled="False">
          <Destination Path="Data Source=y1qylg6yd2.database.windows.net,1433;Initial Catalog=TTSDatabase;Persist Security Info=True;User ID=Lab1;Password=pJ6Cic0EFPC5" />
