    <!-- ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::: :::::::::::::::: ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::: -->

    <add key="ClientValidationEnabled" value="true" />

    <!--where wj wait for processing-->
    <add key="CreateUserQueueName" value="tts-mr-createuseraccount-queue" />
    <add key="CcPaymentProcessingUrlKey" value="/home/PayCC" />

    <!--webjob for Promotion Emails-->
    <!-- PromoEmailFromAddress NEEDS TO be from a domain registered in Mandrill -->
    <add key="PromoEmailFromAddress" value="registrations@ttsregistrations.com" />
    <add key="PromoEmailSubject" value="New promotion available" />
    <!--add some placeholders ("{0}") for String.Formatting in some variable text? -->

    <!--webjob for Weekly Invoice Emails-->
    <!-- WeeklyInvoiceEmailFromAddress NEEDS TO be from a domain registered in Mandrill -->
    <add key="WeeklyInvoiceEmailFromAddress" value="registrations@ttsregistrations.com" />
    <add key="WeeklyInvoiceEmailSubject" value="Weekly invoice available" />
    <!--add some placeholders ("{0}") for String.Formatting in some variable text? -->

    <!--webjob for Multiple Webinars Ordered Confirmation Emails-->
    <!-- WeeklyInvoiceEmailFromAddress NEEDS TO be from a domain registered in Mandrill -->
    <add key="OrderSubmittedMultiEmailSubject" value="Bank Webinars Order Confirmation" />
    <!--add some placeholders ("{0}") for String.Formatting in some variable text? -->

    <add key="CuwNotificationQueueName" value="cuw-notifications" />
    <add key="GetMandrillQueueName" value="tts-orderconfmultimsg-queue" />


    <add key="Foo" value="StorageConnectionString" />

    <add key="elmah.mvc.allowedRoles" value="*" />
    <add key="elmah.mvc.allowedUsers" value="*" />
    <add key="elmah.mvc.disableHandleErrorFilter" value="false" />
    <add key="elmah.mvc.disableHandler" value="false" />
    <add key="elmah.mvc.IgnoreDefaultRoute" value="false" />
    <add key="elmah.mvc.requiresAuthentication" value="false" />
    <add key="elmah.mvc.route" value="elmah" />


    <add key="log4net.Internal.Debug" value="false" />

    <add key="PreserveLoginUrl" value="true" />

    <add key="RelativeCancelVerificationUrl" value="Account/RegisterCancel/" />
    <add key="RelativeConfirmChangeUrl" value="Account/Confirmed/" />
    <add key="RelativeConfirmPasswordResetUrl" value="Account/PasswordResetConfirm/" />
    <add key="RelativeLoginUrl" value="Account/Login" />

    <add key="UnobtrusiveJavaScriptEnabled" value="true" />

    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />

    <add key="WMVRepository" value="http://ttsmedia.ttstrain.com/" />
    <add key="HandoutRepository" value="http://ttsmedia.ttstrain.com/" />

    <add key="Glimpse:DisableAsyncSupport" value="true" />

  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.5.1" />
    <sessionState mode="InProc" timeout="60" />
    <httpRuntime targetFramework="4.5" requestValidationMode="2.0" />
    <authentication mode="Forms">
      <forms name="ttsprovidespremierweb-basedtraining" loginUrl="~/Account/Login" timeout="2880" />
    </authentication>
    <customErrors mode="Off" />
    <!--<customErrors defaultRedirect="~/Error" mode="RemoteOnly">
			<error statusCode="500" redirect="InternalError.htm" />
			<error statusCode="404" redirect="~/Error/NotFound/" />
		</customErrors>-->
    <pages>
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Optimization" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
        <add namespace="BrockAllen.MembershipReboot.WebHost" />
        <add namespace="CUWebinars.Web.Models" />
        <add namespace="CUWebinars.Web.Services" />
      </namespaces>
    </pages>

    <httpModules>
      <add name="ErrorLog" type="Elmah.ErrorLogModule, Elmah" />
      <add name="ErrorMail" type="Elmah.ErrorMailModule, Elmah" />
      <add name="ErrorFilter" type="Elmah.ErrorFilterModule, Elmah" />

      <!--<add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Extensibility.Web.RequestTracking.WebRequestTrackingModule, Microsoft.ApplicationInsights.Extensibility.Web" />-->
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web" />
    </httpModules>
  </system.web>

  <system.webServer>
    <urlCompression doDynamicCompression="true" dynamicCompressionBeforeCache="false" />

    <staticContent>
      <remove fileExtension=".svg" />
      <remove fileExtension=".eot" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <mimeMap fileExtension=".eot" mimeType="application/vnd.ms-fontobject" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
    </staticContent>
    <directoryBrowse enabled="true" />
    <httpErrors existingResponse="PassThrough" />
    <asp scriptErrorSentToBrowser="true" />
    <handlers>
      <add name="ELMAH" verb="POST,GET,HEAD" path="elmah.axd" type="Elmah.ErrorLogPageFactory, Elmah" preCondition="integratedMode" />
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />

      <!--<add name="Glimpse" path="glimpse.axd" verb="GET" type="Glimpse.AspNet.HttpHandler, Glimpse.AspNet" preCondition="integratedMode" />-->
    </handlers>

    <modules runAllManagedModulesForAllRequests="true">
      <remove name="UrlRoutingModule-4.0" />
      <remove name="SessionAuthenticationModule" />
      <add name="UrlRoutingModule-4.0" type="System.Web.Routing.UrlRoutingModule" preCondition="" />
      <add name="ErrorLog" type="Elmah.ErrorLogModule, Elmah" preCondition="managedHandler" />
      <add name="ErrorMail" type="Elmah.ErrorMailModule, Elmah" preCondition="managedHandler" />
      <add name="ErrorFilter" type="Elmah.ErrorFilterModule, Elmah" preCondition="managedHandler" />
      <add name="SessionAuthenticationModule" type="System.IdentityModel.Services.SessionAuthenticationModule, System.IdentityModel.Services, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />

      <add name="Glimpse" type="Glimpse.AspNet.HttpModule, Glimpse.AspNet" preCondition="integratedMode" />
      <remove name="TelemetryCorrelationHttpModule" />
      <add name="TelemetryCorrelationHttpModule" type="Microsoft.AspNet.TelemetryCorrelation.TelemetryCorrelationHttpModule, Microsoft.AspNet.TelemetryCorrelation" preCondition="integratedMode,managedHandler" />
      <remove name="ApplicationInsightsWebTracking" />
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web" preCondition="managedHandler" />
    </modules>
    <validation validateIntegratedModeConfiguration="false" />

    <rewrite>
      <rules>
        <!--
        <rule name="Canonical Hostname" stopProcessing="false">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{HTTP_HOST}" pattern="^(v3\.)(.*)$" />
          </conditions>
          <action type="Redirect" url="https://www.{C:2}{REQUEST_URI}" redirectType="Permanent" />
        </rule>
        -->
      </rules>

    </rewrite>

  </system.webServer>

