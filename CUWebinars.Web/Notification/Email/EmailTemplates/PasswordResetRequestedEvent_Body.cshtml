@model CUWebinars.Web.Notification.Notification

<div style="color:#333;background-color:#C0C0C0">

    <p>
        You (or someone else) has requested a password reset for @Model.ApplicationName.

    <p>
        Username: @Model.Username

    <p>
        Please click here to confirm your request so you can reset your password:

        <a href="@Model.ConfirmPasswordResetUrl">@Model.ConfirmPasswordResetUrl</a> 

    <p>
        If this was in error or not requested then click to cancel the request:

        <a href="@Model.CancelVerificationUrl">@Model.CancelVerificationUrl</a>

    <p>
        Thanks! <br/>

        @Model.EmailSignature

</div>