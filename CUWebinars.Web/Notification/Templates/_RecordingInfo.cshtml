@using System.Web.Mvc.Html
@model CUWebinars.Business.Models.Order

<table border="0" align="center" cellpadding="0" cellspacing="0">
    @{
        var row = Model.OrderRows.SingleOrDefault();
        var joinURL = row.JoinURL;
        if (joinURL == null)
        {
            joinURL = "https://www2.gotomeeting.com/join/" + row.Webinar.WebinarKey;
        }

        <tr>
            <td>
                <table border="0" align="center" cellpadding="0" cellspacing="0">
                    <tr>
                        <td width="150px" style="text-align: right; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: smaller"> </td>
                        <td width="400px" style="text-align: left; background-color: #B4D1EC; padding-left: 6px;"> </td>
                    </tr>
                    <tr>
                        <td width="150px" style="text-align: right; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: smaller"> </td>
                        <td width="400px" style="text-align: left; background-color: #B4D1EC; padding-left: 6px;">
                            <p style="color: black; font-family: Arial, Helvetica, sans-serif; font-size: 12px;">
                                <br />Dear @Model.FirstName,<br />
                                Thank you for your recent order.<br /><br />
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td valign="top" width="150px" style="text-align: right; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: smaller">
                            <p align="right" style="vert-align: top; font-size: smaller">
                                Title:
                            </p>
                        </td>
                        <td width="400px" style="text-align: left; background-color: #B4D1EC; padding-left: 6px;">
                            <p style="color: black; font-family: Arial, Helvetica, sans-serif; font-size: 12px;">
                                 @row.Webinar.Title<br />
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td valign="top" width="150px" style="text-align: right; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: smaller">
                            <p align="right" style="vert-align: top; font-size: smaller">Date:</p>
                        </td>
                        <td width="400px" style="text-align: left; background-color: #B4D1EC; padding-left: 6px;">
                            <p style="color: #000000; font-family: Arial, Helvetica, sans-serif; font-size: 12px;"> <b>@row.Webinar.Date.ToString("dddd, MMMM d"), @row.Webinar.Date.ToString("yyyy")</b> - <i>10:00 am - 11:00 am CT</i><br /><br /></p>
                        </td>
                    </tr>
                    <tr>
                        <td valign="top" width="150px" style="text-align: right; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: smaller"><p align="right" style="vert-align: top; font-size: smaller">Event Materials:</p></td>
                        <td width="400px" style="text-align: left; background-color: #B4D1EC; padding-left: 6px;">
                            <p style="color: #000000; font-family: Arial, Helvetica, sans-serif; font-size: 12px;">
                                @{
                                    foreach (var i in row.Webinar.WebinarFiles)
                                    {
                                        <a href="@i.fileLocation">@i.fileDesc</a>
                                        <a href="@i.fileLocation">@i.fileDesc</a>
                                    }
                                }<br /><br />
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td valign="top" width="150px" style="text-align: right; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: smaller">
                            <p align="right" style="vert-align: top; font-size: smaller">
                                Recording:
                            </p>
                        </td>
                        <td width="400px" style="text-align: left; background-color: #B4D1EC; padding-left: 6px;">
                            <p style="color: #000000; font-family: Arial, Helvetica, sans-serif; font-size: 12px;">
                                This link will connect you to the OnDemand playback page the this event:
                                <br />
                                <br /><br />
                            </p>

                        </td>
                    </tr>
                    @*<tr>
                            <td style="text-align: right; width: 130px; background-color: #CCCCCC; padding-right: 6px; font-size: smaller"></td>
                            <td style="text-align: left; background-color: #B4D1EC; padding-left: 6px;"></td>
                        </tr>*@
                </table>
            </td>
        </tr>}
</table>