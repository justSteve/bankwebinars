@using System.Configuration
@using System.Globalization
@using System.Linq
@using System.Text
@using System.Text.RegularExpressions
@using System.Web.Mvc.Html
@using CUWebinars.Business.Core
@using CUWebinars.Business.Core.Helpers
@using CUWebinars.Business.Models
@using CUWebinars.Business.Notification
@using CUWebinars.Business.Notification.ViewModel

@model CUWebinars.Business.Notification.ViewModel.WebinarPromoViewModel

<title>
    @{
        TtsTemplateHelper TtsTemplateHelperObject = new TtsTemplateHelper();

        var thisWebinar = Model.Webinar;
        string TenantHead = TtsTemplateHelperObject.Tenant();
    }
    [preview-@TenantHead] promo: @thisWebinar.Title
</title>


<html xmlns="http://www.w3.org/1999/xhtml">

@{

    var webinar = Model.Webinar;
    //var aff = Model.Affiliate;
    //int currentUserID = UserFacade.Instance.GetCurrentUserID();


    var ceuStmt = "";
    var ceuShort = "";

    if (String.IsNullOrEmpty(webinar.ceu) == false)
    {
        string[] ceu = webinar.ceu.Split('|');
        ceuShort = ceu[0];
        ceuStmt = ceu[1];
    }

    USTimeZone tz = USTimeZone.Central;
    string DateTimeString = TtsTemplateHelperObject.FormatTimeWithDuration(webinar.Date, tz, true, webinar.Duration);
    
    string Tenant = TtsTemplateHelperObject.Tenant();
    string TenantEmail = TtsTemplateHelperObject.TenantEmail();
    string TenantDomain = TtsTemplateHelperObject.TenantDomain();
    string TenantURL = TtsTemplateHelperObject.TenantURL();
    string TenantLogo = TtsTemplateHelperObject.TenantLogo();
    string TenantPrefix = TtsTemplateHelperObject.TenantPrefix();
    string TenantCom = TenantDomain + ".com";


    <head>
        <title>title</title>
        <style type="text/css">
            .sideBarBody {
                font-family: trebuchet ms;
                text-align: center;
                font-size: 8px;
                color: #000000;
            }

            .sideBarHead {
                font-family: trebuchet ms;
                font-weight: bold;
                text-align: center;
                font-size: 10px;
                color: #FF6600;
                font-weight: bold;
            }

            .headerTop {
                background-color: #FFCC66;
                border-top: 0px solid #000000;
                border-bottom: 1px solid #FFFFFF;
                text-align: center;
            }

            .adminText {
                font-size: 10px;
                color: #996600;
                line-height: 200%;
                font-family: trebuchet ms;
                text-decoration: none;
            }

            .headerBar {
                background-color: #FFFFFF;
                border-top: 0px solid #333333;
                border-bottom: 10px solid #FFFFFF;
            }

            .title {
            }

            .subTitle {
                font-size: 11px;
                font-weight: normal;
                color: #666666;
                font-style: italic;
                font-family: trebuchet ms;
            }

            td {
                font-size: 12px;
                color: #000000;
                line-height: 100%;
                font-family: trebuchet ms;
            }

            .sideColumn {
                background-color: #FFFFFF;
                border-left: 1px dashed #CCCCCC;
                text-align: left;
            }

            .sideColumnText {
                font-size: 11px;
                font-weight: normal;
                color: #999999;
                font-family: trebuchet ms;
                line-height: 150%;
            }

            .sideColumnTitle {
                font-size: 15px;
                font-weight: bold;
                color: #333333;
                font-family: trebuchet ms;
                line-height: 150%;
            }

            .footerRow {
                background-color: #FFFFCC;
                border-top: 10px solid #FFFFFF;
            }

            .footerText {
                font-size: 10px;
                color: #996600;
                line-height: 100%;
                font-family: trebuchet ms;
            }

            ul {
                line-height: 100%;
            }

            p {
                font-size: 12px;
                color: #000000;
                line-height: 100%;
                font-family: trebuchet ms;
            }
        </style>

    </head>


    <body style="font-family: Verdana, Arial, Helvetica, sans-serif">
        <div style="width: 900px; font-family: Arial, Helvetica, sans-serif">
            <table align="center" border="0" cellpadding="0" cellspacing="0">
                <tr>
                    <td bgcolor="#212226" colspan="2">
                        <table align="center" cellpadding="0" cellspacing="0" width="900">
                            <tbody>
                                <tr>
                                    <td align="left" bgcolor="#586B73" style="padding: 10px 0px 0px 15px" width="620">
                                        <div style="font-size: 20px; color: #ffffff; font-weight: bold; font-family: Arial, Helvetica, sans-serif">
                                            Featured Event!
                                        </div>
                                    </td>
                                    <td align="right" bgcolor="#232B2E" style="padding: 0px 5px 0px 5px" width="280">
                                        <div style="font-size: 12px; color: #ffffff; font-weight: bold; font-family: Arial, Helvetica, sans-serif">
                                            SendDate: @Model.SendDate.ToString()
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <table align="center" cellpadding="0" cellspacing="0" width="900px">
                            <tr bgcolor="#586B73">
                                <td width="470px">
                                    <img src="http://www.bankwebinars.com/Content/images/email/{aff_ttsdomain}/banner.jpg" />
                                </td>
                                <td width="230px">
                                    <img src="http://www.bankwebinars.com/Content/images/email/{aff_ttsdomain}/bannerCaption1.jpg" />
                                </td>
                                <td width="200px">
                                    <span>
                                        <a href="http://www.bankwebinars.com/Webinar/Calendar?idaff={aff_idUserAff}">
                                            <img alt="Upcoming.jpg" border="0" src="http://www.bankwebinars.com/Content/images/email/upcomingwebinars1.jpg" />
                                        </a>
                                    </span>
                                </td>

                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td style="border: 1px solid #000000; vertical-align: top;" width="620px">
                        <table align="center" border="0" cellpadding="0" cellspacing="0">
                            <tr>
                                <td style="padding: 15px 5px 0px 15px">
                                    <table>
                                        <tr>
                                            <td colspan="2">
                                                <h1 align="center">@webinar.Title</h1>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td width="130px">
                                                <img src="@(webinar.Presenter.PhotoThumb)" alt="Presenter Photo" />
                                            </td>
                                            <td>
                                                <p align="center">@DateTimeString</p>
                                                <p align="center">Presented by @webinar.Presenter.WebUser.FullName</p>
                                            </td>
                                        </tr>
                                    </table>
                                    <div>
                                        @webinar.Description
                                        <h2>
                                            @webinar.LearnCaption
                                        </h2>
                                        @webinar.LearnBody
                                        <h2>Who Should Attend</h2>
                                        @webinar.WhoAttend
                                        <h2>About @webinar.Presenter.WebUser.FullName </h2>
                                        @Model.EventBody
                                    </div>
                                    <div>
                                        <p>
                                            $265<br />
                                            <a href="http://www.bankwebinars.com/Webinar/Details/@webinar.idWebinar?idaff={aff_idUserAff}">Click here to sign up!</a>
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </td>

                    <td style="border-right: 1px solid #000000; vertical-align: top; padding: 0px 5px 0px 5px" bgcolor="#232B2E" width="280">
                        <table align="center" border="0" cellpadding="0" cellspacing="0" width="250px">
                            <tr>
                                <td style="padding: 10px 0 0 0; vertical-align: top; color: bisque;">
                                    @Model.UpcomingListing<hr />
                                    <p align="center" class="sideBarHead"><b>Compliance Perspectives: Monthly Update</b></p>
                                    <p class="sideBarBody">We are pleased to offer a monthly webinar series to help you keep up with changes and deadlines in the compliance area. <a href="http://www.bankwebinars.com/Webinar/Details/883?idaff={aff_idUserAff}" style="color: red; text-decoration: none; border-bottom: 1px dotted red; font-style: italic;">Click here for more information!</a></p>
                                    <hr />
                                    <p align="center" class="sideBarHead"><b>Webinar Subscription Packages</b></p>
                                    <p class="sideBarBody">Would you and your colleagues like to attend webinars at a lower price? With a Webinar Subscription Package, we can help you greatly reduce that expense. <a href="http://www.bankwebinars.com/handouts/WebinarFlyer2012-1.pdf" style="color: red; text-decoration: none; border-bottom: 1px dotted red; font-style: italic;">Click here to learn more about this cost-saving option.</a> </p>
                                    <hr />
                                    <p align="center" class="sideBarHead"><b>On-Demand Webinars Available</b></p>
                                    <p class="sideBarBody">Unable to attend the live session, or interested in a topic of a past webinar? Not a problem. Get the recording that includes online access to the webinar for six months as well as an audio CD and materials for offline viewing. <a href="http://www.bankwebinars.com/Webinar/Recorded?idaff={aff_idUserAff}" style="color: red; text-decoration: none; border-bottom: 1px dotted red; font-style: italic;">Click here to see all our On-Demand Recordings.</a></p>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td bgcolor="#586B73" colspan="2">
                        <table align="center" cellpadding="10" cellspacing="0" width="640px">
                            <tbody>
                                <tr>
                                    <td align="center">
                                        <p>
                                            A Production of TTS - BankWebinars.com<br />

                                            {aff_ContactPerson} - <a style="color: bisque; text-decoration: none; border-bottom: 1px dotted red;" href='mailto:{aff_ContactEmail}'>{aff_ContactEmail}</a> - {aff_ContactPhone}<br />
                                            <br />
                                        </p>
                                        {aff_EmailFooter}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
    </body>
}
</html>
