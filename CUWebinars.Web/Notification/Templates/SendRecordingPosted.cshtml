@using System.Text
@using System.Web.UI.WebControls
@using CUWebinars.Business.Models

@model CUWebinars.Business.Notification.ViewModel.PostEventPublishModel

    <title>
        @{
            var orderRows = from orderRow in Model.Order.OrderRows
                            where orderRow.RowStatus == OrderRowStatus.Active
                            select orderRow;
            var thisWebinar = orderRows.Single().Webinar;

            string TenantHead = TtsTemplateHelperObject.Tenant();
        }
        [@TenantHead] OnDemand recording posted for @thisWebinar.Title
    </title>

    <html xmlns="http://www.w3.org/1999/xhtml">
    @{

        var row = from orderRow in Model.Order.OrderRows
                  where orderRow.RowStatus == OrderRowStatus.Active
                  select orderRow;
        var webinar = row.Single().Webinar;
        var myRow = row.Single();



        string DateTimeString = TtsTemplateHelperObject.FormatTimeWithDuration(webinar.Date, Model.Order.WebUser.timeZone, true, webinar.Duration);
        string Tenant = TtsTemplateHelperObject.Tenant();
        string TenantEmail = TtsTemplateHelperObject.TenantEmail();
        string TenantDomain = TtsTemplateHelperObject.TenantDomain();
        string TenantURL = TtsTemplateHelperObject.TenantURL();
        string TenantPrefix = TtsTemplateHelperObject.TenantPrefix();
        string TenantLogo = TtsTemplateHelperObject.TenantLogo();


        var RegTypeFriendly = row.Single().RegistrationType.OptionLabel;

        switch (row.Single().RegistrationType.OptionLabel)
        {
            case "OnDemand Recording Only":
                RegTypeFriendly = "Recorded";
                break;
            case "CD-ROM and Hardcopy Handouts":
                RegTypeFriendly = "CD-ROM";
                break;
            case "Live Plus Five":
                RegTypeFriendly = "Live";
                break;

            default:
                break;
        }

        var HeaderText = "Your Recording is posted!";
        var BannerText = "Order Number: " + TenantPrefix + Model.Order.idOrder + "<br />Attendance Type: " + RegTypeFriendly;


        var infoPhrase = new StringBuilder();
        var notiRecordingPosted = myRow.RegistrationType.ShowRecordingNotifications;
        var notiShipped = myRow.RegistrationType.ShowShippedNotifications;


        var onDemandLink = new StringBuilder();

        if (myRow.RegistrationType.ShowLiveNotifications == "Yes")
        {
            infoPhrase.Append("<p>Dear " + Model.Order.FirstName + ",<br /><br />We hope you enjoyed <i>");
            infoPhrase.Append(row.Single().Webinar.Title + "</i>.</p>");

            if (notiRecordingPosted == "No")
            {

                infoPhrase.Append("<p> Included in your registration is a link (see below) to all course material for five(5) business days." +
                                  "  You can upgrade your order to gain 6 months OnDemand access - or get the Premier Package which includes a CD-ROM and printouts of the event's materials. We'll be happy to adjust your registration - just reply to this email! </p>");
            }
            else
            {
                infoPhrase.Append("<p> Included in your registration is a link (see below) to all course material for six months.");

                if (notiShipped == "Yes")
                {
                    infoPhrase.Append(" Your CD-ROM and printouts will be shipped soon and are typically in your hands within 7-10 business days.");
                }
                else
                {
                    infoPhrase.Append("  Add the CD-ROM plus printouts for the Premier Package. We'll be happy to upgrade your registration - just reply to this email!</p>");

                }
            }
        }
        else
        {
            infoPhrase.Append("<p>Dear " + Model.Order.FirstName + ",<br /><br />The recording of <i>");
            infoPhrase.Append(row.Single().Webinar.Title + "</i> is posted and ready to view.</p>");
            infoPhrase.Append("<p> Included in your registration is a link (see below) to all course material for six months.");

            if (notiShipped == "Yes")
            {
                infoPhrase.Append(" Your CD-ROM and printouts will be shipped soon and are typically in your hands within 7-10 business days.");
            }
            else
            {
                infoPhrase.Append("  We'll be happy to upgrade your registration and include a CD-ROM and printouts - just reply to this email!</p>");

            }

        }
        if (@webinar.Title.ToString().StartsWith("Compliance Perspectives"))
        {
            infoPhrase.Clear();
            infoPhrase.Append("<p>Dear " + Model.Order.FirstName + ",<br /><br />We hope you enjoyed this month's edition of the Compliance Perspectives.  </p>");
            if (notiRecordingPosted == "No")
            {
                onDemandLink.Append("<p>This event's materials is valid until next month's edition and may be shared with associates within your organization:</p><p><b>" + TenantURL + "/o/" + Model.Order.idOrder + "-" + myRow.OnDemandCode + "</b></p>");
            }
            else
            {
                onDemandLink.Append("<p>This event's materials is valid for 6 months and may be shared with associates within your organization:</p><p><b>" + TenantURL + "/o/" + Model.Order.idOrder + "-" + myRow.OnDemandCode + "</b></p>Subscription Summary:");
            }
        }
        else
        {
            //onDemandLink.Append("<p>This link to the event's materials is valid until " + Model.ExpiryDate + " and may be shared with associates within your organization:</p><p><b>" + TenantURL + "/o/" + Model.Order.idOrder + "-" + myRow.OnDemandCode + "</b></p>Order Summary:");
            onDemandLink.Append("<p>Log into " + TenantURL + "/MyWebinars to access the recording and other event materials.</p>Order Summary:");
        }

        <head>
            <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
            <title>Connection Information</title>
            <style type="text/css">
                .auto-style1 {
                    height: 10px;
                }

                .auto-style2 {
                    height: 50px;
                }
            </style>
        </head>
