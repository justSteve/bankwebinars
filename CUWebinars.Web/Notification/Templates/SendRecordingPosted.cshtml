                    </td>
                    <td>
                        <table align="center" border="0" cellpadding="0" cellspacing="0" height="115" width="645px">
                            <tbody>
                                <tr>
                                    <td bgcolor="#01232a" width="364">
                                        <img alt="@TenantURL/Content/images/vrLocal/hardware_2_header_1.jpg" border="0" height="36" margin="0px 0px 0px 0px" src="@TenantURL/Content/images/vrLocal/hardware_2_header_1.jpg" style="width: 374px; height: 36px; display: block;" width="374" />
                                    </td>
                                    <td align="right" bgcolor="#01232a" style="padding-right: 15px; border-top-color: rgb(52, 74, 88); border-right-color: rgb(52, 74, 88); border-top-width: 1px; border-right-width: 1px; border-top-style: solid; border-right-style: solid;" width="286">
                                        <div style="color: rgb(255, 255, 255); font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: bold;">
                                            @HeaderText
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td width="462px" bgcolor="#4c5966" valign="top">
                                        <img align="middle" alt="Site Logo" border="0" height="50" hspace="25" margin="0px 0px 0px 0px" src="@TenantLogo" style="display: block;" title="Site Logo" vspace="25" />
                                    </td>
                                    <td bgcolor="#4c5966" style="padding: 0px 15px 0px 0px; border-right-color: rgb(52, 74, 88); border-right-width: 1px; border-right-style: solid;">
                                        <span style="text-align: center; color: rgb(255, 255, 255); font-family: Arial, Helvetica, sans-serif; font-size: 12px;">
                                            @BannerText
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                    <td background="@TenantURL/Content/images/vrLocal/right_shadow.jpg" rowspan="3" valign="top" width="5">
                        <img alt="right_shadow.jpg" border="0" height="1" margin="0px 0px 0px 0px" src="@TenantURL/Content/images/vrLocal/right_shadow.jpg" style="width: 5px; height: 1px; display: block;" width="5" />
                    </td>
                </tr>


                <tr style="background-color: #B4D1EC">
                    <td style="padding: 15px 0px; border-right-color: rgb(52, 74, 88); border-left-color: rgb(52, 74, 88); border-right-width: 1px; border-left-width: 1px; border-right-style: solid; border-left-style: solid;">
                        <table align="center" cellpadding="0" cellspacing="0">
                            <tbody>
                                @*<tr style="background-color: #344a58">
                                        <td colspan="2" height="6">
                                            <img alt="large_box_top.gif" border="0" height="6" margin="0px 0px 0px 0px" src="@TenantURL/Content/images/vrLocal/large_box_top.gif" style="width: 630px; height: 6px; display: block;" />
                                        </td>
                                    </tr>*@

                                <tr style="background-color: #000000;">
                                    <td colspan="2">
                                        <img alt="spacer.gif" height="10" src="@TenantURL/Content/images/vrLocal/spacer.gif" style="width: 1px; height: 10px; display: block;" width="1" />
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="background-color: #344a58">
                                        <table width="630px" border="0" align="center" cellpadding="0" cellspacing="0">
                                            <tr>
                                                <td colspan="2">
                                                    <table width="550px" border="0" align="center" cellpadding="0" cellspacing="0">
                                                        <tr>
                                                            <td style="text-align: right; width: 50px; background-color: #000000; padding-right: 6px; font-size: smaller"></td>
                                                            <td width="500px" style="text-align: left; background-color: #B4D1EC; padding-left: 6px;">
                                                                <table border="0" cellpadding="0" cellspacing="0" style="width: 500px;">
                                                                    <tr>
                                                                        <td colspan="2" style="background-color: #344a58">
                                                                            <table border="0" align="center" cellpadding="0" cellspacing="0">
                                                                                <tr>
                                                                                    <td colspan="2" style="text-align: left; margin-left: 6px; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: smaller">
                                                                                        <div style="color: black; font-family: Arial, Helvetica, sans-serif; padding: 5px; font-size: 12px;">
                                                                                            @infoPhrase
                                                                                            @onDemandLink

                                                                                        </div>
                                                                                    </td>
                                                                                </tr>
                                                                                @Model.OrderSummaryString
                                                                                <tr>
                                                                                    <td colspan="2" style="text-align: left; margin-left: 6px; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: small">
                                                                                        <div style="color: black; font-family: Arial, Helvetica, sans-serif; padding: 5px; font-size: 12px;">
                                                                                            <p>
                                                                                                Again, thank you very much for your patronage and don't hesitate to let us know how we can serve you better!<br /><br />Sincerely,<br />The @Tenant Staff<br /><br />
                                                                                            </p>
                                                                                        </div>
                                                                                    </td>
                                                                                </tr>
                                                                            </table>
                                                                        </td>
                                                                    </tr>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="text-align: right; width: 50px; background-color: #000000; padding-right: 6px; font-size: smaller"></td>
                                                            <td width="500px" style="text-align: left; background-color: #B4D1EC; padding-left: 6px;">
                                                                <br />
                                                                <br />
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="background-color: #344a58; color: #FFFFCC; padding: 10px;" colspan="2"> </td>
                                </tr>
                                <tr style="background-color: #344a58">
                                    <td colspan="2" height="6">
                                        <img alt="large_box_bottom.gif" border="0" height="6" margin="0px 0px 0px 0px" src="@TenantURL/Content/images/vrLocal/large_box_bottom.gif" style="width: 630px; height: 6px; display: block;" />
                                    </td>
                                </tr>

                            </tbody>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td bgcolor="#344a58">
                        <table align="center" cellpadding="0" cellspacing="0" width="630">
                            <tbody>
                                <tr>
                                    <td align="right" style="padding-top: 10px;">
                                        <img alt="Phone 800-831-0678" margin="0px 0px 0px 0px" src="@TenantURL/Content/images/NotiFooter.gif" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td colspan="3" height="23">
                        <img alt="hardware_2_footer.jpg" border="0" height="23" margin="0px 0px 0px 0px" src="@TenantURL/Content/images/vrLocal/hardware_2_footer.jpg" style="width: 660px; height: 23px; display: block;" width="660" />
                    </td>
                </tr>
            </tbody>
