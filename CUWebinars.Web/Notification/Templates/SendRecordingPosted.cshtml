@using System.Text
@using CUWebinars.Business.Models
@*@model CUWebinars.Web.ViewModel.PostEventPublishModel*@
@model CUWebinars.Web.ViewModel.PostEventPublishModel

<title>
    @{
        var orderRows = from orderRow in Model.Order.OrderRows
                        where orderRow.RowStatus == OrderRowStatus.Active
                        select orderRow;
        var thisWebinar = orderRows.Single().Webinar;

        string TenantHead = TtsTemplateHelperObject.Tenant();
    }
    [@TenantHead] OnDemand recording posted for @thisWebinar.Title
</title>

<html xmlns="http://www.w3.org/1999/xhtml">
@{

    var row = from orderRow in Model.Order.OrderRows
              where orderRow.RowStatus == OrderRowStatus.Active
              select orderRow;
    var webinar = row.Single().Webinar;
    var myRow = row.Single();

    var joinURL = row.Single().TtsJoinUrl;
    var phone = "TBA";
    var code = "TBA";

    if (joinURL == null)
    {
        joinURL = "https://www2.gotomeeting.com/join/" + webinar.WebinarKey;
    }
    if (webinar.AccessCodeAttendee != null)
    {
        code = webinar.AccessCodeAttendee;
    }

    string DateTimeString = TtsTemplateHelperObject.FormatTimeWithDuration(webinar.Date, Model.Order.WebUser.timeZone, true, webinar.Duration);
    string Tenant = TtsTemplateHelperObject.Tenant();
    string TenantEmail = TtsTemplateHelperObject.TenantEmail();
    string TenantDomain = TtsTemplateHelperObject.TenantDomain();
    string TenantURL = TtsTemplateHelperObject.TenantURL();
    string TenantPrefix = TtsTemplateHelperObject.TenantPrefix();
    string TenantLogo = TtsTemplateHelperObject.TenantLogo();
    
    if (webinar.AccessPhone != null)
    {
        phone = webinar.AccessPhone;
    }


    var RegTypeFriendly = row.Single().RegistrationType.OptionLabel;

    switch (row.Single().RegistrationType.OptionLabel)
    {
        case "OnDemand Recording Only":
            RegTypeFriendly = "Recorded";
            break;
        case "CD-ROM and Hardcopy Handouts":
            RegTypeFriendly = "CD-ROM";
            break;
        case "Live Plus Five":
            RegTypeFriendly = "Live";
            break;

        default:
            break;
    }

    var HeaderText = "Your Recording is posted!";
    var BannerText = "Order Number: " + TenantPrefix + Model.Order.idOrderLegacy + "<br />Attendance Type: " + RegTypeFriendly;


    var infoPhrase = new StringBuilder();
    var notiRecordingPosted = myRow.RegistrationType.ShowRecordingNotifications;
    var notiShipped = myRow.RegistrationType.ShowShippedNotifications;
    var locations = myRow.AdditionalLocation;
    var addLocs = new StringBuilder();

    var onDemandLink = new StringBuilder();

    if (notiRecordingPosted == "No")
    {
        infoPhrase.Append("<p>Dear " + Model.Order.FirstName + ",<br /><br />We hope you enjoyed <i>");
        infoPhrase.Append(row.Single().Webinar.Title + "</i>.</p>");


        infoPhrase.Append("<p> Included in your registration are links to all course material for five(5) business days." +
                          "  You can upgrade your order to gain 6 months OnDemand access (adds $" + Model.CostFor6month + "). Or get the Premier Package by adding a CD-ROM ($" + Model.CostForCD + "). We'll be happy to adjust your registration - just reply to this email! </p>");
    }
    else
    {
        if (notiShipped == "Yes")
        {
            infoPhrase.Append("<p>Dear " + Model.Order.FirstName + ",<br /><br />We hope you enjoyed <i>");
            infoPhrase.Append(row.Single().Webinar.Title + "</i>.</p>");

            if (myRow.RegistrationType.ShowLiveNotifications == "Yes")
            {
                infoPhrase.Append("<p>Your materials will be shipped soon and are typically in your hands within 7-10 business days.");
                infoPhrase.Append(" Included in your registration are links to all course material for six months.</p>");
            }
        }
        else
        {
            infoPhrase.Append("<p>Dear " + Model.Order.FirstName + ",<br /><br />The recording for  <i>" + row.Single().Webinar.Title + "</i> has been posted!</p>");

            infoPhrase.Append("<p>Your registration includes access to OnDemand playback for the next six months.");
            infoPhrase.Append("  Add the CD-ROM plus printouts for the Premire Package ($" + Model.CostForCD + " extra). We'll be happy to upgrade your registration - just reply to this email!</p>");
        }
    }

    onDemandLink.Append(" <p>This link to the event's materials is valid until " + Model.ExpiryDate + " and may be shared with associates within your organization:</p><p><b>" + TenantURL + "/o/" + Model.Order.idOrder + "-" + myRow.OnDemandCode + "</b></p>Order Summary:");


    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <title>Connection Information</title>
        <style type="text/css">
            .auto-style1 {
                height: 10px;
            }

            .auto-style2 {
                height: 50px;
            }
        </style>
    </head>
    <body style="font-family: Verdana, Arial, Helvetica, sans-serif">
        <table width="660px" border="0" cellspacing="0" cellpadding="0">
            <tbody>
                @*<tr style="background-color: #344a58">
                        <td colspan="3">
                            <img alt="top_shadow.jpg" border="0" height="6" margin="0px 0px 0px 0px" src="@TenantURL/Content/images/vrLocal/top_shadow.jpg" style="width: 100%; height: 6px; display: block;" width="660" />
                        </td>
                    </tr>*@
