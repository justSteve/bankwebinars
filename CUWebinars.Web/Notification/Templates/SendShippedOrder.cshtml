@using CUWebinars.Business.Notification
@using CUWebinars.Html
@model CUWebinars.Business.Models.Order

<title>Confirmation of Registration - CU-@Model.idOrder</title>
<html xmlns="http://www.w3.org/1999/xhtml">
    
<body>
    <text>hello world!</text>
    
    @TtsHtmlObj.Label("OrderId"):
    @TtsHtmlObj.Span(Model.idOrder.ToString(), new { style="color: blue" })


    <table style="table-layout: fixed; width: 660px; white-space: nowrap; " border="0" cellspacing="0" cellpadding="0">
        <tbody>
            <tr style="background-color: #344a58; display: table-row;">
                <td colspan="3"></td>
            </tr>
            <tr style="background-color: #344a58; margin-bottom: 5px; margin-top: 5px;">
                <td>
                    <table align="center" border="0" cellpadding="0" cellspacing="0" height="215">
                        <tbody>
                            <tr>
                                <td bgcolor="#01232a"></td>
                                <td align="right" bgcolor="#01232a" style="padding-right: 15px; border-top-color: rgb(52, 74, 88); border-right-color: rgb(52, 74, 88); border-top-width: 1px; border-right-width: 1px; border-top-style: solid; border-right-style: solid;" width="286">
                                    <div style="color: rgb(255, 255, 255); font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: bold;">Order Confirmation</div>
                                </td>
                            </tr>
                            <tr>
                                <td bgcolor="#344a58" valign="top">
                                    <p>
                                        <br />
                                        @TtsHtmlObj.Image("DaveImage", "https://ttseast.blob.core.windows.net/images/vrLocal/logo.png", "CUwebinars.com", new { style = "width: 332px; height: 50px; display: block;", title = "CUwebinars.com", vspace = "25", width = "232", align = "middle", border = "0", hspace = "25", margin = "0px 0px 0px 0px" })

                                    </p>
                                </td>
                                <td align="left" bgcolor="#344a58" style="padding: 0px 15px 0px 0px; border-right-color: rgb(52, 74, 88); border-right-width: 1px; border-right-style: solid;">
                                    <p style="text-align: center; color: rgb(255, 255, 255); font-family: Arial, Helvetica, sans-serif; font-size: 12px;">
                                    </p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>

</body>

</html>
