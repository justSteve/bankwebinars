@using System.Configuration
@using System.Globalization
@using System.Linq
@using System.Text
@using System.Web.Mvc.Html
@using CUWebinars.Business.Core
@using CUWebinars.Business.Models
@using CUWebinars.Business.Notification.ViewModel
@model CUWebinars.Business.Notification.ViewModel.OrderSubmittedViewModel

<title>
    @{
        var orderRows = from orderRow in Model.Order.OrderRows
                        where orderRow.RowStatus == OrderRowStatus.Active
                        select orderRow;
        var thisWebinar = orderRows.Single().Webinar;
        string TenantHead = TtsTemplateHelperObject.Tenant();
    }
    [preview-@TenantHead] Confirmation of Registration: @thisWebinar.Title
</title>

<html xmlns="http://www.w3.org/1999/xhtml">
@{
    var row = from orderRow in Model.Order.OrderRows
              where orderRow.RowStatus == OrderRowStatus.Active
              select orderRow;
    var affiliate = row.Single().Order.Affiliate.DisplayTitle;
    var webinar = row.Single().Webinar;
    var rowRegType = row.Single().RegistrationType;
    var joinURL = row.Single().JoinURL;
    var myRow = row.Single();
    var phone = "TBA";
    var code = "TBA";
    var notiConnectionInfo = rowRegType.ShowLiveNotifications;
    var notiRecordingPosted = rowRegType.ShowRecordingNotifications;
    var notiShipped = rowRegType.ShowShippedNotifications;
    var displayOrderNumber = Model.Order.idOrder;

    if (Model.Order.idOrderLegacy != 0)
    {
        displayOrderNumber = Model.Order.idOrderLegacy;
    }

    var thankYouPhrase = new StringBuilder();
    var connInfoPhrase = new StringBuilder();
    var locations = myRow.AdditionalLocation;
    var addLocs = new StringBuilder();

    var isFirstOrderForThisUser = true;

    thankYouPhrase.Append("Dear " + Model.Order.FirstName + ",<br /><br />Thank you for your order for <b>");
    thankYouPhrase.Append(row.Single().RegistrationType.OptionLabel);
    thankYouPhrase.Append("</b> of <i>" + row.Single().Webinar.Title + "</i>");

    switch (Model.OrderGenesis)
    {
        case OrderGenesis.CreatedViaCartByExistingUser:
            break;
        case OrderGenesis.CreatedViaCartByNewUser:
            thankYouPhrase.Append(". When your order was submitted, we created an account and requested that you enter a new password. In case you missed that prompt or don't recall entering a password, please visit <b><a href=" + Model.AddPasswordUrl + ">Set My Password</a></b> or paste this URL into your browser:<i>" + Model.AddPasswordUrl + "</i>.");
            break;
        case OrderGenesis.ImportedForExistingUser:
            break;
        case OrderGenesis.ImportedForNewUser:
            thankYouPhrase.Append(" - placed for you by " + Model.Order.Affiliate.DisplayTitle + ". ");

            if (isFirstOrderForThisUser)
            {

                thankYouPhrase.Append(". We've created an account and request that you confirm this transaction by visiting (or pasting this address to your browser) <a href=" + Model.ConfirmChangeEmailUrl + "><b>" + Model.ConfirmChangeEmailUrl + "</b></a>");

            }
            break;
    }


    if (locations.Count != 0)
    {
        //redo this code to address lack of comparison operator
        //  lessThan sign doesn't work with the processor
        System.Text.StringBuilder addresses = new System.Text.StringBuilder();
        int optionsCost = 0;
        var iterator = 0;
        if (locations.Count == 1)
        {
            addLocs.Append("The registration includes a single additional location for " + @locations.First().Email + " costing " + locations.First().Price.ToString("C").Replace(".00", "") + ". ");
        }
        if (locations.Count == 2)
        {
            foreach (var addLoc in locations)
            {
                iterator++;
                if (iterator == 2)
                {
                    addresses.Append(addLoc.Email);
                }
                if (iterator == 1)
                {
                    {
                        addresses.Append(addLoc.Email + " and ");
                    }
                }
                optionsCost = optionsCost + Convert.ToInt32(addLoc.Price);
            }
            addLocs.Append(" This registration also includes " + locations.Count + " additional locations (total added cost is " + optionsCost.ToString("C").Replace(".00", "") + ") for " + addresses + ".");
            addLocs.Append(" Each of these addresses will receive individualized connection information.");
        }
    }

    if (webinar.Status == WebinarStatus.Scheduled)
    {

        if (notiConnectionInfo == "Yes")
        {
            connInfoPhrase.Append("<p>Two to three days prior to the event we'll send connection instructions and links to handouts and other materials. </p>");

            if (notiRecordingPosted == "Yes")
            {
                connInfoPhrase.Append("<p> Shortly following the conclusion you'll receive notification when the recording is posted");
                if (notiShipped == "Yes")
                {
                    connInfoPhrase.Append(" - then again 3-5 days later informing you that we've shipped your CD and printouts");
                }
                connInfoPhrase.Append(".</p>");
            }
            connInfoPhrase.Append("<p>" + addLocs + "</p>");
        }
        else
        {
            connInfoPhrase.Append("<p>Because this order doesn't include the <i>live</i> session we'll only be sending you a notification when the OnDemand Recording is posted");
            if (notiShipped == "Yes")
            {
                connInfoPhrase.Append(" and then another after your CD and printouts have shipped");
            }
            connInfoPhrase.Append(".</p>");
        }
    }


    if (webinar.Status == WebinarStatus.Active || webinar.Status == WebinarStatus.InProgress)
    {
        connInfoPhrase.Append("<p>");
        if (notiConnectionInfo == "Yes")
        {
            connInfoPhrase.Append(" Below you will find a link to connect directly to the webinar.");
        }
        if (notiRecordingPosted == "Yes")
        {
            connInfoPhrase.Append(" Shortly following the conclusion you'll receive notification that the recording is posted");

            if (notiShipped == "Yes")
            {
                connInfoPhrase.Append(" - then again 3-5 days later that we've shipped your CD and printouts");
            }
            connInfoPhrase.Append(".</p>");
        }
    }


    if (webinar.Status == WebinarStatus.Recorded || webinar.Status == WebinarStatus.Archived)
    {
        connInfoPhrase.Append("<p>");
        if (notiRecordingPosted == "Yes")
        {
            connInfoPhrase.Append(" See below for a link to access your recording and event materials.");
        }
        if (notiShipped == "Yes")
        {
            connInfoPhrase.Append(" Over the next 3-5 days you'll see a notification that we've shipped your physical materials.");
        }
        connInfoPhrase.Append("</p>");
    }


    if (joinURL == null)
    {
        joinURL = webinar.CitrixRegisterUrl;
    }
    if (webinar.AccessCodeAttendee != null)
    {
        code = webinar.AccessCodeAttendee;
    }

    string DateTimeString = TtsTemplateHelperObject.FormatTimeWithDuration(webinar.Date, Model.Order.WebUser.timeZone, true, webinar.Duration);
    string Tenant = TtsTemplateHelperObject.Tenant();
    string TenantEmail = TtsTemplateHelperObject.TenantEmail();
    string TenantDomain = TtsTemplateHelperObject.TenantDomain();
    string TenantURL = TtsTemplateHelperObject.TenantURL();
    string TenantLogo = TtsTemplateHelperObject.TenantLogo();
    string TenantPrefix = TtsTemplateHelperObject.TenantPrefix();

    if (webinar.AccessPhone != null)
    {
        phone = webinar.AccessPhone;
    }
    var HeaderText = "Confirmation of Additional Location for<br />" + webinar.Title;
    var BannerText = "Order Number: " + TenantPrefix + displayOrderNumber + "<br />Type: " + row.Single().RegistrationType.OptionLabel;
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <title>[@Tenant]: Confirmation of Registration for @webinar.Title</title>
        <style type="text/css">
            .auto-style1 {
                height: 10px;
            }

            .auto-style2 {
                height: 50px;
            }
        </style>
