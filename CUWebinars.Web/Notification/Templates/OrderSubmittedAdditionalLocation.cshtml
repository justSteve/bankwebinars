    var rowRegType = row.Single().RegistrationType;
    var joinURL = row.Single().TtsJoinUrl;
    var myRow = row.Single();
    var phone = "TBA";
    var code = "TBA";
    var notiConnectionInfo = rowRegType.ShowLiveNotifications;
    var notiRecordingPosted = rowRegType.ShowRecordingNotifications;
    var notiShipped = rowRegType.ShowShippedNotifications;
    var displayOrderNumber = Model.Order.idOrder;
    string DateTimeString = TtsTemplateHelperObject.FormatTimeWithDuration(webinar.Date, Model.Order.WebUser.timeZone, true, webinar.Duration);
    string Tenant = TtsTemplateHelperObject.Tenant();
    string TenantEmail = TtsTemplateHelperObject.TenantEmail();
    string TenantDomain = TtsTemplateHelperObject.TenantDomain();
    string TenantURL = TtsTemplateHelperObject.TenantURL();
    string TenantLogo = TtsTemplateHelperObject.TenantLogo();
    string TenantPrefix = TtsTemplateHelperObject.TenantPrefix();

    if (Model.Order.idOrderLegacy != 0)
    {
        displayOrderNumber = Model.Order.idOrderLegacy;
    }

    var thankYouPhrase = new StringBuilder();
    var connInfoPhrase = new StringBuilder();
    var locations = myRow.AdditionalLocation;
    var addLocs = new StringBuilder();

    var isFirstOrderForThisUser = true;

    thankYouPhrase.Append("Your email is included in an order placed by " + Model.Order.FirstName + " " + Model.Order.LastName + " as an Additional Location for the upcoming event titled");
    thankYouPhrase.Append("<i>" + row.Single().Webinar.Title + "</i>");

    if (webinar.Status == WebinarStatus.Scheduled)
    {
        connInfoPhrase.Append("<p>Two to three days prior to the event we'll send connection instructions and links to handouts and other materials. </p>");
    }


    if (webinar.Status == WebinarStatus.Active || webinar.Status == WebinarStatus.InProgress)
    {
        connInfoPhrase.Append(" <p>Below you will find a link to connect directly to the webinar.</p>");
    }

    if (joinURL == null)
    {
        joinURL = webinar.CitrixRegisterUrl;
    }
    if (webinar.AccessCodeAttendee != null)
    {
        code = webinar.AccessCodeAttendee;
    }


    if (webinar.AccessPhone != null)
    {
        phone = webinar.AccessPhone;
    }
    var HeaderText = "Additional Location for<br />" + webinar.Title;
    var BannerText = "Type: " + row.Single().RegistrationType.OptionLabel;
