    var notiConnectionInfo = rowRegType.ShowLiveNotifications;
    var notiRecordingPosted = rowRegType.ShowRecordingNotifications;

    System.Text.StringBuilder connInfoPhrase = new System.Text.StringBuilder();

    if (webinar.Status == WebinarStatus.Scheduled)
    {
        if (notiConnectionInfo == "Yes")
        {
            connInfoPhrase.Append("<p> Your contact information is included as an attendee ");
            connInfoPhrase.Append("for this upcoming webinar. We'll be sending you an email with connection instructions ");
            connInfoPhrase.Append("2-3 days prior to the event plus a reminder sent the morning of. Included in those ");
            connInfoPhrase.Append("instructions will be a link that will provide direct access to the webinar and has been ");
            connInfoPhrase.Append("generated specifically for this email address - please do not share that link with anyone else.</p>");

            if (notiRecordingPosted == "Yes")
            {
                connInfoPhrase.Append("<p> Shortly following the conclusion you'll receive notification that the recording is posted");
                connInfoPhrase.Append(".</p>");
            }
        }
    }


    if (webinar.Status == WebinarStatus.Active)
