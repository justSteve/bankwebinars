        if (notiRecordingPosted == "Yes")
        {
            connInfoPhrase.Append(" Shortly following the conclusion you'll receive another notification that the recording is posted");
            connInfoPhrase.Append(".</p>");
        }
    }

    if (joinURL == null)
    {
        joinURL = "https://www2.gotomeeting.com/join/" + webinar.WebinarKey;
    }
    if (webinar.AccessCodeAttendee != null)
    {
        code = webinar.AccessCodeAttendee;
    }

