@using System.Web.Mvc.Html
@using CUWebinars.Business.Notification
@model CUWebinars.Business.Models.Order

<title>Confirmation of Registration - CU-@Model.idOrder</title>
<html xmlns="http://www.w3.org/1999/xhtml">
@{
    var row = Model.OrderRows.SingleOrDefault();
    var joinURL = row.JoinURL;
    if (joinURL == null)
    {
        joinURL = "https://www2.gotomeeting.com/join/" + row.Webinar.WebinarKey;
    }

    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <title>Confirmation of Registration - CU-@Model.idOrder</title>
        <style type="text/css">
            .auto-style1 {
                height: 10px;
            }

            .auto-style2 {
                height: 50px;
            }
        </style>
    </head>
    <body style="font-family: Verdana, Arial, Helvetica, sans-serif">
        <table style="table-layout: fixed; width: 660px; white-space: nowrap; " border="0" cellspacing="0" cellpadding="0">
            <tbody>
                @*<tr style="background-color: #344a58; display: table-row;">
                        <td colspan="2">
                            <img alt="top_shadow.jpg" border="0" height="6" margin="0px 0px 0px 0px" src="https://ttseast.blob.core.windows.net/images/vrLocal/top_shadow.jpg" style="height: 6px; display: block;" width="660" />
                        </td>
                    </tr>*@
                <tr style="background-color: #344a58; margin-bottom: 5px; margin-top: 5px;">
                    <td>
                        <table align="center" border="0" cellpadding="0" cellspacing="0" height="150px">
                            <tbody>
                                <tr>
                                    <td align="right" bgcolor="#01232a">
                                        <img alt="https://ttseast.blob.core.windows.net/images/vrLocal/hardware_2_header_1.jpg" border="0" height="36" margin="0px 0px 0px 0px" src="https://ttseast.blob.core.windows.net/images/vrLocal/hardware_2_header_1.jpg" style="width: 374px; height: 36px; display: block;" width="374" />
                                    </td>
                                    <td align="right" bgcolor="#01232a" style="padding-right: 15px; border-top-color: rgb(52, 74, 88); border-right-color: rgb(52, 74, 88); border-top-width: 1px; border-right-width: 1px; border-top-style: solid; border-right-style: solid;" width="286">
                                        <div style="color: rgb(255, 255, 255); font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: bold;">Order Confirmation</div>
                                    </td>
                                </tr>
                                <tr>
                                    <td bgcolor="#344a58" valign="top">
                                        <p>
                                            <img align="middle" alt="CUwebinars.com" border="0" hspace="25" margin="0px 0px 0px 0px" src="https://ttseast.blob.core.windows.net/images/vrLocal/logo.png" style="width: 332px; height: 50px; display: block;" title="CUwebinars.com" vspace="25" width="332" />
                                        </p>
                                    </td>
                                    <td align="left" bgcolor="#344a58" style="padding: 0px 15px 0px 0px; border-right-color: rgb(52, 74, 88); border-right-width: 1px; border-right-style: solid;">
                                        <p style="text-align: right; color: #fff; font-family: Arial, Helvetica, sans-serif; font-size: 12px;">
                                            Order Number: @Model.idOrder<br />
                                            SKU: @row.RegistrationType.SKU
                                        </p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>

                <tr style="background-color: #B4D1EC">
                    <td style="padding: 15px 0px; border-right-color: #344a58; border-left-color: #344a58; border-right-width: 1px; border-left-width: 1px; border-right-style: solid; border-left-style: solid;">

                        <table style="table-layout: fixed; width: 350px; white-space: nowrap; " align="center" cellpadding="0" cellspacing="0">
                            <tbody>
                                @*<tr style="background-color: #344a58">
                                        <td colspan="2" height="6">
                                            <img alt="large_box_top.gif" border="0" height="6" margin="0px 0px 0px 0px" src="https://ttseast.blob.core.windows.net/images/vrLocal/large_box_top.gif" style="width: 630px; height: 6px; display: block;" />
                                        </td>
                                    </tr>*@

                                <tr style="background-color: #344a58">
                                    <td colspan="2">
                                        <img alt="spacer.gif" height="10" src="https://ttseast.blob.core.windows.net/images/vrLocal/spacer.gif" style="width: 1px; height: 10px; display: block;" width="1" />
                                    </td>
                                </tr>

                                <tr>
                                    <td colspan="2" style="background-color: #344a58">
                                        <table border="0" align="center" cellpadding="0" cellspacing="0">
                                            <tr>
                                                <td width="150px" style="text-align: right; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: smaller"> </td>
                                                <td width="400px" style="text-align: left; background-color: #B4D1EC; padding-left: 6px;"> </td>
                                            </tr>
                                            <tr>
                                                <td width="150px" style="text-align: right; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: smaller"> </td>
                                                <td width="400px" style="text-align: left; background-color: #B4D1EC; padding-left: 6px;">
                                                    <p style="color: black; font-family: Arial, Helvetica, sans-serif; font-size: 12px;">
                                                        <br />Dear @Model.FirstName,<br />
                                                        Thank you for your recent order.<br /><br />
                                                    </p>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td valign="top" width="150px" style="text-align: right; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: smaller"><p align="right" style="vert-align: top; font-size: smaller">Title:</p></td>
                                                <td width="400px" style="text-align: left; background-color: #B4D1EC; padding-left: 6px;">
                                                    <p style="color: black; font-family: Arial, Helvetica, sans-serif; font-size: 12px;">
                                                        @row.Webinar.Title<br />
                                                    </p>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td valign="top" width="150px" style="text-align: right; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: smaller"><p align="right" style="vert-align: top; font-size: smaller">Date:</p></td>
                                                <td width="400px" style="text-align: left; background-color: #B4D1EC; padding-left: 6px;">
                                                    <p style="color: #000000; font-family: Arial, Helvetica, sans-serif; font-size: 12px;">
                                                        <b>
                                                            @row.Webinar.Date.ToString("dddd, MMMM d"), @row.Webinar.Date.ToString("yyyy")
                                                        </b> - <i>10:00 am - 11:00 am CT</i><br /><br />
                                                    </p>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td valign="top" width="150px" style="text-align: right; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: smaller"><p align="right" style="vert-align: top; font-size: smaller">Event Materials:</p></td>
                                                <td width="400px" style="text-align: left; background-color: #B4D1EC; padding-left: 6px;">
                                                    <p style="color: #000000; font-family: Arial, Helvetica, sans-serif; font-size: 12px;">
                                                        @{
                                                            foreach (var i in row.Webinar.WebinarFiles)
                                                            {
                                                                <a href="@i.fileLocation">@i.fileDesc</a>
                                                            }
                                                        }<br /><br />
                                                    </p>
                                                </td>
                                            </tr>

                                            @{
                                                if (row.RegistrationType.ShowLiveNotifications == "Yes")
                                                {
                                                    if (row.Webinar.ConnectionInfo != null)
                                                    {
                                                        <tr>
                                                            <td valign="top" width="150px" style="text-align: right; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: smaller"><p align="right" style="vert-align: top; font-size: smaller">Event Materials:</p></td>
                                                            <td width="400px" style="text-align: left; background-color: #B4D1EC; padding-left: 6px;">

                                                                <span> here's connection info</span>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="text-align: right; width: 130px; background-color: #CCCCCC; padding-right: 6px; font-size: smaller"></td>
                                                            <td style="text-align: left; background-color: #B4D1EC; padding-left: 6px;"></td>
                                                        </tr>
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td valign="top" width="150px" style="text-align: right; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: smaller"><p align="right" style="vert-align: top; font-size: smaller">Event Materials:</p></td>
                                                            <td width="400px" style="text-align: left; background-color: #B4D1EC; padding-left: 6px;">

                                                                <p>The connection information is not yet generated.</p>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="text-align: right; width: 130px; background-color: #CCCCCC; padding-right: 6px; font-size: smaller"></td>
                                                            <td style="text-align: left; background-color: #B4D1EC; padding-left: 6px;"></td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td valign="top" width="150px" style="text-align: right; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: smaller"><p align="right" style="vert-align: top; font-size: smaller">Event Materials:</p></td>
                                                        <td width="400px" style="text-align: left; background-color: #B4D1EC; padding-left: 6px;">

                                                            <p><b>Live Attendance</b> is not included in this order.</p>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="text-align: right; width: 130px; background-color: #CCCCCC; padding-right: 6px; font-size: smaller"></td>
                                                        <td style="text-align: left; background-color: #B4D1EC; padding-left: 6px;"></td>
                                                    </tr>
                                                }

                                                if (row.RegistrationType.ShowShippedNotifications == "Yes")
                                                {
                                                    if (row.Webinar.RecordingUrl == "")
                                                    {
                                                        <tr>
                                                            <td valign="top" width="150px" style="text-align: right; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: smaller"><p align="right" style="vert-align: top; font-size: smaller">Event Materials:</p></td>
                                                            <td width="400px" style="text-align: left; background-color: #B4D1EC; padding-left: 6px;">

                                                                <p>
                                                                    The CD-ROM and handouts will ship a few days following the event.
                                                                    The order also includes six months access to the OnDemand Recording.
                                                                    Recordings are posted within 24 hours following the event. Watch your email (or visit MyWebinars) for more information.
                                                                </p>

                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="text-align: right; width: 130px; background-color: #CCCCCC; padding-right: 6px; font-size: smaller"></td>
                                                            <td style="text-align: left; background-color: #B4D1EC; padding-left: 6px;"></td>
                                                        </tr>
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td valign="top" width="150px" style="text-align: right; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: smaller"><p align="right" style="vert-align: top; font-size: smaller">Event Materials:</p></td>
                                                            <td width="400px" style="text-align: left; background-color: #B4D1EC; padding-left: 6px;">


                                                                <p>
                                                                    The CD-ROM and handouts will ship within a few days.
                                                                    The order also includes six months access to the OnDemand Recording.
                                                                    Details are provided in a separate email.
                                                                </p>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="text-align: right; width: 130px; background-color: #CCCCCC; padding-right: 6px; font-size: smaller"></td>
                                                            <td style="text-align: left; background-color: #B4D1EC; padding-left: 6px;"></td>
                                                        </tr>
                                                    }
                                                }
                                                @*else
                                                    {
                                                        if (row.RegistrationType.ShowRecordingNotifications == "Yes")
                                                        {
                                                            <p>The recording included in this order is <b>OnDemand</b> only. No items will be shipped.</p>
                                                            if (row.Webinar.RecordingUrl == "")
                                                            {
                                                                <p>
                                                                    Recordings are posted within 24 hours following the event.
                                                                    Watch your email (or visit MyWebinars) for more information.
                                                                </p>
                                                            }
                                                            else
                                                            {
                                                                @Include("_RecordingInfo.cshtml", @Model)
                                                            }

                                                        }
                                                    }*@
                                            }

                                        </table>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td style="background-color: #344a58; color: #FFFFCC; padding: 10px;" colspan="2">
                        <div style="color: rgb(255, 255, 255); text-align: right; font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: bold;">For Technical Support call 800-831-0678 ext. 6</div>
                    </td>
                </tr>
                <tr style="background-color: #344a58">
                    <td colspan="2" height="6">
                        <img alt="large_box_bottom.gif" border="0" height="6" margin="0px 0px 0px 0px" src="https://ttseast.blob.core.windows.net/images/vrLocal/large_box_bottom.gif" style=" height: 6px; display: block;" />
                    </td>
                </tr>

                <tr>
                    <td colspan="2" bgcolor="#344a58">
                        <table align="center" cellpadding="0" cellspacing="0" width="660">
                            <tbody>
                                <tr>
                                    <td align="right" style="padding-top: 10px;">
                                        <div style="color: rgb(255, 255, 255); font-size: 11px;">
                                            <img align="none" alt="footer" border="0" height="59" hspace="0" src="https://ttseast.blob.core.windows.net/images/vrLocal/footer.gif" style="width: 274px; height: 59px;" title="footer" vspace="0" width="274" />
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td colspan="2" height="23">
                        <img alt="hardware_2_footer.jpg" border="0" height="23" margin="0px 0px 0px 0px" src="https://ttseast.blob.core.windows.net/images/vrLocal/hardware_2_footer.jpg" style=" height: 23px; display: block;" />
                    </td>
                </tr>
            </tbody>
        </table>
    </body>
}
</html>
