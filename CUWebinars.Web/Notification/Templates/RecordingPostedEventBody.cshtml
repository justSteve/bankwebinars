                        <tbody>
                            <tr style="background-color: #344a58">
                                <td colspan="2" height="6">
                                    <img alt="large_box_top.gif" border="0" height="6" margin="0px 0px 0px 0px" src="http://ttsimages.ttstrain.com/images/vrLocal/large_box_top.gif" style="width: 630px; height: 6px; display: block;" />
                                </td>
                            </tr>

                            <tr style="background-color: #344a58">
                                <td colspan="2">
                                    <img alt="spacer.gif" height="10" src="http://ttsimages.ttstrain.com/images/vrLocal/spacer.gif" style="width: 1px; height: 10px; display: block;" width="1" />
