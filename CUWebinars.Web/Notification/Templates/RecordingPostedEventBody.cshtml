                                                    </tr>
                                                    <tr>
                                                        <td style="text-align: right; width: 130px; background-color: #CCCCCC; padding-right: 6px; font-size: smaller"></td>
                                                        <td style="text-align: left; background-color: #B4D1EC; padding-left: 6px;">
                                                            Because of your recent webinar registration an account has been created in your name at @Tenant. Note that this account is administered by CUWebinars.com and yourself. Your initial login to the account will use your last name - all lower case. Upon entry you will be prompted to update this to a secure password of your choosing.
                                                            We recommend that you choose a strong password that is unique to this site.
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="text-align: right; width: 130px; background-color: #CCCCCC; padding-right: 6px; font-size: smaller"></td>
                                                        <td style="text-align: left; background-color: #B4D1EC; padding-left: 6px;"><br />Please confirm your reciept of this message by clicking: <b><a href="@Model.ConfirmChangeEmailUrl">@Model.ConfirmChangeEmailUrl</a></b><br /></td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>

                            <tr>
                                <td style="background-color: #344a58; color: #FFFFCC; padding: 10px;" colspan="2">&nbsp;</td>
                            </tr>
                            <tr style="background-color: #344a58">
                                <td colspan="2" height="6">
                                    <img alt="large_box_bottom.gif" border="0" height="6" margin="0px 0px 0px 0px" src="http://ttsimages.ttstrain.com/images/vrLocal/large_box_bottom.gif" style="width: 630px; height: 6px; display: block;" />
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </td>
            </tr>
            <tr>
                <td bgcolor="#344a58">
                    <table align="center" cellpadding="0" cellspacing="0" width="630">
                        <tbody>
                            <tr>
                                <td align="right" style="padding-top: 10px;">
                                    <div style="color: rgb(255, 255, 255); font-size: 11px;">
                                        <img align="none" alt="footer" border="0" height="59" hspace="0" src="http://ttsimages.ttstrain.com/images/vrLocal/footer.gif" style="width: 274px; height: 59px;" title="footer" vspace="0" width="274" />
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
            <tr>
                <td colspan="3" height="23">
                    <img alt="hardware_2_footer.jpg" border="0" height="23" margin="0px 0px 0px 0px" src="http://ttsimages.ttstrain.com/images/vrLocal/hardware_2_footer.jpg" style="width: 660px; height: 23px; display: block;" width="660" />
                </td>
            </tr>
        </tbody>
    </table>

</body>
</html>
