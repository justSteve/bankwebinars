@model CUWebinars.Web.Membership.Notification

<!DOCTYPE HTML PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Account Is Created</title>
    <style type="text/css">
        .auto-style1 {
            height: 10px;
        }

        .auto-style2 {
            height: 50px;
        }
    </style>
</head>
<body style="font-family: Verdana, Arial, Helvetica, sans-serif">
    @{    string DateTimeString = TtsTemplateHelperObject.FormatTimeWithDuration(webinar.Date, Model.WebUser.timeZone, true, webinar.Duration);
        string Tenant = TtsTemplateHelperObject.Tenant();
        string TenantEmail = TtsTemplateHelperObject.TenantEmail();
        string TenantDomain = TtsTemplateHelperObject.TenantDomain();
        string TenantURL = TtsTemplateHelperObject.TenantURL();
        string TenantPrefix = TtsTemplateHelperObject.TenantPrefix();
        string TenantLogo = TtsTemplateHelperObject.TenantLogo();
    }
    <table width="660px" border="0" cellspacing="0" cellpadding="0">
        <tbody>
            <tr style="background-color: #344a58">
                <td colspan="3">
                    <img alt="top_shadow.jpg" border="0" height="6" margin="0px 0px 0px 0px" src="http://ttsimages.ttstrain.com/images/vrLocal/top_shadow.jpg" style="width: 100%; height: 6px; display: block;" width="660" />
                </td>
            </tr>
            <tr style="background-color: #344a58">
                <td background="http://ttsimages.ttstrain.com/images/vrLocal/left_shadow.jpg" rowspan="3" valign="top" width="5">
                    <img alt="left_shadow.jpg" border="0" height="1" margin="0px 0px 0px 0px" src="http://ttsimages.ttstrain.com/images/vrLocal/left_shadow.jpg" style="width: 5px; height: 1px; display: block;" width="5px" />
                </td>
                <td>
                    <table align="center" border="0" cellpadding="0" cellspacing="0" height="115" width="645px">
                        <tbody>
                            <tr>
                                <td bgcolor="#01232a" width="364">
                                    <img alt="http://ttsimages.ttstrain.com/images/vrLocal/hardware_2_header_1.jpg" border="0" height="36" margin="0px 0px 0px 0px" src="http://ttsimages.ttstrain.com/images/vrLocal/hardware_2_header_1.jpg" style="width: 374px; height: 36px; display: block;" width="374" />
                                </td>
                                <td align="right" bgcolor="#01232a" style="padding-right: 15px; border-top-color: rgb(52, 74, 88); border-right-color: rgb(52, 74, 88); border-top-width: 1px; border-right-width: 1px; border-top-style: solid; border-right-style: solid;" width="286">
                                    <div style="color: rgb(255, 255, 255); font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: bold;">Account Created</div>
                                </td>
                            </tr>
                            <tr>
                                <td width="462px" bgcolor="#344a58" valign="top">
                                    <img align="middle" alt="Site Logo" border="0" height="50" hspace="25" margin="0px 0px 0px 0px" src="@TenantLogo" style="width: 332px; height: 50px; display: block;" title="Site Logo" vspace="25" width="332" />
