<!DOCTYPE html>
<html>
<head>
    <title></title>
    <meta http-equiv="content-type" content="text/html; charset=utf-8" />
</head>
<body style="background-color: #FAFAFA">

    <table width="100%" border="0" cellpadding="0" cellspacing="0">
        <tbody>
            <tr>
                <td valign="top">
                    <table width="100%" border="0" cellpadding="0" cellspacing="0">
                        <tbody>
                            <tr>
                                <td style="padding: 0 9px; mso-line-height-rule: exactly; -ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%;" valign="top">
                                    <table align="left" border="0" cellpadding="0" cellspacing="0">
                                        <tbody>
                                            <tr>
                                                <td valign="top"><img alt="Photo: @webinar.Presenter.WebUser.FullName" class=" mcnimage" src="@webinar.Presenter.PhotoThumb" style="max-width: 200px; border: 0; height: auto; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; vertical-align: bottom;" width="82"></td>
                                            </tr>
                                        </tbody>
                                    </table>

                                    <table width="246" align="center" border="0" cellpadding="0" cellspacing="0">
                                        <tbody>
                                            <tr>
                                                <td valign="middle">
                                                    @webinar.Date.ToLongDateString()<br />
                                                    @Model.TimeFormatDisplay<br />
                                                    Presented by @webinar.Presenter.WebUser.FullName<br>

                                                    <a href="@TenantURL/webinar/details/@Model.Webinar.idWebinar?idaff={aff_idUserAff}" style="color: #2BAADF; font-weight: normal; text-decoration: underline;" target="_blank">Click here to sign up!</a><br /><br />

                                                    <span style="font-size: xx-small; line-height: 100%"><i>*Can't attend? OnDemand playback included with your registration.</i></span>

                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>


</body>
</html>