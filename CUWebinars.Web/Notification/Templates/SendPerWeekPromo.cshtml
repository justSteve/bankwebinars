@using System.Configuration
@using System.Globalization
@using System.Linq
@using System.Text
@using System.Web.Mvc.Html
@using CUWebinars.Business.Core
@using CUWebinars.Business.Models
@using CUWebinars.Business.Notification.ViewModel
@model CUWebinars.Business.Notification.ViewModel.WebinarPromoViewModel

<title>
    @{
        
        string TenantHead = TtsTemplateHelperObject.Tenant();
    }
    [@TenantHead] Promo for: @Model.Webinar.Title
</title>

<html xmlns="http://www.w3.org/1999/xhtml">
@{

    var webinar = Model.Webinar;
    var aff = Model.Affiliate;
    //int currentUserID = UserFacade.Instance.GetCurrentUserID();


    var ceuStmt = "";
    var ceuShort = "";

    if (String.IsNullOrEmpty(webinar.ceu) == false)
    {
        string[] ceu = webinar.ceu.Split('|');
        ceuShort = ceu[0];
        ceuStmt = ceu[1];
    }
    var UpcomingListing = Model.UpcomingListing;

    string DateTimeString = TtsTemplateHelperObject.FormatTimeWithDuration(webinar.Date, aff.WebUser.timeZone, true, webinar.Duration);
    string Tenant = TtsTemplateHelperObject.Tenant();
    string TenantEmail = TtsTemplateHelperObject.TenantEmail();
    string TenantDomain = TtsTemplateHelperObject.TenantDomain();
    string TenantURL = TtsTemplateHelperObject.TenantURL();
    string TenantLogo = TtsTemplateHelperObject.TenantLogo();
    string TenantPrefix = TtsTemplateHelperObject.TenantPrefix();
    string TenantCom = TenantDomain + ".com";


    <head>
        <style type="text/css">
            /*<![CDATA[*/
            .sideBarBody {
                font-family: trebuchet ms;
                text-align: center;
                font-size: 8px;
                color: #000000;
            }

            .sideBarHead {
                font-family: trebuchet ms;
                font-weight: bold;
                text-align: center;
                font-size: 10px;
                color: #FF6600;
                font-weight: bold;
            }

            .headerTop {
                background-color: #FFCC66;
                border-top: 0px solid #000000;
                border-bottom: 1px solid #FFFFFF;
                text-align: center;
            }

            .adminText {
                font-size: 10px;
                color: #996600;
                line-height: 200%;
                font-family: trebuchet ms;
                text-decoration: none;
            }

            .headerBar {
                background-color: #FFFFFF;
                border-top: 0px solid #333333;
                border-bottom: 10px solid #FFFFFF;
            }

            .title {
            }

            .subTitle {
                font-size: 11px;
                font-weight: normal;
                color: #666666;
                font-style: italic;
                font-family: trebuchet ms;
            }

            td {
                font-size: 12px;
                color: #000000;
                line-height: 100%;
                font-family: trebuchet ms;
            }

            .sideColumn {
                background-color: #FFFFFF;
                border-left: 1px dashed #CCCCCC;
                text-align: left;
            }

            .sideColumnText {
                font-size: 11px;
                font-weight: normal;
                color: #999999;
                font-family: trebuchet ms;
                line-height: 150%;
            }

            .sideColumnTitle {
                font-size: 15px;
                font-weight: bold;
                color: #333333;
                font-family: trebuchet ms;
                line-height: 150%;
            }

            .footerRow {
                background-color: #FFFFCC;
                border-top: 10px solid #FFFFFF;
            }

            .footerText {
                font-size: 10px;
                color: #996600;
                line-height: 100%;
                font-family: trebuchet ms;
            }

            ul {
                line-height: 100%;
            }

            p {
                font-size: 12px;
                color: #000000;
                line-height: 100%;
                font-family: trebuchet ms;
            }
            /*]]>*/
        </style>

        <title></title>
    </head>

    <body leftmargin="0" marginwidth="0" topmargin="0" marginheight="0" offset="0" bgcolor="#FFFFFF">

        <div style="width: 900px; margin: 0 auto 0 auto; font-family: Arial, Helvetica, sans-serif">
            <table align="center" border="0" cellpadding="0" cellspacing="0">
                <tr>
                    <td bgcolor="#212226" colspan="2">
                        <table align="center" cellpadding="0" cellspacing="0" width="900">
                            <tbody>
                                <tr>
                                    <td align="left" bgcolor="#586B73" style="padding: 10px 0px 0px 15px" width="620">
                                        <div style="font-size: 20px; color: #ffffff; font-weight: bold; font-family: Arial, Helvetica, sans-serif">
                                            Featured Events! @aff.DisplayTitle
                                        </div>
                                    </td>
                                    <td align="right" bgcolor="#232B2E" style="padding: 0px 5px 0px 5px" width="280">
                                        <div style="font-size: 12px; color: #ffffff; font-weight: bold; font-family: Arial, Helvetica, sans-serif">
                                            @DateTimeString
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <table align="center" cellpadding="0" cellspacing="0" width="900">
                            <tr bgcolor="#586B73">
                                <td width="470">
                                    <img src="http://www.bankwebinars.com/Content/images/email/@aff.ttsDomain/banner.jpg" />
                                </td>
                                <td width="230">
                                    <img src="http://www.bankwebinars.com/Content/images/email/@aff.ttsDomain/bannerCaption1.jpg" />
                                </td>
                                <td width="200">
                                    <p>
                                        <a href="http://www.bankwebinars.com/Webinar/Calendar?idaff=@aff.idUserAff">
                                            <img alt="Upcoming.jpg" border="0" src="http://www.bankwebinars.com/Content/images/email/upcomingwebinars1.jpg" />
                                        </a>
                                    </p>
                                </td>

                            </tr>
                        </table>
                    </td>
                </tr>

                <tr>
                    <td style="border: 1px solid #000000; vertical-align: top;" width="620">
                        <table align="center" border="0" cellpadding="0" cellspacing="0">
                            <tbody>
                                <tr>
                                    <td style="padding: 0px 5px 0px 5px">
                                        <div id="eventBody">
                                            <p>Greetings {FIRST_NAME}, </p>
                                            @Html.Raw(Model.EventBody)
                                        </div>

                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                    <td style="border-right: 1px solid #000000; vertical-align: top; padding: 0px 5px 0px 5px" bgcolor="#232B2E" width="280">
                        <table align="center" border="0" cellpadding="0" cellspacing="0" width="250">
                            <tbody>
                                <tr>
                                    <td style="padding: 10px 0px; vertical-align: top; color: bisque;">

                                        @Html.Raw(UpcomingListing)
                                        <hr />
                                        <p align="center" class="sideBarHead"><b>Compliance Perspectives: Monthly Update</b></p>
                                        <p class="sideBarBody">We are pleased to offer a monthly webinar series to help you keep up with changes and deadlines in the compliance area. <a href="http://www.bankwebinars.com/Webinar/Details/883?idaff=@aff.idUserAff" style="color: red; text-decoration: none; border-bottom: 1px dotted red; font-style: italic;">Click here for more information!</a></p>
                                        <hr />
                                        <p align="center" class="sideBarHead"><b>Webinar Subscription Packages</b></p>
                                        <p class="sideBarBody">Would you and your colleagues like to attend webinars at a lower price? With a Webinar Subscription Package, we can help you greatly reduce that expense. <a href="http://www.bankwebinars.com/handouts/WebinarFlyer2012-1.pdf" style="color: red; text-decoration: none; border-bottom: 1px dotted red; font-style: italic;">Click here to learn more about this cost-saving option.</a> </p>
                                        <hr />
                                        <p align="center" class="sideBarHead"><b>On-Demand Webinars Available</b></p>
                                        <p class="sideBarBody">Unable to attend the live session, or interested in a topic of a past webinar? Not a problem. Get the recording that includes online access to the webinar for six months as well as an audio CD and materials for offline viewing. <a href="http://www.bankwebinars.com/Webinar/Recorded?idaff=@aff.idUserAff" style="color: red; text-decoration: none; border-bottom: 1px dotted red; font-style: italic;">Click here to see all our On-Demand Recordings.</a></p>

                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td bgcolor="#586B73" colspan="2">
                        <table align="center" cellpadding="10" cellspacing="0" width="640">
                            <tbody>
                                <tr>
                                    <td align="center">

                                        <p>
                                            A Production of TTS - BankWebinars.com<br />

                                            @aff.ContactPerson - <a style="color: bisque; text-decoration: none; border-bottom: 1px dotted red;" href='mailto:@aff.ContactEmail'>@aff.ContactEmail</a> - @aff.ContactPhone<br />
                                            <br />
                                        </p>

                                        @aff.EmailFooter
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </table>
        </div>

    </body>
}
</html>
