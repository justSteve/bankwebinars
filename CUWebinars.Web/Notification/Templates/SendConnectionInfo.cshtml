                                        <td align="right" style="padding-top: 10px;">
                                            <div style="color: rgb(255, 255, 255); font-size: 11px;">
                                                <img align="none" alt="footer" border="0" height="59" hspace="0" src="https://ttseast.blob.core.windows.net/images/vrLocal/footer.gif" style="width: 274px; height: 59px;" title="footer" vspace="0" width="274" />
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>*@
                <tr>
                    @*<td colspan="2" height="23">
                                <img alt="hardware_2_footer.jpg" border="0" height="23" margin="0px 0px 0px 0px" src="https://ttseast.blob.core.windows.net/images/vrLocal/hardware_2_footer.jpg" style=" height: 23px; display: block;" />
                            </td>
