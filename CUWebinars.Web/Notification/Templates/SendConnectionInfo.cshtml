@using System.Web.Mvc.Html
@using CUWebinars.Business.Core.Helpers
@using CUWebinars.Business.Models
@using CUWebinars.Business.Notification
@using Newtonsoft.Json.Linq
@model CUWebinars.Business.Models.Order


<title>
    Connection Information for @Model.OrderRows.SingleOrDefault().Webinar.Title
</title>

<html xmlns="http://www.w3.org/1999/xhtml">
@{
    var row = Model.OrderRows.SingleOrDefault();
    //var row = Model.OrderRows.SingleOrDefault(or => or.RowStatus == OrderRowStatus.Active);
    var joinURL = row.JoinURL;
    var phone = "TBA";
    var code = "TBA";

    if (joinURL == null)
    {
        joinURL = "https://www2.gotomeeting.com/join/" + row.Webinar.WebinarKey;
    }
    if (row.Webinar.AccessCode != null)
    {
        code = row.Webinar.AccessCode;
    }

    string DateTimeString = TtsDateTimeTemplateHelperObject.FormatTimeWithDuration(row.Webinar.Date, Model.WebUser.timeZone, true, row.Webinar.Duration);
    
    if (row.Webinar.AccessPhone != null)
    {
        code = row.Webinar.AccessPhone;
    }
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <title>Connection Information for @row.Webinar.Title</title>
        <style type="text/css">
            .auto-style1 {
                height: 10px;
            }

            .auto-style2 {
                height: 50px;
            }
        </style>
    </head>
    <body style="font-family: Verdana, Arial, Helvetica, sans-serif">
        <table style="table-layout: fixed; width: 660px; white-space: nowrap; " border="0" cellspacing="0" cellpadding="0">
            <tbody>
                @*<tr style="background-color: #344a58; display: table-row;">
                        <td colspan="2">
                            <img alt="top_shadow.jpg" border="0" height="6" margin="0px 0px 0px 0px" src="https://ttseast.blob.core.windows.net/images/vrLocal/top_shadow.jpg" style="height: 6px; display: block;" width="660" />
                        </td>
                    </tr>*@
                <tr style="background-color: #344a58; margin-bottom: 5px; margin-top: 5px;">
                    <td>
                        <table align="center" border="0" cellpadding="0" cellspacing="0" width="660px" height="100px">
                            <tbody>
                                <tr>
