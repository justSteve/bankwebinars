                        <table style="table-layout: fixed; width: 550px; white-space: nowrap; " align="center" cellpadding="0" cellspacing="0">
                            <tbody>
                                @*<tr style="background-color: #344a58">
                                        <td colspan="2" height="6">
                                            <img alt="large_box_top.gif" border="0" height="6" margin="0px 0px 0px 0px" src="https://ttseast.blob.core.windows.net/images/vrLocal/large_box_top.gif" style="width: 630px; height: 6px; display: block;" />
                                        </td>
                                    </tr>*@

                                <tr style="background-color: #344a58">
                                    <td colspan="2">
                                        <img alt="spacer.gif" height="6" src="https://ttseast.blob.core.windows.net/images/vrLocal/spacer.gif" style="width: 1px; height: 6px; display: block;" width="1" />
                                    </td>
                                </tr>

                                <tr>
                                    <td colspan="2" style="background-color: #344a58">
                                        <table border="0" align="center" cellpadding="0" cellspacing="0">
                                            <tr>
                                                <td width="150px" style="text-align: right; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: smaller"> </td>
                                                <td width="400px" style="text-align: left; background-color: #B4D1EC; padding-left: 6px;"> </td>
                                            </tr>
                                            <tr>
                                                <td colspan="2" style="text-align: left; margin-left: 6px; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: smaller">
                                                    <p style="color: black; font-family: Arial, Helvetica, sans-serif; font-size: 12px;">
                                                        <br />Dear @Model.FirstName,<br />
                                                        Please find below the information required to attend the upcoming webinar <i>@row.Webinar.Title</i><br /><br />
                                                    </p>
                                                </td>
                                            </tr>
                                            @*<tr>
                                                    <td valign="top" width="150px" style="text-align: right; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: smaller"><p align="right" style="vert-align: top; font-size: smaller">Presenter:</p></td>
                                                    <td width="400px" style="text-align: left; background-color: #B4D1EC; padding-left: 6px;">
                                                        <p style="color: black; font-family: Arial, Helvetica, sans-serif; font-size: 12px;">
                                                            @row.Webinar.Presenter.WebUser.FullName<br />
                                                        </p>
                                                    </td>
                                                </tr>*@
                                            <tr>
                                                <td valign="top" width="150px" style="text-align: right; background-color: #CCCCCC; padding-right: 6px; font-family: Arial, Helvetica, sans-serif; font-size: smaller">
                                                    <p align="right" style="vert-align: top; font-size: smaller">
                                                        Date:
                                                    </p>
                                                </td>
                                                <td width="400px" style="text-align: left; background-color: #B4D1EC; padding-left: 6px;">
                                                    <p style="color: #000000; font-family: Arial, Helvetica, sans-serif; font-size: 12px;">
                                                        <b>
                                                            @row.Webinar.Date.ToString("dddd, MMMM d"), @row.Webinar.Date.ToString("yyyy")
