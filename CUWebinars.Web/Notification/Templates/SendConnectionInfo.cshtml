                                            <img alt="https://ttseast.blob.core.windows.net/images/vrLocal/hardware_2_header_1.jpg" border="0" height="36" margin="0px 0px 0px 0px" src="https://ttseast.blob.core.windows.net/images/vrLocal/hardware_2_header_1.jpg" style="width: 374px; height: 36px; display: block;" width="374" />
                                        </td>*@
                                    <td colspan="2" align="right" bgcolor="#01232a" style="padding-right: 15px; border-top-color: rgb(52, 74, 88); border-right-color: rgb(52, 74, 88); border-top-width: 1px; border-right-width: 1px; border-top-style: solid; border-right-style: solid;">
                                        <div style="color: rgb(255, 255, 255); font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: bold;">Your Connection Information</div>
                                    </td>
                                </tr>
                                <tr>
                                    <td width="320px" bgcolor="#344a58" valign="top" style="width: 332px; height: 50px; padding: 15px; display: block;">
                                        <p>
                                            <img align="middle" alt="CUwebinars.com" border="0" hspace="25" margin="0px 0px 0px 0px" src="https://ttseast.blob.core.windows.net/images/vrLocal/logo.png" title="CUwebinars.com" vspace="25" />
                                        </p>
                                    </td>
                                    <td width="328px" align="left" bgcolor="#344a58" style="padding: 0px 15px 0px 0px; width: 328px; border-right-color: rgb(52, 74, 88); border-right-width: 1px; border-right-style: solid;">
                                        <p style="text-align: right; color: #fff; font-family: Arial, Helvetica, sans-serif; font-size: 12px;">
                                            Order Number: @Model.idOrder<br />
                                            @row.RegistrationType.OptionLabel
                                        </p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>

                <tr style="background-color: #B4D1EC">
