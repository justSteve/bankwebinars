@model CUWebinars.Web.Models.NotificationHeaderModel
<tr style="background-color: #344a58">
    <td>
       &nbsp;
    </td>
    <td>
        <table align="center" border="0" cellpadding="0" cellspacing="0" height="115" width="645px">
            <tbody>
                <tr>
                    <td  width="364">
                        &nbsp;
                    </td>
                    <td align="right"  style="padding-right: 15px;" width="286">
                        <div style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: bold;">
                            @Html.Raw(Model.HeaderText)
                        </div>
                    </td>
                </tr>
                <tr>
                    <td width="462px" valign="top">
                        <img align="middle" alt="Site Logo" border="0" height="50" hspace="25" margin="0px 0px 0px 0px" src="@Model.TenantLogo" style="display: block;" title="Site Logo" vspace="25" />
                    </td>
                    <td align="left" style="padding: 0px 15px 0px 0px; ">
                        <p style="text-align: center; font-family: Arial, Helvetica, sans-serif; font-size: 12px;">
                            @Model.BannerText
                        </p>
                    </td>
                </tr>
            </tbody>
        </table>
    </td>
    <td >
        &nbsp;
    </td>
</tr>
