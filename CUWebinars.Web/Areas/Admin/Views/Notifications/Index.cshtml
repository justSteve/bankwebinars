@model ConnectionInfoViewModel
@{
    ViewBag.Title = "Webinar Details";
    Layout = "~/Views/Shared/_Layout_Public.cshtml";

    string ceuShort = String.Empty;
    string ceuStmt = String.Empty;
    if (String.IsNullOrEmpty(Model.Webinar.ceu) == false)
    {
        string[] ceu = Model.Webinar.ceu.Split('|');
        ceuShort = ceu[0];
        ceuStmt = ceu[1];
    }

    //{
    var timeZ = USTimeZone.Central;
    if (Model.WebUser != null)
    {
        timeZ = Model.WebUser.timeZone;
    }
    var showUsersTimeFormat = "<i>" + Html.DisplayTime(Model.Webinar.Date, timeZ, false) + " - " + Html.DisplayTime(Model.Webinar.Date, Model.Webinar.Duration, timeZ) + "<br /></i>";
}
@*<link href="@Url.Content("~/Content/css/checkout.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Content/css/Details.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Content/css/TTSstyles.css")" rel="stylesheet" type="text/css" />*@
<style>
    /* tooltip styling. by default the element to be styled is .tooltip  */
    .tooltip {
        display: none;
        background: transparent;
        font-size: 12px;
        height: 70px;
        width: 160px;
        color: #fff;
        padding: 8px;
        margin: 8px;
    }

    .propValue {
        background-color: darkblue;
        color: White;
        padding: 2px 5px;
    }
    /* style the trigger elements */
    #ceu a {
        border: 0;
        cursor: pointer;
    }
</style>
<script language="javascript" type="text/javascript">

    $(document).ready(function () {
        $("#@(Model.btnWhichState)").button("toggle");
        $("#@(Model.btnWebinar)").button("toggle");
        $("#@(Model.btnHasOrder)").button("toggle");

    });

</script>

@using (Html.BeginForm("Index", "Notifications", FormMethod.Post, new { id = "frmTemplate" }))
{
    <div class="bs-docs-example">
        <div class="btn-toolbar" style="margin: 0;">
            <div class="btn-group" data-toggle="buttons-radio">
                <button id="Pre" class="btn btnWhichState active" value="Pre">Pre</button>
                <button id="Pre_" class="btn btnWhichState" value="Pre_">Pre w/ConnInfo</button>
                <button id="Post" class="btn btnWhichState" value="Post">Post</button>
            </div>
            <div class="btn-group" data-toggle="buttons-radio">
                <button id="hr1" class="btn btnWebinar active" value="hr1">1 Hr</button>
                <button id="hr2" class="btn btnWebinar" value="hr2">2 Hr</button>
                <button id="pt3" class="btn btnWebinar" value="pt3">4-Part</button>
                <button id="pt4" class="btn btnWebinar" value="pt4">4-Part</button>
                <button id="pt5" class="btn btnWebinar" value="pt5">4-Part</button>
                <button id="cp" class="btn btnWebinar" value="cp">CP</button>
            </div>
            <div class="btn-group" data-toggle="buttons-radio">
                <button id="No" class="btn btnHasOrder active" value="No">No Order</button>
                <button id="Live" class="btn btnHasOrder" value="Live">Live</button>
                <button id="OnDemand" class="btn btnHasOrder" value="OnDemand">OnDemand</button>
                <button id="CD-ROM" class="btn btnHasOrder" value="CD-ROM">CD-ROM</button>
                <button id="Live-OnDemand" class="btn btnHasOrder" value="Live-OnDemand">Live+OnDemand</button>
                <button id="Premium" class="btn btnHasOrder" value="Premium">Premium</button>
            </div>
        </div>
    </div>
    <div class="content">
        <h1>
            @Model.Webinar.Title
        </h1>
        <input type="hidden" name="id" value="@Model.Webinar.idWebinar " />
        <input type="hidden" id="btnWhichState" name="btnWhichState" />
        <input type="hidden" id="btnWebinar" name="btnWebinar" />
        <input type="hidden" id="btnHasOrder" name="btnHasOrder" />
        <input type="hidden" id="webuser.idUser" name="webuser.idUser" value="55" />
        <input type="hidden" id="orderrow.idOrderRow" name="orderrow.idOrderRow" value="" />
        <input type="hidden" id="affiliate.id" name="affiliate.ID" value="62" />

        <div class="webinarDetails">
            @* <div class="presenter">

                    @if (Model.Webinar.Presenter.PhotoFull != null)
                    {
                        <img src='@Model.Webinar.Presenter.PhotoFull' class="presenterImg" />
                    }
                    <h3>
                        @Model.Webinar.Presenter.FullName </h3>
                    <br />
                    @Html.Raw(Model.Webinar.Presenter.BiographyLong)
                </div>*@
            <div class="date">
                <b>
                    @Html.DisplayDate(Model.Webinar.Date)
                </b><br />
                <span>@Html.Raw(showUsersTimeFormat)</span>
                <div id="ceu">
                    <a href="#" title="@ceuStmt ">
                        @Html.Raw(ceuShort)
                    </a>
                </div>
                @{
    if (Model.Order.OrderRows.Single().idOrderRow != null && Model.Order.OrderRows.Single().idOrderRow > 0)
    {
        <div align="center" class="label-success label">Your details are posted below.</div>
    }
                }
            </div>

            @*            @{
                    if (Model.Order.OrderRows.Single().idOrderRow== null)
                    {
                    <input type="submit" class="btn-success btn btn-large" value=" Sign Up " id="AddToCart1" />
                    }
                }*@
            @*            <div class="description">
                    @Html.Raw(Model.Webinar.DescriptionLong)
                </div>
                <div class="description">
                    <h2>
                        @Html.Raw(Model.Webinar.LearnCaption)</h2>
                    @Html.Raw(Model.Webinar.LearnBody)
                </div>
                <div class="description">
                    <h2>Who Should Attend?</h2>
                    @Html.Raw(Model.Webinar.WhoAttend)
                </div>*@
            <div id="SignUpForm">
                @{
                    @Html.Partial(partialViewName: "~/Views/Webinar/Partials/DisplayOptions.cshtml", model: Model)
                }
            </div>
        </div>
    </div>
}
