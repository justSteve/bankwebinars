@model ResetPasswordModel
<script language="javascript" type="text/javascript">
    //function submitReset() {
    //    $("#Email").val($("#RegisterFields_Email").val());
    //    $("#Password").val($("#Password1").val());
    //    $("#frmSignin").submit();
    //}


    $(document).ready(function () {

        $("form#ResetPasswordForm").submit(function (e) {
            e.preventDefault();
            if (!$('#ResetPassEmail').valid()) {
                return false;
            }
            var jsonUrl = "/Account/ResetPassword";
            var q = $("#ResetPassEmail").val();
            if (q.length == 0) {
                $("#ResetPassEmail").focus();
            } else {
                $.ajax({
                    type: 'GET',
                    cache: false,
                    url: jsonUrl,
                    data: { email: q },
                    beforeSend: function () {
                        // this is where we append a loading image
                        $('#ResetPassLegend').html('<div class="btn-warning style="width: 200px; height: 20px;">&nbsp;&nbsp;<i class="icon-spinner icon-spin "></i>&nbsp;&nbsp;&nbsp;&nbsp;Please Wait...</div>');
                    },
                    success: function (data) {

                        // successful request; do something with the data
                        $('#ResetPW').hide("slow");
                        $('#MailSent').show("slow");
                        $('#sent2Address').html(q);
                    },
                    error: function () {
                        // failed request; give feedback to user
                        $('body').html('<p class="error"><strong>Oops!</strong> Try that again in a few moments.</p>');
                    }
                });
            }
            return false;
        });

        $("form#ResetSent").submit(function () {
            var jsonUrl = "/Account/ResetPassword";
            var q = $("#RetryPassEmail").val();
            if (q.length == 0) {
                $("#RetryPassEmail").focus();
            } else {
                $.ajax({
                    type: 'GET',
                    cache: false,
                    url: jsonUrl,
                    data: { email: q },
                    beforeSend: function () {
                        // this is where we append a loading image
                        $('#ResetPassLegend').html('<div class="btn-warning style="width: 200px; height: 20px;">&nbsp;&nbsp;<i class="icon-spinner icon-spin "></i>&nbsp;&nbsp;&nbsp;&nbsp;Please Wait...</div>');
                    },
                    success: function (data) {
                        // successful request; do something with the data
                        alert("Hit: " + q);

                        //$('#ResetPW').hide("slow");
                        //$('#MailSent').show("slow");
                        $('#sent2Address').html(q);
                        $('#ResetPassLegend').html('<div class="btn-warning style="width: 200px; height: 20px;">&nbsp;&nbsp;<i class="icon-spinner icon-spin "></i>&nbsp;&nbsp;&nbsp;&nbsp;Reset Instructions Sent</div>');
                    },
                    error: function () {
                        // failed request; give feedback to user
                        $('body').html('<p class="error"><strong>Oops!</strong> Try that again in a few moments.</p>');
                    }
                });
            }
            return false;
        });

    });
</script>
<div id="ResetPW">
    @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Get, new { id = "ResetPasswordForm", ReturnUrl = "Account/Login" }))
    {
        @*@Html.AntiForgeryToken()*@
        //TODO: In that the only an email is being sent and
        // nothing malicious can be achieved by forging this form
        // I've disabled the AntiForgery token. But please add
        // a bit of validation to the ajax call (or elsewhere, if easier)
        // so that a form is not submitted if an invalid email address is entered.
        
        @Html.ValidationSummary(false)

        <fieldset>
            <legend id="ResetPassLegend">Reset Password</legend>
            <p>
                To reset your password, enter your email and we'll send you a link with reset instructions.
            </p>

            <div>
                @Html.LabelFor(l => l.Email)
                @Html.TextBoxFor(t => t.Email, new { id = "ResetPassEmail" })
                @Html.ValidationMessageFor(m => m.Email)
            </div>
            <div>
                <input class="btn" type="submit" value="Reset Password" />
            </div>
        </fieldset>
    }
</div>

<div id="MailSent">
    @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Get, new { id = "ResetSent", ReturnUrl = "Account/Login" }))
    {
        @*@Html.AntiForgeryToken()*@
        @Html.ValidationSummary(false)

        <fieldset>
            <legend id="MailSentLegend">Reset Instructions Sent</legend>
            <p>
                We've sent an email with reset instructions to the requested address: <b><span id="sent2Address"></span>.</b><br /><br />
                If you don't see those instructions (after a short period of time) or need immediate assistance,
                please call tech support at 800-831-0678 ext 706. <br />Thank you.
            </p>
            <div>
                @*@Html.LabelFor(l => l.ResetPassword.Email)*@
                @Html.TextBoxFor(t => t.Email, new { id = "RetryPassEmail" })
                @Html.ValidationMessageFor(m => m.Email)
            </div>
            <div>
                <input class="btn" type="submit" value="Enter Different Address?" />
            </div>
        </fieldset>
    }
</div>
