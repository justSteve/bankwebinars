@model ResetPasswordModel

@using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { id = "ResetPasswordForm", ReturnUrl = "Account/Login" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false)

    <fieldset>
        <legend>Reset Password</legend>

        @if (Model.EmailSent)
        {
            <p>You have been sent an email at @Model.Email. </p>
            <p>Please click the link in that email to navigate to a page where you will be able to select a new password.</p>   
        }
        else
        {
            <p>
                To reset your password enter your email and we'll send you a link to reset your password.
            </p>

            <div>
                @Html.LabelFor(l => l.Email)
                @Html.TextBoxFor(t => t.Email)
                @Html.ValidationMessageFor(m => m.Email)
                
            </div>
            <div>
                <input class="btn" type="submit" value="Reset Password" />
            </div>            
        }

    </fieldset>
}
