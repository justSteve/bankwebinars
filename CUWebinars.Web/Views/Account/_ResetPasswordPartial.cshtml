@model ResetPasswordModel

<div id="ResetPW">
    @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { id = "ResetPasswordForm", ReturnUrl = "Account/Login" }))
    {
        <fieldset>
            <legend id="ResetPassLegend">Reset Password</legend>
            <p>
                Resetting your password; we'll send the provided address a link with reset instructions.
            </p>

            <div>
                @Html.LabelFor(l => l.Email)
                @Html.TextBoxFor(t => t.Email, new { id = "ResetPassEmail" })
                @Html.ValidationMessageFor(m => m.Email)
            </div>
            <div>
                <input id="NormalResetPasswordButton" class="btn" type="submit" value="Reset Password" />
            </div>
        </fieldset>
    }
</div>


