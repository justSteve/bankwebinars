@model LocalPasswordModel

<div id="LogInContainer" class="container">
    <div style="margin-left: 200px;" id="reset">
        @using (Html.BeginForm("ResetPasswordWhereNotVerified", "Account"))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary()

            <fieldset>
                <legend>Set Password Form</legend>
                
                <div class="row">You need to change your password, as your current password was temporary in nature.</div>
                <div class="row">Please enter a new password and confirm it below.</div>
                <div class="row">&nbsp;</div>

                    <div class="row">
                        @Html.LabelFor(m => m.NewPassword)
                        @Html.PasswordFor(m => m.NewPassword)
                    </div>
                    <div class="row">
                        @Html.LabelFor(m => m.ConfirmPassword)
                        @Html.PasswordFor(m => m.ConfirmPassword)
                    </div>
                    <input type="submit" value="Set password" class="btn btn-default" />
</fieldset>
        }
    </div>
</div>

