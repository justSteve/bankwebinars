@model  MyWebinarsDTO
@using CUWebinars.Web.Core;
@using CUWebinars.Business.Models


@{
    ViewBag.Title = "My Webinars";
    Layout = "/Views/Shared/_LayoutPublic.cshtml";


    WebUser currentUser = Model.WebUser;
    var EditResult = "<span>&nbsp;</span>";
    var userSubscription = new DiscountDetailsModel() { Discount = Model.Subscription, UserId = currentUser.idUser };
    //var userPackage = new DiscountDetailsModel() { Discount = Model.Package, UserId = currentUser.idUser };
    if (TempData["EditResult"] != null && (string)TempData["EditResult"] != "")
    {
        EditResult = TempData["EditResult"].ToString();
    }

    if (@Html.ValidationMessage("GeneralError") != null)
    {
        EditResult = "ERROR: " + @Html.ValidationMessage("GeneralError").ToHtmlString();
    }
}

@*<link href="/Content/css/home_index.css" rel="stylesheet" type="text/css" />*@


<div class="container">
    <h2 class="short_headline">My Webinars</h2>
    <div class="pull-right">
        <a class="btn btn-info btn-small" href="~/Account/EditUser?returnUrl=/Account/MyWebinars/@currentUser.idUser">Edit Account Profile</a>
    </div>
    <ul class="nav nav-tabs">
        <li class="active"><a href="#upcoming1" data-toggle="tab">Upcoming Events</a></li>
        <li><a href="#recorded1" data-toggle="tab">Recorded Events</a></li>
        <li><a href="#subscriptions" data-toggle="tab">Subscriptions & Discounts</a></li>
        @*<li><a href="#account" data-toggle="tab">Edit Account Profile</a></li>*@

    </ul>


    <div class="tab-content" id="mywebinars">
        <div class="tab-pane active" id="upcoming1">
            @if (Model.Scheduled.Count > 0)
            {
                Html.RenderPartial("Partials/upcoming");
            }
            else
            {
                <div>No orders for an upcoming event were found.</div>
            }
        </div>
        <div class="tab-pane" id="recorded1">
            @if (Model.Recorded.Count > 0)
            {
                Html.RenderPartial("Partials/Recorded");
            }
        </div>
        <div class="tab-pane" id="subscriptions">
            @if (userSubscription != null)
            {

               Html.RenderPartial("Partials/Subscription", userSubscription);

            }
        </div>
        @*<div class="tab-pane" id="account">

            </div>*@

        @*<div class="row-fluid">
                @{Html.RenderPartial("Partials/Messages");}
            </div>*@
        <br />
    </div>

    @*@{Html.RenderPartial("Partials/Archived");}*@
