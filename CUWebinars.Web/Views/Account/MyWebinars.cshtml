    //var userSubscription = new DiscountDetailsModel() { Discount = Model.Package, UserId = currentUser.idUser };
    //var userPackage = new DiscountDetailsModel() { Discount = Model.Package, UserId = currentUser.idUser };
    if (TempData["EditResult"] != null && (string)TempData["EditResult"] != "")
    {
        EditResult = TempData["EditResult"].ToString();
    }

    if (@Html.ValidationMessage("GeneralError") != null)
    {
        EditResult = "ERROR: " + @Html.ValidationMessage("GeneralError").ToHtmlString();
    }
    var activeScheduled = "active";
    var activeRec = "";
    var activeArchived = "";

    if (Model.Scheduled.Count == 0)
    {
        activeScheduled = "";
        activeRec = "active";
    }
    //if (Model.Scheduled.Count == 0 && Model.Recorded.Count == 0)
    //{
    //    activeScheduled = "";
    //    activeArchived = "active";
    //}
}
@{
