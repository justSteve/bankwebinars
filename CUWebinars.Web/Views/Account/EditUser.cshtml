@model  CUWebinars.Web.Models.DataTablesModels.EditUserInfoModel
@{
    ViewBag.Title = "Edit Contact Info";
    var fullNameClaim = Model.LoggedInUser.Claims.FirstOrDefault(c => c.Type == CUWebinars.Business.Constants.ClaimTypes.FullName);

    if (!ReferenceEquals(null, fullNameClaim))
    {
        ViewBag.LoggedInUserIdentity = fullNameClaim;
    }
}

<script type="text/javascript">
    var returnUrl = '@Model.ReturnUrl';
</script>

<div id="EditUserContainer" class="container">


    <p class="message-success">@Model.StatusMessage</p>
    <p class="pull-right">
        You're logged in as
        @{
            if (ReferenceEquals(fullNameClaim, null))
            {
                <strong>@User.Identity.Name><br /></strong><text>.</text>
            }
            else
            {
                <strong>@fullNameClaim.Value</strong><text>.</text>
            }
        }<br />Email: <strong>@Model.EditFields.Email</strong><br />
</p>

    @using (Html.BeginForm("updateuser", "Account", FormMethod.Post, new { id = "editUserForm", @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()

        @Html.EditorFor(m => m.EditFields)

        <div class="form-inline">
            <div class="btn-group" style="width:160px">&nbsp;</div>
            <div class="btn-group">
                <input type="submit" value="Update" class="btn btn-default" />
            </div>
        </div>
    }

</div>

<div id="ConfirmDeleteShippingAddressdialog" title="Delete Shipping Address" style="display:none">
    <p>Are you sure you want to delete your Shipping Address?</p>
    <p>If you proceed and click the Update button, your Shipping Address will be the same as your Billing Address.</p>
</div>

@section Scripts {
    @Styles.Render("~/Content/themes/base/css")
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/web-user-details-manage")
}

