@using CUWebinars.Web.Core
@model Order
@{

    var newUserMsg = "<div style='margin-left:30px;margin-top:10px;margin-bottom:10px'>An order confirmation email has been dispatched to <span class='text text-info'><strong>" + Model.BillingEmail + "</strong></span>, which includes complete details of that registration. </div>";
}
<div id="LogInContainer" class="container">
    <div id="reset">

        <div class="legendImitator">Order Submitted</div>

        <div class="text-success"> <b>Thank you for your order!</b></div>

        <div class="row">
            @Html.Raw(newUserMsg)
        </div>
        <div id="OrderSummaryContainer">
            @Html.Partial("~/Views/Shared/Partials/_OrderSumUser.cshtml", Model)
        </div>

        <div id="FeedbackContainer" class="span4">
            <section>
                <h4>Feedback</h4>
                @{Html.RenderPartial("Partials/_CheckoutFeedback");}
            </section>
        </div>
    </div>
</div>
