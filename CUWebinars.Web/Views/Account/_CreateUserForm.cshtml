@model RegisterViewModel

@{

    var SetSameAsBilling = "checked";
    if (ViewData["BillingSame"] != null)
    {
        SetSameAsBilling = ViewData["BillingSame"].ToString();
    }
}
@Styles.Render("~/Content/register-user-styles")

@using (Html.BeginForm("Register", "Account", null, FormMethod.Post, new { id = "_CreateUserForm", name = "createUser" }))
{
    <legend>Creating Account</legend>
    @Html.AntiForgeryToken()
    <input type="hidden" id="RegisterFields_BillingAddress_Name" name="RegisterFields.BillingAddress.Name" />
    <input type="hidden" id="RegisterFields_ShippingAddress_Name" name="RegisterFields.ShippingAddress.Name" />
    <input type="hidden" id="RegisterFields_BillingAddress_Country" name="RegisterFields.BillingAddress.Country" value="US" />
    <input type="hidden" id="RegisterFields_ShippingAddress_Country" name="RegisterFields.ShippingAddress.Country" value="US" />
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
    <input type="hidden" id="emailAddress" />

    @Html.ValidationSummary("Error: ", new { id="registerValSummary"})
    <div class="accordion" id="createUserPanes">
        <div class="accordion-group">
            <div class="accordion-heading">
                <a class="accordion-toggle" data-toggle="collapse" data-parent="#createUserPanes" href="#collapseEmail">
                    <span id="labelEmail">Email</span>
                </a>
            </div>
            <div id="collapseEmail" class="accordion-body collapse in">
                <div class="accordion-inner">
                    <div id="wrapEmail">
                        @*<div class="span1" style="text-align: right;">
                                Email:
                            </div>*@
                        <div class="span6">
                            @Html.TextBoxFor(model => model.RegisterFields.Email, new { style = "width: 180px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.Email)
                        </div>
                    </div>
                    <div id="wrapZip">
                        <div class="span10">
                            Zip Code:
                            <input type="text" class="enterSubmit" name="getZip" id="getZip" style="width: 70px;" />
                            @*<input type="button" value="Find City/State" name="findCityState" class="btn btn-success" />*@
                            &nbsp;&nbsp;<input type="button" value="Have a Non-US Address?" name="nonUSAddressBtn" id="nonUSAddressBtn" class="btn btn-mini btn-info" />
                        </div>
                    </div>
                    <div id="wrapReset">
                        <div class="container">
                            <div id="LoginPart" class="span4">
                                @Html.ValidationSummary("There were 1 or more errors:", new { id = "loginErrorSummary" })
                                <h3>Login to existing account?</h3>
                                <p style="text-align: right;">
                                    Email: <input id="Email1" name="Email1" value="" type="text"> <br>
                                    Password: <input id="Password1" name="Password1" type="password"><br>

                                    @*<input type="button" class="btn-success btn" name="submitLogin" value="Login" />*@
                                </p>
                            </div>
                            <div><h3>Or...</h3></div>
                            <div id="ResetPart">
                                    We can email you a link that will reset your password.
                                    <input id="EdgeCaseResetPasswordButton" type="button" class="btn btn-danger" name="resetPass" value="Reset Password" />
                            </div>
                        </div>

                    </div>
                    <div id="wrapPass">
                        <div class="container">
                            <div class="row">
                                <div class="span10">
                                    <p>Please enter a secure and unique password to be used with this site.</p>

                                    @Html.LabelFor(m => m.RegisterFields.Password, new { style = "display:inline-block;" }):
                                    @Html.PasswordFor(m => m.RegisterFields.Password, new { style = " width:100px;" })
                                    &nbsp;&nbsp;
                                    @Html.LabelFor(m => m.RegisterFields.ConfirmPassword,
                                        new
                                        {
                                            @for = "RegisterFields.ConfirmPassword",
                                            style = "display:inline-block;"
                                        }):

                                    @Html.PasswordFor(m => m.RegisterFields.ConfirmPassword, new
                                        {
                                            id = "RegisterFields.ConfirmPassword",
                                            @class = "{equalTo: '#Password'}",
                                            style = " width:100px;"
                                        })
                                    <br />@Html.ValidationMessageFor(m => m.RegisterFields.Password)<br />
                                    @Html.ValidationMessageFor(m => m.RegisterFields.ConfirmPassword)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="accordion-group">
            <div class="accordion-heading">
                <a class="accordion-toggle" data-toggle="collapse" data-parent="#createUserPanes" href="#collapseBilling">
                    Billing
                </a>
            </div>
            <div id="collapseBilling" class="accordion-body collapse">
                <div class="accordion-inner well-large">
                    <div id="getFirstLast">
                        <div class="span1">
                            First:
                        </div>
                        <div class="span4">
                            @*<input type="text" id="RegisterFields.FirstName" name="RegisterFields_FirstName" style="width: 100px;" />*@
                            @Html.TextBoxFor(model => model.RegisterFields.FirstName, new { style = "width: 75px;" })
                            &nbsp;&nbsp; &nbsp;Last:
                            @*<input type="text" id="RegisterFields.LastName" name="RegisterFields_LastName" style="width: 100px;" />*@
                            @Html.TextBoxFor(model => model.RegisterFields.LastName, new { style = "width: 75px;" })
                        </div>
                    </div>
                    <div id="getFull">
                        <div class="span1">
                            Name:
                        </div>
                        <div class="span4">
                            <input type="text" id="FullName" name="FullName" style="width: 240px;" />
                        </div>
                    </div>
                    <div id="wrapInstitution">
                        <div class="span5">
                            Title: @Html.TextBoxFor(model => model.RegisterFields.Title, new { style = "width: 110px;" }) &nbsp; &nbsp;Institution:&nbsp;&nbsp;@Html.EditorFor(model => model.RegisterFields.Institution, new { style = "width: 110px;" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div id="wrapPhone">
                        <div class="span1">Phone:</div>
                        <div class="span8">
                            @Html.TextBoxFor(model => model.RegisterFields.BillingAddress.Phone, new { style = "width: 100px;" })
                            Address: @Html.TextBoxFor(model => model.RegisterFields.BillingAddress.StreetAddress, new { style = "width: 175px;" })
                            &nbsp;&nbsp;<text>(2nd address optional)</text> @Html.TextBoxFor(model => model.RegisterFields.BillingAddress.StreetAddress2, new { style = "width: 150px;" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div id="wrapCity">
                        <div class="span1">
                            City:
                        </div>
                        <div class="span8">
                            @Html.TextBoxFor(model => model.RegisterFields.BillingAddress.City, new { style = "width: 140px;" })

                            &nbsp;&nbsp; State: @Html.TextBoxFor(model => model.RegisterFields.BillingAddress.State, new { style = "width: 30px;" })
                            &nbsp;&nbsp; Zip:
                            @Html.TextBoxFor(model => model.RegisterFields.BillingAddress.Zip, new { style = "width: 50px;" })

                            <label for="TimeZone" style="display: inline-block">Time Zone:</label>
                            <select style="width: 120px" id="TimeZone" name="TimeZone">
                                <option value="-4">Caribbean</option>
                                <option value="-5">Eastern</option>
                                <option value="-6">Central</option>
                                <option value="-7">Mountain</option>
                                <option value="-8">Pacific</option>
                                <option value="-9">Alaskan</option>
                                <option value="-10">Hawaiian</option>
                            </select>

                        </div>
                    </div>
                </div>

                <div class="span1" id="nonUSAddressInput">
                    <textarea name="nonUSAddressInput" rows="5" cols="100">Special Handling for Address:</textarea>
                </div>
                @Html.HiddenFor(model => model.RegisterFields.BillingAddress.TypeOfAddress)
            </div>
        </div>
        <div class="accordion-group">
            <div class="accordion-heading">
                <a class="accordion-toggle" data-toggle="collapse" data-parent="#createUserPanes" href="#collapseShipping">Shipping</a>
            </div>
            <div id="collapseShipping" class="accordion-body collapse">
                <div class="accordion-inner">
                    <div>
                        Same As Billing?
                        @Html.HiddenFor(model => model.RegisterFields.ShippingAddress.Phone)

                        <input type="checkbox" @(SetSameAsBilling) name="sameAsBilling" id="sameAsBilling" />
                    </div>

                    <div class="fieldContainer">
                        <div class="span1">Name:</div>
                        <div class="span4">
                            <input type="text" id="FullNameShipping" name="FullNameShipping" style="width: 200px;" />
                        </div>
                    </div>

                    @*<div id="wrapPhone">
                        <div class="span1">Phone:</div>
                        <div class="span4">
                            @Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.Phone, new { style = "width: 140px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.ShippingAddress.Phone)
                        </div>
                    </div>*@
                    <div id="wrapAddress">
                        <div class="span1">
                            Address:
                        </div>
                        <div class="span4">
                            @Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.StreetAddress, new { style = "width: 175px;" })
                            @Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.StreetAddress2, new { style = "width: 150px;" })
                        </div>
                    </div>
                    <div id="wrapCity">
                        <div class="span1">
                            City:
                        </div>
                        <div class="span4">
                            @Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.City, new { style = "width: 140px;" })

                            &nbsp;&nbsp; State: @Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.State, new { style = "width: 30px;" })
                            &nbsp;&nbsp; Zip:   @Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.Zip, new { style = "width: 50px;" })

                        </div>
                    </div>
                    @Html.ValidationMessageFor(model => model.RegisterFields.ShippingAddress.StreetAddress)&nbsp;&nbsp;
                    @Html.ValidationMessageFor(model => model.RegisterFields.ShippingAddress.City)

                    @Html.ValidationMessageFor(model => model.RegisterFields.ShippingAddress.State)

                    @Html.ValidationMessageFor(model => model.RegisterFields.ShippingAddress.Zip)

                    @Html.HiddenFor(model => model.RegisterFields.ShippingAddress.TypeOfAddress)
                </div>

            </div>
        </div>
    </div>
    
    <div class="form-inline">
        <div class="btn-group" style="width: 160px">&nbsp;</div>
        <div class="btn-group">
            <input id="TheSubmitButton" type="button" value="Register" name="TheSubmit" class="btn btn-default" />
        </div>
    </div>
}
<form id="checkEmail">
    @Html.AntiForgeryToken()
    <input type="hidden" name="emailChecker" id="emailChecker" />
</form>

<form id="checkZip"><input type="hidden" name="ZipChecker" id="ZipChecker" /></form>
<form id="nonUSForm"><input type="hidden" name="AddressText" id="AddressText" /></form>
<form id="checkInstitution"><input type="hidden" name="InstitutionChecker" id="InstitutionChecker" /></form>


<div id="modalInstitution" class="modal hide">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h3>Insitution Information</h3>
    </div>
    <div id="UserInstitutionBody" class="modal-body">
        <h5>Is this your institution?</h5>        <div id="ShowInstitution">placeholder for ajax response</div>

        <div id="instInfo">
            <p><input type="button" class="btn btn-primary" name="YesUseAddress"  id="YesUseAddress" value="Yes, use this address." /></p>
            <p><input type="button" class="btn btn-warning" name="EnterDiffAddress"  id="EnterDiffAddress" value="Yes, that's my institution but I want to enter a different address." /></p>
            <p><input type="button" class="btn btn-warning" name="NotInstitution"  id="NotInstitution" value="No, that's not my institution" /></p>
        </div>
    </div>
    @*<div class="modal-footer">
            <a href="#" id="cancelContinue" class="close btn" data-dismiss="modal">Cancel</a>
            <a href="#" id="updateInstitution" class="btn btn-danger">Update</a>
        </div>*@
</div>
