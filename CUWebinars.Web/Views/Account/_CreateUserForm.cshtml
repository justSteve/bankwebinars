@model RegisterViewModel

@{
    //WebUser currentUser = CurrentSession.Instance.CurrentUser;

    var SetSameAsBilling = "checked";
    if (ViewData["BillingSame"] != null)
    {
        SetSameAsBilling = ViewData["BillingSame"].ToString();
    }
}
<style>
    .fieldContainer {
        /*width: 380px;*/
        line-height: 25px;
    }

    .span1 {
        text-align: right;
    }
</style>

@using (Html.BeginForm("Register", "Account", null, FormMethod.Post, new { id = "_CreateUserForm", name = "createUser" }))
{
    <legend>Creating Account</legend>
    @Html.AntiForgeryToken()
    <input type="hidden" id="FirstName" name="FirstName" />
    <input type="hidden" id="LastName" name="LastName" />
    <input type="hidden" id="ShippingFirstName" name="ShippingFirstName" />
    <input type="hidden" id="ShippingLastName" name="ShippingLastName" />
    <input type="hidden" id="RegisterFields_BillingAddress_Country" name="RegisterFields.BillingAddress.Country" value="US" />
    <input type="hidden" id="RegisterFields_ShippingAddress_Country" name="RegisterFields.ShippingAddress.Country" value="US" />
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
    <input type="hidden" id="emailAddress"  />

    @Html.ValidationSummary(true)
    <div class="accordion" id="createUserPanes">

        <div class="accordion-group">
            <div class="accordion-heading">
                <a class="accordion-toggle" data-toggle="collapse" data-parent="#createUserPanes" href="#collapseEmail">
                    <span id="labelEmail">Email</span>
                </a>
            </div>
            <div id="collapseEmail" class="accordion-body collapse in">
                <div class="accordion-inner">
                    <div class="fieldContainer" id="wrapEmail">
                        @*<div class="span1" style="text-align: right;">
                                Email:
                            </div>*@
                        <div class="span6">
                            @Html.TextBoxFor(model => model.RegisterFields.Email, new { style = "width: 180px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.Email)
                        </div>
                    </div>
                    <div class="fieldContainer" id="wrapZip">
                        <div class="span1" style="text-align: right;">
                            Zip Code:
                        </div>
                        <div class="span4">
                            <input type="text" name="getZip" id="getZip" style="width: 70px;" />
                            <input type="button" value="Find City/State" name="findCityState" class="btn btn-success" />
                            <input type="button" value="Have a Non-US Address?" name="nonUSAddress" class="btn btn-mini btn-info" />
                        </div>
                    </div>
                    <div class="fieldContainer" id="wrapReset">
                        <div class="container">
                            <div class="span4">
                                <h3>Login to existing account?</h3><p style="text-align: right;">
                                    Email: <input id="Email1" name="Email1" value="" type="text"> <br>
                                    Password: <input id="Password1" name="Password1" type="password"><br><input type="button" class="btn-success btn" name="submitLogin" value="Login" />
                                </p>
                            </div>
                            <div class="span2"><h3 style="text-align: center; background-color: blanchedalmond">Or...</h3></div><div class="span4">
                                <p style="margin-top: 50px;">We can email you a link that will reset your password. <input type="button" class="btn btn-danger" name="resetPass" value="Reset Password" /></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="accordion-group">
            <div class="accordion-heading">
                <a class="accordion-toggle" data-toggle="collapse" data-parent="#createUserPanes" href="#collapseBilling">
                    Billing
                </a>
            </div>
            <div id="collapseBilling" class="accordion-body collapse">
