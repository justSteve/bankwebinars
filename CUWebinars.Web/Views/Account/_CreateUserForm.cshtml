        <div class="accordion-group">
            <div class="accordion-heading">
                <a class="accordion-toggle" data-toggle="collapse" data-parent="#createUserPanes" href="#collapseShipping">Shipping</a>
            </div>
            <div id="collapseShipping" class="accordion-body collapse">
                <div class="accordion-inner">
                    <div>
                        Same As Billing?
                        <input type="checkbox" @(SetSameAsBilling) name="sameAsBilling" id="sameAsBilling" />
                    </div>

                    <div class="fieldContainer">
                        <div class="span1">Name:</div>
                        <div class="span4">
                            <input type="text" id="FullNameShipping" name="FullNameShipping" style="width: 180px;" />
                        </div>
                    </div>

                    <div class="fieldContainer" id="wrapPhone">
                        <div class="span1">Phone:</div>
                        <div class="span4">
                            @Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.Phone, new { style = "width: 140px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.ShippingAddress.Phone)
                        </div>
                    </div>
                    <div class="fieldContainer" id="wrapAddress">
                        <div class="span1">
                            Address:
                        </div>
                        <div class="span4">
                            @Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.StreetAddress, new { style = "width: 175px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.ShippingAddress.StreetAddress)&nbsp;&nbsp;
                            @Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.StreetAddress2, new { style = "width: 150px;" })
                        </div>
                    </div>
                    <div class="fieldContainer" id="wrapCity">
                        <div class="span1">
                            City:
                        </div>
                        <div class="span4">
                            @Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.City, new { style = "width: 140px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.ShippingAddress.City)

                            &nbsp;&nbsp; State: @Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.State, new { style = "width: 30px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.ShippingAddress.State)
                            &nbsp;&nbsp; Zip:   @Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.Zip, new { style = "width: 50px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.ShippingAddress.Zip)
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="form-inline">
        <div class="btn-group" style="width: 160px">&nbsp;</div>
        <div class="btn-group">
            <input type="submit" value="Register" class="btn btn-default" />
