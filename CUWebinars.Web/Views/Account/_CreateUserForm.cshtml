@model RegisterViewModel

@{
    //WebUser currentUser = CurrentSession.Instance.CurrentUser;

    var SetSameAsBilling = "checked";
    if (ViewData["BillingSame"] != null)
    {
        SetSameAsBilling = ViewData["BillingSame"].ToString();
    }
}
<style>
    .fieldContainer {
        /*width: 380px;*/
        line-height: 25px;
    }

    .span1 {
        text-align: right;
    }
</style>

<script language="javascript" type="text/javascript">


    $(document).ready(function () {
        $("#wrapZip").hide();
        $("#getFirstLast").hide();

        $('#collapseShipping').on('shown', function () {
            if ($("#sameAsBilling:checked").val()) {
                SetShippingToBilling();
            }
        });
        var availableTags = [];
        //http://stackoverflow.com/questions/5077409/what-does-autocomplete-request-server-response-look-like
        $("#RegisterFields_Institution").autocomplete({
            source: function (request, response) {
                alert(request.term);
                $.ajax({
                    type: 'GET',
                    cache: false,
                    url: '/Account/AutocompleteInstitution',
                    data: {
                        zip: "54636", term: request.term
                    },
                    //data: { zip: $("#RegisterFields_BillingAddress_Zip").val()},
                    //beforeSend: function () {
                    //    // this is where we append a loading image
                    //    $('#lableEmail').html('<div class="btn-warning style="width: 400px; height: 20px;">&nbsp;&nbsp;<i class="icon-spinner icon-spin "></i>&nbsp;&nbsp;&nbsp;&nbsp;Checking that Email...</div>');
                    //},
                    success: function (data) {
                        response($.map(data.geonames, function (item) {
                            return {
                                label: item.name + (item.adminName1 ? ", " + item.adminName1 : "") + ", " + item.countryName,
                                value: item.name
                            };
                        }));
                    }
                });
            },
            //source: '/Account/AutocompleteInstitution',
            //minLength: ,
            open: function (event, ui) {
                $(".ui-autocomplete").css("z-index", 1000);
            },
            select: function (event, ui) {
                $("#RegisterFields_Institution").val(ui.item.Work_Item);
                return false;
            }
        });

        $("form#checkEmail").submit(function () {
            var jsonUrl = "/Account/CheckEmail";
            var q = $("#emailChecker").val();
            if (q.length == 0) {
                $("#RegisterFields_Email").focus();
            } else {
                $.ajax({
                    type: 'GET',
                    cache: false,
                    url: jsonUrl,
                    data: { email: q },
                    beforeSend: function () {
                        // this is where we append a loading image
                        $('#lableEmail').html('<div class="btn-warning style="width: 400px; height: 20px;">&nbsp;&nbsp;<i class="icon-spinner icon-spin "></i>&nbsp;&nbsp;&nbsp;&nbsp;Checking that Email...</div>');
                    },
                    success: function (data) {
                        // successful request; do something with the data
                        if (data.success == "foundNothing") {
                            $('#wrapEmail').hide("fast");
                            $('#wrapZip').show("fast");
                            $('#lableEmail').html('<div class="btn-success" style="width: 400px; height: 20px;"><b>&nbsp;&nbsp;' + q + '</b>&nbsp; is recorded.</div>');
                        }
                        if (data.success == "foundInstitution") {
                            $('#lableEmail').html('<div class="btn-success" style="width: 400px; height: 20px;"><b>&nbsp;&nbsp;' + q + '</b>&nbsp; is recorded.</div>');
                            $('#wrapEmail').html('<h3>Login to existing account?</h3><p>Email: <input id="Email" name="Email" value="' + q + '" type="text"> <br>Password: <input id="Password" name="Password" type="password"><br><input type="button" class="btn-info btn" id="submitLogin" value="Login" /></p><h3>Or...</h3><p>We can email you a link that will reset your password. <input type="button" class="btn btn-danger" id="resetPassword" value="Reset Password" /></p>');
                        }

                        if (data.success == "foundExistingEmail") {
                            $('#ResetPasswordForm input[name=Email]').val(q);
                            $('#lableEmail').html('<div class="btn-danger" style="width: 400px; height: 20px;"><b>&nbsp;&nbsp;' + q + '</b>&nbsp; is already on file.</div>');
                            $('#wrapEmail').html('<h3>Login to existing account?</h3><p>Email: <input id="Email" name="Email" value="' + q + '" type="text"> <br>Password: <input id="Password" name="Password" type="password"><br><input type="button" class="btn-info btn" id="submitLogin" value="Login" /></p><h3>Or...</h3><p>We can email you a link that will reset your password. <input type="button" class="btn btn-danger" id="resetPassword" value="Reset Password" /></p>');
                        }
                    },
                    error: function () {
                        // failed request; give feedback to user
                        $('#wrapEmail').html('<p class="error"><strong>Oops!</strong> Try that again in a few moments.</p>');
                    }
                });
            }
            return false;
        });

        $("form#checkZip").submit(function () {
            var jsonUrl = "/Account/CheckZip";
            var q = $("#ZipChecker").val();
            if (q.length == 0) {
                $("#RegisterFields_Zip").focus();
            } else {
                $.ajax({
                    type: 'GET',
                    cache: false,
                    url: jsonUrl,
                    data: { Zip: q },
                    beforeSend: function () {
                        // this is where we append a loading image
                        $('#lableEmail').html('<div class="btn-warning style="width: 400px; height: 20px;">&nbsp;&nbsp;<i class="icon-spinner icon-spin "></i>&nbsp;&nbsp;&nbsp;&nbsp;Checking that Zip...</div>');
                    },
                    success: function (data) {
                        // successful request; do something with the data
                        if (data.success == "true") {
                            $('#collapseEmail').collapse('toggle');
                            $('#collapseInstitution').collapse('toggle');
                            $('#RegisterFields_BillingAddress_City').val(data.City);
                            $('#RegisterFields_BillingAddress_State').val(data.State);
                            $('#RegisterFields_BillingAddress_Zip').val(q);
                            $('#TimeZone').val(data.TimeZone);
                            $('#lableEmail').html('<div class="btn-success" style="width: 400px; height: 20px;"><b>&nbsp;&nbsp;Email and Zipcode are recorded.</div>');
                        }
                        if (data.success == "false") {
                            $('#lableZip').html('<div class="btn-danger" style="width: 400px; height: 20px;"><b>&nbsp;&nbsp;Zipcode was not found!</div>');
                        }

                        if (data.success == "foundExistingZip") {
                            $('#ResetPasswordForm input[name=Zip]').val(q);
                            $('#wrapZip').html('<h3>Login to existing account?</h3><p>Zip: <input id="Zip" name="Zip" value="' + q + '" type="text"> <br>Password: <input id="Password" name="Password" type="password"><br><input type="button" class="btn-info btn" id="submitLogin" value="Login" /></p><h3>Or...</h3><p>We can Zip you a link that will reset your password. <input type="button" class="btn btn-danger" id="resetPassword" value="Reset Password" /></p>');
                        }
                    },
                    error: function () {
                        // failed request; give feedback to user
                        $('#wrapZip').html('<p class="error"><strong>Oops!</strong> Try that again in a few moments.</p>');
                    }
                });
            }
            return false;
        });

        $("form#checkInstitution").submit(function () {

            var jsonUrl = "/Account/CheckInstitution";
            var q = $("#InstitutionChecker").val();
            if (q.length == 0) {
                $("#RegisterFields_Institution").focus();
            } else {
                //$("#RegisterFields_Institution").html(ajax_load);
                $.getJSON(
                    jsonUrl,
                    { "Institution": q },
                    function (json) {
                        var result = "Language code is \"<strong>" + json.responseData.cResult + "\"";
                        $("#RegisterFields_Institution").html(result);
                    }
                );
            }
            return false;
        });

        $('#RegisterFields_Email').change(function () {
            //alert("hit: " + $('#RegisterFields_Email').val());
            //  $.getJSON()
            $('#emailChecker').val($('#RegisterFields_Email').val());
            $("#checkEmail").submit();
        });

        //$('#RegisterFields_Institution').change(function () {
        //    alert("hit" + $('#RegisterFields_Institution').val());
        //    //  $.getJSON()
        //    $('#InstitutionChecker').val($('#RegisterFields_Institution').val());
        //    $("form#checkInstitution").submit();
        //});

        $('#RegisterFields_BillingAddress_Zip').change(function () {
            $('#ZipChecker').val($('#RegisterFields_BillingAddress_Zip').val());
            $("form#checkZip").submit();
        });

        $('#FullName').blur(function () {
            var tempName = $('#FullName').val().split(' ');

            if (tempName.length == 2) {
                $('#RegisterFields_FirstName').val(tempName[0]);
                $('#RegisterFields_LastName').val(tempName[1]);

            } else {
                $('#RegisterFields_FirstName').val(tempName[0]);
                $('#RegisterFields_LastName').val(tempName[1]);
                $('#getFull').hide();
                $('#getFirstLast').show();
                $('#RegisterFields_LastName').focus();
            }
        });

        $("#sameAsBilling").change(function (e) {
            var thisCheck = $(this);
            if (thisCheck.is(':checked')) {
                if ($("#sameAsBilling:checked").val()) {
                    SetShippingToBilling();
                } else {
                    if ($("#FullNameShipping").val() === null || $("#FullNameShipping").val() === "") $("#FullNameShipping").val($("#FullName").val());
                    if ($("#ShippingFirstName").val() === null || $("#ShippingFirstName").val() === "") $("#ShippingFirstName").val($("#FirstName").val());
                    if ($("#ShippingLastName").val() === null || $("#ShippingLastName").val() === "") $("#ShippingLastName").val($("#LastName").val());
                    if ($("#RegisterFields_ShippingAddress_City").val() === null || $("#RegisterFields_ShippingAddress_City").val() === "") $("#RegisterFields_ShippingAddress_City").val($("#RegisterFields_BillingAddress_City").val());
                    if ($("#RegisterFields_ShippingAddress_StreetAddress").val() === null || $("#RegisterFields_ShippingAddress_StreetAddress").val() === "") $("#RegisterFields_ShippingAddress_StreetAddress").val($("#RegisterFields_BillingAddress_StreetAddress").val());
                    if ($("#RegisterFields_ShippingAddress_StreetAddress2").val() === null || $("#RegisterFields_ShippingAddress_StreetAddress2").val() === "") $("#RegisterFields_ShippingAddress_StreetAddress2").val($("#RegisterFields_BillingAddress_StreetAddress2").val());
                    if ($("#RegisterFields_ShippingAddress_State").val() === null || $("#RegisterFields_ShippingAddress_State").val() === "") $("#RegisterFields_ShippingAddress_State").val($("#RegisterFields_BillingAddress_State").val());
                    if ($("#RegisterFields_ShippingAddress_Zip").val() === null || $("#RegisterFields_ShippingAddress_Zip").val() === "") $("#RegisterFields_ShippingAddress_Zip").val($("#RegisterFields_BillingAddress_Zip").val());
                }
            }
            return false;
        });


        function SetShippingToBilling() {
            $("#FullNameShipping").val($("#FullName").val());
            $("#ShippingFirstName").val($("#FirstName").val());
            $("#ShippingLastName").val($("#LastName").val());
            $("#RegisterFields_ShippingAddress_City").val($("#RegisterFields_BillingAddress_City").val());
            $("#RegisterFields_ShippingAddress_StreetAddress").val($("#RegisterFields_BillingAddress_StreetAddress").val());
            $("#RegisterFields_ShippingAddress_StreetAddress2").val($("#RegisterFields_BillingAddress_StreetAddress2").val());
            $("#RegisterFields_ShippingAddress_State").val($("#RegisterFields_BillingAddress_State").val());
            $("#RegisterFields_ShippingAddress_Zip").val($("#RegisterFields_BillingAddress_Zip").val());
            $("#RegisterFields_ShippingAddress_Country").val($("#RegisterFields_BillingAddress_Country").val());
            $("#RegisterFields_ShippingAddress_Phone").val($("#RegisterFields_BillingAddress_Phone").val());
        }
    });

</script>
@using (Html.BeginForm("Register", "Account", null, FormMethod.Post, new { id = "_CreateUserForm" }))
{

    @Html.AntiForgeryToken()

    <input type="hidden" id="FirstName" name="FirstName" />
    <input type="hidden" id="LastName" name="LastName" />
    <input type="hidden" id="ShippingFirstName" name="ShippingFirstName" />
    <input type="hidden" id="ShippingLastName" name="ShippingLastName" />
    <input type="hidden" id="RegisterFields.BillingAddress.Country" name="RegisterFields.BillingAddress.Country" value="US" />
    <input type="hidden" id="RegisterFields.ShippingAddress.Country" name="RegisterFields.ShippingAddress.Country" value="US" />
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

    @Html.ValidationSummary(true)
    <div class="accordion" id="createUserPanes">

        <div class="accordion-group">
            <div class="accordion-heading">
                <a class="accordion-toggle" data-toggle="collapse" data-parent="#createUserPanes" href="#collapseEmail">
                    <span id="lableEmail">Please Enter Your Email Address</span>
                </a>
            </div>
            <div id="collapseEmail" class="accordion-body collapse in">
                <div class="accordion-inner">
                    <div class="fieldContainer" id="wrapEmail">
                        <div class="span1" style="text-align: right;">
                            Email:
                        </div>
                        <div class="span4">
                            @Html.TextBoxFor(model => model.RegisterFields.Email, new { style = "width: 180px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.Email)
                        </div>
                    </div>
                    <div class="fieldContainer" id="wrapZip">
                        <div class="span1" style="text-align: right;">
                            Zip Code:
                        </div>
                        <div class="span4">
                            @Html.TextBoxFor(model => model.RegisterFields.BillingAddress.Zip, new { style = "width: 50px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.BillingAddress.Zip)<br />
                            <input type="button" value="Have a Non-US Address?" id="nonUSAddress" class="btn btn-mini btn-info" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="accordion-group">
            <div class="accordion-heading">
                <a class="accordion-toggle" data-toggle="collapse" data-parent="#createUserPanes" href="#collapseInstitution">
                    <span id="lableInstitution">Institution</span>
                </a>
            </div>
            <div id="collapseInstitution" class="accordion-body collapse">
                <div class="accordion-inner">
                    <div class="fieldContainer" id="wrapInstitution">
                        <div class="span2" style="text-align: right;">
                            Name of Institution:
                        </div>
                        <div class="span5 ui-widget">
                            @Html.TextBoxFor(model => model.RegisterFields.Institution, new { style = "width: 250px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.Institution)
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="accordion-group">
            <div class="accordion-heading">
                <a class="accordion-toggle" data-toggle="collapse" data-parent="#createUserPanes" href="#collapseBilling">
                    Billing
                </a>
            </div>
            <div id="collapseBilling" class="accordion-body collapse">
                <div class="accordion-inner">
                    <div class="fieldContainer" id="getFirstLast">
                        <div class="span1">
                            First:
                        </div>
                        <div class="span4">
                            @*<input type="text" id="RegisterFields.FirstName" name="RegisterFields_FirstName" style="width: 100px;" />*@
                            @Html.TextBoxFor(model => model.RegisterFields.FirstName, new { style = "width: 75px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.FirstName)
                            &nbsp;&nbsp; &nbsp;Last:
                            @*<input type="text" id="RegisterFields.LastName" name="RegisterFields_LastName" style="width: 100px;" />*@
                            @Html.TextBoxFor(model => model.RegisterFields.LastName, new { style = "width: 75px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.LastName)
                        </div>
                    </div>
                    <div class="fieldContainer" id="getFull">
                        <div class="span1">
                            Name:
                        </div>
                        <div class="span4">
                            <input type="text" id="FullName" name="FullName" style="width: 240px;" />
                        </div>
                    </div>
                    <div class="fieldContainer" id="wrapInstitution">
                        <div class="span1">Institution:</div>
                        <div class="span4">
                            @Html.EditorFor(model => model.RegisterFields.Institution)
                            @Html.ValidationMessageFor(model => model.RegisterFields.Institution)
                        </div>
                    </div>

                    <div class="fieldContainer" id="wrapPhone">
                        <div class="span1">Phone:</div>
                        <div class="span4">
                            @Html.TextBoxFor(model => model.RegisterFields.BillingAddress.Phone, new { style = "width: 140px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.BillingAddress.Phone)
                        </div>
                    </div>
                    <div class="fieldContainer" id="wrapAddress">
                        <div class="span1">
                            Address:
                        </div>
                        <div class="span4">
                            @Html.TextBoxFor(model => model.RegisterFields.BillingAddress.StreetAddress, new { style = "width: 175px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.BillingAddress.StreetAddress)&nbsp;&nbsp;
                            @Html.TextBoxFor(model => model.RegisterFields.BillingAddress.StreetAddress2, new { style = "width: 150px;" })
                        </div>
                    </div>
                    <div class="fieldContainer" id="wrapCity">
                        <div class="span1">
                            City:
                        </div>
                        <div class="span4">
                            @Html.TextBoxFor(model => model.RegisterFields.BillingAddress.City, new { style = "width: 140px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.BillingAddress.City)

                            &nbsp;&nbsp; State: @Html.TextBoxFor(model => model.RegisterFields.BillingAddress.State, new { style = "width: 30px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.BillingAddress.State)
                            &nbsp;&nbsp; Zip:
                            @Html.TextBoxFor(model => model.RegisterFields.BillingAddress.Zip, new { style = "width: 50px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.BillingAddress.Zip)
                        </div>
                    </div>
                    <div class="row">
                        <div class="span1">
                            @Html.LabelFor(m => m.RegisterFields.Password, new { style = "display:inline-block" }):
                        </div>
                        <div class="span3">
                            @Html.PasswordFor(m => m.RegisterFields.Password)
                            @Html.ValidationMessage("Password")
                        </div>

                    </div>
                    <div class="row">
                        <div class="span1">
                            @Html.LabelFor(m => m.RegisterFields.ConfirmPassword,
                                new
                                {
                                    @for = "RegisterFields.ConfirmPassword",
                                    style = "display:inline-block"
                                }
                                ):
                        </div>
                        <div class="span3">

                            @Html.PasswordFor(m => m.RegisterFields.ConfirmPassword, new
                            {
                                id = "RegisterFields.ConfirmPassword",
                                @class = "{equalTo: '#Password'}"
                            })
                            @Html.ValidationMessage("PasswordConfirmation")
                        </div>
                    </div>
                    <div class="row">
                        <div class="span1">
                            <label for="TimeZone" style="display: inline-block">Time Zone:</label>
                        </div>
                        <div class="span3">
                            <select style="width: 120px" id="TimeZone" name="TimeZone">
                                <option value="4">Eastern</option>
                                <option value="3">Central</option>
                                <option value="2">Mountain</option>
                                <option value="1">Pacific</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="accordion-group">
            <div class="accordion-heading">
                <a class="accordion-toggle" data-toggle="collapse" data-parent="#createUserPanes" href="#collapseShipping">Shipping</a>
            </div>
            <div id="collapseShipping" class="accordion-body collapse">
                <div class="accordion-inner">
                    <div>
                        Same As Billing?
                        <input type="checkbox" @(SetSameAsBilling) name="sameAsBilling" id="sameAsBilling" />
                    </div>

                    <div class="fieldContainer">
                        <div class="span1">Name:</div>
                        <div class="span4">
                            <input type="text" id="FullNameShipping" name="FullNameShipping" style="width: 180px;" />
                        </div>
                    </div>

                    <div class="fieldContainer" id="wrapPhone">
                        <div class="span1">Phone:</div>
                        <div class="span4">
                            @Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.Phone, new { style = "width: 140px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.ShippingAddress.Phone)
                        </div>
                    </div>
                    <div class="fieldContainer" id="wrapAddress">
                        <div class="span1">
                            Address:
                        </div>
                        <div class="span4">
                            @Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.StreetAddress, new { style = "width: 175px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.ShippingAddress.StreetAddress)&nbsp;&nbsp;
                            @Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.StreetAddress2, new { style = "width: 150px;" })
                        </div>
                    </div>
                    <div class="fieldContainer" id="wrapCity">
                        <div class="span1">
                            City:
                        </div>
                        <div class="span4">
                            @Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.City, new { style = "width: 140px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.ShippingAddress.City)

                            &nbsp;&nbsp; State: @Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.State, new { style = "width: 30px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.ShippingAddress.State)
                            &nbsp;&nbsp; Zip:
                            @Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.Zip, new { style = "width: 50px;" })
                            @Html.ValidationMessageFor(model => model.RegisterFields.ShippingAddress.Zip)
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="form-inline">
        <div class="btn-group" style="width: 160px">&nbsp;</div>
        <div class="btn-group">
            <input type="submit" value="Register" class="btn btn-default" />
        </div>
    </div>
}
<form id="checkEmail"><input type="hidden" name="emailChecker" id="emailChecker" /></form>
<form id="checkZip"><input type="hidden" name="ZipChecker" id="ZipChecker" /></form>
<form id="checkInstitution"><input type="hidden" name="InstitutionChecker" id="InstitutionChecker" /></form>
