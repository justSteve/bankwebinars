@using TTSTrain.Webinars.Business.Facade
@using TTSTrain.Webinars.Business
@using TTSTrain.Webinars.Business.Entity
@using TTSTrain.Webinars.WebEntry


<script src="/Scripts/EditOrder.js"></script>
<script>

    function payByCC(id) {
        window.showModalDialog("@System.Configuration.ConfigurationManager.AppSettings[AppConst.CC_PAYMENT_PROCESSING_URL_KEY]/@Model.OrderRow.Order.ID", null, "dialogwidth: 900px; dialogheight: 370px; center: yes; resizable: yes");
        $('#step2_Submit2Sage' + id).submit();
        window.location.reload();
    }
</script>

@model TTSTrain.Webinars.WebEntry.ViewModels.EditOrderRowViewModel
@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout_Admin_Bootstrap.cshtml";
    var alertType = "alert-info";
    var notifyState = "btn-success";



    if (TempData["alertType"] != null && (string)TempData["alertType"] != "")
    {
        alertType = TempData["alertType"].ToString();
        if (alertType == "alert-success")
        {
            notifyState = "btn-danger"; // ViewData["NotifyState"].ToString();
    <span>
        <script>
            $(document).ready(function () {
                $("#Resend").attr('value', "Notify User of Update?");
            });
        </script>
    </span>
        }
    }

    var EditResult = "<span>&nbsp;</span>";

    if (TempData["EditResult"] != null && (string)TempData["EditResult"] != "")
    {
        EditResult = TempData["EditResult"].ToString();

    }
    string genComments = "";
    string storeComments = "";
    string privateComments = "";
    string origin = "";

    if (@Html.ValidationMessage("GeneralError") != null)
    {
        EditResult = "ERROR: " + @Html.ValidationMessage("GeneralError").ToHtmlString();

    }
    var UserDetails = Model.OrderRow.Order.User.FirstName + " " + Model.OrderRow.Order.User.LastName + " - " + Model.OrderRow.Order.CustomerInstitution + "<br>" + Model.OrderRow.Order.User.Email + " - " + " <a href='/account/edit/" + Model.OrderRow.Order.User.ID + "' target='new'/>[Edit]</a>";

    if (Model.CurrentUser.UserType == UserType.Admin && (Model.OrderRow.Order.User.Affiliate != Model.OrderRow.Order.Affiliate))
    {
        UserDetails += "<br><font color='red'>Mismatched Affiliate! Order Affiliate = " + Model.OrderRow.Order.Affiliate.LastName + " </font>";
    }
    string DeleteOrderLabel = "Delete This Order?";
    if (Model.OrderRow.Status == OrderRowStatus.Canceled
        )
    {
        DeleteOrderLabel = "UnDelete This Order?";
    }

    if (Model.OrderRow.Order.GeneralComments != null)
    {
        genComments = Model.OrderRow.Order.GeneralComments.ToString().Replace("_", " ");
    }
    if (Model.OrderRow.Order.StoreComments != null)
    {
        storeComments = Model.OrderRow.Order.StoreComments.ToString().Replace("_", " ");
    }
    if (Model.OrderRow.Order.StoreCommentsPrivate != null)
    {
        privateComments = Model.OrderRow.Order.StoreCommentsPrivate.ToString().Replace("_", " ");
    }
    if (Model.OrderRow.Order.Origin != null)
    {
        origin = Model.OrderRow.Order.Origin.ToString().Replace("_", " ");
    }    
}

<div class="row">
    <div class="@alertType alignleft span10">@Html.Raw(EditResult)</div>
    <div class="@alertType span2 alignright">Details: BW-@Model.OrderRow.Order.ID</div>

    <div class="span8">
        <b>
            @Html.Encode(Model.OrderRow.Webinar.Title) </b>-
        @Html.Encode(Model.OrderRow.Webinar.Presenter.FullName)
        <br />
        @Html.DisplayDate((DateTime)Model.OrderRow.Webinar.Date) @Html.DisplayTime((DateTime)Model.OrderRow.Webinar.Date, (USTimeZone)Model.OrderRow.Order.User.TimeZone, false)
        -
        @Html.DisplayTime((DateTime)Model.OrderRow.Webinar.Date, (decimal)Model.OrderRow.Webinar.Duration, (USTimeZone)Model.OrderRow.Order.User.TimeZone)
    </div>
    <div class="span4 alignright">
        <div class="dropdown">
            <a class="btn btn-primary dropdown-toggle" data-toggle="dropdown" href="#">Change Order? <span class="caret"></span></a>
            <!-- Link or button to toggle dropdown -->
            <ul class="dropdown-menu" role="menu" aria-labelledby="dLabel">
                <li><a tabindex="-1" href="#deleteOrder" role="button" class="btn-small" data-toggle="modal">@DeleteOrderLabel</a></li>
                <li><a tabindex="-1" href="#addDiscount" role="button" class="btn-small" data-toggle="modal">Apply Discount?</a></li>
                <li><a tabindex="-1" href="#addLocation" role="button" class="btn-small" data-toggle="modal">Additional Location?</a></li>
                <li><a tabindex="-1" href="#" onclick="payByCC(@Model.OrderRow.Order.ID); return true;" role="button" class="btn-small" data-toggle="modal">Submit Payment?</a></li>
                <li><a tabindex="-1" href="#changeAssignedUser" role="button" class="btn-small" data-toggle="modal">Assign to Different User?</a></li>
                @if (Model.CurrentUser.UserType == UserType.Admin || Model.CurrentUser.ID == 62)
                {
                    <li><a tabindex="-1" href="#changeAssignedAffiliate" role="button" class="btn-small" data-toggle="modal">Change Credited Affiliate?</a></li>
                }
            </ul>
        </div>
    </div>
</div>

<div class="row">
    <div class="span2 offset1 alignright">
        User:<br />
        <a href="#orderHistory" onclick="getRegistrationsTableCode(@Model.OrderRow.Order.User.ID);" role="button" class="btn-mini" data-toggle="modal">[Order History]</a>
    </div>
    <div class="span5">@Html.Raw(@UserDetails)

        <span>
            <br />
            @*@{
                var UserIni = "";
                if (Model.OrderRow.Order.InitiatedBy == UserType.Admin)
                {
                    UserIni = Model.OrderRow.Order.InitiatedBy2.LastName;
                }
                else
                {
                    UserIni = Model.OrderRow.Order.InitiatedBy.ToString();
                }
            }*@
            Source of Order: @Model.OrderRow.Order.InitiatedBy.ToString() </span>
        <br />
        @{
            if (Model.CurrentUser.UserType == UserType.Admin || Model.CurrentUser.ID == 62)
            {
            <span>Order's Affiliate: @Model.OrderRow.Order.Affiliate.TTSDomain</span>
           
                var altUsers = (IList<User>)ViewData["altUsers"];

                if (altUsers != null && altUsers.Count > 1)
                {
            @Html.Partial("~/Views/Admin/Registrations/Partials/_handleDupes.cshtml", Model.OrderRow)
                }
            }
        }
    </div>
    <div class="span4 alignright">
        Order Date: @Model.OrderRow.Order.OrderDate.ToShortDateString()
    </div>
</div>

<div class="row">
    <div class="span2 offset1 alignright">Type:</div>
    <div class="span3">@{Html.RenderPartial("_OrderRow_EditDropDown", Model.OrderRow);}</div>

    <div class="span6">
    </div>
</div>
<div class="row">
    <div class="span2 offset1 alignright">Billing:</div>
    <div class="span4">
        <div>@Html.Raw(TTSTrain.Webinars.WebEntry.Support.AffiliateReport.AffiliateReportSubTableDataDTOAssembler.BuildPaidColumn(Model.OrderRow).ToString().Replace("Total:", ""))&nbsp;&nbsp;        
            @if (Model.CurrentUser.UserType == UserType.Admin)
            {
                <form name="changeOrderStatusForm" action="/Admin/Registrations/EditStatus/@Model.OrderRow.ID" method="post">
                    <b>Status:</b>
                    @Html.DropDownList("registrationStatus", AppHelper.GetuEditableOrderRowStatuses(Model.OrderRow.Status),
                                           new { onchange = "document.changeOrderStatusForm.submit();" })
                </form>
            }
        </div>
    </div>
    <div class="span5">
        &nbsp;
    </div>
</div>
<div class="row">
    <div class="span2 offset1 alignright">
        Comments:<br />
    </div>
    <div class="span7">@Html.Raw(genComments)
        @Html.Raw(storeComments)
        @if (Model.CurrentUser.UserType == UserType.Admin)
        {
            <br />
            @Html.Raw(privateComments)
            <br />@Html.Raw(origin)
        }

    </div>
    <div class="span2">&nbsp;</div>
</div>
<div class="row">
    <div class="span12 alignright">

        @using (Html.BeginForm("ResendRegistrationConfirmation/" + Model.OrderRow.ID, "Registrations",
                               FormMethod.Post))
        {
            <input type="submit" class="btn @notifyState" id="Resend" name="ResendRegistrationConfirmation" value="Resend Registration Confirmation" />
        }

        @if (!string.IsNullOrEmpty(Model.OrderRow.Webinar.RecordingUrl))
        {

            using (Html.BeginForm("ResendLinks/" + Model.OrderRow.ID, "Registrations",
                                   FormMethod.Post))
            {
            <input type="submit" class="btn btn-success" name="ResendLinks" value="Resend Links" />
            }
        }

    </div>
</div>


<div id="changeAssignedAffiliate" class="modal hide fade">
    @using (Html.BeginForm("SetAffiliateAssignedToOrder", "Registrations", FormMethod.Post, new { id = "frmChangeAffiliate" }))
    {
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h3>Change Affiliate Credited To Order:</h3>
        </div>
        <div class="modal-body">
            @{
        if (Model.CurrentUser.UserType == UserType.Admin)
        {
                <p>
                    <b>Choose Affiliate:</b>
                    @Html.DropDownList("assignedAffiliate", AppHelper.GetListOfAffiliates(Model.OrderRow.Order.Affiliate.ID),
                                           new { onchange = "document.changeAffiliateForm.submit();" })
                    <input type="hidden" name="ID" value="@Model.OrderRow.ID"/>
                </p>
        }
        if (Model.CurrentUser.ID == 62)
        {
                <p>
                    <b>Choose Affiliate:</b>
                    @Html.DropDownList("assignedAffiliate", AppHelper.GetListOfCFTAffiliates(Model.OrderRow.Order.Affiliate.ID),
                                           new { onchange = "document.changeAffiliateForm.submit();" })
                    <input type="hidden" name="ID" value="@Model.OrderRow.ID"/>
                </p>
        }
            }
        </div>
        <div class="modal-footer">
            <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
            <input type="submit" class="btn btn-primary" value="Save Changes" />
        </div>
    }
</div>

<div id="orderHistory" class="modal hide fade" style="width: 60%;">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h3>Order History:</h3>
    </div>
    <div id="registrationsTableContainer" class="modal-body">
        <!-- this will be used as html template for displaying sub-table and this table is always hidden -->
        <table border="0" id="registrationsTable" class="display">
            <thead>
                <tr>
                    <th>Order#
                        <br />
                        Placed By </th>
                    <th>Date<br />
                        Title</th>
                    <th>Billing</th>
                    <th>Affiliate</th>
                    <th>Order<br />
                        Date</th>
                    <th>&nbsp;</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="7" class="dataTables_empty">Loading registrations list...</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="modal-footer">
        <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
        @*<input type="submit" class="btn btn-primary" value="Save Changes" />*@
    </div>

</div>

<div id="changeAssignedUser" class="modal hide fade">
    @*, data_async=true, data_target="#modal-body" *@
    @using (Html.BeginForm("SetUserAssignedToOrder", "Registrations", FormMethod.Post, new { id = "frmSetUserAssignedToOrder" }))
    {
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h3>Change User Assigned To Order:</h3>
        </div>  <div class="modal-body">
            <p>
                <b>Found Users...</b><br />
                @Html.DropDownList("byInstitution", AppHelper.GetSelectListOfUsersByInstitution(0, Model.OrderRow), new { onchange = "changeAssignedUser(this);" })&nbsp;&nbsp;<br />
                @Html.DropDownList("byDomain", AppHelper.GetSelectListOfUsersByDomain(0, Model.OrderRow), new { onchange = "changeAssignedUser(this);" })&nbsp;&nbsp;<br />
                @Html.DropDownList("byName", AppHelper.GetSelectListOfUsersByLastName(0, Model.OrderRow), new { onchange = "changeAssignedUser(this);" })&nbsp;&nbsp;
                <br />

                <a href="#" id="previewUser" target="_new" onclick="OpenSummary(@Model.OrderRow.Order.User.ID); return false;" role="button" >[Order History]</a><br/>
                <input type="hidden" name="orderID" value="@Model.OrderRow.ID"/>
                <input type="hidden" name="migrateOrder" value="one" />
                <input type="text" id="targetUserID" name="targetUserID" value="Targeted User ID" />
            </p>
        </div>
        <div class="modal-footer">
            <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
            <input type="button" name="moveOne" class="btn btn-primary" disabled="disabled" value="Just This Order" /><input type="button" name="moveAll" disabled="disabled" class="btn btn-primary" value="Change All" />
        </div>
    }
</div>

<div id="addDiscount" class="modal hide fade">
    @using (Html.BeginForm("SetDiscount/" + Model.OrderRow.ID, "Registrations", FormMethod.Post, new { id = "frmSetDiscount" }))
    {
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h3>Change User Assigned To Order:</h3>
        </div>
        <div class="modal-body">
            @{
                <input type="hidden" name="idOrder" value="@Model.OrderRow.ID"/>
        var discountCode = string.Empty;
        if (string.IsNullOrEmpty(Model.OrderRow.DiscountCode))
        {
            if (Model.OrderRow.Discount != null)
            {
                discountCode = Model.OrderRow.Discount.Code;
            }
        }
        else
        {
            discountCode = Model.OrderRow.DiscountCode;
        }

        if (Model.OrderRow.Webinar.IsSubscriptionWebinar == false)
        {
            if (TempData["DiscountCodeError"] == null)
            {
                <div>
                    <a onclick="$('#inputDiscountCode').css('display', 'block');">Add Discount Code?</a><br />
                    <div id="inputDiscountCode" class="value">
                        <div class="center">
                            @Html.TextBox("UpdateCart.DiscountCode" + Model.OrderRow.ID, discountCode, new { @class = "input" })<br />
                            @Html.ValidationMessage("DiscountCode" + Model.OrderRow.ID)
                            <input type="image" src="/Content/images/search-icon.png" class="image" />
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div>@TempData["DiscountCodeError"]
                    <br />
                    <div class="center">
                        Reenter:
                                @Html.TextBox("UpdateCart.DiscountCode" + Model.OrderRow.ID, discountCode, new { @class = "input" })<br />
                        @Html.ValidationMessage("DiscountCode" + Model.OrderRow.ID)
                        <input type="image" src="/Content/images/search-icon.png" class="image" />
                    </div>

                </div>
            }

        }

            }
        </div>
        <div class="modal-footer">
            <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
            <input type="submit" class="btn btn-primary" value="Save Changes" />
        </div>
    }
</div>

<div id="addLocation" class="modal hide fade">
@Html.Partial("~/Views/Shared/AddLocationsView.cshtml", Model.OrderRow)
</div>

<div id="deleteOrder" class="modal hide fade">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h3>@DeleteOrderLabel</h3>
    </div>
    <div class="modal-body">
        @{
            if (Model.OrderRow.Status == OrderRowStatus.Canceled
                )
            {
            <form name="registrationUnDeleteForm" action="/Admin/Registrations/UnDelete/@Model.OrderRow.ID"
                      method="post">
                @Html.ValidationMessage("DeleteOrder")
                <input type="submit" name="UnDelete?" value="UnDelete?" />
            </form>
            }
            else
            {
            <form name="registrationDeleteForm" action="/Admin/Registrations/Delete/@Model.OrderRow.ID"
                      method="post">
                @Html.ValidationMessage("DeleteOrder")
                <input type="submit" name="Delete?" value="Delete?" />
            </form>
            }
        }
    </div>
    <div class="modal-footer">
        <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
    </div>
</div>

