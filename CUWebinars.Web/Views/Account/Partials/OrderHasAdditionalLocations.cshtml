@using System.Globalization
@using CUWebinars.Business.Constants
@model  OrderHasAdditionalLocationsViewModel

@{
    var nfi = new CultureInfo(DomainConstants.UsLocale, false).NumberFormat;

    if (Model.AdditionalLocations != null)
    {
        var numberOfAdditionalLocations = Model.AdditionalLocations.Count();

        if (numberOfAdditionalLocations > 0)
        {
            if (numberOfAdditionalLocations == 1)
            {
                <span>The registration includes a single additional location for @Model.AdditionalLocations.First().Email costing @Model.AdditionalLocations.First().Price.ToString("C", nfi). </span>
            }
            else
            {
                <span>The registration includes @numberOfAdditionalLocations additional locations (total added cost is @Model.OptionsCost.ToString("C", nfi)) for @Model.Addresses</span>
                <text>.</text>
            }
        }
    }
}