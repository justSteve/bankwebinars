@using System.Globalization
@using CUWebinars.Business.Constants
@model  OrderHasAdditionalLocationsViewModel

@{
    var nfi = new CultureInfo(DomainConstants.UsLocale, false).NumberFormat;

    if (Model.AdditionalLocations != null)
    {
        var numberOfAdditionalLocations = Model.AdditionalLocations.Count();

        if (numberOfAdditionalLocations > 0)
        {
            if (numberOfAdditionalLocations == 1)
            {
                <span id="addlocSpiel" class="text-info">The registration includes a single additional location for <span class="muted">@Model.AdditionalLocations.First().Email</span> costing @Model.AdditionalLocations.First().Price.ToString("C", nfi). </span>
            }
            else
            {
                <span id="addlocSpiel" class="text-info">The registration includes @numberOfAdditionalLocations additional locations (total added cost is @Model.OptionsCost.ToString("C", nfi)) for @Html.Raw(@Model.Addresses)</span><text>.</text>
            }
        }
    }
}