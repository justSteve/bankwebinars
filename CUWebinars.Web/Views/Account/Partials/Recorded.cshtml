@model CUWebinars.Web.Core.MyWebinarsDTO
@using System.Configuration
@using System.Data
@using System.Data.SqlClient
@using CUWebinars.Web.Helpers
@using TTSDataLayer.Models

@{
    WebUser currentUser = Model.WebUser;

    USTimeZone timeZ = currentUser.timeZone;
    string email = Model.WebUser.email;
}
<div class="container clearfix" id="main-content">
    <!--begin main content-->
    <div class="row-fluid sidebar-right">
        <!--begin row-fluid-->
        <div class="span9 primary-column">
            <h3>
                Recorded Events <span style="font-weight: normal; font-size: small; color: Green;">
                    (found
                    @Model.Recorded.Count.ToString())
                </span>
            </h3>
            <ul class="s-accordion faq fancy">

                @foreach (var recorded in Model.Recorded)
                {
                    <li class="s-wrap">
                        @{
                    var row = recorded.OrderRow.Single();

                    //TODO: re-code this so that the registration type can be obtained without
                    //a hit to the db on each record.
                    Option registrationType = new Option();
                    using (var context = new TTSWebinarsContext())
                    {
                        var paramWebinarID = new SqlParameter("idOption", SqlDbType.Int) { Value = (int)row.RegistrationType };
                        registrationType = context.Options.SqlQuery(
                            "dbo.GetRegistrationType @idOption", paramWebinarID).Single();

                    }
                        }
                        <h4 class="trigger" id="upcoming-@row.idWebinar"><a href="#">@row.Webinar.Title<i class="icon-plus-sign"></i></a></h4>
                        <div class="s-content">
                            <span style="font-size: small;">
                                @Html.DisplayDate(row.Webinar.Date)<br />
                                <br />
                                Order ID: @row.Order.idOrder<br />Date Ordered: @row.Order.OrderDate.ToShortDateString()
                            </span>

                            @if (registrationType.OptionLabel != RegistrationType.Live_Session_Only.ToString() &&
            registrationType.OptionLabel != RegistrationType.FourPart_Series.ToString())
                            {
                                if (row.Webinar.RecordingUrl != "")
                                {
                                    <div class="myWebinarscaption">
                                        <p class="ShowsPlayBlock" align="center">
                                            <font size="+1" face="Arial, Helvetica, sans-serif" color="#0D037C">
                                                <b><a href="@ConfigurationManager.AppSettings["WMVRepository"]/@row.Webinar.RecordingUrl" target="_blank">Click here to view this OnDemand Recording</a></b><br />
                                            </font>
                                        </p>

                                        @{Html.RenderPartial("DisplayTemplates/HandoutsListing", row.Webinar);}
                                        @if (row.ShipmentDate.HasValue)
                                        {
                                            <p>This order shipped on:<b>@Html.DisplayDate(row.ShipmentDate.Value)</b></p>
                                        }
                                        <div class="shareOnDemand">
                                            <p>Need to share this event with a co-worker? Just provide them this URL: http://www.bankwebinars.com/Webinar/OnDemandPlayback?idWebinar=@row.Webinar.idWebinar&idUser=@row.Order.WebUser.idUser</p>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="myWebinarscaption">
                                        <span style="font-size: small;">(Recording not yet uploaded.)</span>
                                    </div>
                                }
                            }
                            else
                            {<div class="myWebinarscaption">
                                <p style="font-size: small;">
                                    Upgrade your registration with an On-Demand Recording package!<br />
                                </p>
                            </div>
                            }
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>