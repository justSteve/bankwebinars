@model CUWebinars.Web.Core.MyWebinarsDTO
@using System.Configuration
@using System.Data
@using System.Data.SqlClient
@using System.Globalization
@using System.Linq
@using CUWebinars.Web.Core
@using CUWebinars.Web.Helpers
@using CUWebinars.Business.Models

@{
    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;
    WebUser currentUser = Model.WebUser;

    USTimeZone timeZ = currentUser.timeZone;
    string email = Model.WebUser.email;
    NumberFormatInfo nfi = new CultureInfo("en-US", false).NumberFormat;
    nfi.CurrencyDecimalDigits = 0;
}
<div class="container">
    <!--begin main content-->
    <div class="row-fluid">
        <!--begin row-fluid-->
        <div class="span12">
            @foreach (var recorded in Model.Recorded)
            {
                var row = recorded.OrderRows.Single(or => or.RowStatus == OrderRowStatus.Active);
                var upOnDemandCost = 100;
                var upPremium = 140;

                if (row.Webinar.Duration == 1)
                {
                    upOnDemandCost = 70;
                    upPremium = 100;
                }

                var expiresDate = row.Webinar.Date.AddMonths(6);
                var remainingDays = Convert.ToInt32((expiresDate - DateTime.Now).TotalDays);
                var accessPhrase = "will be accessible ";

                if (row.RegistrationType.ShowRecordingNotifications == "No")
                {
                    accessPhrase = "would be accessible (with upgrade) ";
                }

                <div class=" container-fluid">
                    <div class="row-fluid">
                    </div><div class="pull-right span4" id="orderSum-@row.idWebinar">
                        @{Html.RenderPartial("DisplayTemplates/OrderSumUser", row.Order);}
                    </div>
                    <h4 class="span7" id="recorded-@row.idWebinar">@row.Webinar.Title</h4>
                    <div style="font-size: small;  line-height: 1.2; margin-bottom: 10px;" class="span7">
                        This event was recorded on @Html.DisplayDate(row.Webinar.Date) and @accessPhrase until @Html.DisplayDate(expiresDate)
                        - @remainingDays more days.
                        <br />
                        @if (row.RegistrationType.ShowRecordingNotifications == "No")
                        {
                            <p style="font-size: small;">
                                <span class="btn btn-success btn-mini" id="upgradeRegistration_@row.idOrder">Upgrade</span> this registration with an <i>OnDemand Recording package</i> for @upOnDemandCost.ToString("C", nfi) or our <i>Premium package</i> for @upPremium.ToString("C", nfi)!<br />
                            </p>
                        }
                    </div>



                    <div class="span12">
                        @if (row.RegistrationType.ShowRecordingNotifications == "Yes")
                        {
                            <div class="container-fluid well well-large" align="center">
                                @if (row.Webinar.RecordingUrl != "")
                                {
                                    <div class="row-fluid ">
                                        <div class="span7">
                                            <font size="+1" face="Arial, Helvetica, sans-serif" color="#0D037C">
                                                <b><a href="/webinar/GetWebinarRecording/@row.Webinar.idWebinar" target="_blank">Click here to view this OnDemand Recording</a></b><br />
                                                @*<b><a href="@globalConfig.WMVRepository@row.Webinar.RecordingUrl" target="_blank">Click here to view this OnDemand Recording</a></b><br />*@
                                            </font>
                                        </div>
                                        <div class="span5">
                                            @{Html.RenderPartial("DisplayTemplates/HandoutsListing", row.Webinar);}
                                        </div>

                                    </div>
                                    <div>
                                        <p>Need to share this event with a co-worker? <br />Provide them this URL: <tt><b>@globalConfig.TenantURL/Webinar/Play?w=@row.Webinar.idWebinar&u=@row.Order.WebUser.idUser</b></tt></p>
                                    </div>


                                }
                                else
                                {
                                    <div>
                                        <span style="font-size: small;">(Recording not yet uploaded.)</span>
                                    </div>
                                }

                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>