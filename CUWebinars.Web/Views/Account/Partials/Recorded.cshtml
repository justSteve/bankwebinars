@model CUWebinars.Web.Core.MyWebinarsDTO
@using System.Linq
@using CUWebinars.Web.Core
@using CUWebinars.Web.Helpers
@using CUWebinars.Web.Models.JsonModels
@using Newtonsoft.Json

@{
    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;

    var nfi = new CultureInfo("en-US", false).NumberFormat;
    nfi.CurrencyDecimalDigits = 0;

    WebUser currentUser = Model.WebUser;
}

<div class="container">
    <!--begin main content-->
    <div class="row-fluid">
        <!--begin row-fluid-->
        <div class="span12">
            @foreach (var recorded in Model.Recorded)
            {
                var row = recorded.Value.OrderRows.Single(or => or.RowStatus == OrderRowStatus.Active);

                var onDemandClaim = new PostEventClaim();
                if (Model.MyClaims != null)
                {
                    foreach (var claim in Model.MyClaims)
                    {
                        var thisClaim = JsonConvert.DeserializeObject<PostEventClaim>(claim.ToString());
                        if (thisClaim.OnDemandCode == row.OnDemandCode)
                        {
                            onDemandClaim.OrderId = row.idOrder;
                            onDemandClaim.OnDemandCode = thisClaim.OnDemandCode;
                            onDemandClaim.ExpiryDate = thisClaim.ExpiryDate;
                        }
                    }
                }
                var onDemandClaimString = "";
                if (onDemandClaim.OnDemandCode != null)
                {
                    onDemandClaimString = onDemandClaim.OrderId.ToString() + "-" + onDemandClaim.OnDemandCode;
                }

                //var expiresDate = row.Webinar.Date.AddMonths(6);
                var remainingDays = Convert.ToInt32((onDemandClaim.ExpiryDate - DateTime.Now).TotalDays);
                var accessPhrase = "will be accessible for six months from your order date";

                if (row.RegistrationType.ShowRecordingNotifications == "No")
                {
                    accessPhrase = "would be accessible (by upgrading your order) for 6 months from now";
                }

                <div class="container-fluid">
                    <div class="row-fluid">
                        <div class="pull-right span3" id="orderSum-@row.idWebinar">
                            @{Html.RenderPartial("DisplayTemplates/OrderSumUser", row.Order);}
                        </div>
                        <div class="span7" style="font-size: small;  line-height: 1.2; margin-bottom: 10px;">
                            <h4 id="recorded-@row.idWebinar">@row.Webinar.Title</h4>
                            <div>
                                <p>
                                    This event was recorded on @Html.DisplayDate(row.Webinar.Date) and @accessPhrase.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="span2 pull-right">
                        <form method="GET" action="/Account/MyCertificate">
                            <input type="hidden" name="orderID" value="@row.idOrder" />
                            <input type="submit" value="My Certificate" id="ShowCertificate" class="btn btn-success pull-right btn-mini pull-left" />
                        </form>
                    </div>
                    <div class="container-fluid">
                        @if (row.RegistrationType.ShowRecordingNotifications == "Yes")
                        {
                            <div class="row-fluid">
                                @if (row.Webinar.RecordingUrl != "")
                                {
                                    <div class="span3 well well-large">
                                        <a target="_blank" href="/webinar/GetWebinarRecording/@row.Webinar.idWebinar">
                                            <span><i class="icon-facetime-video"> </i></span> Video Playback
                                        </a>

                                        @{Html.RenderPartial("DisplayTemplates/HandoutsListing", row.Webinar);}
                                        @if (row.RegistrationType.ShowShippedNotifications == "Yes")
                                        {
                                            if (row.ShipmentDate != null)
                                            {
                                                <div>
                                                    The CD and handouts shipped @row.ShipmentDate<text>.</text>
                                                </div>
                                            }
                                            else
                                            {
                                                <div>
                                                    The CD and handouts are typically shipped within 3-5 days following the event.
                                                </div>
                                            }
                                        }

                                    </div>
                                    <div class="span6">
                                        @if (!String.IsNullOrWhiteSpace(onDemandClaimString))
                                        {
                                            <p>
                                                Need to share this event with a co-worker? <br />
                                                <tt>
                                                    <strong>
                                                        @globalConfig.TenantURL/o/@onDemandClaimString
                                                    </strong>
                                                </tt>
                                            </p>
                                        }
                                        @if (currentUser.email.EndsWith("ttstrain.com") && !String.IsNullOrWhiteSpace(recorded.Key))
                                        {
                                            <p>
                                                @{
                                            var urlSuffix = recorded.Value.idOrder + "-" + recorded.Key;
                                            <text>A post-event assesment for this event is available. Pass this URL to any co-workers<br /> <tt>
                                                    <strong>
                                                        @globalConfig.TenantURL/quiz/index/@urlSuffix
                                                    </strong>
                                                </tt></text>
                                                }
                                            </p>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div>
                                        <span style="font-size: small;">(Recording not yet uploaded.)</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            // user has not purchased recording
                            <div class="row-fluid">
                                @if (onDemandClaim.ExpiryDate > DateTime.Now)
                                {

                                    <div class="span8">
                                        <p>
                                            Complementary access to the OnDemand recording is available until @onDemandClaim.ExpiryDate.ToShortDateString().
                                            Need to share this event with a co-worker?
                                            <a href="@globalConfig.TenantURL/o/@onDemandClaimString">
                                                Provide them this URL:<br /> <tt><b>@globalConfig.TenantURL/o/@onDemandClaimString</b></tt>
                                            </a>
                                        </p>
                                    </div>
                                    <div class="span4">
                                        <a target="_blank" href="/webinar/GetWebinarRecording/@row.Webinar.idWebinar"><span style="margin-left: 15px;"><i class="icon-facetime-video"></i></span> Playback</a>

                                        @{Html.RenderPartial("DisplayTemplates/HandoutsListing", row.Webinar);}

                                    </div>
                                }
                                else
                                {
                                    <div>
                                        @{Html.RenderPartial("DisplayTemplates/ShowUpgradeCost", row.Order);}
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>