@model CUWebinars.Web.Core.MyWebinarsDTO
@using System.Linq
@using CUWebinars.Web.Core
@using CUWebinars.Web.Helpers

@{
    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;

    var nfi = new CultureInfo("en-US", false).NumberFormat;
    nfi.CurrencyDecimalDigits = 0;
}
<div class="container">
    <!--begin main content-->
    <div class="row-fluid">
        <!--begin row-fluid-->
        <div class="span12">
            @foreach (var recorded in Model.Recorded)
            {
                var row = recorded.OrderRows.Single(or => or.RowStatus == OrderRowStatus.Active);
                var upOnDemandCost = 100;
                var upPremium = 140;

                if (row.Webinar.Duration == 1)
                {
                    upOnDemandCost = 70;
                    upPremium = 100;
                }
                var hasClaim = false;
                if (Model.MyClaims != null)
                {
                    foreach (var claim in Model.MyClaims)
                    {
                        if (claim.ToString().Split(':')[0] == row.idWebinar.ToString())
                        {
                            hasClaim = true;
                        }

                    }
                }

                var expiresDate = row.Webinar.Date.AddMonths(6);
                var remainingDays = Convert.ToInt32((expiresDate - DateTime.Now).TotalDays);
                var accessPhrase = "will be accessible ";

                if (row.RegistrationType.ShowRecordingNotifications == "No")
                {
                    accessPhrase = "would be accessible (with upgrade) ";
                }

                <div class=" container-fluid">
                    <div class="row-fluid">
                        <div class="pull-right span3" id="orderSum-@row.idWebinar">
                            @{Html.RenderPartial("DisplayTemplates/OrderSumUser", row.Order);}

                        </div>
                        <div class="span7" style="font-size: small;  line-height: 1.2; margin-bottom: 10px;">
                            <h4 id="recorded-@row.idWebinar">@row.Webinar.Title</h4>
                            <div>
                                <p>
                                    This event was recorded on @Html.DisplayDate(row.Webinar.Date) and @accessPhrase until @Html.DisplayDate(expiresDate)
                                    - @remainingDays more days.
                                </p>

                                <form method="POST" action="/Account/MyCertificate">
                                    <input type="hidden" name="orderID" value="@row.idOrder" />
                                    <aside class="widget">
                                        <input type="submit" value="My Certificate" id="ShowCertificate" class="btn btn-success btn-mini pull-left" />
                                    </aside>
                                </form>
                                @if (row.RegistrationType.ShowRecordingNotifications == "No")
                                {
                                    <p style="font-size: small;">
                                        <span class="btn btn-success btn-mini" id="upgradeRegistration_@row.idOrder">Upgrade</span> this registration with an <i>OnDemand Recording package</i> for @upOnDemandCost.ToString("C", nfi) or our <i>Premium package</i> for @upPremium.ToString("C", nfi)!<br />
                                    </p>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="container-fluid">
                        @if (row.RegistrationType.ShowRecordingNotifications == "Yes")
                        {
                            <div class="row-fluid">
                                @if (row.Webinar.RecordingUrl != "")
                                {
                                    <div class="span4">
                                        <a target="_blank" href="/webinar/GetWebinarRecording/@row.Webinar.idWebinar"><span style="margin-left: 15px;"><i class="icon-facetime-video"></i></span> Playback</a>

                                        @{Html.RenderPartial("DisplayTemplates/HandoutsListing", row.Webinar);}
                                        @if (row.RegistrationType.ShowShippedNotifications == "Yes")
                                        {
                                            if (row.ShipmentDate != null)
                                            {
                                                <div>
                                                    The CD and handouts shipped @row.ShipmentDate<text>.</text>
                                                </div>
                                            }
                                            else
                                            {
                                                <div>
                                                    The CD and handouts are typically shipped within 3-5 days following the event.
                                                </div>
                                            }
                                        }

                                    </div>
                                    <div class="span7">
                                        <p>Need to share this event with a co-worker? Provide them this URL:<br /> <tt><b>@globalConfig.TenantURL/Webinar/Play?w=@row.Webinar.idWebinar&u=@row.Order.WebUser.idUser</b></tt></p>

                                    </div>

                                }
                                else
                                {
                                    <div>
                                        <span style="font-size: small;">(Recording not yet uploaded.)</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            // user has not purchased recording
                            <div class="row-fluid">
                                @if (hasClaim)
                                {
                                    <div class="span4">
                                        <a target="_blank" href="/webinar/GetWebinarRecording/@row.Webinar.idWebinar"><span style="margin-left: 15px;"><i class="icon-facetime-video"></i></span> Playback</a>

                                        @{Html.RenderPartial("DisplayTemplates/HandoutsListing", row.Webinar);}

                                    </div>
                                    <div class="span7">
                                        <p>
                                            Complementary access to the OnDemand recording is provided for five business days following the event.
                                            Need to share this event with a co-worker? Provide them this URL:<br /> <tt><b>@globalConfig.TenantURL/Webinar/Play?w=@row.Webinar.idWebinar&u=@row.Order.WebUser.idUser</b></tt>
                                        </p>
                                    </div>
                                }
                                else
                                {
                                    <div>
                                        <span style="font-size: small;">Upgrade your order to access this OnDemand recording.</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>