@model CUWebinars.Web.Core.MyWebinarsDTO
@using System.Linq
@using System.Runtime.Serialization.Json
@using CUWebinars.Web.Core
@using CUWebinars.Web.Helpers
@using CUWebinars.Web.Models.JsonModels
@using Newtonsoft.Json

@{
    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;
    DataContractJsonSerializer odClaim = new DataContractJsonSerializer(typeof(Claim));

    //var thisClaim = myClaimToRecording.

    var nfi = new CultureInfo("en-US", false).NumberFormat;
    nfi.CurrencyDecimalDigits = 0;

}
<div class="container">
    <!--begin main content-->
    <div class="row-fluid">
        <!--begin row-fluid-->
        <div class="span12">
            @foreach (var recorded in Model.Recorded)
            {
                var row = recorded.OrderRows.Single(or => or.RowStatus == OrderRowStatus.Active);


                var onDemandClaim = new OnDemandClaim();
                if (Model.MyClaims != null)
                {
                    foreach (var claim in Model.MyClaims)
                    {
                        var thisClaim = JsonConvert.DeserializeObject<OnDemandClaim>(claim.ToString());
                        if (thisClaim.OrderId == row.idOrder)
                        {
                            onDemandClaim.OrderId = row.idOrder;
                            onDemandClaim.OnDemandCode = thisClaim.OnDemandCode;
                            onDemandClaim.ExpiryDate = thisClaim.ExpiryDate;
                        }
                    }
                }

                var onDemandClaimString = onDemandClaim.OrderId.ToString() + "-" + onDemandClaim.OnDemandCode;
                var expiresDate = row.Webinar.Date.AddMonths(6);
                var remainingDays = Convert.ToInt32((expiresDate - DateTime.Now).TotalDays);
                var accessPhrase = "will be accessible ";

                if (row.RegistrationType.ShowRecordingNotifications == "No")
                {
                    accessPhrase = "would be accessible (with upgrade) ";
                }

                <div class=" container-fluid">
                    <div class="row-fluid">
                        <div class="pull-right span3" id="orderSum-@row.idWebinar">
                            @{Html.RenderPartial("DisplayTemplates/OrderSumUser", row.Order);}
                        </div>
                        <div class="span7" style="font-size: small;  line-height: 1.2; margin-bottom: 10px;">
                            <h4 id="recorded-@row.idWebinar">@row.Webinar.Title</h4>
                            <div>
                                <p>
                                    This event was recorded on @Html.DisplayDate(row.Webinar.Date) and @accessPhrase until @Html.DisplayDate(expiresDate)
                                    - @remainingDays more days.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="span2 pull-right">
                        <form method="POST" action="/Account/MyCertificate">
                            <input type="hidden" name="orderID" value="@row.idOrder" />
                            <input type="submit" value="My Certificate" id="ShowCertificate" class="btn btn-success pull-right btn-mini pull-left" />
                        </form>
                    </div>
                    <div class="container-fluid">
                        @if (row.RegistrationType.ShowRecordingNotifications == "Yes")
                        {
                            <div class="row-fluid">
                                @if (row.Webinar.RecordingUrl != "")
                                {
                                    <div class="span3 well well-large">
                                        <a target="_blank" href="/webinar/GetWebinarRecording/@row.Webinar.idWebinar">
                                            <span><i class="icon-facetime-video"> </i></span> Video Playback
                                        </a>

                                        @{Html.RenderPartial("DisplayTemplates/HandoutsListing", row.Webinar);}
                                        @if (row.RegistrationType.ShowShippedNotifications == "Yes")
                                        {
                                            if (row.ShipmentDate != null)
                                            {
                                                <div>
                                                    The CD and handouts shipped @row.ShipmentDate<text>.</text>
                                                </div>
                                            }
                                            else
                                            {
                                                <div>
                                                    The CD and handouts are typically shipped within 3-5 days following the event.
                                                </div>
                                            }
                                        }

                                    </div>
                                    <div class="span6">
                                        <p>
                                            Need to share this event with a co-worker? Provide them this URL:<br /> <tt><b>http://@globalConfig.TenantURL/o/@onDemandClaimString</b></tt>
                                        </p>
                                        <p>
                                            A post-event assement is available:<br /> <tt><b>http://beta.bankwebinars.com/quiz/index/77790-27ixbqr</b></tt>
                                        </p>

                                    </div>
                                }
                                else
                                {
                                    <div>
                                        <span style="font-size: small;">(Recording not yet uploaded.)</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            // user has not purchased recording
                            <div class="row-fluid">
                                @if (onDemandClaim.ExpiryDate > DateTime.Now)
                                {
                                    <div class="span4">
                                        <a target="_blank" href="/webinar/GetWebinarRecording/@row.Webinar.idWebinar"><span style="margin-left: 15px;"><i class="icon-facetime-video"></i></span> Playback</a>

                                        @{Html.RenderPartial("DisplayTemplates/HandoutsListing", row.Webinar);}

                                    </div>
                                    <div class="span7">
                                        <p>
                                            Complementary access to the OnDemand recording is provided for five business days following the event - @row.Webinar.Date.AddDays(8).
                                            Need to share this event with a co-worker? Provide them this URL:<br /> <tt><b>@globalConfig.TenantURL/o/@onDemandClaimString</b></tt>
                                        </p>
                                    </div>
                                }
                                else
                                {
                                    <div>
                                        @{Html.RenderPartial("DisplayTemplates/ShowUpgradeCost", row.Order);}
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>