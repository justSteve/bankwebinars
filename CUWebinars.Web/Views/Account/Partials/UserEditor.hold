@model TTSTrain.Webinars.Business.Entity.User
@using TTSTrain.Webinars.WebEntry
@using TTSTrain.Webinars.Business.Facade
@using TTSTrain.Webinars.Business.Entity
@{
    User currentUser = UserFacade.Instance.GetCurrentUser();
}
<ul id="myTabs" class="nav nav-tabs">
    <li><a href="#billing" data-toggle="tab">Billing</a></li>
    <li><a href="#shipping" data-toggle="tab">Shipping</a></li>
    <li><a href="#account" data-toggle="tab">Account</a></li>
    <li><a href="#discount" data-toggle="tab">Discounts & Subscriptions</a></li>
    @if (currentUser.UserType.ToString() == "Admin")
    {
        <li><a href="#admin" data-toggle="tab">Admin</a></li>
    }
</ul>
<div class="container-fluid">
    <div id="myTabContent" class="tab-content">

        <div class="tab-pane fade" id="billing">
            <div class="row-fluid">
                <legend class="span12">Billing Address</legend>
                <div class="fieldContainer" id="getFirstLast">
                    <div>
                        <div class="span2">
                            First Name:
                        </div>
                        <div class="span9">
                            @Html.EditorFor(model => model.FirstName)
                            @Html.ValidationMessageFor(model => model.FirstName)
                        </div>
                    </div>
                    <div class="labelEditwrap">
                        <div class="span2">
                            Last Name:
                        </div>
                        <div class="span9">
                            @Html.EditorFor(model => model.LastName)
                            @Html.ValidationMessageFor(model => model.LastName)
                        </div>
                    </div>
                </div>
                <div class="fieldContainer" id="getFull">
                    <div class="span2">
                        Name:
                    </div>
                    <div class="span9">
                        <input type="text" id="FullName" name="FullName" style = "width: 240px;" value="@Model.FullName.Trim()" />
                    </div>
                </div>
                <div class="fieldContainer" id="wrapEmail">
                    <div class="span2">
                        Email:
                    </div>
                    <div class="span9">
                        @Html.TextBoxFor(model => model.Email, new { style = "width: 240px;" })
                        @Html.ValidationMessageFor(model => model.Email)
                    </div>
                </div>
                <div class="fieldContainer" id="wrapPhone">
                    <div class="span2">
                        Phone:
                    </div>
                    <div class="span9">
                        @Html.TextBoxFor(model => model.Phone1, new { style = "width: 140px;" })
                        @Html.ValidationMessageFor(model => model.Phone1)
                    </div>
                </div>
                <div class="fieldContainer" id="wrapInstitution">
                    <div class="span2">
                        Institution:
                    </div>
                    <div class="span9">

                        @Html.Hidden("Institution", Model.Institution.Name)
                        @Html.EditorFor(model => model.ProvisionalInstitution)

                        @Html.ValidationMessageFor(model => model.ProvisionalInstitution)
                    </div>
                </div>

                <div class="fieldContainer" id="wrapAddress">
                    <div class="span2">
                        Address:
                    </div>
                    <div class="span9">
                        @Html.TextBoxFor(model => model.Address, new { style = "width: 200px;" })
                        @Html.ValidationMessageFor(model => model.Address)
                    </div>
                </div>
                <div class="fieldContainer" id="wrapCity">
                    <div class="span2">
                        City:
                    </div>
                    <div class="span9">
                        @Html.TextBoxFor(model => model.City, new { style = "width: 140px;" })
                        @Html.ValidationMessageFor(model => model.City)
                    </div>
                </div>
                <div class="fieldContainer" id="wrapState">
                    <div class="span2">
                        State:
                    </div>
                    <div class="span9">@Html.ValidationMessageFor(model => model.State)@Html.ValidationMessageFor(model => model.Zip)
                        @Html.TextBoxFor(model => model.State, new { style = "width: 30px;" })&nbsp; &nbsp;&nbsp;Zip: @Html.TextBoxFor(model => model.Zip, new { style = "width: 50px;" })

                    </div>
                </div>
            </div>
        </div>




        <div class="tab-pane fade" id="shipping">
            <div class="row-fluid">
                <legend class="span12">Shipping Address</legend>
                <div class="fieldContainer">
                    <div class="span2">
                        First Name:
                    </div>
                    <div class="span9">
                        @Html.TextBoxFor(model => model.ShippingFirstName, new { @class = "ship" })
                        @Html.ValidationMessageFor(model => model.ShippingFirstName)
                    </div>
                </div>
                <div class="fieldContainer" id="wrapShippingLastName">
                    <div class="span2">
                        Last Name:
                    </div>
                    <div class="span9">
                        @Html.TextBoxFor(model => model.ShippingLastName, new { @class = "ship" })
                        @Html.ValidationMessageFor(model => model.ShippingLastName)
                    </div>
                </div>
                <div class="fieldContainer" id="wrapShippingAddress">
                    <div class="span2">
                        Address:
                    </div>
                    <div class="span9">
                        @Html.TextBoxFor(model => model.ShippingAddress, new { @class = "ship" })
                        @Html.ValidationMessageFor(model => model.ShippingAddress)
                    </div>
                </div>
                <div class="fieldContainer" id="wrapCity">
                    <div class="span2">
                        City:
                    </div>
                    <div class="span9">
                        @Html.TextBoxFor(model => model.ShippingCity, new { @class = "ship" })
                        @Html.ValidationMessageFor(model => model.ShippingCity)
                    </div>
                </div>
                <div class="fieldContainer" id="wrapShippingState">
                    <div class="span2">
                        State:
                    </div>
                    <div class="span9">
                        @Html.TextBoxFor(model => model.ShippingState, new { style = "width: 30px;" })
                        @Html.ValidationMessageFor(model => model.ShippingState)
                    </div>
                </div>
                <div class="fieldContainer" id="wrapShippingZip">
                    <div class="span2">
                        Zip:
                    </div>
                    <div class="span9">
                        @Html.TextBoxFor(model => model.ShippingZip, new { style = "width: 50px;" })
                        @Html.ValidationMessageFor(model => model.ShippingZip)
                    </div>

                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="account">
            <div class="row-fluid">
                <legend class="span12">Account Preferences</legend>
                <div id="PasswordManagement">
                    @{
                        
                        if (currentUser.UserType == UserType.Affiliate)
                        {
                        <div>
                            <a href="#PassResetModal" role="button" data-toggle="modal" class="btn btn-info">Reset password and Email User</a>
                        </div>}
                        else
                        {
                        <div class="fieldContainer">
                            <div class="span2">
                                Password:
                            </div>
                            <div class="span9">
                                <b>@Model.Password</b>&nbsp;&nbsp;&nbsp;&nbsp; <a href="#" id="passwordChangeLink">Change?</a>
                            </div>
                        </div>
                        <div class="fieldContainer changePass" style="display: none;">
                            <div class="span2">
                                Change To:
                            </div>
                            <div class="span9">
                                @Html.Password("NewPassword")
                                @Html.ValidationMessage("NewPassword")
                            </div>
                        </div>
                        <div class="fieldContainer changePass" style="display: none;">
                            <div class="span2">
                                Confirm:
                            </div>
                            <div class="span9">
                                @Html.Password("NewPasswordConfirmation", string.Empty, new
                                                                                            {
                                                                                                @class = "{equalTo: '#NewPassword'}"
                                                                                            })
                                @Html.ValidationMessage("NewPasswordConfirmation")
                            </div>
                        </div>
                        }
                    }
                </div>
                <div class="fieldContainer">
                    <div class="span2">
                        Time Zone:
                    </div>
                    <div id="TZ" class="span9">
                        <select id="TimeZone" name="TimeZone">
                            <option value="4">Eastern</option>
                            <option value="3">Central</option>
                            <option value="2">Mountain</option>
                            <option value="1">Pacific</option>
                        </select>
                        @*@Html.EnumDropDownListFor(m => m.TimeZone)*@ @*
                @Html.DropDownList("TimeZone", AppHelper.GetUSTimeZones(Model.TimeZone) )*@
                        @Html.ValidationMessage("TimeZone")
                    </div>
                </div>
                <div class="fieldContainer labelEditwrap">
                    <div class="span2">
                        <label for="FutureMail">
                            Mailing List:</label>
                    </div>
                    <div class="span9">
                        @Html.CheckBox("FutureMail", Model.FutureMail)
                    </div>
                </div>
                <div class="span11">
                    Comment or Question:
                </div>
                <div class="span11">
                    @Html.TextArea("GeneralComments", Model.GeneralComments, new { style = "width: 360px;" })
                    @Html.ValidationMessage("GeneralComments")
                </div>

            </div>
        </div>
        <div class="tab-pane fade" id="discount">
            <div class="row-fluid">
                <legend class="span12">Discounts and Subscriptions</legend>
                @*<h3 align="center">Ask about our new Loyalty Program!</h3>*@
                @if (Model.SubscriptionDiscount != null)
                {
                    <h3 align="center">Discount Code <b>@Model.SubscriptionDiscount.Code</b> has @Model.SubscriptionDiscount.UsesNumber uses remaining.
                    </h3>
                }
                else
                {
                    <div>
                        Enter a Discount Code:
                            <input type="text" name="SubscriptionDiscount" />
                    </div>
                }
            </div>
        </div>
        <div class="tab-pane fade" id="admin">
            <div class="row-fluid">
                <legend class="span12">Admin</legend>
                @{
                    using (Html.BeginForm("SetAffiliateAssignedToUser/" + @Model.ID, "Account", FormMethod.Post))
                    {
                        {
                    <div class="field fieldContainer">
                        <div class="span2">
                            <label for="ChangeAffiliate">
                                Affiliate:</label>
                        </div>
                        <div class="span9">
                            @Html.DropDownList("changeAffiliate", AppHelper.GetListOfAffiliates(Model.Affiliate.ID),
                                                   new { onchange = "this.form.submit();", style = "width:140px;" })
                        </div>
                    </div>
                        }
                    }
                    
                }
            </div>
        </div>
    </div>
    <div class="span12">

        <button class="btn btn-success " role="button" id="submitButton">Submit Updates</button>
    </div>

</div>



<div id="PassResetModal" class="modal hide fade">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h3>Password Reset</h3>
    </div>
    <div id="PassResetResult" class="modal-body">
        <p>Update security policies require that passwords be encrypted and visible to only the end-user. Clicking the reset button below will generate a new, random password and send it to the user's email address.</p>
    </div>
    <div class="modal-footer">
        <a href="#" id="cancelContinue" class="close" data-dismiss="modal" class="btn">Cancel</a>
        <a href="#" id="resetPassword" class="btn btn-danger">Reset Password</a>
    </div>
</div>
