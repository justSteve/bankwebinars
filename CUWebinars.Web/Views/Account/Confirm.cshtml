@model ChangeEmailFromKeyInputModel
           
@{
    ViewBag.Title = "Manage Account";
    var identity = ((ClaimsIdentity)User.Identity)
        .Claims.FirstOrDefault(c => c.Type == CUWebinars.Business.Constants.ClaimTypes.FullName);

    if (!ReferenceEquals(null, identity))
    {
        ViewBag.LoggedInUserIdentity = identity;
    }
}
           
<div id="LogInContainer" class="container">
    <div class="flat-form">

        <div id="myTabContent" class="tab-content">

            @using (Html.BeginForm("Confirm", "Account", "Post"))
            {
                @Html.AntiForgeryToken()
                
                <fieldset>
                    <legend>Verify Account</legend>
                    <div>
                        <p>Enter your password and click the confirm button.</p>

                        <p>@Html.LabelFor(m => m.Password, new { style="display:inline-block"})<text>: </text></p>
                        @Html.PasswordFor(m => m.Password)

                        @Html.HiddenFor(m => m.Key)

                        <div class="form-inline">

                            <div class="btn-group">
                                <input type="submit" value="Confirm" class="btn btn-default" />
                            </div>
                        </div>
                    </div>
                </fieldset>
            }

        </div>
    </div>
</div>