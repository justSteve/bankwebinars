@using CUWebinars.Web.Core
@model Order
@{
    GlobalConfig _globalConfig = GlobalConfig.GlobalConfigSingleton;

    var myRow = Model.OrderRows.Single(or => or.RowStatus == OrderRowStatus.Active);
    var newUserMsg = "<div class='span7'><p>" +
                    "An order confirmation email has been dispatched to " + Model.BillingEmail + " and includes " +
                     "complete details of your registration. </p></div>";
    if (!User.Identity.IsAuthenticated)
    {
        newUserMsg = "<div class='span7'><p>" +
                     "An order confirmation email has been dispatched to " + Model.BillingEmail + " and includes " +
                     "a link that will confirm your identity and activate this account. You will not be able " +
                     "to log into our website until visiting the link provided in that email. </p>" +
                     "<p>If you do not see our message in a timely fashion (and after checking your spam folder " +
                     "for a message from " + _globalConfig.TenantEmail + ") please contact Customer Service at 800-831-0678 ext. 703.</p></div>";
    }
}
<div id="LogInContainer" class="container">
    <div id="reset">

        <div class="legendImitator">Order for @myRow.Webinar.Title  Submitted</div>

        <div class="text-success"> <b>Your credit card transaction did not complete successfully. Our processor replied with this message:@ViewBag.Message"</b></div>

        <div class="row">
            @Html.Raw(newUserMsg)
        </div>
        <div id="OrderSummaryContainer">
            @Html.Partial("~/Views/Shared/Partials/_OrderSumUser.cshtml", Model)
        </div>

        <div id="FeedbackContainer" class="span6">
            <section>
                <h4>Feedback</h4>
                @{Html.RenderPartial("Partials/_CheckoutFeedback");}
            </section>
        </div>
    </div>
</div>
