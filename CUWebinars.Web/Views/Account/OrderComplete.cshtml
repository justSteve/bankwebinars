@using CUWebinars.Business.Constants
@using CUWebinars.Web.Core
@model Order
@{
    GlobalConfig _globalConfig = GlobalConfig.GlobalConfigSingleton;

    var myRow = Model.OrderRows.Single(or => or.RowStatus == OrderRowStatus.Active);
    var newUserMsg = "<div class='span7'><p>" +
                    "An order confirmation email has been dispatched to <b>" + Model.BillingEmail + "</b> and includes " +
                     "complete details of your registration. </p>";
    if (!User.Identity.IsAuthenticated && Model.Origin != DomainConstants.OriginExpress)
    {
        newUserMsg = "<div class='span7'><p>" +
                     "An order confirmation email has been dispatched to <b>" + Model.BillingEmail + "</b>.</p>" +
                     "<p>If you do not see our message in a timely fashion (and after checking your spam folder " +
                     "for a message from " + _globalConfig.TenantEmail + ") please contact Customer Service at that same address.</p>";
    }
    if (!User.Identity.IsAuthenticated && Model.Origin == DomainConstants.OriginExpress)
    {
        newUserMsg = "<div class='span7'><p>" +
                    "An order confirmation email has been dispatched to <b>" + Model.BillingEmail + "</b> and includes " +
                     "complete details of your registration. </p>";
    }

    var createdSeriesOrders = "";
    if (myRow.Order.UserComments != null && myRow.Order.UserComments.Contains("CheckoutMessage"))
    {
        //{"CheckoutMessage":"Child Orders are 153339,153340,153341"}
        var _temp = myRow.Order.UserComments.Replace("{ \"CheckoutMessage\":\"Child Orders are ", "");
            
        var _createdSeriesOrders = _temp.Split(',');
        createdSeriesOrders = " This order for a " + _createdSeriesOrders.Length + "-part series has created orders for each of the episodes: ";
        var i = "";

        foreach (var list in _createdSeriesOrders)
        {
            i += _globalConfig.TenantPrefix + list + ", ";
        }
        createdSeriesOrders += i.TrimEnd(' ');
        createdSeriesOrders += i.TrimEnd(',');
        createdSeriesOrders += ".";
        newUserMsg += "<p> " + createdSeriesOrders + "</p>";

    }

    newUserMsg += "</div>";

}
<div id="LogInContainer" class="container">
    <div id="reset">

        <div class="legendImitator">Order for @myRow.Webinar.Title  Submitted</div>

        <div class="text-success"> <b>Thank you for your order!</b></div>

        <div class="row">
            @Html.Raw(newUserMsg)
        </div>
        <div id="OrderSummaryContainer">
            @Html.Partial("~/Views/Shared/Partials/_OrderSumUser.cshtml", Model)
        </div>

        <div id="FeedbackContainer" class="span6">
            <section>
                <h4>Feedback</h4>
                @{Html.RenderPartial("Partials/_CheckoutFeedback");}
            </section>
        </div>
    </div>
</div>
