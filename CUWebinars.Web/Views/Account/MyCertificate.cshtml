@using System.Configuration
@using System.Linq
@using System.Web.Mvc.Html
@using CUWebinars.Business.Models
@using CUWebinars.Web.Core
@model CertOfCompletionViewModel

@*<title>*@
@{
    Layout = "";



    GlobalConfig _globalConfig = GlobalConfig.GlobalConfigSingleton;
    var myRow = from orderRow in Model.Order.OrderRows
                where orderRow.RowStatus == OrderRowStatus.Active
                select orderRow;
    var webinar = myRow.Single().Webinar;


    var Presenter = webinar.Presenter.WebUser.FullName;
    string DateTimeString = DateTimeHelper.FormatDate(webinar.Date);
    var background = "~/Content/img/CertificateBackground.jpg";
}

<html xmlns="http://www.w3.org/1999/xhtml">
@{
    <head>
        <script src="~/Scripts/jquery-1.11.1.min.js"></script>
        <script src="~/Scripts/bootstrap-modalmanager.js"></script>
        <script src="~/Scripts/bootstrap-modal.js"></script>
        <script src="~/Scripts/bootstrap.min.js"></script>
        <meta name="viewport" content="width=device-width" />
        <title></title>
        <link rel="stylesheet" type="text/css" href="~/Content/css/styleCrisp.css">
        <link rel="stylesheet" type="text/css" href="~/Content/css/bootstrap.css">
        <link rel="stylesheet" type="text/css" href="~/Content/css/bootstrap-modal.css">

        <style>
            p, h1, h2, h3 {
                color: black;
            }
        </style>
        <script language="javascript">
            $(function () {
                $('#myModal').modal('show');
            });
        </script>
    </head>

    <body>
        <div id="myModal" class="modal show fade">
            <form method="GET" action="/Account/MyCertificate">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h3>Certificate Generator</h3>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="orderID" value="@myRow.SingleOrDefault().idOrder" />
                    <div>Name to Display:</div>
                    <input type="text" name="displayName" value="Enter name to display here" />

                    <p>Refresh this page to enter a different name. </p>
                </div>
                <div class="modal-footer">
                    <a href="#" data-dismiss="modal" class="btn">Close & Print</a>
                    <input type="submit" value="Generate" id="ShowCertificate" class="btn btn-success pull-right" />
                </div>
            </form>
        </div>

        <div id="background" style="margin: auto; margin-top: 35px; width: 960px; height: 800px; background-image: url('/Content/img/CertificateBackground.jpg'); background-repeat: no-repeat;">

            <div style="padding: 120px; border: 1px; border-color: black; border-style: solid;" id="wrapper">
                <h2 style="text-align: center;">Total Training Solutions</h2>
                <p align="center">presents this</p>
                <h1 style="text-align: center; font-size: 34px;">Certificate of Completion</h1>
                <p align="center">to</p>
                <h2 align="center">
                    <b>@Model.DisplayName</b>
                </h2>

                <p align="center">for</p>
                <h3 align="center">
                    <br /><b>@webinar.Title</b>
                </h3>
                @{
                    if (_globalConfig.Tenant == "CUWebinars")
                    {
                        <p align="center">
                            1 Hour Webinar <br/>1.25 CE Credits
                        </p>
                    }
                    else
                    {
                        <p align="center">
                            @webinar.Duration.ToString().Replace(".00", "") Hour Webinar <br/>
                            @Model.CeuShort
                        </p>

                    }
}
                    <table align="center" cellpadding="0" cellspacing="0" width="600px" border="0">
                        <tbody>
                            <tr>
                                <td valign="top">
                                    <p align="left">
                                        Presented By: <br /><b>@Presenter</b>
                                    </p>
                                </td>
                                <td valign="top">
                                    <p align="right">@DateTimeString</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <br />
                </div>
            </div>
        </body>
                }
            </html>

