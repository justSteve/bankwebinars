@model ChangePasswordFromResetKeyInputModel
@{
    ViewBag.Title = "Change Password";
}

<div id="LogInContainer" class="container">
    <div class="flat-form">

        @using (Html.BeginForm("PasswordResetConfirm", "Account", new { returnUrl = "/Account/Login" }))
        {
            @Html.ValidationSummary("An error occurred; a new reset link is required. Send your email address with the subject 'Please reset [your address]' to support@ttstrain.com or use our Help & Feedback button (lower right corner) for immediate assistance.", new { id = "valSummaryResetPwdForm" })
            @Html.AntiForgeryToken()
            
            <fieldset>
                <legend>@ViewBag.Title</legend>

                @if(Model.ChangePasswordSucceeded)
                {
                    <p>You have successfully changed your password and can @Html.ActionLink("proceed to the Login Page", "Login").</p>
                }
                else 
                { 
                    @Html.EditorForModel()
                    <div>
                        <button id="submitNewPasswordButton" class="btn">Change Password</button>
                    </div>
                }
            </fieldset>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/reset-password-form")
}