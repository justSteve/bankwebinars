@using CUWebinars.Web.Core
@model ChangePasswordFromResetKeyInputModel
@{
    ViewBag.Title = "Change Password";
    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;
}
<style>
    .enterSubmit {
        font-size: large;
    }
</style>

<script type="text/javascript" language="javascript">
    $(function () {
        $('#PasswordBtn')
            .on('click',
                function (e) {
                    //handles submit and postback of /Account/ResetPasword

                    e.preventDefault();

                    var jsonPayload = { Password: $('#passwordAfterReset').val(), Email:  $('#Email1').val()};
                    console.log(jsonPayload);
                    $.ajax({
                        type: 'POST',
                        contentType: 'application/json; charset=utf-8',
                        cache: false,
                        url: "/Account/SignInFromReset",
                        dataType: 'json',
                        data: JSON.stringify(jsonPayload),
                        //headers: headers,
                        beforeSend: function () {
                            $('#ResetPasswordBtn').hide();
                            $('#resetMessage').html('<span class="label label-warning">&nbsp;<i class="icon-spinner icon-spin"></i>&nbsp;Working...</span>');
                        }
                    })
                        .done(function (data) {
                            //console.log(data);
                            if (data.Result === 'Success') {
                                $('#resetMessage')
                                    .html('<span class="label label-sucess"><i class="icon icon-thumbs-up"></i>&nbsp;&nbsp;Please find the new Reset Request email and click the included link.</span>');

                            } else {
                                if (data['Invalid'] === 'UserNotVerified') {
                                    L.clientLogger.error("#388 UserNotVerified ", { result: data && data.Result });

                                    $('#labelEmail')
                                        .html('<span class="label label-important">&nbsp;<i class="icon icon-exclamation-sign"></i>&nbsp;Connection Error #388. Email @globalConfig.TenantEmail.</span>');
                                } else if (data['Invalid'] === 'UnkownEmail') {
                                    L.clientLogger.error("UnknownEmail", { result: data && data.Result });

                                    $('#labelEmail')
                                        .html('<span class="label label-important">&nbsp;<i class="icon icon-exclamation-sign"></i>&nbsp;We do not have a record of that email address. Email @globalConfig.TenantEmail.</span>');
                                } else {
                                    L.clientLogger.error("Unknown error #454", { result: data && data.Result });
                                    $('#labelEmail')
                                        .html('<span class="label label-important">&nbsp;<i class="icon icon-exclamation-sign"></i>&nbsp;Error.Connection Error #454. Email @globalConfig.TenantEmail.</span>');
                                }
                            }
                        })
                        .fail(commonFuncs.failCallBack);
                });

        $('#ResetPasswordBtn')
            .on('click',
                function (e) {
                    //handles submit and postback of /Account/ResetPasword

                    e.preventDefault();

                    var jsonPayload = { email: $('#emailToReset').val()};
                    console.log(jsonPayload);
                    $.ajax({
                        type: 'POST',
                        contentType: 'application/json; charset=utf-8',
                        cache: false,
                        url: "/Account/ResetPassword",
                        dataType: 'json',
                        data: JSON.stringify(jsonPayload),
                        //headers: headers,
                        beforeSend: function () {
                            $('#ResetPasswordBtn').hide();
                            $('#resetMessage').html('<span class="label label-warning">&nbsp;<i class="icon-spinner icon-spin"></i>&nbsp;Working...</span>');
                        }
                    })
                        .done(function (data) {
                            //console.log(data);
                            if (data.Result === 'Success') {
                                $('#resetMessage')
                                    .html('<span class="label label-sucess"><i class="icon icon-thumbs-up"></i>&nbsp;&nbsp;Please find the new Reset Request email and click the included link.</span>');

                            } else {
                                if (data['Invalid'] === 'UserNotVerified') {
                                    L.clientLogger.error("#388 UserNotVerified ", { result: data && data.Result });

                                    $('#labelEmail')
                                        .html('<span class="label label-important">&nbsp;<i class="icon icon-exclamation-sign"></i>&nbsp;Connection Error #388. Email @globalConfig.TenantEmail.</span>');
                                } else if (data['Invalid'] === 'UnkownEmail') {
                                    L.clientLogger.error("UnknownEmail", { result: data && data.Result });

                                    $('#labelEmail')
                                        .html('<span class="label label-important">&nbsp;<i class="icon icon-exclamation-sign"></i>&nbsp;We do not have a record of that email address. Email @globalConfig.TenantEmail.</span>');
                                } else {
                                    L.clientLogger.error("Unknown error #454", { result: data && data.Result });
                                    $('#labelEmail')
                                        .html('<span class="label label-important">&nbsp;<i class="icon icon-exclamation-sign"></i>&nbsp;Error.Connection Error #454. Email @globalConfig.TenantEmail.</span>');
                                }
                            }
                        })
                        .fail(commonFuncs.failCallBack);
                });
    });
</script>
<div id="LogInContainer" class="container">
    <div class="flat-form">

        @using (Html.BeginForm("PasswordResetConfirm", "Account"))
        {
        @Html.ValidationSummary("An error occurred; ", new { id = "valSummaryResetPwdForm" })
        @Html.AntiForgeryToken()

        if (Model.ChangePasswordSucceeded)
        {

        <fieldset>

            <legend>You have successfully changed your password!</legend>
            <div style="display: none;" id="hadInProc"><span class="label label-success">&nbsp;<i class="icon icon-thumbs-up"></i>&nbsp; Password reset succeeded!</span><p>We've detected an <i> In Process </i> order in your cart. If you have that order open in another tab you can return there, enter your new password and complete the checkout. <a href="@globalConfig.TenantURL/Checkout">Or just click here to resume or cancel.</a> </p></div>
            <div style="display: none;"><span class="label label-success">&nbsp;Password reset succeeded!</span><p>We've detected an <i> In Process </i> order in your cart. If you have that order open in another tab you can return there, enter your new password and complete the checkout. <a href="@globalConfig.TenantURL/Checkout">Or just click here to resume or cancel.</a> </p></div>
            <div style="display: none;" id="hadNoneInProc"><i class="icon icon-thumbs-up"></i>&nbsp; You have successfully changed your password and can @Html.ActionLink("proceed to the Login Page", "Login").</div>



        </fieldset>
        }
        else
        {
        if (Model.Email == "Expired Key")
        {
        <fieldset>
            <legend>Expired Reset Link</legend>
            <div style="margin-bottom: 25px">
                <p id="resetMessage">
                    Please ensure you are clicking the most recent email with subject line: <b>Password Reset Request</b>.
                    If you are not receiving notifications from us it can be helpful to send an email to @globalConfig.TenantEmail with a subject line of "Test" and re-try the reset procedure.
                </p>
                <p>
                    Email to Reset: <input type="text" name="emailToReset" id="emailToReset" /><br />
                    <input id="ResetPasswordBtn" type="button" class="btn btn-mini btn-danger" name="resetPass" value="Send New Reset Request" />
                </p>
                <p>If you need immediate assistance, please contact us via our online chat (lower right corner of this page).</p>
            </div>

        </fieldset>
        }
        else
        {
        <fieldset>
            <legend>@ViewBag.Title</legend>
            @Html.EditorForModel()
            <input type="hidden" name="email" value="@Model.Email" />
            <div>
                <button id="submitNewPasswordButton" class="btn">Change Password</button>
            </div>
        </fieldset>
        }
        }
        }
    </div>
    @using (Html.BeginForm("SignInFromReset", "Account", FormMethod.Post, new {name = "frmSignInFR", id = "frmSignInFR", ReturnUrl = "/"}))
    {
    <input type="hidden" name="password" id="passwordFR" />
    <input type="hidden" name="email" id="emailFR" />
    }
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/reset-password-form")
}
