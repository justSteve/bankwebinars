@model ChangePasswordFromResetKeyInputModel
@{
    ViewBag.Title = "Change Password";
}

<div id="LogInContainer" class="container">
    <div class="flat-form">

        @using (Html.BeginForm("PasswordResetConfirm", "Account", new { returnUrl = "/Account/Login" }))
        {
            @Html.ValidationSummary("Please address the following issues in the form below, or call 800-831-0678 ext 706 for immediate assistance:", new { id = "valSummaryResetPwdForm" })
            @Html.AntiForgeryToken()
            
            <fieldset>
                <legend>@ViewBag.Title</legend>

                @if(Model.ChangePasswordSucceeded)
                {
                    <p>You have successfully changed your password.</p>
                    <p>You can now go the the @Html.ActionLink("Login", "Login") page to log in with your new password.</p>                          
                }
                else 
                { 
                    @Html.EditorForModel()
                    <div>
                        <button id="submitNewPasswordButton" class="btn">Change Password</button>
                    </div>
                }
            </fieldset>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/reset-password-form")
}