@model CreateUserConfirmedViewModel

@Styles.Render("~/Content/create-order-details")

<div id="addPasswordContainer" class="container">
    <div id="addPasswordDoneMessageContainer">

        @{
            if (string.IsNullOrWhiteSpace(Model.ScreenMessage) || Model.ScreenMessage.StartsWith("Thank you"))
            {
                using (Html.BeginForm("AddPasswordForCartCreatedUser", "Account", FormMethod.Post, new {id = "addPasswordForm"}))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary("Please address the following login errors: ", new {id = "addPwdValSummary"})

                    <fieldset>
                        <legend>Set Password Form</legend>

                        @if (Model.ScreenMessage.StartsWith("Thank you"))
                        {
                            <div>@Model.ScreenMessage</div>
                        }
                        
                        <div>Please choose a password that is hard to guess and is unique to this site.</div>
                        <div>&nbsp;</div>
                        @Html.HiddenFor(m => m.Email)
                        @Html.HiddenFor(m => m.OldPassword)

                        <div>
                            @Html.LabelFor(m => m.NewPassword)
                            @Html.PasswordFor(m => m.NewPassword)
                        </div>
                        <div>
                            @Html.LabelFor(m => m.ConfirmPassword)
                            @Html.PasswordFor(m => m.ConfirmPassword)
                        </div>
                        <input type="submit" value="Set password" class="btn btn-default" />
                        <div id="addPwdMsgLabelWrap" style="display: inline-block"></div>
                    </fieldset>
                }
            }
            else
            {
                <div class="legendImitator">Password Already Initialized</div>
                @Html.Raw(@Model.ScreenMessage)
            }

            <div>Your order details are as follows</div>
            @Html.Partial("~/Views/Shared/Partials/_OrderSumUser.cshtml", Model.Order)
        }

    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/add-password")
}