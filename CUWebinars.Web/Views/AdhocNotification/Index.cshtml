@model AdhocNotificationViewModel

@{
    ViewBag.Title = "Send Ad Hoc Notification";
}

<section>
    <div style="width: 1100px; margin: 30px auto">
        <h2>Ad-hoc Notifications</h2>
        
        @using (Html.BeginForm("Index", "AdhocNotification", FormMethod.Post, new { id="AdhocNotificationForm", @class = "form-horizontal " }))
        {

            <div class="control-group">
                <label class="control-label" for="inputEmail">Webinars</label>
                <div class="controls">
                    @Html.DropDownListFor(m => m.SelectedUpcomingWebinarId, new SelectList(Model.Webinars, "Value", "Text"), "Choose an Upcoming Webinar", new {@class = "input-xlarge"})
                </div>
            </div>
            <div id ="RegTypesCheckBoxes" class="control-group">
                <label class="control-label" for="inputEmail">Reg Types</label>
                <div class="controls">
                    @*@Html.DropDownListFor(m => m.SelectedUpcomingWebinarId, new SelectList(Model.Webinars, "Value", "Text"), "Choose an Upcoming Webinar", new {@class = "input-xlarge"})*@
                </div>
            </div>

        }
    </div>
</section>


@section Scripts {
    <script src="@Url.Content("~/Scripts/app/notification-ops/adhoc-notifications.js")"></script>

}