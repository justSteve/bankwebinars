@using CUWebinars.Web.Core
@model Order

@{
    ViewBag.Title = "Email for Billing";

    Layout = "~/Views/Shared/_LayoutPublic.cshtml";


    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;
}

<div class="hero-unit">
    <div id="webinarTitle" class="container">
        <div class="span10">
            <h2>Billing Email</h2>
        </div>
    </div>
</div>
<!--close hero-unit-->

<div class="container clearfix" id="main-content">
    <!--begin main content-->

    @using (Html.BeginForm("AddBillingEmail", "Order", FormMethod.Post))
    {
        <div>Please enter the email to invoice for @globalConfig.TenantPrefix@Model.idOrder</div>
        <input type="text" name="addThisEmailAsBilling" id="addThisEmailAsBilling" placeholder="Please enter the desired email." />
        <input type="hidden" name="idOrder" id="idOrder" value="@Model.idOrder" /><br />
        <input class="btn" type="submit" value="Submit" />
    }
    <div id="response"></div>
</div>