@using CUWebinars.Business.Constants
@using CUWebinars.Business.Core.Helpers
@using CUWebinars.Web.Core
@using Newtonsoft.Json.Linq
@model Order
<script language="javascript" src="~\Scripts/app/mywebinars/share-notis.js" type="text/javascript"></script>

<div class="hero-unit">
    <div id="webinarTitle" class="container">
        <div class="span10">
            <h2>Billing Email</h2>
        </div>
    </div>
</div>
@{
    ViewBag.Title = "Email for Billing";

    Layout = "~/Views/Shared/_LayoutPublic.cshtml";

    <div class="container clearfix" id="main-content">
        <!--begin main content-->
        <div class="row-fluid">
            <div class="span6 offset2">
                <aside class="widget">
                    <h5 class="short_headline"><span>Add Email To Invoice Notifications</span></h5>

                    <input type="hidden" value="@Model.idOrder" name="idOrder" />
                    <div id="ShareContainer" style="padding: 12px;" class="well-large">
                        <section>
                            <div style="font-size: small;">
                                @{
                                    using (Html.BeginForm("AddBillingEmail", "Order", FormMethod.Post, new { id = "shareInfoForm_" + Model.idOrder, @class = "form-horizontal" }))
                                    {
                                        <span class="input-append">
                                            <input type="text" id="getEmail" placeholder="Email Address" class="span9" name="addresses" />
                                            <input type="hidden" value="@Model.idOrder" name="idOrder" />
                                            <input type="hidden" value="/Order/AddBillingEmail" class="source" />

                                            <button id="submitThis_@Model.idOrder" class="submitThis btn btn-primary">Send</button>
                                        </span>
                                        <div id="caption" style="text-align: center;">
                                            Enter the email you would like to share billing notifications with.
                                        </div>
                                    }
                                }
                            </div>
                        </section>
                    </div>
                </aside>
            </div>
        </div>
    </div>

}


