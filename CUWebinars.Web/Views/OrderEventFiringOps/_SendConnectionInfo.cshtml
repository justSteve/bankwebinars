@model AdhocNotificationViewModel

<div class="control-group">
    <label class="control-label" for="inputEmail">Webinars</label>
    <div class="controls">
        @Html.DropDownListFor(m => m.SelectedUpcomingWebinarId, new SelectList(Model.Webinars, "Value", "Text"), "Choose an Upcoming Webinar", new { @class = "input-xlarge" })
    </div>
</div>
<div class="control-group">
    <div class="controls">
        <button id="GetSendConnectionInfoRecipientsButton" class="btn">Get Recipients</button>
    </div>
</div>
<div id="EmailInputAndFireEventButton"></div>
