@model ManageOrderEditModel
@{
    ViewBag.Test = "";
}
<style type="text/css">
    div.addLocsBox {
        background-color: #ddd;
        padding: 5px;
        -ms-border-radius: 6px;
        border-radius: 6px;
        margin-top: 10px;
    }
</style>

@{
    ViewBag.Title = "Edit Order";
}

<div class="container">
    <div class="row">
        <div class="legendImitator">
            Edit Order
            <div class="pull-right">
                <button id="byUser" type="button" class="btn btn-success btn-small" data-toggle="collapse" data-target="#byUserWrapper">Show Orders By This User</button>
                <input type="text" style="width: 75px; margin-top: 8px;" id="orderIdInput" value="@Model.Id" />
                <button id="getOrderButton" class="btn">Lookup Order</button>
            </div>
        </div>
        <div id="byUserWrapper" class="collapse">
            @Html.Partial("~/Views/Admin/Partials/_ShowOrdersByUser.cshtml", Model)
        </div>

        <div id="manageOrderWrapper span7">
            <div style="padding: 0;" id="orderRelatedFields">
                <h4 id="webinarHeading">@Model.Order.OrderRows.FirstOrDefault().Webinar.Title - @Model.Order.OrderRows.FirstOrDefault().Webinar.Date.ToShortDateString() @Model.Order.OrderRows.FirstOrDefault().Webinar.Date.ToShortTimeString()</h4>
                @Html.Partial("~/Views/Admin/Home/_OrderEditDetails.cshtml", Model)
            </div>
        </div>



    </div>
</div>
@section scripts {
    @Scripts.Render("~/bundles/manage-order-from-details")
    <script src="@Url.Content("~/Scripts/app/notification-ops/order-event-notifications.js")"></script>
    <script src="@Url.Content("~/Scripts/app/notification-ops/membership-notifications.js")"></script>
    <script src="@Url.Content("~/Scripts/app/ToastLogger.js")"></script>
}

<script src="@Url.Content("~/Scripts/app/notification-ops/details-event-webpart.js")"></script>
@Styles.Render("~/Content/manage-order-styles")