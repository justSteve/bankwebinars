@using CUWebinars.Business.Constants
@using FluentDate
@using FluentDateTime
@using CUWebinars.Web.ViewModel

@using Newtonsoft.Json

@model CUWebinars.Business.Notification.ViewModel.WebinarPromoViewModel


@{

    var promoEvent = Model.Webinar;

    Layout = "/Views/Shared/_LayoutAdmin.cshtml";
    if (Model.Affiliates.Count < 2)
    {
        Layout = "/Views/Shared/_LayoutAffiliate.cshtml";
    }
    string wDate = "<b>" + DateTimeHelper.FormatDate(Model.Webinar.Date) + "</b> &nbsp;";
    wDate = wDate + DateTimeHelper.FormatTimeWithDuration(Model.Webinar.Date, Model.TimeZone, false, Model.Webinar.Duration);

    ViewBag.Title = "Generate Promo Emails - Reminders" + promoEvent.Title;

    //var minDay = 1.Days().Since(DomainConstants.BuildUtcNowAsCts);
    //var maxDay = DomainConstants.BuildUtcNowAsCts.NextMonth();

    bool hasAffiliates = Model.Affiliates.Count > 1;
    bool isAffiliateRestricted = Model.Affiliate != null;

    if (hasAffiliates != true)
    {
        <script language="javascript" type="text/javascript">

            var currentUserId = @Model.Affiliate.idUserAff + 0;
            var webinarId = @Model.Webinar.idWebinar;

        </script>
    }
}

@Scripts.Render("~/bundles/wijmo-editor-scripts")
