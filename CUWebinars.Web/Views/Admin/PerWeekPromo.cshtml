@* vertical tab layout based on http://tutsme-webdesign.info/tutorials/navs/pills_stacked_panesright.html*@
@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "mailer", @class = "form-inline form-promo-generater" }))
{
    <div class="container-admin">
        @*<div align="right">
                <input type="button" id="GenButton" onclick="javascript: GetWeekly();" value="Gen Multiple Events" />
            </div>*@
        <h2>
            @Model.Webinar.Title
        </h2>
        <p>
            @Model.Webinar.Presenter.WebUser.FullName &nbsp;
            @Html.Raw(wDate)
        </p>

        <div class="row-fluid">
            <div class="span2" style="height:98%; overflow: auto;">
                <ul class="nav nav-pills nav-stacked" style="margin: 0; padding: 0;">
                    <li class="active"><a href="#tab_Master" data-toggle="pill" data-link-affid="0">MASTER</a></li>
                    @foreach (var aff in Model.Affiliates)
                    {
                        <li><a href="#tab_@aff.idUserAff" data-toggle="pill" data-link-affid="@aff.idUserAff">@aff.ttsDomain - @aff.idUserAff</a></li>
                    }
                </ul>
            </div>

            <div class="span10">
                <div class="tab-content">
                    <div class="tab-pane active" id="tab_Master" data-pane-affid="0">
                        <h4 class="float-right">Master Markup</h4>
                        <p>
                            @Html.HiddenFor(m => m.TemplateType)
                            @Html.HiddenFor(m => m.Webinar.idWebinar)
                            @Html.HiddenFor(m => m.Webinar.Title)

                            <input type="button" id="resetAllAffiliates" class="button btn btn-small" value="Reset All Affiliates" />
                            <label for="SendDate">Send date:</label>@Html.TextBoxFor(m => m.SendDate, "{0:MM/dd/yyyy}", new { @class = "input", type = "date" })
                            <button id="submitGenPromoTexts" class="button btn btn-success btn-small">Generate Master Markup</button>

                        </p>
                        <p>
                            <textarea id="editor_0" name="editor_0" style="display: none;"></textarea>
                        </p>
                    </div>

                    @foreach (var aff in Model.Affiliates)
                    {
                        // create a "tab" for each Affiliate to hold affiliate-specific stuff
                        <div class="tab-pane" id="tab_@aff.idUserAff" data-pane-affid="@aff.idUserAff">
                            <h4 class="float-right">@aff.ttsDomain.ToUpper() Markup</h4>
                            <p>
                                <input type="button" class="button btn btn-small reset-to-master" value="Reset to Master" />
                                <input type="button" class="button btn btn-small copy-markup" value="Copy to Clipboard" />
                                @Html.TextBox("SendToList_" + @aff.idUserAff, "", new { @class = "input" })
                                <input type="button" class="button btn btn-small send-to-affiliate" value="Send" />
                                <button class="button btn btn-small write-markup-to-storage">Save</button>
                            </p>
                            <p>
                                <textarea id="editor_@aff.idUserAff" name="editor_@aff.idUserAff" style="display: none;"></textarea>
                            </p>
                        </div>
                    }

                    <!-- the following items always show below the Affiliate-specific content above -->
                    <p>
                        <textarea id="editorTA" name="editorTA" style="width:98%; height:90%; margin:0; padding: 0;"></textarea>
                        <div><input type="button" class="button btn btn-small copy-markup" value="Copy to Clipboard" /></div>
                        <textarea id="copyToClipboard" class="disabled" style="width:98%; height:60px; margin:10px 0 0 0; padding: 5px;"></textarea>
                    </p>

                </div><!-- tab content -->
            </div>
        </div><!-- row-fluid -->
    </div>
}

