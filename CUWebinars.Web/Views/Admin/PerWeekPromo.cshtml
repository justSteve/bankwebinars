@using CUWebinars.Business.Constants
@using FluentDate
@using FluentDateTime
@using CUWebinars.Web.ViewModel

@using Newtonsoft.Json

@model CUWebinars.Business.Notification.ViewModel.WebinarPromoViewModel

@{

    //a.      Need an option to select past events
    //i.     E.g. sending 5 most popular webinars from previous month
    //b.      Can’t see the webinar date
    //i.     E.g. sending webinars for a given week, would need to know dates
    //c.      The scroll arrows don’t work when you click them
    //d.      Can you update the default text color of “This Week's Featured Events!” to #000000?
    var promoEvent = Model.Webinar;
    Layout = "/Views/Shared/_LayoutAdmin.cshtml";

    string wDate = "<b>" + DateTimeHelper.FormatDate(Model.Webinar.Date) + "</b> &nbsp;";
    wDate = wDate + DateTimeHelper.FormatTimeWithDuration(Model.Webinar.Date, Model.TimeZone, false, Model.Webinar.Duration);

    ViewBag.Title = "Generate Promo Emails - Daily" + promoEvent.Title;

    //var minDay = 1.Days().Since(DomainConstants.BuildUtcNowAsCts);
    //var maxDay = DomainConstants.BuildUtcNowAsCts.NextMonth();

    bool hasAffiliates = Model.Affiliates.Count > 0;
    bool isAffiliateRestricted = Model.Affiliate != null;
}

<link type="text/css" href="~/Scripts/WijmoEditor/Themes/arctic/jquery-wijmo.css" rel="stylesheet" />
@Scripts.Render("~/bundles/wijmo-editor-scripts")
<link type="text/css" href="~/Scripts/WijmoEditor/Themes/arctic/jquery-wijmo.css" rel="stylesheet" />
@Styles.Render("~/bundles/wijmo-editor-styles")


<script id="scriptInit" type="text/javascript">
        @{
            var affDTO = (from Affiliate a in Model.Affiliates
                          select new
        {
                    ttsDomain = a.ttsDomain,
            idUserAff = a.idUserAff,
            EmailBanner = a.EmailBanner,
            ContactPerson = a.ContactPerson,
            ContactEmail = a.ContactEmail,
            ContactPhone = a.ContactPhone,
            EmailFooter = a.EmailFooter.Trim()
        }).ToList();
           
    }
    var valOfStatus = "@Model.Webinar.Status";
    var _subject = "ANNOUNCING: @Model.Webinar.Title";
    var affs = @Html.Raw(Json.Encode(affDTO));

    $(document)
        .ready(function() {
            $("#editorTA")
                .wijeditor({
                    // editorMode: "split" // can default to split view if they want
                    textChanged: function(e, data) { // Set textChanged event handler function
                        SetCopyToClipboardTextArea(false);
                    }
                });
        });
</script>

@*figure out how to get the calendar working*@
<script src="/Scripts/fullcalendar/fullcalendar.js" type="text/javascript"></script>
<link href="/Scripts/fullcalendar/fullcalendar.css" rel="stylesheet" type="text/css" />


@* vertical tab layout based on http://tutsme-webdesign.info/tutorials/navs/pills_stacked_panesright.html*@
@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "mailer", @class = "form-inline form-promo-generater" }))
{
    <div class="container-admin">
        @*<div align="right">
                <input type="button" id="GenButton" onclick="javascript: GetWeekly();" value="Gen Multiple Events" />
            </div>*@
        <h2>
            @Model.Webinar.Title
        </h2>
        <p>
            @Model.Webinar.Presenter.WebUser.FullName &nbsp;
            @Html.Raw(wDate)
        </p>

        <div class="row-fluid">
            <div class="span2" style="height:98%; overflow: auto;">
                <ul class="nav nav-pills nav-stacked" style="margin: 0; padding: 0;">
                    <li class="active"><a href="#tab_Master" data-toggle="pill" data-link-affid="0">MASTER</a></li>
                    @foreach (var aff in Model.Affiliates)
                    {
                        <li><a href="#tab_@aff.idUserAff" data-toggle="pill" data-link-affid="@aff.idUserAff">@aff.ttsDomain - @aff.idUserAff</a></li>
                    }
                </ul>
            </div>

            <div class="span10">
                <div class="tab-content">
                    <div class="tab-pane active" id="tab_Master" data-pane-affid="0">
                        <h4 class="float-right"><button type="button" class="btn  btn-info setStatusBtn" id="setStatusBtn_@Model.Webinar.idWebinar" name="setStatusBtn">Set to Draft</button></h4>
                        <p>
                            @Html.HiddenFor(m => m.TemplateType)
                            @Html.HiddenFor(m => m.Webinar.idWebinar)
                            @Html.HiddenFor(m => m.Webinar.Title)

                            <input type="button" id="resetAllAffiliates" class="button btn btn-small" value="Reset All Affiliates" />
                            <label for="SendDate">Send date:</label>@Html.TextBoxFor(m => m.SendDate, "{0:MM/dd/yyyy}", new { @class = "input", type = "date" })
                            <button id="submitGenPromoTexts" class="button btn btn-success btn-small">Generate Master Markup</button>
                            @if (hasAffiliates)
                            {
                                <button id="writeAllAffMarkupToStorage" class="button btn btn-small">Save@(isAffiliateRestricted ? " Affiliate" : " All")</button>

                                <button id="sendAll" class="button btn btn-small">Send@(isAffiliateRestricted ? " Affiliate" : " All")</button>
                            }
                        </p>
                        <p>
                            <textarea id="editor_0" name="editor_0" style="display: none;"></textarea>
                        </p>
                    </div>

                    @foreach (var aff in Model.Affiliates)
                    {
                        // create a "tab" for each Affiliate to hold affiliate-specific stuff
                        <div class="tab-pane" id="tab_@aff.idUserAff" data-pane-affid="@aff.idUserAff">
                            <h4 class="float-right">@aff.ttsDomain.ToUpper() Markup</h4>
                            <p>
                                <input type="button" class="button btn btn-small reset-to-master" value="Reset to Master" />
                                <input type="button" class="button btn btn-small copy-markup" value="Copy to Clipboard" />
                                @Html.TextBox("SendToList_" + @aff.idUserAff, "", new { @class = "input" })
                                <input type="button" class="button btn btn-small send-to-affiliate" value="Send" />
                                <button class="button btn btn-small write-markup-to-storage">Save</button>
                            </p>
                            <p>
                                <textarea id="editor_@aff.idUserAff" name="editor_@aff.idUserAff" style="display: none;"></textarea>
                            </p>
                        </div>
                    }

                    <!-- the following items always show below the Affiliate-specific content above -->
                    <p>
                        <textarea id="editorTA" name="editorTA" style="width:98%; height:90%; margin:0; padding: 0;"></textarea>
                        <div><input type="button" class="button btn btn-small copy-markup" value="Copy to Clipboard" /></div>
                        <textarea id="copyToClipboard" class="disabled" style="width:98%; height:60px; margin:10px 0 0 0; padding: 5px;"></textarea>
                    </p>

                </div><!-- tab content -->
            </div>
        </div><!-- row-fluid -->
    </div>
}

