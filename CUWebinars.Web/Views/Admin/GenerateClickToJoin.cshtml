@model GenerateClickToJoinViewModel

@{
    ViewBag.Title = "Generate Click to Join Address for Ad Hoc Caller";
}

<div id="mainContentWrap" class="container bufferBottom30">


    <div class="legendImitator">Generate Click to Join</div>

    @using (Html.BeginForm("GenerateClickToJoinForAdHocCaller", "Admin", FormMethod.Post, new { id = "clickToJoinForm", @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="text text-info" style="margin-left: 30px;">Please enter either an Order Id <strong>OR </strong>the email address of the caller plus the Webinarid</div><br />
            <div class="control-group">
                @Html.LabelFor(m => m.OrderId, new { @class = "control-label" })
                <div class="controls">
                    @Html.EditorFor(m => m.OrderId)
                </div>
            </div>
        </div>
        <div class=" row">

            <div class="controls">
                OR
            </div>

        </div>
        <div class="row">
            <div class="control-group">
                @Html.LabelFor(m => m.Email, new { @class = "control-label" })
                <div class="controls">
                    @Html.EditorFor(m => m.Email)
                </div>
            </div>
        </div>
    <div class="control-group">
        <label class="control-label" for="inputEmail">Webinars</label>
        <div class="controls">
            @Html.DropDownListFor(m => m.SelectedWebinarId, new SelectList(Model.Webinars, "Value", "Text"), new { @class = "input-xlarge" })
        </div>
    </div>
        <div class=" row">
            <div class="control-group">
                <div class="control-group">
                    <div class="controls">
                        <button id="genClickToJoinCodeButton" class="btn">Generate Code</button>

                        <h2 id="accessCode" class="text text-info"></h2>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

@Scripts.Render("~/bundles/click-to-join")