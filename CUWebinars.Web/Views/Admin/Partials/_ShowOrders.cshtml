@model ShowOrdersViewModel

@{
    ViewBag.Title = "Orders";
}

<div class="legendImitator">Display Orders</div>
@Styles.Render("~/Content/data-tables")
<table id="ordersTable" class="table table-striped table-bordered dataTable no-footer" cellspacing="0" width="100%">
    <thead>
        <tr>
            <th>OrderId</th>
            <th>Last, First</th>
            <th>Institution</th>
            <th>Phone</th>
            <th>Email</th>
        </tr>
    </thead>

    <tfoot>
        <tr>
            <th>OrderId</th>
            <th>Last, First</th>
            <th>Institution</th>
            <th>Phone</th>
            <th>Email</th>
        </tr>
    </tfoot>
</table>

<div id="webinarIdDiv" class="initialHide">@Model.Webinar.idWebinar</div>
