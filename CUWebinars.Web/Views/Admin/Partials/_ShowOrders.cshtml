@model ShowOrdersViewModel

@{
    ViewBag.Title = "Orders";

    if (Model.Affiliate != null && !Model.UserIsAdmin)
    {
        <script type="text/javascript">
            if (DISPLAYORDERS === null || typeof DISPLAYORDERS === 'undefined') {var DISPLAYORDERS = {};}var DO = DISPLAYORDERS;DO.affiliateId = @Model.Affiliate.idUserAff;

        </script>
    }
    //OrderStatus enum
    //Error = 0,
    //InProcess = 1,
    //Submitted = 2,
    //Billed = 3,
    //Paid = 4,
    //Abandoned = 5,
    //Canceled = 6,
    //AwaitingVerification = 7,
    //Unknown = 255

    var showAffColumn = Model.UserIsAdmin ? "true" : "false";
    //\Scripts\app\admin\display-orders.js
    // AdminController/
    <div class="btn-group pull-left" id="showAllOrders" data-toggle="buttons-radio">
        <button type="button" class="btn btn-info">All Orders</button>
        <button type="button" class="btn btn-info">Just This Event</button>
    </div>


    <div class="btn-group pull-right" id="includeOrders" data-toggle="buttons-checkbox">
        
        <button type="button" class="btn btn-primary">InProcess</button>
        <button type="button" class="btn btn-primary">Submitted</button>
        <button type="button" class="btn btn-primary">Billed</button>
        <button type="button" class="btn btn-primary">Paid</button>
        <button type="button" class="btn btn-primary">Pending</button>@*AwaitingConfirmation*@
        <button type="button" class="btn btn-info">Active</button>
        <button type="button" class="btn btn-info">Inactive</button>
    </div>
    <table data-aff="@showAffColumn" id="ordersTable" class="table table-striped table-bordered dataTable no-footer" cellspacing="0" width="100%">
        <thead>
            <tr>
                <th>Order</th>
                <th>User</th>
                <th>Institution</th>
                <th>Billing</th>
                @*<th>Discount</th>*@
                <th>Affiliate</th>
                <th>Order Date</th>
                <th>Status</th>
            </tr>
        </thead>
    </table>

    <div id="webinarIdDiv" class="initialHide">@Model.Webinar.idWebinar</div>
}
