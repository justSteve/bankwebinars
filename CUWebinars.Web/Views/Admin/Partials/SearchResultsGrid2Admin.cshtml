@model ShowOrdersViewModel

@{
    ViewBag.Title = "Orders";
    int idWebinar = 0;
    string searchTerm = "";
    if (Model.Webinar != null)
    {
        idWebinar = Model.Webinar.idWebinar;
    }

    if (Model.SearchTerm != null)
    {
        searchTerm = Model.SearchTerm;
    }

    if (Model.Affiliate != null && !Model.UserIsAdmin)
    {

        <script type="text/javascript">
            if (SHOWORDERS === null || typeof SHOWORDERS === 'undefined') {
                var SHOWORDERS = {};

            }
            var affiliateId = @Model.Affiliate.idUserAff;
            var showAffiliateColumn = false;
            var showWebinarColumn = true;
            var currentAffiliateId = affiliateId;
            var currentAffiliateDisplayTitle = "@Model.Affiliate.DisplayTitle";

            SHOWORDERS.affiliateId = @Model.Affiliate.idUserAff;
            SHOWORDERS.searchTerm = "@Model.SearchTerm";

        </script>
    }

    if (Model.UserIsAdmin)
    {
        Layout = "/Views/Shared/_LayoutAdmin.cshtml";

        <script type="text/javascript">


            if (SHOWORDERS === null || typeof SHOWORDERS === 'undefined') {
                var SHOWORDERS = {};

            }

            SHOWORDERS.affiliateId = 19;
            SHOWORDERS.searchTerm = "@Model.SearchTerm";
        </script>
    }


    <div id="filter-buttons" class="clearfix" style="margin-bottom:8px;">

        <div id="hdrCaption" style="position: absolute; color: white; font-size: larger; background-color: darkgray; padding: 10px;" class="classForHoverEffect pull-left"></div>
        <div class="btn-group pull-right" id="order-status-filter-container" data-toggle="buttons-checkbox">

            <button type="button" class="btn btn-primary btn-mini os-inactive" value="InProcess">In Process</button>
            <button type="button" class="btn btn-primary btn-mini os-active" value="Submitted">Submitted</button>
            <button type="button" class="btn btn-primary btn-mini os-active" value="Billed">Billed</button>
            <button type="button" class="btn btn-primary btn-mini os-active" value="Paid">Paid</button>
            <button type="button" class="btn btn-primary btn-mini os-inactive" value="AwaitingVerification">Pending</button>

            <button type="button" class="btn btn-info btn-mini os-active-group-control" value="Active">Active</button>
            <button type="button" class="btn btn-info btn-mini os-inactive-group-control" value="Inactive">Inactive</button>

        </div>
    </div>

    <table id="ordersTable" class="table table-striped table-bordered dataTable no-footer" cellspacing="0" width="100%">
        <thead>
            <tr>
                <th id="hdrOrder">Order</th>
                <th id="hdrUser">User</th>
                <th id="hdrWebinar">Webinar</th>
                <th id="hdrInstitution">Institution</th>
                <th id="hdrBilling">Billing</th>
                <th id="hdrAffiliate">Affiliate</th>
                <th id="hdrRoyalty">Royalty</th>
                <th id="hdrLinks">Order Date</th>
                <th id="hdrStatus">Status</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td colspan="2" class="dataTables_empty">Loading registrations list...</td>
            </tr>
        </tbody>

    </table>

    <div id="webinarIdDiv" class="hidden">@idWebinar</div>
    <div id="searchTermDiv" class="hidden">@searchTerm</div>
}
