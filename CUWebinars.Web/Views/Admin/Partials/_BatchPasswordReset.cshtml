@model BatchPasswordResetViewModel

<div class="span8">
    @using (Html.BeginForm("BatchPasswordReset", "Admin", FormMethod.Post, new { id = "BatchPasswordResetForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary("Server Error:", new { id = "batchPwdMigrateValSummary" })
        
        <fieldset>
            <legend id="ResetPassLegend">Reset Passwords by Batch</legend>

            <div class="row">
                @Html.LabelFor(m => m.UserEmails) 
                <textarea id="usersTextArea" rows="10" style="width:100%" autofocus></textarea><span id="PasswordResetStatus" style="color: green"></span>
                @Html.ValidationMessageFor(m => m.UserEmails)
            </div>
            <div class="row">
                <button id="ResetBatchButton" class="btn btn-default">Reset Passwords</button>
            </div>
        </fieldset>
    }
</div>

