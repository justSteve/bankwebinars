@model ShowOrdersViewModel
@{
    var total = Model.Orders.Sum(o => o.Total);
    var totalRoyalty = Model.Orders.Sum(o => o.OrderRows.SingleOrDefault(r => r.RowStatus == OrderRowStatus.Active).Royalty);
}
<div class="well well-large pull-right">
    Total Revenue = @total.ToString("C") <br />
    Total Royalty = @totalRoyalty.ToString("C")
</div>
<table id="royaltiesTable" class="table table-striped table-bordered dataTable no-footer" cellspacing="0" width="100%">

    @*{ 'data': 'idOrder', 'visible': false },
        { 'data': 'LastName' },
        { 'data': 'RegistrationTypeString' },
        { 'data': 'Royalty' },
        { 'data': 'OrderDate' }
        ],*@
    <thead>
    <tr>
        <th id="hdrOrder"><br/><br/>Order</th>
        <th id="hdrUser">User</th>
        <th id="hdrBilling">Billing</th>
        <th id="hdrRoyalty" style="text-align: right;">Royalty</th>
        <th id="hdrLinks">Order Date</th>
    </tr>
    </thead>
    <tbody>
        <tr>
            <td colspan="2" class="dataTables_empty">Loading list...</td>
        </tr>
    </tbody>
    <tfoot>
        <tr>
            <th id="ftrOrder"><br /><br />Order</th>
            <th id="ftrUser">User</th>
            <th id="ftrBilling">Billing</th>
            <th id="ftrRoyalty">Royalty</th>
            <th id="ftrLinks">Order Date</th>
        </tr>
    </tfoot>

</table>
<div id="webinarIdDiv" class="initialHide">@Model.Webinar.idWebinar</div>

