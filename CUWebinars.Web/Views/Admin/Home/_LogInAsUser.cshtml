@model LogInAsOtherUserViewModel

@{
    Layout = null;
}

<div class="span8">
    
    @Html.ValidationSummary("There was a problem with user impersonation: ", new { id = "registerValidationSummary" })

    @using (Html.BeginForm("LogInAsUser", "Admin", FormMethod.Post, new { id = "LogInAsUserForm", target = "_blank" }))
    {
        @Html.AntiForgeryToken()

        <fieldset>
            <legend id="ResetPassLegend">Impersonate User</legend>

            <div>
                @Html.LabelFor(l => l.Email)
                @Html.TextBoxFor(t => t.Email)
                @Html.ValidationMessageFor(m => m.Email)
            </div>
            <div>
                @Html.LabelFor(l => l.Password)
                @Html.PasswordFor(t => t.Password)
                @Html.ValidationMessageFor(m => m.Password)
            </div>
            <div>
                <input id="LogInAsOtherUserButton" class="btn btn-default" type="submit" value="Log in As User" /><span id="LogInAttemptStatus" style="color: green"></span>
            </div>
        </fieldset>
    }

    <div id="OperationMessage"></div>
</div>

