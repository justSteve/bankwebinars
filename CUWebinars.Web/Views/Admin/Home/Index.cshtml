<style>
    .nav-tabs > .active > a, .nav-tabs > .active > a:hover, .nav-tabs > .active > a:focus {
        background-color: #555555;
        color: white;
    }

    .nav-tabs {
        border-bottom: 2px solid darkgray;
    }
</style>

<div id="div4Webinars" class="container">

    <ul class="nav nav-tabs">
        <li class="active"><a href="#webinars" data-toggle="tab">Webinars</a></li>
        <li><a href="#account" data-toggle="tab">Settings</a></li>
        <li><a href="#reports" data-toggle="tab">Invoices</a></li>
        <li><a href="#subscriptions" data-toggle="tab">Subscriptions</a></li>
        <li><a href="#CompliancePerspectives" data-toggle="tab">Compliance Perspectives</a></li>
    </ul>


    <div class="tab-content" id="mywebinars">
        <div class="tab-pane active" id="webinars">
            @{ Html.RenderPartial("Admin/_Webinars"); }
        </div>
        <div class="tab-pane " id="account">
            @{ Html.RenderPartial("Partials/_AffAccount", Model.AffiliateSettingsViewModel);}
        </div>
        <div class="tab-pane" id="reports">
            @{ Html.RenderPartial("Admin/_Reports", Model.InvoicesModel); }

        </div>
        <div class="tab-pane" id="subscriptions">
            @{ Html.RenderPartial("Admin/_Subscriptions", Model.WpsViewModel); }
        </div>
        <div class="tab-pane" id="CompliancePerspectives">
            @{ Html.RenderPartial("Admin/_SubscriptionsCP", Model.CompPersSubscriptionsModel); }

        </div>
    </div>
</div>
