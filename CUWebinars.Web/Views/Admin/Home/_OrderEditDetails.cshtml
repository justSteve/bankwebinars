@using System.Activities.Statements
@using Ninject
@model ManageOrderEditModel
@{

    var myRow = Model.Order.OrderRows.Single(or => or.RowStatus == OrderRowStatus.Active);
}

@using (Html.BeginForm("ManageOrder", "Admin", FormMethod.Post, new { id = "manageOrderForm" }))
{
    @Html.ValidationSummary("There have been some errors:", new { id = "manageOrderFormValSummary" })

    @Html.AntiForgeryToken()
    <div class="row navbar">
        <div class="span6 navbar-inner">
            <ul class="nav" aria-labelledby="dLabel">
                <li><a tabindex="-1" href="#" onclick="payByCC(); return true;" role="button" data-toggle="modal">Submit Payment</a></li>
                <li><a tabindex="-1" href="#changeAssignedUser" role="button" data-toggle="modal">Assign to Different User</a></li>
                <li><a tabindex="-1" href="#changeAssignedAffiliate" role="button" data-toggle="modal">Credited to @Model.AffiliateName Change?</a></li>
            </ul>
        </div>
        <div class="span2">
            Origin: @Model.Order.Origin
            <br />
            Affiliate: @Model.Order.idAffiliate
        </div>
    </div>
    <div class="row">
        <div id="UserSummaryPanel" class="well span3">
            <div class="control-group">
                <div class="controls">
                    @Html.ActionLink("Edit?", "edituser", "account", new { id = @Model.UserId, returnUrl = "/Admin/ManageOrder/" + Model.Id }, new { @class = "btn  btn-mini pull-right" })
                    @Html.TextBoxFor(m => m.WebUser.email, new { id = "UserEmail", disabled = "disabled" }) @*read-only*@
                    @Html.TextBoxFor(m => m.WebUser.FullName, new { id = "FullName", disabled = "disabled" }) @*read-only*@
                    @Html.TextBoxFor(m => m.PhoneNumber, new { id = "Phone", disabled = "disabled" }) @*read-only*@
                </div>
            </div>
        </div>
        <div id="pricingSummaryPanel" class="span3">
            <div class="control-group">
                <label class="control-label" for="DisplayRowPriceViewModel_PricesAndDiscounts_UnitPrice">Base Price:</label>
                <div class="controls">
                    @Html.TextBoxFor(m => m.DisplayRowPriceViewModel.PricesAndDiscounts.UnitPrice, new { id = "UnitPriceText", disabled = "disabled" }) @*read-only*@
                    @Html.HiddenFor(m => m.DisplayRowPriceViewModel.PricesAndDiscounts.UnitPrice) @* Required for POST. TextBoxFor won't ModelBind *@
                </div>
            </div>
            <div class="control-group">
                @Html.TextBoxFor(m => m.DisplayRowPriceViewModel.Discount.DiscountCode, new { placeholder = "Enter discount code ", @class = "input input-small" })
                <button id="applyDiscountButton" class="btn btn-default">Apply code</button>

                <div class="controls">
                    @Html.TextBoxFor(m => m.DisplayRowPriceViewModel.PricesAndDiscounts.TotalDiscount, new { id = "TotalDiscountText", disabled = "disabled" }) @*read-only*@
                    @Html.HiddenFor(m => m.DisplayRowPriceViewModel.PricesAndDiscounts.TotalDiscount) @* Required for POST. TextBoxFor won't ModelBind *@
                </div>
            </div>

            <div class="control-group">
                <label class="control-label" for="DisplayRowPriceViewModel_PricesAndDiscounts_TotalOrderPrice">Total Order Price:</label>
                <div class="controls">
                    @Html.TextBoxFor(m => m.DisplayRowPriceViewModel.PricesAndDiscounts.TotalOrderPrice, new { id = "TotalOrderPriceText", disabled = "disabled" }) @*read-only*@
                    @Html.HiddenFor(m => m.DisplayRowPriceViewModel.PricesAndDiscounts.TotalOrderPrice) @* Required for POST. TextBoxFor won't ModelBind *@
                </div>
            </div>
        </div>
        <div class="span3">
            <div id="StatusWrapper">
                <div>
                    <span>Order Status: </span><strong>@Model.DisplayRowPriceViewModel.OrderStatus.ToString()</strong>
                </div>
            </div>

            <div id="regTypeSelectWrapper">
                <div>
                    <label for="RegType">Change Registration Type:</label>
                    @Html.Partial("~/Views/Cart/Partials/_DisplayOptionsInDropDown.cshtml", Model.DisplayOptionsInDropDownViewModel)
                </div>
            </div>
            <div id="postEventClaim">
                @if (Model.PostEventAccessExpires < DateTime.Now)
                {
                    <label for="PostEventAccess">Access to PostEvent Materials:</label>
                    <input type="text" placeholder="Extend Access" /><a tabindex="-1" href="#ExtendPostEventAccessModal" class="btn btn-mini" role="button" data-toggle="modal">Extend Access</a>
                }
                else
                {
                    <label for="PostEvent">Post Event Expires:</label>
                    @Model.PostEventAccessExpires.ToShortDateString()
                    <a tabindex="-1" href="#ExtendPostEventAccessModal" class="btn btn-mini" role="button" data-toggle="modal">Extend Access</a>

                }
            </div>
        </div>
    </div>
    <div class="row">

        <div class="addLocsPanel span4">
            <div class="control-group">
                <div class="controls">
                    There are <span id="nrAddLocs">@Model.NumberOfAdditionalLocations</span> Additional Locations for this order.
                    @{
                        if (Model.AdditionalLocationsAvailableOnLoad)
                        {
                            <button id="addLocationsButton" class="btn btn-default btn-small">add more?</button>
                        }
                        else
                        {
                            <button id="addLocationsButton" class="btn btn-default btn-small" disabled="disabled">add more?</button>
                        }
                    }
                </div>
                @Html.Raw(Model.AdditionalLocationsRenderer.ToString())
            </div>
            <div class="control-group">
                <label class="control-label" for="DisplayRowPriceViewModel_PricesAndDiscounts_TotalCostOfOptions">Total Additional Locations Price:</label>
                <div class="controls">
                    @Html.TextBoxFor(m => m.DisplayRowPriceViewModel.PricesAndDiscounts.TotalCostOfOptions, new { id = "TotalCostOfOptionsText", disabled = "disabled" }) @*read-only*@
                    @Html.HiddenFor(m => m.DisplayRowPriceViewModel.PricesAndDiscounts.TotalCostOfOptions) @* Required for POST. TextBoxFor won't ModelBind *@
                    &nbsp;
                    <button id="UpdateAddLocsButton" class="btn btn-primary btn-mini">Update Additional Locations</button>
                </div>
            </div>
        </div>

        <div id="SubmitPanel" class="span2">
            <div class="control-group">
                <div class="controls">
                    <button id="editOrderSubmitButton" class="btn btn-primary">Submit Edited Details</button>
                </div>
            </div>
        </div>
    </div>
    @Html.HiddenFor(m => m.CostPerAdditionalLocation)
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.UserId)
    @Html.HiddenFor(m => m.WebinarId)
    @Html.HiddenFor(m => m.NumberOfAdditionalLocations)
    @Html.HiddenFor(m => m.DisplayRowPriceViewModel.NumberOfAdditionalLocations)
    @Html.HiddenFor(m => m.DisplayRowPriceViewModel.OrderStatus)
    @Html.HiddenFor(m => m.DisplayRowPriceViewModel.Price)
    @Html.HiddenFor(m => m.DisplayRowPriceViewModel.RowPrice)
    @Html.HiddenFor(m => m.DisplayRowPriceViewModel.PricesAndDiscounts.FlatOff)
}

<div id="changeAssignedAffiliate" class="modal hide fade">
    @using (Html.BeginForm("SetAffiliateAssignedToOrder", "Registrations", FormMethod.Post, new { id = "frmChangeAffiliate" }))
    {
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h3>Change Affiliate Credited To Order:</h3>
    </div>
    <div class="modal-body">
        @{

            @*<p>
                    <b>Choose Affiliate:</b>
                    @Html.DropDownList("assignedAffiliate", AppHelper.GetListOfAffiliates(Model.OrderRow.Order.Affiliate.ID),
                                           new { onchange = "document.changeAffiliateForm.submit();" })
                    <input type="hidden" name="ID" value="@Model.OrderRow.ID" />
                </p>*@
        }
    </div>
    <div class="modal-footer">
        <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
        <input type="submit" class="btn btn-primary" value="Save Changes" />
    </div>
    }
</div>

<div id="changeAssignedUser" class="modal hide fade">
    @using (Html.BeginForm("SetUserAssignedToOrder", "Admin", FormMethod.Post, new { id = "frmSetUserAssignedToOrder" }))
    {
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h3>Change User Assigned To Order:</h3>
    </div>
    <div class="modal-body">

        <input type="hidden" name="orderID" value="@Model.Order.idOrder" />
        <input type="hidden" name="migrateOrder" value="one" />
        <input type="text" id="targetUserID" name="targetUserID" value="Targeted User ID" />

    </div>
    <div class="modal-footer">
        <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
        <input type="button" name="moveOne" class="btn btn-primary" disabled="disabled" value="Just This Order" />
        <input type="button" name="moveAll" disabled="disabled" class="btn btn-primary" value="Change All" />
    </div>
    }
</div>


<div id="ExtendPostEventAccessModal" class="modal hide fade">
    @using (Html.BeginForm("ExtendPostEventAccess", "Account", FormMethod.Post, new { id = "frmExtendPostEventAccess" }))
    {
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h3>Enter Expiration Date:</h3>
        </div>
        <div class="modal-body">
            <input type="hidden" name="orderID" value="@Model.Order.idOrder" />
            <input type="text" id="newExpiryDate" name="newExpiryDate" placeholder="Expires On" />

        </div>
        <div class="modal-footer">
            <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
            <input type="submit" class="btn btn-primary" value="Submit" />
        </div>
    }
</div>
