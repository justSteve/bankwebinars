@using CUWebinars.Web.Core

@model GenerateWeeklyInvoicesViewModel

@{

    StringBuilder listAff = new StringBuilder();
    foreach (var aff in Model.Affiliates)
    {
        listAff.Append(aff.idUserAff + ",");
    }
    Layout = "/Views/Shared/_LayoutAdmin.cshtml";

}


<script language="javascript" type="text/javascript">
    $(function () {

        sendRptCheckBoxesDiv = $('#SendRptCheckBoxes').find('.controls');
        crunchingLabel = $('#crunchingLabel');

        $('#sendRpt').hide();
        $('#submitStartDate').on('click', function (args) {

            args.preventDefault();
            FireGenerator();
        });
    });
    //var arryAff = [@listAff];
    var arryAff = [62];
    var iterator = 0;

    function FireGenerator() {
        //

        var affId = arryAff[iterator];


        var payload = { startDate: $("#startDate").val(), _idAffiliate: affId };

        $.ajax({
            type: 'GET',
            contentType: constants.JsonContentType,
            cache: false,
            async: false,
            timeout: 3000,
            url: "/Admin/GenerateWeeklyInvoicesEvent?startDate=" + payload.startDate + "&_idAffiliate=" + payload._idAffiliate,
            dataType: constants.JsonDataType,
            //data: JSON.stringify(payload),
            beforeSend: function () {
                crunchingLabel.html('<span class="label label-warning">&nbsp;<i class="icon-spinner icon-spin "></i>&nbsp;Processing ' + (iterator + 1) + ' of ' + arryAff.length + '</span>');
            }
        }).done(function (data) {

            if (data.OrdersFound) {
                sendRptCheckBoxesDiv.append('<p>No orders found for ' + payload._idAffiliate + '</p>');
            } else {
                console.log(data);
                var parsedInvoice = data.Link.PrimaryUri.replace('http://storeforbw.blob.core.windows.net/affiliateinvoices/', '').replace('.pdf', '');
                // successful request; do something with the data
                //// Values being returned
                //AffiliateLabel = affiliate.DisplayTitle + " ("+affiliate.ttsDomain +" - "+affiliate.idUserAff+ ")",
                //Link = blob, ?? How to drill to URL
                //GrandTotalOnBilled,
                //GrandTotalOnPaid,
                //GrandTotalDiscounts,
                //GrandTotalRoyalties,
                //GrandTotalNetDue
                sendRptCheckBoxesDiv.append('<p class="checkbox-inline"><input type="checkbox" checked="Checked" id="inlineCheckbox_' + parsedInvoice + '" value="' + data.AffiliateLabel + '">' + data.AffiliateLabel + '<a href="' + data.Link.PrimaryUri + '" _target=_new> View Report</a></p>');
            }
            crunchingLabel.html('');
            iterator++;
            if (iterator < arryAff.length) {
                console.log(iterator + ": " + arryAff.length);
                FireGenerator();
            } else {
                $('#sendRpt').show();
            }
        }).fail(function (jqXHR, textStatus, errorThrown) {
            // failed request; give feedback to user
            alert("problem with " + payload._idAffiliate + " -- " + errorThrown);
            iterator++;

            if (iterator < arryAff) {
                FireGenerator(iterator);
            }
            crunchingLabel.html('');
        });
    }
</script>
<div style="width: 1100px; margin: 30px auto">
    <h2>Generates Weekly Invoices</h2>
    <div id="crunchingLabel"></div>
    @using (Html.BeginForm("GenerateWeeklyInvoicesEvent", "Admin", FormMethod.Get, new { id = "GenerateWeeklyInvoicesForm", @class = "form-horizontal " }))
    {
        @Html.AntiForgeryToken()

        <div id="frmStartDate">
            <p>Start Date</p>
            <div>
                <input type="date" name="startDate" id="startDate" />
                <button id="submitStartDate">Submit</button>
            </div>

        </div>
    }
    @using (Html.BeginForm("SendWeeklyInvoicesEvent", "Admin", FormMethod.Get, new { id = "SendWeeklyInvoicesForm", @class = "form-horizontal " }))
    {
        <div id="SendRptCheckBoxes" class="control-group">
            <button id="sendRpt">Send Report</button>
            <div class="controls">


            </div>
        </div>

    }

</div>
