@{

    StringBuilder listAff = new StringBuilder();
    foreach (var aff in Model.Affiliates)
    {
        listAff.Append(aff.idUserAff + ",");
    }
    Layout = "/Views/Shared/_LayoutAdmin.cshtml";
    
}


<script language="javascript" type="text/javascript">
    $(function () {

        sendRptCheckBoxesDiv = $('#SendRptCheckBoxes').find('.controls');
        crunchingLabel = $('#crunchingLabel');

        $('#submitStartDate').on('click', function (args) {
            FireGenerator();
        });
    });
    //var arryAff = [@listAff];
    var arryAff = [62, 2988];
    var iterator = 0;

    function FireGenerator() {
        //
        var affId = arryAff[iterator];
        

        var payload = { startDate: $("#startDate").val(), _idAffiliate: affId };

       $.ajax({
            type: 'GET',
            contentType: constants.JsonContentType,
            cache: false,
            async: false,
            timeout: 3000,
            url: "/Admin/GenerateWeeklyInvoicesEvent?startDate=" + payload.startDate + "&_idAffiliate=" + payload._idAffiliate,
            dataType: constants.JsonDataType,
            //data: JSON.stringify(payload),
            beforeSend: function () {
                crunchingLabel.html('<span class="label label-warning">&nbsp;<i class="icon-spinner icon-spin "></i>&nbsp;Processing...</span>');
            }
        }).done(function (data) {

            if (data.OrdersFound) {

                sendRptCheckBoxesDiv.append('<p>none found now</p>');
            } else {
                console.log(data);
                // successful request; do something with the data
                //// Values being returned
                //AffiliateLabel = affiliate.DisplayTitle + " ("+affiliate.ttsDomain +" - "+affiliate.idUserAff+ ")",
                //Link = blob, ?? How to drill to URL
                //GrandTotalOnBilled,
                //GrandTotalOnPaid,
                //GrandTotalDiscounts,
                //GrandTotalRoyalties,
                //GrandTotalNetDue

                sendRptCheckBoxesDiv.append('<label class="checkbox-inline"><input type="checkbox" checked="Checked" id="inlineCheckbox_' + payload._idAffiliate + '" value="' + data.AffiliateLabel + '">' + data.AffiliateLabel + '</label>');
                sendRptCheckBoxesDiv.append('<a href="' + data.Link.PrimaryUri + '" _target=_new>View Report</a>');
            }
            crunchingLabel.html('');
            iterator++;
            if (iterator < arryAff.length-1) {
                console.log(iterator + ": " + arryAff.length);
                FireGenerator();
            }
        }).fail(function (jqXHR, textStatus, errorThrown) {
            // failed request; give feedback to user
            alert("problem with " + payload._idAffiliate + " -- " + errorThrown);
            iterator++;

            if (iterator < arryAff) {
                FireGenerator(iterator);
            }
            crunchingLabel.html('');
        });
    }
</script>
