@model ChangePasswordFromResetKeyInputModel
@{
    ViewBag.Title = "Change Password";
}

<div class="span8">
    @using (Html.BeginForm(
        "FirePasswordResetEvent", 
        "MembershipNotificationOps", FormMethod.Post, 
        new { id = "PasswordConfirmResetForm", returnUrl = "/Account/Login" }
        ))
    {
        @Html.ValidationSummary(false, "Please correct the following errors:")

        <fieldset>
            <legend>@ViewBag.Title</legend>

            @if (Model.ChangePasswordSucceeded)
            {
                <p>You will also shortly receive an email confirming the change in password.</p>
            }
            else
            {
                <text>Please enter your new Password and confirm it:</text>
                @Html.EditorForModel()
                <label for="verificationKey">Verification Key</label>
                <input id="verificationKey" name="verificationKey" type="text" />
                <div>
                    <button id="PasswordResetVerifyButton" class="btn">Change Password</button><span id="PasswordResetVerifyStatus" style="color: green"></span>
                </div>
            }
        </fieldset>
    }
</div>
