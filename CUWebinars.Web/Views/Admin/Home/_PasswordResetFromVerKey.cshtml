@using CUWebinars.Web.Core
@model ChangePasswordFromResetKeyInputModel
@{
        GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;
}
<script type="text/javascript" language="javascript">
    // document.ready starts here
    $(function () {
        $("#modalEnterPasswordResetLink")
            .on('shown',
                function () {
                    $("#modalEnterPasswordResetLink").css("margin-top", "-240px");
                });

        $("#NoEmailBtn")
            .click(function (e) {
                e.preventDefault();
                $("#getKeyHead").html('');

            });
        $("#EnterVerKeyBtn")
            .click(function (e) {

                e.preventDefault();
                $("#getKeyHead").html('Key Entered');
                $("#getPWHead").html('Please enter and confirm a new password: ');

            });
        $("#EnterVerKeyBtn2")
            .click(function (e) {

                e.preventDefault();
                $("#getKeyHead").html('Key Entered');
                $("#getPWHead").html('Please enter and confirm a new password: ');

            });
    });


    $("#PasswordBtn")
        .click(function (e) {

            e.preventDefault();
            //PasswordResetConfirmInCheckout
            var self = this;
            console.log($("input[name=__RequestVerificationToken]").val());
            var token = $("input[name=__RequestVerificationToken]").val();

            var headers = {};
            headers['__RequestVerificationToken'] = token;
            console.log(headers);


            var model = {
                Key: $('#Key').val(),
                Email: $("#RegisterFields_Email").val(),
                ConfirmPassword: $("#ConfirmPassword").val(),
                Password: $("#Password").val()
            };

            $.ajax({
                type: 'POST',
                contentType: constants.JsonContentType,
                cache: false,
                url: '/Account/PasswordResetConfirmInCheckout',
                dataType: constants.JsonDataType,
                data: JSON.stringify(model),
                headers: headers,
                beforeSend: function () {
                    $(self)
                        .after('<span id="loadSpinner2">&nbsp;<i class="icon-spinner icon-spin"></i></span>');
                    $('#resetResult').remove();
                }
            })
                .done(function (data) {

                    if (data.Result === 'Success') {
                        $(self)
                            .after('<span id="resetResult">&nbsp;<span class="label label-success"><span> Password reset complete!</span></span></span>');
                        $("#PasswordBtn").text('Continue...');
                    } else if (data.Result === 'Fail') {
                        $(self)
                            .after('<span id="resetResult">&nbsp;<span class="label label-important"><i class="icon icon-exclamation-sign"></i>&nbsp;<span>Password reset failed!</span></span><br>' + data.Msg + '<br><button id="ReenterResetKey" data-toggle="collapse" data-parent="#pwReset" href="#getKey" class="btn">Reenter Reset Key</button></span>');
                        if (data.Msg === 'Invalid Key: Please ensure you are using the most recent Reset Request email.') {
                            $("#getKeyHead")
                                .html('Please find the most recent Password Reset Request email and enter the included URL here.');
                        }
                    }
                    $('#loadSpinner2').remove();
                });
        });

</script>
<div>
    @using (Html.BeginForm("PasswordResetConfirmInCheckout", "Account", FormMethod.Post, new { id = "EnterPasswordResetLinkForm", returnUrl = "/PasswordResetFromVerKey" }))
    {
        @Html.ValidationSummary(false, "Error:")
        @Html.AntiForgeryToken()

        <fieldset>
            @if (Model.ChangePasswordSucceeded)
            {
                <p>An email has been sent confirming that the password has been changed.</p>
            }
            else
            {
                <div class="accordion" id="pwReset">
                    <div class="accordion-group">
                        <div id="getKeyHead" class="accordion-heading">
                            <label for="Key">
                                Reset Request Link is Sent 
                            </label>
                            
                        </div>
                        <div id="getKey" class="accordion-body collapse in">
                            <div class="accordion-inner">
                                Please check your email for a message containing the reset link. Clicking that link will open a new browser window letting you enter and confirm a new password. After that you'll be able to verify and submit this order.<br/>

                                @*<button id="EnterNewPW" data-toggle="collapse" data-parent="#pwReset" href="#getPW" class="btn btn-mini btn-success">Resume</button>*@
                                <button id="NoEmailBtn" data-toggle="collapse" data-parent="#pwReset" href="#noEmailFound" class="btn btn-mini btn-warning pull-right">I didn't get an email</button>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-group">
                        <div id="getPWHead" class="accordion-heading">
                            Waiting for Confirmed Password
                        </div>
                        <div id="getPW" class="accordion-body collapse">
                            <div class="accordion-inner">
                                After you've confirmed your new password you may enter it here to log this browser tab in a resume checking out.
                                <input id="passwordAfterReset" name="Password" type="password" />
                                <br />
                                <div>
                                    <button id="PasswordBtn" class="btn">Password</button><span id="PasswordResetVerifyStatus" style="color: green"></span>
                                </div>
                                
                            </div>
                        </div>
                    </div>
                    <div class="accordion-group">
                        <div id="getNoEmailFoundHead" class="accordion-heading">
                            
                        </div>
                        <div id="noEmailFound" class="accordion-body collapse">
                            <div class="accordion-inner">
                                <div>
                                    Follow these steps to whitelist @globalConfig.TenantEmail:
                                    <ul>
                                        <li>Check your spam folder for mail from @globalConfig.TenantEmail</li>
                                        <li>Send a test message to @globalConfig.TenantEmail</li>
                                        <li>Re-submit a password reset request</li>
                                        <li>If you still do not see an email from us, contact us using the Help & Feedback online chat button in lower right corner.</li>
                                    </ul>

                                    <input id="Key2" name="Key" type="text" />
                                    <button id="EnterVerKeyBtn2" data-toggle="collapse" data-parent="#pwReset" href="#getPW" class="btn">Continue</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </fieldset>
    }
</div>

