@model ChangePasswordFromResetKeyInputModel
@{
    ViewBag.Title = "Update Password";
}
<script type="text/javascript" language="javascript">
    // document.ready starts here
    $(function () {
        $("#modalEnterPasswordResetLink")
            .on('shown',
                function () {

                });
        $("#EnterVerKeyBtn")
        .click(function (e) {
            alert("hit");
            e.preventDefault();
            $("#getKeyHead").html('Key Entered');
            $("#getPWHead").html('Please enter and confirm a new password: ');

        });
    });



    $("#PasswordResetVerifyButton").click(function (e) {

        e.preventDefault();
        //PasswordResetConfirmInCheckout
        var self = this;
        console.log($("input[name=__RequestVerificationToken]").val());
        var token = $("input[name=__RequestVerificationToken]").val();

        var headers = {};
        headers['__RequestVerificationToken'] = token;
        console.log(headers);


        var model = {
            Key: $('#Key').val(),
            Email: $("#RegisterFields_Email").val(),
            ConfirmPassword: $("#ConfirmPassword").val(),
            Password: $("#Password").val()
        };

        $.ajax({
            type: 'POST',
            contentType: constants.JsonContentType,
            cache: false,
            url: '/Account/PasswordResetConfirmInCheckout',
            dataType: constants.JsonDataType,
            data: JSON.stringify(model),
            headers: headers,
            beforeSend: function () {
                $(self).after('<span id="loadSpinner2">&nbsp;<i class="icon-spinner icon-spin"></i></span>');
                $('#resetResult').remove();
            }
        }).done(function (data) {

            if (data.Result === 'Success') {
                $(self).after('<span id="resetResult">&nbsp;<span class="label label-success"><span> Password reset email has been sent!</span></span></span>');

            } else if (data.Result === 'Fail') {
                $(self).after('<span id="resetResult">&nbsp;<span class="label label-important"><i class="icon icon-exclamation-sign"></i>&nbsp;<span>Password reset failed!</span></span></span>');
            }

            $('#loadSpinner2').remove();
        });
    });

</script>
<div>
    @using (Html.BeginForm("PasswordResetConfirmInCheckout", "Account", FormMethod.Post, new { id = "EnterPasswordResetLinkForm", returnUrl = "/PasswordResetFromVerKey" }))
    {
        @Html.ValidationSummary(false, "Error:")
        @Html.AntiForgeryToken()

        <fieldset>
            <legend>@ViewBag.Title</legend>

            @if (Model.ChangePasswordSucceeded)
            {
                <p>An email has been sent confirming that the password has been changed.</p>
            }
            else
            {
                <div class="accordion" id="pwReset">
                    <div class="accordion-group">
                        <div id="getKeyHead" class="accordion-heading">
                            @*<a class="accordion-toggle" data-toggle="collapse" data-parent="#pwReset" href="#getKey">*@
                            <label for="Key">
                                Please copy the reset link from your email and paste it here:
                            </label>
                            @*</a>*@
                        </div>
                        <div id="getKey" class="accordion-body collapse in">
                            <div class="accordion-inner">
                                <input id="Key" name="Key" type="text" />
                                <br />
                                <button id="EnterVerKeyBtn" data-toggle="collapse" data-parent="#pwReset" href="#getPW" class="btn">Continue</button>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-group">
                        <div id="getPWHead" class="accordion-heading">
                            @*<a class="accordion-toggle" data-toggle="collapse" data-parent="#pwReset" href="#getPW">*@
                            Waiting for Reset Key
                            @*</a>*@
                        </div>
                        <div id="getPW" class="accordion-body collapse">
                            <div class="accordion-inner">
                                @Html.EditorForModel()
                                <div>
                                    <button id="PasswordResetVerifyButton" class="btn">Update Password</button><span id="PasswordResetVerifyStatus" style="color: green"></span>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            }
        </fieldset>
    }
</div>

