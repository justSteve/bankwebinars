
<style type="text/css">
    div.addLocsBox {
        background-color: #ddd;
        padding: 5px;
        -ms-border-radius: 6px;
        border-radius: 6px;
        margin-top: 10px;
    }
</style>

@{
    ViewBag.Title = "ManageOrder";
}

<div class="container">
    <div class="legendImitator">Manage Order</div>

    <div style="display: inline-block;vertical-align: top;">
        <div class="control-group">
            <label class="control-label" for="orderIdInput">Enter the order id:</label>
            <div class="controls">
                <p>
                    Find: <input type="text" id="orderIdInput" class="input input-medium" data-provide="typeahead" autocomplete="off" />
                    <span id="chosenUserName" class="text text-info"></span>
                </p>
                <input name="SelectedWebUser" id="SelectedWebUser" type="hidden" />
                </div>
            <div class="control-group">
                <div class="controls">
                    <button id="getOrderButton" class="btn">Search Order</button>
                </div>
            </div>
        </div>
    </div>

    <div id="manageOrderWrapper">
        <div id="orderRelatedFields"></div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/manage-order-from-details")
    <script src="@Url.Content("~/Scripts/app/notification-ops/order-event-notifications.js")"></script>
    <script src="@Url.Content("~/Scripts/app/notification-ops/membership-notifications.js")"></script>
    <script src="@Url.Content("~/Scripts/app/ToastLogger.js")"></script>
}

@Styles.Render("~/Content/manage-order-styles")