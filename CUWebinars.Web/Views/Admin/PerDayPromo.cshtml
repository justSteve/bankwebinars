@using FluentDate
@using FluentDateTime
@using CUWebinars.Web.ViewModel

@model CUWebinars.Business.Notification.ViewModel.WebinarPromoViewModel

@{

    @*var isAff = UserFacade.Instance.GetCurrentUser();

        if (isAff.UserType == UserType.Affiliate)
        {
            <script type="text/javascript">
            $(document).ready(function () {
                $("#affList").hide();
                $("#GenButton").hide();

            });
            </script>
        }*@
    var webinars = Model.Webinars;
    var promoEvent = Model.Webinar;
    Layout = "/Views/Shared/_LayoutAdmin.cshtml";

    string wDate = "<b>" + DateTimeHelper.FormatDate(Model.Webinar.Date) + "</b><br>";
    wDate = wDate + DateTimeHelper.FormatTimeWithDuration(Model.Webinar.Date, Model.TimeZone, false, Model.Webinar.Duration) + "<br>";

    ViewBag.Title = "Send VR - Daily " + promoEvent.Title;

    var minDay = 1.Days().Since(DateTime.Now);
    var maxDay = DateTime.Now.NextMonth();

}
<script type="text/javascript" src="/Scripts/cleditor/jquery.cleditor.min.js"></script>
<script type="text/javascript" src="/Scripts/cleditor/jquery.cleditor.xhtml.min.js"></script>

<script id="scriptInit" type="text/javascript">
    $(document).ready(function () {

        $("#input").cleditor();

        $('#calendar').fullCalendar({
            events: "/Webinar/CalendarData",
            timeFormat: 'h(:mm)t ',
            allDayDefault: false,
            weekends: false,
            loading: function (bool) {
                if (bool) $('#veil').show();
                else $('#veil').hide();
            }
        });

        //$("#calendar1").wijcalendar({ monthCols: 2, monthRows: 1 });

        //$("#calendar1").wijcalendar({
        //    afterSelect: function (e, args) {
        //        $("#SendDate").val(ISODateString(args.date));
        //    }
        //});
        //$("#editor").cleditor();

        //$("#editor").hide();


        $("#submitGenPromoTexts").bind('click', function () {
            GenerateMessages();
        });
    }
    );
    function GenerateMessages() {

        var date1 = new Date($("#SendDate").val());
        var date2 = new Date(@(promoEvent.Date.ToShortDateString()));

        date1.setHours(0);
        date1.setMinutes(0);
        date1.setSeconds(0);
        date1.setMilliseconds(0);
        date2.setHours(0);
        date2.setMinutes(0);
        date2.setSeconds(0);
        date2.setMilliseconds(0);

        $.ajax({
            url: '/Admin/PromoGenerate',
            type: 'POST',
            data: $('#mailer').serialize(),
            dataType: "json",
            //contentType: "application/json",
            success: function (result) {
                $('[id^="aff"]').hide();
                $("#affList").show();
                $.each(result, function (id, msg) {
                    $("#aff" + msg.AffID).show();
                    $("#send" + msg.AffID).show();
                    $("#edit" + msg.AffID).html(msg.MsgBody);
                    //alert(item.ImageUrl);
                });
                $("#editorDiv").show();

                $("#editor").cleditor("setText", result[0].MsgBody);

            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                alert(textStatus + " " + errorThrown);
            }
        });
    }

    function ISODateString(d) {
        function pad(n) { return n < 10 ? '0' + n : n; }

        return pad(d.getUTCMonth() + 1)
            + '-' + pad(d.getUTCDate())
            + '-' + d.getUTCFullYear();
    }

    function SendtoAff(affID) {
        $("#editor").cleditor("setText", $("#edit" + affID).html());
        $('#send' + affID).text("Please Wait");
        var msgBody = $("#edit" + affID).html();
        //var msgBody = en(msgBody);

        $.ajax({
            url: '/Admin/SendtoAff',
            type: 'POST',
            data: { "affID": affID, "msgBody": msgBody },
            dataType: "json",
            //contentType: "json",
            success: function (result) {
                $('#send' + affID).text("Success");
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                $('#send' + affID).text(textStatus + " " + errorThrown);
            }
        });
    }

    function SetEditorText(aff) {
        $("#editor").cleditor.updateFrame();
        //("setText", $("#edit" + aff).html());
        //$("#editor").bind("textChanged", function (e, data) { $("#edit" + aff).html(data); });
    }

</script>
<script src="/Scripts/fullcalendar/fullcalendar.js" type="text/javascript"></script>
<link href="/Scripts/fullcalendar/fullcalendar.css" rel="stylesheet" type="text/css" />

<p align="right">
    <input type="button" id="GenButton" onclick="javascript: GetWeekly();" value="Gen Multiple Events" />
</p>
<h2>
    @Model.Webinar.Title
</h2>
<p>
    @Model.Webinar.Presenter.WebUser.FullName<br />
    @Html.Raw(wDate)<br />
</p>
<div id="Daily">
    @{
        using (Html.BeginForm(null, null, FormMethod.Post, new { id = "mailer" }))
        {
            @Html.Hidden("TemplateVersion", "Daily")
            @Html.Hidden("Webinar.idWebinar", Model.Webinar.idWebinar)

            <p>Date to Send Promo: @Html.TextBox("SendDate", Model.SendDate)</p>

            <div id="calendar1"></div>
            <div id="affList" name="affList">
                <p>Please check all affiliates to be included in this promo:</p>
                @{
            foreach (var aff in Model.Affiliates)
            {
                <div id="aff@(aff.idUserAff)">
                    <input name="cb_@(aff.idUserAff)" type="checkbox" checked="checked" />
                    <a href='javascript:SetEditorText(@aff.idUserAff)'>@(aff.ttsDomain) </a>

                    <div style="display: none;" id="send@(aff.idUserAff)"><a id="a_(@aff.idUserAff)" href="javascript:SendtoAff(@aff.idUserAff)">Send</a></div>
                    <div style="display: none; float: left; width: 200px;" id="edit@(aff.idUserAff)">
                    </div>
                </div>

            }
                }
            </div>

            <input type="button" id="submitGenPromoTexts" value="Submit" />
        }

    }
    <div id="editorDiv">
        <textarea style="width: 100%; height: 1000px;" id="editor"></textarea>
    </div>
</div>
<script>
    $(document).ready(function () {
        $("#editorDiv").hide();
    });

</script>
