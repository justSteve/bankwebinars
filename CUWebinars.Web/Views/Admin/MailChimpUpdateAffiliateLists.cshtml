@model ListSegmentsViewModel

@{
    ViewBag.Title = "MailChimp Lists By Affiliate";
    Layout = "/Views/Shared/_LayoutAdmin.cshtml";

}

<div id="MailchimpListContainer" class="container">


    <h2>MailChimp Lists By Affiliate</h2>
    <div>
        @{
            <h1>SBAs</h1>
            foreach (var affiliate in Model.SBA)
            {
                <h2>@affiliate.ttsDomain</h2>
                <div>@Html.Raw(affiliate.idMailChimpList)</div>
            }
            <h1>CFTs</h1>
            foreach (var affiliate in Model.CFT)
            {
                <h2>@affiliate.ttsDomain</h2>
                <div>@Html.Raw(affiliate.idMailChimpList)</div>
            }
            <h1>Other</h1>
            foreach (var affiliate in Model.Other)
            {
                <h2>@affiliate.ttsDomain</h2>
                <div>@Html.Raw(affiliate.idMailChimpList)</div>
            }
            <h1>NotFounds</h1>
            @Html.Raw(Model.AffOutput)
        }

    </div>
</div>