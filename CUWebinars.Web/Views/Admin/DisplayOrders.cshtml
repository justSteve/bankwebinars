
@{
    ViewBag.Title = "Orders";
}

@Styles.Render("~/Content/data-tables")

<h2>Display Orders</h2>

<table id="ordersTable" class="table table-striped table-bordered dataTable no-footer" cellspacing="0" width="100%">
    <thead>
        <tr>
            <th>First name</th>
            <th>Last name</th>
            <th>Institution</th>
            <th>Billing Phone</th>
            <th>Billing Email</th>
            <th>Billing Address</th>
            <th>Billing Address2</th>
            <th>Billing City</th>
            <th>Billing State</th>
            <th>Billing Zip</th>
            <th>Shipping First Name</th>
            <th>Shipping Last Name</th>
            <th>Shipping Phone</th>
            <th>Shipping Address</th>
            <th>Shipping Address2</th>
            <th>Shipping City</th>
            <th>Shipping State</th>
            <th>Shipping Zip</th>
        </tr>
    </thead>

    <tfoot>
        <tr>
            <th>First name</th>
            <th>Last name</th>
            <th>Institution</th>
            <th>Billing Phone</th>
            <th>Billing Email</th>
            <th>Billing Address</th>
            <th>Billing Address2</th>
            <th>Billing City</th>
            <th>Billing State</th>
            <th>Billing Zip</th>
            <th>Shipping First Name</th>
            <th>Shipping Last Name</th>
            <th>Shipping Phone</th>
            <th>Shipping Address</th>
            <th>Shipping Address2</th>
            <th>Shipping City</th>
            <th>Shipping State</th>
            <th>Shipping Zip</th>
        </tr>
    </tfoot>
</table>

@section scripts{
    @Scripts.Render("~/bundles/dataTables")    
    @Scripts.Render("~/bundles/display-orders")    
}

