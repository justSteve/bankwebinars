    @{
        CUWebinars.Web.Services.IStateService stateService = new CUWebinars.Web.Services.StateService();

        var currentAffiliate = stateService.GetValue<Affiliate>("CurrentAffiliate");
        //    var currentUser = UserFacade.Instance.GetCurrentUser();
        var currentUserID = 0;
        var currentUserAffiliateFullName = "na";
        //var currentUser = CurrentSession.Instance.CurrentUser;

        //if (currentUser != null)
        //{
        //    currentUserID = currentUser.ID;
        //    currentUserAffiliateFullName = currentUser.Affiliate.FullName;
        //}

        var sessionRecorded = "";

        var sessionUpcoming = "";

        var upcomingSessions = stateService.GetValue<System.Text.StringBuilder>("upcoming");

        if (upcomingSessions != null)
        {
            sessionRecorded = stateService.GetValue<System.Text.StringBuilder>("rec");
            sessionUpcoming = upcomingSessions.ToString();
        }
        else
        {
            Response.Redirect("/");
        }

        var includeUpcoming = stateService.GetValue<bool>("IncludeUpcoming");

        if (includeUpcoming == null)
        {
            stateService.SetValue("IncludeUpcoming", true);
        }

        var includeRecorded = stateService.GetValue<bool>("IncludeRecorded");

        if (includeRecorded == null)
        {
            stateService.SetValue("IncludeRecorded", false);
        }

        var includeArchived = stateService.GetValue<bool>("IncludeArchived");

        if (includeArchived == null)
        {
            stateService.SetValue("IncludeArchived", false);
        }
         
    }
