@using System.Text
@using CUWebinars.Web.Core
@{
    
    
    var globalConfig = GlobalConfig.GlobalConfigSingleton;
    var imgUrl = globalConfig.ImgRepository;
    var certDir = "~/Content/images/BankWebinars/Webinars/w" + ViewBag.Webinar + "/cert.jpg";

    //GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;
}


@{
    var PageStyleType = ViewBag.PageStyleType;
    IStateService stateService = new StateService();

    var currentAffiliate = stateService.GetValue<Affiliate>("CurrentAffiliate");

    var currentUserID = 0;
    var currentUserAffiliateFullName = currentAffiliate.WebUser.FullName;
