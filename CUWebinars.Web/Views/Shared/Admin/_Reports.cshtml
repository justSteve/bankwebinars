
@using System.Linq
@using CUWebinars.Web.Core
@using CUWebinars.Web.Helpers
@using CUWebinars.Web.Models.JsonModels
@using Newtonsoft.Json
@model InvoicesModel
@{
    GlobalConfig _globalConfig = GlobalConfig.GlobalConfigSingleton;

    var nfi = new CultureInfo("en-US", false).NumberFormat;
    nfi.CurrencyDecimalDigits = 0;

}

<style>
    #limheight {
    height: 1200px; /*your fixed height*/
    -webkit-column-count: 4;
       -moz-column-count: 4;
            column-count: 4; 
        list-style-type: none;
}
#limheight li {
    
}
</style>
<div class="container">
    <!--begin main content-->
    <div class="row-fluid">
        <!--begin row-fluid-->
        <div class="span12">
            @{
                if (Model.Links != null)
                {
                    <ul id="limheight">
                        @foreach (var link in Model.Links)
                        {
                            var weekNumber = link.AbsoluteUri.Split('/')[4];
                            <li><a href="@link.AbsoluteUri">@weekNumber</a></li>
                        }
                    </ul>
                }
                else
                {
                    <div>No Invoices Found</div>
                }
            }
        </div>
    </div>
</div>
