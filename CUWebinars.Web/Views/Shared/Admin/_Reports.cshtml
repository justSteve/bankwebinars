
@using System.Linq
@using CUWebinars.Web.Core
@using CUWebinars.Web.Helpers
@using CUWebinars.Web.Models.JsonModels
@using Newtonsoft.Json
@model InvoicesModel
@{
    GlobalConfig _globalConfig = GlobalConfig.GlobalConfigSingleton;

    var nfi = new CultureInfo("en-US", false).NumberFormat;
    nfi.CurrencyDecimalDigits = 0;

}

<div class="container">
    <!--begin main content-->
    <div class="row-fluid">
        <!--begin row-fluid-->
        <div class="span12">
            @{
                if (Model.Links != null)
                {
                    foreach (var link in Model.Links.Reverse())
                    {
                        //http://storeforbw.blob.core.windows.net/invoicesprivate/10-31-2016/45-2016-62.pdf?sv=2014-02-14&sr=b&sig=c04lkgGd0cuBYX7MdLJOQzFzrxrBwIwG7S84EU7HEeQ%3D&se=2016-11-06T16%3A18%3A53Z&sp=r
                        var weekNumber = link.AbsoluteUri.Split('/')[4];
                        <a href="@link.AbsoluteUri">@weekNumber</a>
                        <br/>
                    }
                }
                else
                {
                    <div>No Invoices Found</div>
                }
            }
        </div>
    </div>
</div>


