@using System.Linq
@using CUWebinars.Web.Core
@using CUWebinars.Web.Helpers
@using CUWebinars.Web.Models.JsonModels
@using Newtonsoft.Json
@model  CompPersSubscriptionsModel
@{
    GlobalConfig _globalConfig = GlobalConfig.GlobalConfigSingleton;

    var nfi = new CultureInfo("en-US", false).NumberFormat;
    nfi.CurrencyDecimalDigits = 0;


}
<style>
    table td {
        border: medium;
        padding: 4px;
        text-align: left;
    }
</style>
<div class="container">
    <!--begin main content-->
    <div class="row-fluid">
        <!--begin row-fluid-->
        <div class="span12">
            @{
                if (Model.Discounts != null)
                {
                    var rowCount = 0;
                    <table>
                        <tr style="background-color: black; color: gray"><td></td><td>OrderId</td><td>Email</td><td>Renewal Term</td><td>Expires</td></tr>
                        @foreach (var discount in Model.Discounts.OrderBy(d => d.DateValidTo).Where(d => d.DiscountType == DiscountType.ComplianceSeries))
                        {
                            rowCount++;
                            <tr><td>@rowCount<text>.</text></td>
                                <td>@discount.idDiscount</td>
                                <td>@discount.UserEmail</td>
                                <td>
                                    <div style="text-align: right">@discount.RenewalTerm</div></td>
                                <td>
                                    <div style="text-align: right">@discount.DateValidTo.ToString().Replace("12:00:00 AM", "")</div></td>

                            </tr>
                        }
                    </table>
                }
            }
        </div>
    </div>
</div>



