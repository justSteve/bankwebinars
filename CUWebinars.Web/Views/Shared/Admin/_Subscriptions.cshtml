@using System.Linq
@using CUWebinars.Web.Core
@using CUWebinars.Web.Helpers
@using CUWebinars.Web.Models.JsonModels
@using Newtonsoft.Json
@model  WpsViewModel
@{
    GlobalConfig _globalConfig = GlobalConfig.GlobalConfigSingleton;

    var nfi = new CultureInfo("en-US", false).NumberFormat;
    nfi.CurrencyDecimalDigits = 0;

    if (Model.Affiliate == null)
    {
        <script language="javascript" type="text/javascript">
            var idAffiliate = 19;
        </script>
    }
    else
    {

        <script language="javascript" type="text/javascript">
            var idAffiliate = Model.Affiliate.idUserAff;;
        </script>
    }
}

<style>
    table td {
        border: medium;
        padding: 4px;
        text-align: left;
    }
</style>
<script type="text/javascript" language="javascript">
    @*var idDiscount = @Model.Webinar.idWebinar;*@
    $(function () {
        $("td[id^=showDiscountDetails_]").click(
            function () {
                
                
                
                var thisId = ($(this).data("thisid"));              
                $("div[id^='discountDetails_']").hide();

                $("div[id^=discountDetails_" + thisId + "]").show();

                var payload = { idAffilate: idAffiliate, idDiscount: thisId };
                
                $.ajax({
                    type: 'POST',

                    cache: false,
                    url: '/Admin/AuditDiscount',
                    dataType: constants.JsonDataType,
                    data: payload,
                    beforeSend: function() {
                        //$(self)
                        //    .after('<span id="spinnerLabel" class="label label-info" style="margin-left:5px"><span>&nbsp;<i class="icon-spinner icon-spin"></i>&nbsp;Sending...</span></span>');
                    }
                }).done(function(result) {

                    if (result.Result === 'Success') {
                        alert("Success");
                    }
                });

            });
    });

</script>
<div class="container">
    <!--begin main content-->
    <div class="row-fluid">
        <!--begin row-fluid-->
        <div class="span12">
            @{
                if (Model.Discounts != null)
                {
                    <table>
                        <tr style="background-color: black; color: gray"><td>Code</td><td>Email</td><td>Remaining</td><td>Status</td></tr>
                        @foreach (var discount in Model.Discounts.OrderBy(d => d.DateValidTo).Where(d => d.DiscountType == DiscountType.Subscription))
                        {
                            var users = "";
                            foreach (var user in discount.WpsUsers)
                            {
                                users += user.email + ", ";
                            }
                            <tr>
                                <td id="showDiscountDetails_@discount.idDiscount" data-thisid="@discount.idDiscount">
                                    @discount.DiscountCode (@discount.idDiscount)
                                    <div id="discountDetails_@discount.idDiscount" class="initialHide">hidden?</div>
                                </td>
                                <td>@users.TrimEnd(' ').TrimEnd(',')</td>
                                <td>
                                    <div style="text-align: right">@discount.CreditsRemain</div>
                                </td>
                                <td>
                                    <div style="text-align: right">@discount.Status</div>
                                </td>

                            </tr>
                        }
                    </table>
                }
            }
        </div>
    </div>
</div>



