                    </section>
                    <!--close section-->
                </div>
                <!-- close .span4 -->
                <div class="span4">
                    <section>
                        <h4>Follow Us</h4>
                        @Html.Raw(footSocial)

                        @{
                            if (currentAffiliate.idUserAff > 19)
                            {
                                <p style="margin-top: 10px;" align="center">This site is managed for @currentAffiliate.DisplayTitle by @globalConfig.TenantDomain and Total Training Solutions - TTSTrain.com.</p>
                            }
                        }
                    </section>

                </div>
                <!-- close .span4 -->
            </div>
            <!-- close .row-fluid-->
        </div>
        <!-- close footer .container-->
        <section class="footerCredits">
            <div class="container">
                <ul class="clearfix">
                    <li style="text-align: right;">@globalConfig.TenantDomain is © 2015 & All Rights Reserved By Total Training Solutions. <br /></li>
                    <li style="text-align: left;"><a href="/home/privacystatement">Privacy Statement</a><br />For financial institution training visit<a href="http://www.ttstrain.com/?s=cuwebinars" target="_new"> TTSTrain.com </a></li>
                </ul>
            </div>
            <!--footerCredits container-->
        </section>
        <!--close section-->
    </footer>
    <!--/.footer-->

    <span class="backToTop"><a href="#top">back to top</a></span>
    <!-- close #page-->

    <div class="modal hide fade in" id="DisplayErrorModal">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h3 id="CreateUserHeader">Error Condition Detected</h3>
        </div>
        <div id="DisplayErrorBody" class="modal-body">
            <div id="ErrorBody"></div>
        </div>
        <div class="modal-footer">
            <a href="#" id="ErrorSubmitter" class="btn btn-primary">Continue</a>
        </div>
    </div>


    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/CrispApp")

    <script type="text/javascript">
        $(document).ready(function () {
            $("#search-box").hide();
            $("#search-wrapper").mouseover(function () {
                $("#search-box").show();
            });
        });
    </script>
    @RenderSection("scripts", required: false)
    <link rel="stylesheet" href="~/Content/css/bootstrapOverrides.css" type="text/css" media="screen" />

</body>
</html>
