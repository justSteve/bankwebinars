        <div id="search-wrapper" class="search-wrapper">
            <form class="search" method="post" action="/webinar/search">
                <ul class="notifications" id="userNotifications">
                    <li><i class="icon-search"></i></li>
                </ul>
                <input id="search-box" name="searchTerm" type="text" placeholder="Search for?">
            </form>
        </div>

    </section>
    <!-- begin .header-->
    <header class="header  clearfix" style="margin-bottom: 0px; padding-bottom: 0; ">
        <div class="container">
            <div class="row-fluid">
                <!-- begin #logo-->

                <div id="logo" class="span3" style='background: url("@currentAffiliate.Logo") no-repeat scroll 0 0 rgba(0, 0, 0, 0)'>

                </div>
                <!-- end #logo -->
                <!-- begin #main_menu -->
                <nav id="main_menu" class="span8">
                    <ul class="primary_menu">
                        <li class="parent"><a href="/webinar/calendar">calendar</a></li>
                        <li class="parent">
                            <a href="javascript:void(0)">topics<i></i></a>
                            <ul>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/15">Compliance</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/26">Risk Management</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/16">IRA</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/17">Customer Service</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/19">Operations</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/18">Security</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/20">Auditing</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/21">Sales</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/22">Lending</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/23">Human Resources</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/27">Teller</a></li>
                            </ul>
                        </li>
                        <li class="parent">
