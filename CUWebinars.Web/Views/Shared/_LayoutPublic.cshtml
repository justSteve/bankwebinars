@{
    var PageStyleType = ViewBag.PageStyleType;
    IStateService stateService = new StateService();

    var currentAffiliate = stateService.GetValue<Affiliate>("CurrentAffiliate");

    var currentUserID = 0;
    var currentUserAffiliateFullName = currentAffiliate.WebUser.FullName;
    //var currentUser = CurrentSession.Instance.CurrentUser;

    //if (currentUser != null)
    //{
    //    currentUserID = currentUser.ID;
    //    currentUserAffiliateFullName = currentUser.Affiliate.FullName;
    //}

    StringBuilder sessionRecorded = new StringBuilder();

    StringBuilder sessionUpcoming = new StringBuilder();

    var upcomingSessions = stateService.GetValue<StringBuilder>("upcoming");

    if (upcomingSessions != null)
    {
        sessionRecorded = stateService.GetValue<StringBuilder>("rec");
        sessionUpcoming = upcomingSessions;
    }
    else
    {
        Response.Redirect("/");
    }

    var subdomainBranding = stateService.GetValue<string>("SubdomainBranding");
    var firstPage = stateService.GetValue<string>("FirstPage");
    var sessionID = stateService.GetValue<string>("SessionID");
    var affiliateSessionSource = stateService.GetValue<string>("AffiliateSessionSource");


    //var initialQueryString = stateService.GetValue<string>("InitialQueryString");
    //TODO: Why's this?
    // System.InvalidCastException was unhandled by user code
    //HResult=-2147467262
    //Message=Unable to cast object of type 'System.Web.HttpValueCollection' to type 'System.String'.


    var includeUpcoming = stateService.GetValue<bool>("IncludeUpcoming");

    if (includeUpcoming == null)
    {
        stateService.SetValue("IncludeUpcoming", true);
    }

    var includeRecorded = stateService.GetValue<bool>("IncludeRecorded");

    if (includeRecorded == null)
    {
        stateService.SetValue("IncludeRecorded", false);
    }

    //var includeArchived = stateService.GetValue<bool>("IncludeArchived");

