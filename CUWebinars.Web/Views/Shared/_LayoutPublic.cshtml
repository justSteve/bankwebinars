@{
    var PageStyleType = ViewBag.PageStyleType;
    IStateService stateService = new StateService();

    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;
    string currentUrl = Request.Url.AbsoluteUri;

    if (currentUrl.ToLower().Contains("complianceperspectives") && !currentUrl.Contains("883"))
    {
        <script type="text/javascript">
            window.location.href = "https://www.complianceperspectives.com/883/compliance-perspectives-a-monthly-update";
        </script>
    }

    var currentAffiliate = stateService.GetValue<Affiliate>(WebUiConstants.CurrentAffiliate);
    var currentUser = stateService.GetValue<WebUser>(WebUiConstants.CurrentUser);
    string currentUserAffiliateFullName = string.Empty;
    if (currentAffiliate != null)
    {
        //currentUserAffiliateFullName = currentAffiliate.WebUser.FullName;
        ViewBag.currentAffiliateId = currentAffiliate.idUserAff;
    }
    else
    {
        //CUWebinars.Business.Core.Tracing.Tracer.Warning("CurrentAffiliate should always have a value. Session | {0}", new AppHelper(Request, stateService).GetUserAuditInfo());
        Debug.Assert(currentAffiliate != null, "CurrentAffiliate should always have a value.");

    }
    var footAddress = "";
    var footSocial = "";

    try
    {
        footAddress = currentAffiliate.WebFooter.Split('~')[0];
        footSocial = "";
        if (currentAffiliate.WebFooter.Split('~').Length > 1)
        {
            footSocial = currentAffiliate.WebFooter.Split('~')[1];
        }

    }
    catch (Exception e)
    {
        var a = "holder";
    }
    //var footAddress = currentAffiliate.WebFooter.Split('~')[0];
    //var footSocial = "";
    //if (currentAffiliate.WebFooter.Split('~').Length > 1)
    //{
    //    footSocial = currentAffiliate.WebFooter.Split('~')[1];
    //}

    var firstPage = stateService.GetValue<string>("FirstPage");
    var sessionID = stateService.GetValue<string>(WebUiConstants.SessionId);
    var affiliateSessionSource = stateService.GetValue<string>("AffiliateSessionSource");
}
