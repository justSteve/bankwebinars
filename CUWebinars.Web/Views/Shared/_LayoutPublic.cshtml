@using System.Configuration
@using System.Text
@using CUWebinars.Web.Core
@{
    var PageStyleType = ViewBag.PageStyleType;
    IStateService stateService = new StateService();

    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;

    //TODO: following on the idea of a fundamentally spaghettized aspect of the Details page, let's replace these 'if' tests for both admins and affiliates. Instead, redirect the given role to a corresponding _LayoutPage.
    var currentAffiliate = stateService.GetValue<Affiliate>(WebUiConstants.CurrentAffiliate);
    string currentUserAffiliateFullName = string.Empty;
    if (currentAffiliate != null)
    {
        currentUserAffiliateFullName = currentAffiliate.WebUser.FullName;
    }
    else
    {
        CUWebinars.Business.Core.Tracing.Tracer.Warning("CurrentAffiliate should always have a value. Session | {0}", new AppHelper(Request).GetUserAuditInfo());
        Debug.Assert(currentAffiliate != null, "CurrentAffiliate should always have a value.");
    }

    var currentUserID = 0;

    //StringBuilder sessionRecorded = new StringBuilder();
    //StringBuilder sessionUpcoming = new StringBuilder();

    //var upcomingSessions = stateService.GetValue<StringBuilder>("upcoming");

    //if (upcomingSessions != null)
    //{
    //sessionRecorded = stateService.GetValue<StringBuilder>("rec");
    //    sessionUpcoming = upcomingSessions;
    //}
    //else
    //{
    //    //Response.Redirect("/?resetSession=null");
    //}

    var subdomainBranding = stateService.GetValue<string>("SubdomainBranding");
    var firstPage = stateService.GetValue<string>("FirstPage");
    var sessionID = stateService.GetValue<string>(WebUiConstants.SessionId);
    var affiliateSessionSource = stateService.GetValue<string>("AffiliateSessionSource");
}
