    @Scripts.Render("~/bundles/modernizr")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/CommonModules")
    @Scripts.Render("~/bundles/myApp")
    @Scripts.Render("~/bundles/app-processing-manage")
    @Styles.Render("~/Content/CrispCSS")
    @Styles.Render("~/Content/common-styles")

    <!-- Icons ================ -->
    <!-- For non-Retina iPhone, iPod Touch, and Android 2.1+ devices: -->
    <link rel="apple-touch-icon-precomposed" href="~/Content/images/BankWebinars/apple-touch-icon.png" />
    <!-- For first- and second-generation iPad: -->
    <link rel="apple-touch-icon-precomposed" sizes="72x72" href="~/Content/images/BankWebinars/apple-touch-icon-72x72-precomposed.png" />
    <!-- For iPhone with high-resolution Retina display: -->
    <link rel="apple-touch-icon-precomposed" sizes="114x114" href="~/Content/images/BankWebinars/apple-touch-icon-114x114-precomposed.png" />
    <!-- For third-generation iPad with high-resolution Retina display: -->
    <link rel="apple-touch-icon-precomposed" sizes="144x144" href="~/Content/images/BankWebinars/apple-touch-icon-144x144-precomposed.png" />

    <link rel="shortcut icon" href="~/Content/images/BankWebinars/favicon.ico" />
    <meta property="og:description" content="@GlobalConfig.GlobalConfigSingleton.Tenant is Webinars for the financial industry." />


    <style>
        table td {
            border: none;
            text-align: center;
        }

        .hero-unit {
            padding-top: 20px;
            padding-bottom: 0px;
        }

        .preheader {
            background-color: lightgray;
            width: 100%;
            padding-left: 25px;
        }

        .affFooter {
            color: white;
        }
    </style>
    <script>
        window.$zopim(function () {
            window.$zopim.livechat.bubble.setTitle('Help & Feedback');
        });

    </script>
    <script>
        //to accomodate IE  http://stackoverflow.com/questions/5522164/input-placeholders-for-internet-explorer -- Jonathan Tonge
        var placeholder = 'placeholder' in document.createElement('input');
        if (!placeholder) {
            $.getScript("/Scripts/placeholder.js", function () {
                $(":input").each(function () {   // this will work for all input fields
                    $(this).placeHolder();
                });
            });
        }
    </script>
    @{
        if (@User.Identity.IsAuthenticated)
        {
            //if (!Html.IsDebug())
            //{
            <script>
                window.$zopim(function () {
                    window.$zopim.livechat.setName("@User.Identity.Name.ToString().Replace("@", "_")");

                });
            </script>
            //}
        }
    }
</head>
<body class="@PageStyleType">
    <!-- begin accesibility skip to nav skip content -->
    <ul class="visuallyhidden" id="top">
        <li><a href="#nav" title="Skip to navigation" accesskey="n">Skip to navigation</a></li>
        <li><a href="#page" title="Skip to content" accesskey="c">Skip to content</a></li>
    </ul>
    <!-- end /.visuallyhidden accesibility-->
    <!-- mobile navigation trigger-->
    <h5 class="mobile_nav"></h5>
    <!--end mobile navigation trigger-->
    <section class="container preheader">
        <!--this is the login for the user-->
        <div id="loginContainer">
            @Html.Partial("_LoginPartial")
        </div>


        <ul class="social">
            <li><a href="" target="_blank" data-placement="bottom" title="A TTS Production"><img src="~/Content/images/TTS-logoPreHeader.jpg" /></a></li>
            <li><a class="socicon small facebook" href="https://www.facebook.com/home.php#!/pages/Total-Training-Solutions/300546163412" target="_blank" data-placement="bottom" title="Follow us on Facebook"></a></li>
            <li><a class="socicon small twitterbird" href="https://twitter.com/#!/ttstrain" target="_blank" data-placement="bottom" title="Follow us on Twitter"></a></li>
            <li><a class="socicon small linkedin" href="https://www.linkedin.com/company/bankwebinars-com" target="_blank" data-placement="bottom" title="Follow us on LinkedIn"></a></li>
            <li>
                <div id="search-wrapper" class="search-wrapper">
                    <form class="search" method="post" action="/webinar/search">
            <li><i class="icon-search"></i></li>
            <input id="search-box" name="searchTerm" type="text" placeholder="Search for?">
            </form>
            </div>

            </li>
        </ul>

    </section>
    <!-- begin .header-->
    <header class="header  clearfix" style="margin-bottom: 0px; padding-bottom: 0; ">
        <div class="container">
            <div class="row-fluid">
                <!-- begin #logo-->
                <a href="/">
                    <div id="logo" class="span3" style='background: url("@currentAffiliate.Logo") no-repeat scroll 0 0 rgba(0, 0, 0, 0)'></div>
                </a>
                <!-- end #logo -->
                <!-- begin #main_menu -->
                <nav id="main_menu" class="span8">
                    <ul class="primary_menu">
                        <li class="parent"><a href="/webinar/calendar">calendar</a></li>
                        <li class="parent">
                            <a href="javascript:void(0)">topics<i></i></a>
                            <ul>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/15">Compliance</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/26">Risk Management</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/16">IRA</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/17">Customer Service</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/19">Operations</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/18">Security</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/20">Auditing</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/21">Sales</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/22">Lending</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/23">Human Resources</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/27">Teller</a></li>
                            </ul>
                        </li>
                        <li class="parent">
                            <a href="javascript:void(0)">Upcoming Webinars<i></i></a>

                            <ul>@Html.Action("UpComingWebinarMenu", "Navigation")</ul>
                        </li>
                        <li class="parent">
                            <a href="javascript:void(0)">OnDemand Webinars<i></i></a>
                            <ul>@Html.Action("GetRecordedWebinarMenu", "Navigation")</ul>
                        </li>
                        <li>
                            <a href="javascript:void(0)">About Us<i></i></a>
                            <ul>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Home/WhatIsAWebinar">What Is A Webinar?</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Home/CommonQuestions">Commonly Asked Questions</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Home/DetailedConnectionInstructions">Connecting to Your Webinar</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Home/contactus">Contact Us</a></li>
                            </ul>
                        </li>
                        @if (Request.IsAuthenticated)
                        {
                            <li><a href="/Account/MyWebinars">My Webinars</a></li>
                        }
                    </ul>
                </nav>
                <!-- close / #main_menu -->
            </div>
        </div>
        <!-- close / .container-->
    </header>
    <!-- close /.header -->
    <div id="page">
        @RenderBody()
    </div>
    <!--begin footer -->
    <footer id="footer" class="clearfix">
        <div class="container">
            <!--footer container-->
            <!--footer container-->
            <div class="row-fluid">
                <div class="span4">
                    <section>
                        <h4>Stay Updated</h4>
                        @{Html.RenderPartial("Partials/_AddToMailingBox");}
                    </section>
                </div>
                <!-- close .span4 -->
                <div class="span4">
                    <section>
                        <h4>Contact Us</h4>
                        <div class="affFooter">   @Html.Raw(footAddress)</div>
                    </section>
                    <!--close section-->
                </div>
                <!-- close .span4 -->
                <div class="span4">
                    <section>
                        <h4>Follow Us</h4>
                        @Html.Raw(footSocial)

                        @{
                            if (currentAffiliate.idUserAff > 19)
                            {
                                <p style="margin-top: 10px;" align="center">This site is managed for @currentAffiliate.DisplayTitle by @globalConfig.TenantDomain and Total Training Solutions - TTSTrain.com.</p>
                            }
                        }
                    </section>

                </div>
                <!-- close .span4 -->
            </div>
            <!-- close .row-fluid-->
        </div>
        <!-- close footer .container-->
        <section class="footerCredits">
            <div class="container">
                <ul class="clearfix">
