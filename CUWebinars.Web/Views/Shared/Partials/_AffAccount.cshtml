@using CUWebinars.Web.Core
@model CUWebinars.Web.Models.AffiliateSettingsViewModel

@{
    GlobalConfig _globalConfig = GlobalConfig.GlobalConfigSingleton;

    var nfi = new CultureInfo("en-US", false).NumberFormat;
    nfi.CurrencyDecimalDigits = 0;


    ClaimsIdentity claimsIdentityOfAuthenticatedUser = (ClaimsIdentity)User.Identity;

    if (claimsIdentityOfAuthenticatedUser.HasClaim(
        (claim) => claim.Type == CUWebinars.Business.Constants.ClaimTypes.Affiliate))
    {
        <script type="text/javascript" language="javascript">
            $(function () {
                $('[id^="admin"').hide();
                $("[name='Affiliate.Logo']").prop('disabled', true);
                $("[name='Affiliate.WebFooter']").prop('disabled', true);
                $("[name='Affiliate.EmailBanner']").prop('disabled', true);
                $("[name='Affiliate.EmailFooter']").prop('disabled', true);

                $('#AffiliateUpdate').submit(function (e) {

                    e.preventDefault();

                    $("[name='Affiliate.Logo']").prop('disabled', false);
                    $("[name='Affiliate.WebFooter']").prop('disabled', false);
                    $("[name='Affiliate.EmailBanner']").prop('disabled', false);
                    $("[name='Affiliate.EmailFooter']").prop('disabled', false);

                    var jsonUrl = '/Admin/UpdateAffiliate';

                    var payload = $('form#AffiliateUpdate').serialize();

                    $.ajax({
                        type: 'POST',
                        contentType: 'application/x-www-form-urlencoded',
                        cache: false,
                        url: jsonUrl,
                        dataType: 'json',
                        data: payload,
                        beforeSend: function () {
                            // this is where we append a loading image
                            $('#resultWrapper').html('<span class="label label-warning">&nbsp;<i class="icon-spinner icon-spin "></i>&nbsp;Saving Updates...</span>');
                        }
                    }).done(function (data) {
                        $("[name='Affiliate.Logo']").prop('disabled', true);
                        $("[name='Affiliate.WebFooter']").prop('disabled', true);
                        $("[name='Affiliate.EmailBanner']").prop('disabled', true);
                        $("[name='Affiliate.EmailFooter']").prop('disabled', true);
                        // successful request; do something with the data
                        if (data.result === 'Success') {
                            $('#resultWrapper').html('<span class="label label-success">&nbsp;Saved</span>');
                        } else if (data.result === 'Failed') {
                            $('#resultWrapper').html('<span class="label label-danger">&nbsp;Update Failed</span>');
                        }

                    }).fail(commonFuncs.failCallBack)
                      .always(function (data, status, message) {

                          if (data && data.responseText) {
                              if (status === 'error' && JSON.parse(data.responseText)['Message'] === 'Uncaught Ajax Error') {
                                  L.clientLogger.error("HandleAjaxExceptionAttribute #457 ", { result: data });
                              }

                          }
                      });

                });

            });
        </script>
    }
}

