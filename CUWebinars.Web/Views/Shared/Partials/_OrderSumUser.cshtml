@using CUWebinars.Web.Core
@model Order

@{
    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;
    var myRow = Model.OrderRows.Single(or => or.RowStatus == OrderRowStatus.Active);
    NumberFormatInfo nfi = new CultureInfo("en-US", false).NumberFormat;
    nfi.CurrencyDecimalDigits = 0;

}
<div id="odrSum-@Model.idOrder" style="width: 250px;">

    <div style="font-size: small; " class="well well-small">
        <i>Order ID:</i> @globalConfig.TenantPrefix@Model.idOrder<br />
        <i>Date Ordered:</i> @Model.OrderDate.ToShortDateString()<br />
        <i>Type of Attendance:</i> @myRow.RegistrationType.OptionLabel<br />
        @if (myRow.ShipmentDate.HasValue)
        {
            <text>This order shipped on:<b>@Html.DisplayDate(myRow.ShipmentDate.Value)</b></text>
        }
        <i>Total Cost:</i> @Model.Total.ToString("C", nfi)
    </div>

</div>