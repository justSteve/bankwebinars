@using System.Text
@using CUWebinars.Business.Services
@model OrderRow
@{
    @*if (Model != null)
    {
        var verbose = false;
        if (ViewData.ContainsKey("verbose"))
        {
            if (!String.IsNullOrEmpty(ViewData["verbose"].ToString()))
            {
                verbose = (bool)ViewData["verbose"];
            }
        }
        var row = Model;

        decimal optionsTotal = OrderManagementService.CalculateOptionsPrice(row);
        StringBuilder rowAmount = new StringBuilder();
        if (row.DiscountFlatOff != 0.0M || row.DiscountPercentOff != 0.0M || optionsTotal != 0.0M)
        {
            rowAmount.Append("Base Cost: " + OptionsFacade.Instance.Load((int)row.RegistrationType).Price.ToString("c0") + "<br />");
        }
        else if (verbose == true)
        {
            rowAmount.Append("Base Cost: " + OptionsFacade.Instance.Load((int)row.RegistrationType).Price.ToString("c0") + "<br />");
        }

        if (row.DiscountFlatOff != 0.0M)
        {
            rowAmount.Append("Discounted: " + row.DiscountFlatOff.ToString("c") + " (" + row.DiscountCode + ")<br />");
        }
        else if (verbose == true)
        {
            rowAmount.Append("Discounted: " + row.DiscountFlatOff.ToString("c") + " (" + row.DiscountCode + ")<br />");
        }
        if (optionsTotal != 0.0M)
        {
            if (row.Options.OfType<AdditionalLocationsOrderRowOption>().Single().AdditionalLocationsCount == 1)
            {
                rowAmount.Append("One Additional Location: " + optionsTotal.ToString("c").Replace(".00", "") + "<br>");
            }
            else
            {
                rowAmount.Append(row.Options.OfType<AdditionalLocationsOrderRowOption>().Single().AdditionalLocationsCount.ToString() + " Additional Locations: " + optionsTotal.ToString("c").Replace(".00", "") + "<br>");
            }
        }
        else if (verbose == true)
        {
            if (row.Options.OfType<AdditionalLocationsOrderRowOption>().Single().AdditionalLocationsCount == 1)
            {
                rowAmount.Append("One Additional Location: " + optionsTotal.ToString("c").Replace(".00", "") + "<br>");
            }
            else
            {
                rowAmount.Append(row.Options.OfType<AdditionalLocationsOrderRowOption>().Single().AdditionalLocationsCount.ToString() + " Additional Locations: " + optionsTotal.ToString("c").Replace(".00", "") + "<br>");
            }
        }
        rowAmount.Append("Total Cost: " + row.RowPrice.ToString("c").Replace(".00", ""));

        <div id="billingDetails" class="well" style="text-align: right;">
            @Html.Raw(rowAmount.ToString())<br />

        @{
        var statusLabel = "";
        switch (row.Status)
        {
            case OrderStatus.InProcess:
                <span class="label label-warning">@OrderStatus.InProcess</span>
                break;

            case OrderStatus.Submitted:
            <span class="label label-info">@OrderStatus.Submitted</span>
                break;

            case OrderStatus.Paid:
            <span class="label label-success">@OrderStatus.Paid</span>
                break;

            case OrderStatus.PendingAuth:
            <span class="label label-warning">@OrderStatus.PendingAuth</span>
                break;
        }
        }

    </div>
    }*@
}
