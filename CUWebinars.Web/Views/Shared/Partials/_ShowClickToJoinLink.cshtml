@using System.Configuration


@{
    var url = "";
    if (@ConfigurationManager.AppSettings["Tenant"] == "BankWebinars")
    {
        url = "http://form.jotformpro.com/form/43462160046952?yourEmail21=";
    }
    if (@ConfigurationManager.AppSettings["Tenant"] == "CUWebinars")
    {
        url = "http://form.jotformpro.com/form/32764012877155?yourEmail21=";

    }

}

<script language="javascript" type="text/javascript">
    function openCJWindow() {
        window.open('@url' + $("#getEmail").val(), 'blank', 'scrollbars=yes,toolbar=no,width=700,height=500');
    }
</script>

<section>
    <p style="font-size: small;">
        Forward the Click-To-Join link to an associate (note: each link is good for a single sign-on).<br />
        @*<form action="/webinar/clicktojoin" method="post">*@
        <span class="input-append">
            <input type="email" id="getEmail" placeholder="Email Address" class="span6" name="email" />
            <button onclick="javascript: openCJWindow();" class="btn btn-primary">Send</button>

        </span>
        @*</form>*@<br />
        (We <i>won't</i> share your email address.)
    </p>
</section>


