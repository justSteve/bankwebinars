@using System.Configuration


@{
    var url = "";
    if (@ConfigurationManager.AppSettings["Tenant"] == "BankWebinars")
    {
        url = "http://eepurl.com/cQV2f5";
    }
    if (@ConfigurationManager.AppSettings["Tenant"] == "CUWebinars")
    {
        url = "http://eepurl.com/cQe9Gf";

    }
    if (@ConfigurationManager.AppSettings["Tenant"] == "DirectorSeries")
    {
        url = "http://eepurl.com/cXa77L";

    }
    if (@ConfigurationManager.AppSettings["Tenant"] == "MortgageWebinars")
    {
        url = "http://eepurl.com/dGQIxf";

    }
}

<script language="javascript" type="text/javascript">
    $('#getEmailForMC').on('click', function (e) {
        e.preventDefault();
        window.open('@url', 'blank', 'scrollbars=yes,toolbar=no,width=700,height=500');
    });

    function openJWindow() {
        window.open('@url', 'blank', 'scrollbars=yes,toolbar=no,width=700,height=500');
    }
</script>

<section>
    <p style="font-size: small;">
        Learn about upcoming events.<br />
        
        <span class="input-append">
            <input type="email" name="getEmailForMC1" placeholder="Email Address" class="span6" name="email" />
            <button onclick="javascript: openJWindow();" class="btn btn-primary">Sign Up</button>

        </span><br />
        (We <i>will not</i> share your email address.)
    </p>
</section>


