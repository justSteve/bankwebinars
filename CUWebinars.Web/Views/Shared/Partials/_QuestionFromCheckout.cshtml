@using System.Configuration


@{
    var url = "https://form.jotform.com/60898267714974";

}

<script language="javascript" type="text/javascript">
    function openJWindow() {
        window.open('@url' + $("#getQuestion").val(), 'blank', 'scrollbars=yes,toolbar=no,width=700,height=500');
    }
</script>

<section>
    <p>
        <span>
            <input type="text" id="getQuestion" placeholder="Your Question?" class="span6" name="question" />
            <button onclick="javascript: openJWindow();" class="btn btn-primary">Ask Us Anything!</button>

        </span>
    </p>
</section>



