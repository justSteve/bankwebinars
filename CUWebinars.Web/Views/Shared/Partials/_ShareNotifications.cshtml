@using System.Configuration




<section>
    <div style="font-size: small;">
        <form style="margin: 0;" action="/Account/ShareNotifications" method="post">

                <input type="email" id="getEmail" placeholder="Email Address" class="span6" name="email" />
                <input type="submit" class="btn btn-primary" value="Submit" />
            
        </form>
        <div style="text-align: center; margin: 3px;">
            Want an associate to recieve copies of this event's notifications? Just enter an email and we'll send a copy of any messages sent to the primary email address.
        </div>
    </div>
</section>



