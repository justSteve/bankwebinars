@using System.Configuration


@{
    var url = "";
    if (@ConfigurationManager.AppSettings["Tenant"] == "BankWebinars")
    {
        url = "http://form.jotformpro.com/form/50827231711953?feedback=";
    }
    if (@ConfigurationManager.AppSettings["Tenant"] == "CUWebinars")
    {
        url = "http://form.jotform.us/form/51606487629162?feedback=";
    }
    if (@ConfigurationManager.AppSettings["Tenant"] == "CCS")
    {
        url = "http://form.jotform.us/form/82665882832974?feedback=";
    }
    if (@ConfigurationManager.AppSettings["Tenant"] == "DES")
    {
        url = "http://form.jotform.us/form/82665890932974?feedback=";
    }
    if (@ConfigurationManager.AppSettings["Tenant"] == "MortgageWebinars")
    {
        url = "http://form.jotform.us/form/82666742532967?feedback=";
    }

}

<script language="javascript" type="text/javascript">
    function openCOWindow() {
        window.open('@url' + $("#getFeedback").val(), 'blank', 'scrollbars=yes,toolbar=no,width=700,height=500');
    }
</script>

<section>
    <p style="font-size: small;">
        Your feedback is critical to our ability to improve your experience!<br />

        <span class="input-append">
            <input type="text" id="getFeedback" placeholder="Your Comment?" class="span6" name="Comment" />
            <button onclick="javascript: openCOWindow();" class="btn btn-primary">How did we do?</button>

        </span>
    </p>
</section>



