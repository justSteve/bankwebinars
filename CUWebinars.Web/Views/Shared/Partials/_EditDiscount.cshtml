@model CUWebinars.Web.Models.EditDiscountModel
@using (Html.BeginForm("EditDiscount", "Account", "Post"))
{
    @Html.AntiForgeryToken()

    <div id="DiscountContainer" class="well-large">
        <h3>Discount</h3>
        @Html.EditorFor(b => b.Discount)
    </div>
    <div class="form-inline">
        <div class="btn-group" style="width:160px">&nbsp;</div>
        <div class="btn-group">
            <input type="submit" value="Update Discount" class="btn btn-default" />
        </div>
    </div>
}


