@if (Request.IsAuthenticated)
{
    <nav class="user clearfix">
        @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm" }))
        {
            var identity = ((System.Security.Claims.ClaimsIdentity)User.Identity)
                .Claims
                .Where(c => c.Type == CUWebinars.Business.Constants.ClaimTypes.FullName)
                .FirstOrDefault();
            
            if(!ReferenceEquals(null, identity))
            {
                @Html.AntiForgeryToken()
                @Html.ActionLink(identity.Value, "Manage", "Account", routeValues: null, htmlAttributes: new { title = "Manage" })
                <a href="javascript:document.getElementById('logoutForm').submit()">&nbsp;&nbsp;[Log Off]</a>
            }
            else
            {
                <a href="@Url.Action("Login", "Account")"><i class="icon-user"></i> Login</a>
            }
            
        }
    </nav>
}
else
{
    <nav class="user clearfix"> <a href="@Url.Action("Login", "Account")"><i class="icon-user"></i> Login</a> </nav>
}
