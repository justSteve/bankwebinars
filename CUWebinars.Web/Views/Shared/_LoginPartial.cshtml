@if (Request.IsAuthenticated)
{
    <nav class="user clearfix">
        @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new {id = "logoutForm"}))
        {
            Claim identity;

            if (ReferenceEquals(null, ViewBag.LoggedInUserIdentity))
            {
                identity = ((ClaimsIdentity) User.Identity)
                    .Claims
                    .FirstOrDefault(c => c.Type == CUWebinars.Business.Constants.ClaimTypes.FullName);
            }
            else
            {
                identity = ViewBag.LoggedInUserIdentity as Claim;
            }

            if (!ReferenceEquals(null, identity))
            {
                @Html.AntiForgeryToken()
                @*
                    @Html.ActionLink(identity.Value, "EditContactInfo", "Account", routeValues: null, htmlAttributes: new { title = "Manage", id = "btnLogin" })*@
                @Html.ActionLink(identity.Value, "Manage", "Account", routeValues: null, htmlAttributes: new {title = "Edit Billing", id = "btnLogin"})
                @*<span>@identity.Value</span>*@

                if (ReferenceEquals(Session["AdminUserEmail"], null))
                {
                    <a href="javascript:document.getElementById('logoutForm').submit()">&nbsp;&nbsp;[Log Off]</a>
                }
                else
                {
                    <a href="javascript:document.getElementById('logoutForm').submit()">&nbsp;&nbsp;[Release]</a>
                }
            }
            else
            {
                <a id="btnLogin" href="@Url.Action("Login", "Account")"><i class="icon-user"></i> Login</a>
            }

            if (!ReferenceEquals(null, ViewBag.UserHasDiscount))
            {
                <div class="search-wrapper">
                    @Html.Partial("_DiscountPartial")
                </div>
            }
            if (!ReferenceEquals(null, ViewBag.UserHasMessages))
            {
                <div class="search-wrapper">
                    @Html.Partial("_MessagesPartial")
                </div>
            }


        }

    </nav>
}
else
{
    <nav class="user clearfix"> <a id="btnLogin" href="@Url.Action("Login", "Account")"><i class="icon-user"></i> Login</a> </nav>
}
