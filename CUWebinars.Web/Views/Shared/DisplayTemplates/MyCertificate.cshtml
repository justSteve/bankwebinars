@using CUWebinars.Web.Core
@model CertOfCompletionViewModel

<div id="MyCertificate-@Model.Order.idOrder" style="width: 150px;">
    <div style="margin-top: 10px;">
        <form method="POST" action="/Account/MyCertificate">
            <input type="hidden" name="orderID" value="@Model.Order.idOrder" />
            <input type="submit" value="My Certificate" id="ShowCertificate" class="btn pull-right btn-mini btn-success" />
        </form>
    </div>
</div>
