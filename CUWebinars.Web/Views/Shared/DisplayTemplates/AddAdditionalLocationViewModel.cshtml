@model AddAdditionalLocationViewModel
    
<blockquote style="margin-bottom: 0;color:red;font-weight:bold">
    TODO: replace with dynamic text!!! @*@Model.AdditionalLocation.DescriptionConfirm*@
</blockquote>
<div style="padding-left: 50px;">
    <b>Each additional location adds $150 to your registration:</b> @*TODO: this is hard coded. Need to change that.*@
    <div id="AdditionalLocationContainer">
        
        <div class="row pull-right">
            <button value="Add?" type="button" class="btn btn-success btn-small" name="AddLocationsButton" id="AddLocationsButton">Add?</button>
        </div>

        @{
            
            var emails = Model.AdditionalLocations.Select(al => al.Email).ToArray();

            <ol>
                @for (int i = 0; i < emails.Length; i++)
                {
                    <li>@emails[i]</li>
                }
            </ol>
        }

        </div> 
</div>

<!-- Button to trigger modal -->


<!-- Modal -->
<div id="AdditionalLocationsModal" class="modal hide fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-body">
        @* modal content goes here *@
    </div><!-- /.modal-content -->
</div>


@Scripts.Render("~/bundles/AdditionalLocation")
