@using CUWebinars.Web.Core
@model Order
@{
    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;
    var myRow = Model.OrderRows.Single(or => or.RowStatus == OrderRowStatus.Active);
    NumberFormatInfo nfi = new CultureInfo("en-US", false).NumberFormat;
    nfi.CurrencyDecimalDigits = 0;


    var dataOperations = new CUWebinars.Business.Core.DataOperations(GlobalConfig.GlobalConfigSingleton.DefaultConnectionString);

    Double[] i = dataOperations.GetCostOfUpgrades(Model.OrderRows.Single(or => or.RowStatus == OrderRowStatus.Active).idRegType);

    Double basePrice = i[0];
    Double cost6 = i[1] - basePrice;
    Double costCD = i[2] - basePrice;

}
<span class="btn btn-success btn-mini" id="upgradeRegistration_@Model.idOrder">Upgrade</span> this registration with an <i>OnDemand Recording package</i> for @cost6.ToString("C", nfi) or our <i>Premium package</i> for @costCD.ToString("C", nfi)!<br />
