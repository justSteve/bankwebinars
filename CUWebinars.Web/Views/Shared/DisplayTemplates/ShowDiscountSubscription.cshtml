@model DiscountModel

<style>
    .form-horizontal .control-group {
        margin-bottom: 5px;
    }

        .form-horizontal .control-group input {
            border-radius: 0px;
            padding: 1px 6px;
        }

    input[type="radio"], input[type="checkbox"] {
        margin: 0;
    }

    table td {
        border: thin solid;
        border-spacing: 1px;
        padding: 3px;
    }
</style>

@Html.HiddenFor(model => model.DiscountCode)


@*why no show: cgelormino@lakelandbank.com*@
@if (
Model.TypeOfDiscount == DiscountType.Subscription
    )
{
    <div class="row-fluid">
        <div class="span4 offset1">
            <div>
                @if (Model.CreditsRemain > 0)
                {
                    if (Model.DateValidTo > Model.DateValidFrom)
                    {
                        <p style="font-size: larger">
                            Your subscription will expire on @Model.DateValidTo.ToShortDateString()
                        </p>
                    }
                    else
                    {
                        if (Model.CreditsRemain < 1.1M)
                        {
                            <p style="font-size: larger">
                                Your subscription (@Model.DiscountCode) has <b>@Model.CreditsRemain.ToString().Replace(".00", "")</b> credit remaining.
                            </p>
                        }
                        else
                        {
                            <p style="font-size: larger">
                                Your subscription (@Model.DiscountCode) has <b>@Model.CreditsRemain.ToString().Replace(".00", "")</b> credits remaining.
                            </p>

                            <p style="font-size: larger">
                                @if (Model.UsersOnWsp != null && Model.UsersOnWsp.Count() > 1)
                                {
                                    <div><b>The following users have access: </b></div>
                                    foreach (var webUser in @Model.UsersOnWsp.Distinct())
                                    {
                                        <div class="userOfWsp">@webUser.email</div>
                                    }
                                    @*<div><b>Need to add someone?</b> <input type="text" name="addUserToWSP" /></div>*@
                                }
                            </p>
                            <p style="font-size: larger">
                                @if (Model.WspUsageSum != null && Model.WspUsageSum
                                    .Where(o => o.OrderStatus == OrderStatus.Billed || o.OrderStatus == OrderStatus.Paid).Count() > 1)
                                {
                                    <div><b>The following orders have been paid for via this WSP:</b></div>
                                    //build table starts here
                                    <table width="1000">
                                        <tr><td>Order ID</td><td>Date</td><td>Email</td><td>Event Title - Date</td><td>Credits Used</td></tr>
                                        @foreach (var order in @Model.WspUsageSum.Where(o => o.OrderRows.SingleOrDefault(r => r.RowStatus == OrderRowStatus.Active).idWebinar != 2520)
                                            .OrderByDescending(o => o.OrderDate))
                                        {
                                            //these are the rows
                                            <tr>
                                                <td>
                                                    <div class="orderByWsp">
                                                        @order.idOrder
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="orderByWsp">
                                                        @order.OrderDate.ToShortDateString()
                                                    </div>
                                                </td>

                                                <td>
                                                    <div class="orderByWsp">
                                                        @order.BillingEmail
                                                    </div>
                                                </td>                                                <td>
                                                    <div class="orderByWsp">
                                                        @order.OrderRows.SingleOrDefault(r => r.RowStatus == OrderRowStatus.Active).Webinar.Title  (@order.OrderRows.SingleOrDefault(r => r.RowStatus == OrderRowStatus.Active).Webinar.Date.ToShortDateString())
                                                    </div>
                                                </td>                                                <td>
                                                    <div class="orderByWsp">
                                                        @order.OrderRows.SingleOrDefault(r => r.RowStatus == OrderRowStatus.Active).RegistrationType.CreditCost
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </table>
                                    @*<div>Have a question or comment?<input type="text" name="addQuestionFromWspUsageSum" /></div>*@
                                }
                            </p>
                        }
                    }
                }
                else
                {

                    <p style="font-size: larger; color: red;">
                        Your subscription package has expired.
                    </p>
                }
                @if (Model.DateValidTo > Model.DateValidFrom)
                {
                    <p style="font-size: larger">
                        <a class="btn btn-success pull-right" href="javascript:void( window.location='https://www.bankwebinars.com/webinar/details/2520?renew=@Model.DiscountCode', 'blank')">Order Today!</a>
                    </p>
                }
                else
                {
                    <div style="margin-top: 6px;">
                        <a class="btn btn-success pull-right" href="javascript:void( window.location='https://www.bankwebinars.com/webinar/details/2520?renew=@Model.DiscountCode', 'blank')">Add More!</a>
                    </div>}
            </div>
            @*<div>@Html.RenderPartial("DisplayTemplates/ShowOrdersByDiscount", Model);</div>*@
        </div>

        @*<div class="span4 offset1 ">
                Combine your Webinar Subscription Package
                with a 6 or 12 month Compliance Perspectives subscription
                package for the ultimate in regulatory training coverage.

                <table align="center" style="border: black; margin-top: 6px;">
                    <tr style="background-color: lightcyan">
                        <td>Add 6 Months</td>
                        <td>$990</td>
                    </tr>
                    <tr style="background-color: lightblue">
                        <td>Add 12 Months</td>
                        <td>$1,695</td>
                    </tr>
                </table>

                <div style="margin: 10px;">
                    <p>
                        <a class="btn btn-success pull-right" href="javascript:void( window.open('http://form.jotformpro.com/form/51955606623964', 'blank','scrollbars=yes,toolbar=no,width=700,height=500'))">Order Today!</a>
                    </p>
                </div>

            </div>*@
    </div>
}