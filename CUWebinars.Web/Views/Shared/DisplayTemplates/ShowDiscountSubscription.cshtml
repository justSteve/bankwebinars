@model DiscountModel

<style>
    .form-horizontal .control-group {
        margin-bottom: 5px;
    }

        .form-horizontal .control-group input {
            border-radius: 0px;
            padding: 1px 6px;
        }

    input[type="radio"], input[type="checkbox"] {
        margin: 0;
    }

    table td {
        border: thin solid;
        border-spacing: 1px;
        padding: 3px;
    }
</style>

@Html.HiddenFor(model => model.DiscountCode)



@if (Model.DiscountCode.StartsWith("CP"))
{
    <div class="row-fluid">
        <div class="span4 ">
            Your annual Compliance Perspectives subscription will
            renew on @Model.DateValidTo.ToShortDateString() for
            a @Model.RenewalTerm month term totaling $@Model.Cost.ToString().Replace(".00", "")<text>.</text>
        </div>


        <div class="span4 offset1 ">
            Combine your Compliance Perspectives registration
            with a 6 or 12 month subscription package for the ultimate in
            regulatory training coverage.


            <table align="center" style="border: black; margin-top: 6px;">
                <tr style="background-color: lightcyan">
                    <td>Add 6 Month Unlimited</td>
                    <td>$5,800</td>
                </tr>
                <tr style="background-color: lightblue">
                    <td>Add 12 Month Unlimited</td>

                    <td>$9,775</td>
                </tr>
            </table>

            <div style="margin-top: 6px;">
                <a class="btn btn-success pull-right" href="javascript:void( window.open('http://form.jotformpro.com/form/51916745818971', 'blank','scrollbars=yes,toolbar=no,width=700,height=500'))">Order Today!</a>
            </div>

        </div>
    </div>
}

@if (
Model.DiscountCode.StartsWith("BZ") ||
Model.DiscountCode.StartsWith("SL") ||
Model.DiscountCode.StartsWith("GD") ||
Model.DiscountCode.StartsWith("PL")
    )
{
    <div class="row-fluid">
        <div class="span4 offset1">
            <div>
                @if (Model.CreditsRemain > 0)
                {
                    <p style="font-size: larger">
                        Your subscription (@Model.DiscountCode) has <b>@Model.CreditsRemain.ToString().Replace(".00", "")</b> remaining.
                    </p>
                }
                else
                {
                    <p style="font-size: larger; color: red;">
                        Your subscription package has expired. It has been used <b> @Model.CreditsUsed.ToString().Replace(".00", "")</b> times.
                    </p>
                }
                <div style="margin-top: 6px;">
                    <a class="btn btn-success pull-right" href="javascript:void( window.open('http://form.jotformpro.com/form/51916745818971', 'blank','scrollbars=yes,toolbar=no,width=700,height=500'))">Click here to add more credits!</a>
                </div>
            </div>
        </div>

        <div class="span4 offset1 ">
            Combine your Webinar Subscription Package
            with a 6 or 12 month Compliance Perspectives subscription
            package for the ultimate in regulatory training coverage.

            <table align="center" style="border: black; margin-top: 6px;">
                <tr style="background-color: lightcyan">
                    <td>Add 6 Months</td>
                    <td>$990</td>
                </tr>
                <tr style="background-color: lightblue">
                    <td>Add 12 Months</td>
                    <td>$1,695</td>
                </tr>
            </table>

            <div style="margin: 10px;">
                <p>
                    <a class="btn btn-success pull-right" href="javascript:void( window.open('http://form.jotformpro.com/form/51955606623964', 'blank','scrollbars=yes,toolbar=no,width=700,height=500'))">Order Today!</a>
                </p>
            </div>

        </div>
    </div>
}