@using System.Configuration
@model Webinar

<div id="showHandouts-@Model.idWebinar ">
    @{
        foreach (var file in Model.WebinarFiles)
        {
            <a class="btn btn-warning" href='@ConfigurationManager.AppSettings["HandoutRepository"]@file.fileLocation' target='_blank'>@file.fileDesc</a>
            <br />
        }
    }
</div>