@model TTSDataLayer.Models.Webinar

<div id="showHandouts-@Model.idWebinar ">
    <p style="margin-left: 50px;" class="cCon">
        Download Materials
    </p>
    <div class="handouts" style="margin-left: 50px;">
        @{
            foreach (var file in Model.WebinarFiles)
            {
                <a href='http://@file.fileLocation' target='_blank'>@file.fileDesc</a>
                <br />
            }
        }
    </div>
</div>