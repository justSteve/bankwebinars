@using CUWebinars.Web.Utils
@{
    var currentAffiliate = CurrentSession.Instance.CurrentAffiliate;
    //    var currentUser = UserFacade.Instance.GetCurrentUser();
    var currentUserID = 0;
    var currentUserAffiliateFullName = "na";
    ////    var currentUser = UserFacade.Instance.GetCurrentUser();
    //var currentUserID = 0;
    //var currentUserAffiliateFullName = "na";
    ////var currentUser = CurrentSession.Instance.CurrentUser;

    ////if (currentUser != null)
    ////{
    ////    currentUserID = currentUser.ID;
    ////    currentUserAffiliateFullName = currentUser.Affiliate.FullName;
    ////}

    var sessionRecorded = "";

    var sessionUpcoming = "";
    if (Session["upcoming"] != null)
    {
        sessionRecorded = Session["rec"].ToString();
        sessionUpcoming = Session["upcoming"].ToString();
    }
    else
    {
        Response.Redirect("/");
    }

    if (Session["IncludeUpcoming"] == null)
    {
        Session["IncludeUpcoming"] = "true";
    }

    if (Session["IncludeRecorded"] == null)
    {
        Session["IncludeRecorded"] = "false";
    }
    if (Session["IncludeArchived"] == null)
    {
        Session["IncludeArchived"] = "false";
    }
}

