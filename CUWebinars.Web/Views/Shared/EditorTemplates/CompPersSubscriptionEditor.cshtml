@model CompPersSubscriptionsModel

<style>
    .form-horizontal .control-group {
        margin-bottom: 5px;
    }

        .form-horizontal .control-group input {
            border-radius: 0px;
            padding: 1px 6px;
        }

    input[type="radio"], input[type="checkbox"] {
        margin: 0;
    }
</style>

@{
    var autoRenew = false;

}
@Html.HiddenFor(model => model.Discount.DiscountCode)

<div class="row-fluid">
    <div class="span4 control-group">
        <div>Start Date: @Model.Discount.DateValidFrom.ToShortDateString()</div>
    </div>

    <div class="span4 control-group">
        <div>Expires: @Model.Discount.DateValidTo.ToShortDateString()</div>
    </div>
</div>

@if (Model.Discount.Notes.Contains("autorenew"))
{    <div class="row-fluid">
        <div class="span4 offset1 control-group">Your subscription is set to auto-renew when your current term ends. Call 800-831-0678 ext. 303 to cancel. </div>
    </div>
    <script type="text/javascript">
        $(document).ready(function() {
            $("#saveChangesButton").hide();
            });
    </script>
}
else
{
    <div class="row-fluid">
        <b>Please choose your renewal term.</b>
    </div>
    <div class="row-fluid">
        <div class="span3 control-group">
            <label for="renew_6"> <input type="radio" id="renew_6" name="renew_6" /> 6 Months - $954 </label>
        </div>
        <div class="span3 control-group">
            <label for="renew_12"><input type="radio" id="renew_12" name="renew_12" /> 12 Months - $1749</label>
        </div>
    </div>
}


@*and so on*@
