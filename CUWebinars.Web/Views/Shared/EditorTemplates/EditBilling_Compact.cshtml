@model  EditOrderInfoModel

@Html.HiddenFor(model => model.EditFields.Id)
<style>
    .form-horizontal .control-group {
        margin-bottom: 5px;
    }

        .form-horizontal .control-group input {
            border-radius: 0px;
            padding: 1px 6px;
        }
</style>


<div class="row-fluid">
    <div class="span4 control-group">
        @Html.LabelFor(model => model.EditFields.AdditionalLocations, new { @class = "control-label" })
        <div class="controls">
            @Html.EditorFor(model => model.EditFields.AdditionalLocations)
            @Html.ValidationMessageFor(model => model.EditFields.AdditionalLocations)
        </div>
    </div>

    <div class="span4 control-group">
        @Html.LabelFor(model => model.EditFields.LastName, new { @class = "control-label" })
        <div class="controls">
            @Html.EditorFor(model => model.EditFields.LastName)
            @Html.ValidationMessageFor(model => model.EditFields.LastName)
        </div>
    </div>
</div>
<div class="row-fluid">
    <div class="span4 control-group">
        @Html.LabelFor(model => model.EditFields.Title, new { @class = "control-label" })
        <div class="controls">
            @Html.EditorFor(model => model.EditFields.Title)
            @Html.ValidationMessageFor(model => model.EditFields.Title)
        </div>
    </div>
    <div class="span4 control-group">
        @Html.LabelFor(model => model.EditFields.Institution, new { @class = "control-label" })
        <div class="controls">
            @Html.EditorFor(model => model.EditFields.Institution, new { @class = "control-label", disabled = "disabled" })
        </div>
    </div>
</div>
<div class="row-fluid">
    <div id="BillingAddressContainer">
        <div class="span5">
            <h4>Billing Address</h4>
            @Html.EditorFor(b => b.BillingAddress)
        </div>
    </div>


    <div id="ShippingAddressContainer">
        <div class="span4">

            <div id="linksToAddShippingFields" class="pull-right">
                <a href="" class="btn btn-mini pull-right" id="AddShippingAddressLink">Set Shipping Address?</a>
                <a href="" class="btn btn-mini pull-right" id="HideAddShippingAddressLink">Set Shipping to Billing?</a>

            </div>
            <div>
                <h4>Shipping Address</h4>
                @Html.EditorFor(b => b.ShippingAddress)
            </div>
        </div>
    </div>

    @Html.HiddenFor(m => m.AccountDetailsTitle)

    <div id="passwordWrapper">
        @*// not implemented*@
    </div>
</div>
