@model EditInstitutionInfoModel

@Html.HiddenFor(model => model.EditFields.idOfCurrentUser)
<style>
    .form-horizontal .control-group {
        margin-bottom: 5px;
    }

        .form-horizontal .control-group input {
            border-radius: 0px;
            padding: 1px 6px;
        }
</style>

<form id="edit-institution-form" class="form-compact" novalidate="novalidate">
    <div class="row-fluid">
        <div class="control-group">
            <div class="span4">
                @Html.LabelFor(model => model.EditFields.InstitutionName, new {@class = "control-label span3"})
                <div class="controls span8">
                    @Html.EditorFor(model => model.EditFields.InstitutionName)
                    @Html.ValidationMessageFor(model => model.EditFields.InstitutionName)
                </div>
            </div>
            <div class="span4 ">
                @Html.LabelFor(model => model.EditFields.City, new {@class = "control-label span3"})
                <div class="controls span8">
                    @Html.EditorFor(model => model.EditFields.City)
                    @Html.ValidationMessageFor(model => model.EditFields.City)
                </div>
            </div>
        </div>
    </div>
    <div class="row-fluid">
        <div class="control-group">
            <div class="span5 center">
                @*@Html.HiddenFor(model => model.EditFields.idWebUser)*@
                @Html.HiddenFor(model => model.EditFields.idOfCurrentUser)
                @Html.HiddenFor(model => model.EditFields.idInstitution)
                @Html.AntiForgeryToken()

                <button id="save-changes-institution" class="btn btn-success btn-small">Save changes</button>
                <a href="#" id="cancel-changes" class="btn btn-link">Cancel</a>
            </div>
            <div class="span7 center">
                <button class="btn btn-small btn-success show-other-users">Other Users</button>
            </div>
        </div>
    </div>
</form>