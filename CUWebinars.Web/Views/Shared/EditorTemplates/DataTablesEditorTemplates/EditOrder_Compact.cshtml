@model  CUWebinars.Web.Models.DataTablesModels.EditOrderInfoModel

@{
    var abbvLable = "";

    if (Model.EditFields.DisplayRowPriceViewModel.RegistrationType.OptionLabel.StartsWith("Live Plus Five"))
    {
        abbvLable = "Live";
    }
    if (Model.EditFields.DisplayRowPriceViewModel.RegistrationType.OptionLabel.StartsWith("OnDemand"))
    {
        abbvLable = "Recorded Only";
    }
    if (Model.EditFields.DisplayRowPriceViewModel.RegistrationType.OptionLabel.StartsWith("CD"))
    {
        abbvLable = "CD-ROM";
    }

}

@Html.HiddenFor(model => model.EditFields.Id)
<style>
    .form-horizontal .control-group {
        margin-bottom: 5px;
    }

        .form-horizontal .control-group input {
            border-radius: 0px;
            padding: 1px 6px;
        }
</style>


<div class="row-fluid">

    <div class="offset1 span4 control-group">
        <table>
            <tr>
                <td align="right">
                    @abbvLable
                </td>
                <td>@Model.EditFields.DisplayRowPriceViewModel.Price.ToString("C0")</td>
                <td id="_xRowPrice"></td>
            </tr>
            <tr>
                <td align="right">
                    AddLocs:
                </td>
                <td>@Model.EditFields.DisplayRowPriceViewModel.PricesAndDiscounts.TotalCostOfOptions.ToString("C0")</td>
                <td id="_xAddLoc"><i class="fa fa-plus-circle"></i></td>
            </tr>
            <tr>
                <td align="right">
                    Discount:
                </td>
                <td>@Model.EditFields.DisplayRowPriceViewModel.PricesAndDiscounts.TotalDiscount.ToString("C0")</td>
                <td><i id="_xDiscount" class="icon-white icon-plus-sign"></i></td>
            </tr>
            @if (@Model.EditFields.DisplayRowPriceViewModel.PricesAndDiscounts.TaxAmount > 0)
            {
                <tr>
                    <td align="right">
                        Tax:
                    </td>
                    <td>@Model.EditFields.DisplayRowPriceViewModel.PricesAndDiscounts.TaxAmount.ToString("C0")</td>
                    <td id="_xTax"><i class="fa fa-plus-circle"></i></td>
                </tr>
            }
            <tr>
                <td align="right">
                    Total Price:
                </td>
                <td>@Model.EditFields.DisplayRowPriceViewModel.PricesAndDiscounts.TotalOrderPrice.ToString("C0")</td>
                <td id="_xTotalPrice"></td>
            </tr>
        </table>
    </div>
    <div span4>
        <div id="addLocsPanel" class=" hidden">
            <div class="control-group">
                <div class="controls">
                    There are <span id="nrAddLocs">@Model.EditFields.NumberOfAdditionalLocations</span> Additional Locations for this order.
                    @if (Model.EditFields.AdditionalLocationsAvailableOnLoad)
                    {
                        <button id="addLocationsButton" class="btn btn-default btn-small">add more?</button>
                    }
                    else
                    {
                        <button id="addLocationsButton" class="btn btn-default btn-small" disabled="disabled">add more?</button>
                    }

                </div>
                @Html.Raw(Model.EditFields.AdditionalLocationsRenderer.ToString())
            </div>
            <div class="control-group">
                <label class="control-label" for="DisplayRowPriceViewModel_PricesAndDiscounts_TotalCostOfOptions">Total Additional Locations Price:</label>
                <div class="controls">

                    @Html.TextBoxFor(m => m.EditFields.DisplayRowPriceViewModel.PricesAndDiscounts.TotalCostOfOptions, new { id = "TotalCostOfOptionsText", disabled = "disabled" }) @*read-only*@
                    @Html.HiddenFor(m => m.EditFields.DisplayRowPriceViewModel.PricesAndDiscounts.TotalCostOfOptions) @* Required for POST. TextBoxFor won't ModelBind *@
                    &nbsp;
                    <button id="UpdateAddLocsButton" class="btn btn-primary btn-mini">Update Additional Locations</button>
                </div>
            </div>
        </div>
        <div id="discountPanel" class="hidden">
            
        </div>
    </div>
</div>
