@model  CUWebinars.Web.Models.DataTablesModels.EditOrderInfoModel

@{
    var regTypeDropDownHtml = ViewBag.RegTypeDropDownHtml;
    var discount = Model.EditFields.Discount;

    var abbvLable = Model.EditFields.DisplayRowPriceViewModel.RegistrationType.OptionLabel;


    if (Model.EditFields.DisplayRowPriceViewModel.RegistrationType.OptionLabel.StartsWith("Live Plus Five"))
    {
        abbvLable = "Live";
    }
    if (Model.EditFields.DisplayRowPriceViewModel.RegistrationType.OptionLabel.StartsWith("OnDemand"))
    {
        abbvLable = "Recorded Only";
    }
    if (Model.EditFields.DisplayRowPriceViewModel.RegistrationType.OptionLabel.StartsWith("CD"))
    {
        abbvLable = "CD-ROM";
    }
}

@Html.HiddenFor(model => model.EditFields.idOrderRow)

@using (Html.BeginForm("UpdateAdditionalLocations", "Admin", FormMethod.Post, new { id = "updateAdditionalLocationsForm" }))
{
    @Html.AntiForgeryToken()
    @*<input type="hidden" name="orderRowId" value="@Model.EditFields.Order.OrderRows.SingleOrDefault(r => r.RowStatus == OrderRowStatus.Active).idOrderRow" />
        <input type="hidden" name="additionalLocations" value="" id="updateAdditionalLocationsForm_addLocs" />*@
}

<script src="~/Scripts/app/admin/edit-forms-in-grid.js"></script>
<script src="~/Scripts/app/cart/add-additional-locations.js"></script>
<style>
    #EditFields_DisplayRowPriceViewModel_Discount_DiscountCode {
        margin-top: 9px;
    }



    .form-horizontal .control-group {
        margin-bottom: 5px;
    }

        .form-horizontal .control-group input {
            border-radius: 0px;
            padding: 1px 6px;
        }
</style>

<script type="text/javascript" language="javascript">

    //$("#addLocsPanel").hide();
    //$("#discountPanel").hide();
    //$("#_xAddLoc").click(function () {
    //    $("#discountPanel").hide();
    //    $("#addLocsPanel").show();
    //});

    //$("#_xDiscount").click(function () {
    //    $("#discountPanel").show();
    //    $("#addLocsPanel").hide();
    //});
    $("#displayRegType").text("@abbvLable");
</script>

<div class="row-fluid">
    <div class="span12">
        <div class="span1 control-group">
            <div class="dropdown">
                <a class="dropdown-toggle btn btn-info btn-small" data-toggle="dropdown" href="#">Change Order</a>
                <ul class="dropdown-menu" role="menu" aria-labelledby="dropdownMenu">
                    <li><a tabindex="-1" href="#" id="showChangeUser">Assign to Different User</a></li>
                    <li><a tabindex="-1" href="#" id="showChangeAssignedAffiliate">Credited to <span id="affiliateNameText">@Model.EditFields.Order.Affiliate.ttsDomain</span> Change?</a></li>
                    <li><a tabindex="-1" href="#" id="showMonerisModal">Submit Payment</a></li>
                    <li><a tabindex="-1" href="#" id="showExtendAccessButton">Extend OnDemand Access</a></li>
                </ul>
            </div>
        </div>
        <div class="span2">
            <table width="100%;">
                <tr>
                    <td align="right">@Html.Raw(regTypeDropDownHtml)</td>
                    <td align="right" id="DisplayRowPriceViewModel_PricesAndDiscounts_UnitPrice">@Model.EditFields.DisplayRowPriceViewModel.Price.ToString("C0")</td>
                </tr>
                <tr>
                    <td>AddLocs:</td>
                    <td id="DisplayRowPriceViewModel_PricesAndDiscounts_TotalCostOfOptions">@Model.EditFields.DisplayRowPriceViewModel.PricesAndDiscounts.TotalCostOfOptions.ToString("C0")</td>
                </tr>
                <tr>
                    <td align="right">Discount:</td>
                    <td align="right" id="DisplayRowPriceViewModel_PricesAndDiscounts_TotalDiscount"><span></span> @Model.EditFields.DisplayRowPriceViewModel.PricesAndDiscounts.TotalDiscount.ToString("C0")</td>

                </tr>
                @if (@Model.EditFields.DisplayRowPriceViewModel.PricesAndDiscounts.TaxAmount > 0)
                {
                    <tr>
                        <td align="right">Tax:</td>
                        <td align="right">@Model.EditFields.DisplayRowPriceViewModel.PricesAndDiscounts.TaxAmount.ToString("C0")</td>
                    </tr>
                }
                <tr>
                    <td>
                        <div align="right">Total:</div>
                    </td>
                    <td id="DisplayRowPriceViewModel_PricesAndDiscounts_TotalOrderPrice">
                        <div class="align_right">@Model.EditFields.DisplayRowPriceViewModel.PricesAndDiscounts.TotalOrderPrice.ToString("C0")</div>
                    </td>
                </tr>
            </table>
        </div>
        <div style="background-color: lightsteelblue" class="span4">
            <div id="addLocsPanel" style="text-align: center; border-style: solid;">
                @using (Html.BeginForm("UpdateOrderCompactAddLoc", "Account", FormMethod.Post, new { id = "editOrderCompactAddLoc" }))
                {
                    @Html.AntiForgeryToken()
                    <div>
                        @Html.HiddenFor(m => m.EditFields.CostPerAdditionalLocation)
                        @Html.HiddenFor(m => m.EditFields.idOrderRow)
                        @Html.HiddenFor(m => m.EditFields.WebUser.idUser)
                        @Html.HiddenFor(m => m.EditFields.WebinarId)
                        @Html.HiddenFor(m => m.EditFields.NumberOfAdditionalLocations)
                        @Html.HiddenFor(m => m.EditFields.DisplayRowPriceViewModel.NumberOfAdditionalLocations)
                        @Html.HiddenFor(m => m.EditFields.DisplayRowPriceViewModel.Price)
                        @Html.HiddenFor(m => m.EditFields.DisplayRowPriceViewModel.RowPrice)
                        @Html.HiddenFor(m => m.EditFields.DisplayRowPriceViewModel.PricesAndDiscounts.TotalCostOfOptions) @* Required for POST. TextBoxFor won't ModelBind *@&nbsp;
                    </div>
                    <div class="control-group">
                        <div class="controls">
                            @if (Model.EditFields.AdditionalLocationsAvailableOnLoad)
                            {
                                <button id="addLocationsButton" class="btn btn-default btn-mini">Add?</button>
                            }
                            else
                            {
                                <button id="addLocationsButton" class="btn btn-default btn-mini" disabled="disabled">na</button>
                            }
                            Additional Locations: <span id="nrAddLocs">@Model.EditFields.NumberOfAdditionalLocations</span>

                        </div>
                        @Html.Raw(Model.EditFields.AdditionalLocationsRenderer.ToString())
                    </div>
                    <div class="control-group">
                        Billable:
                        @Model.EditFields.DisplayRowPriceViewModel.PricesAndDiscounts.TotalCostOfOptions.ToString("C0")
                        @*@Html.TextBoxFor(m => m.EditFields.DisplayRowPriceViewModel.PricesAndDiscounts.TotalCostOfOptions, new { id = "TotalCostOfOptionsText", disabled = "disabled" })*@
                        <button id="UpdateAddLocsButton" class="btn btn-primary btn-mini">Commit Updates</button>
                    </div>
                }
            </div>
            <div style="text-align: center; border-style: solid;" id="discountPanel">




                @if (discount == null)
                {
                    @Html.TextBoxFor(m => m.EditFields.Discount.DiscountCode, new { placeholder = "Enter code", @class = "input input-small" })
                    <button id="applyDiscountButton" class="btn btn-mini btn-success">Apply Code</button>
                }
                else
                {
                    if (Model.EditFields.Discount.DiscountType == DiscountType.ComplianceSeries)
                    {
                        <div class="control-group">
                            <br />
                            <button id="renewCPSubscriptionButton" class="btn btn-default btn-mini btn-success ">Renew Subscription</button>

                            <div class="controls">
                                Expires on: @Model.EditFields.Discount.DateValidTo.ToShortDateString()
                                <br />
                                Billing Date: @Model.EditFields.Discount.DateBilled.ToString().Split(' ')[0]
                            </div><br />
                            <button id="cancelDiscountButton" class="btn btn-danger btn-mini ">Cancel Subscription</button>
                        </div>
                    }
                }
            </div>
        </div>
        <div class="span5">
            <div id="notesPanel">
                <textarea class="form-control" style="min-width: 100%">"@Model.EditFields.Order.AdminComments</textarea>
            </div>
            @if (Model.EditFields.Discount != null && Model.EditFields.Discount.Notes != null)
            {
                <div>
                    <textarea class="form-control" style="min-width: 100%">"@Model.EditFields.Discount.Notes</textarea>
                </div>
                <button id="editDiscountNotesButton" class="btn btn-default btn-mini">Edit Note</button>
            }
        </div>

        @*//  modals*@
        <div id="changeAssignedAffiliate" class="modal hide fade">
            @using (Html.BeginForm("SetAffiliateAssignedToOrder", "Admin", FormMethod.Post, new { id = "frmChangeAffiliate" }))
            {
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h3>Change Affiliate Credited To Order:</h3>
                </div>
                <div class="modal-body">
                    @*modal content will be loaded here*@
                </div>
                <div class="modal-footer">
                    <button id="cancelChangeAffiliate" class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
                    <button id="submitChangeAffilate" class="btn btn-primary">Save Changes</button>
                </div>
            }
        </div>
        @if (Model.EditFields.Discount != null)
        {
            <div id="renewCPSubscriptionModal" class="modal hide fade">
                @using (Html.BeginForm("UpdateCPSubscription", "Account", FormMethod.Post, new { id = "frmUpdateCPSubscription" }))
                {
                    var currentExpiryDate = Model.EditFields.Discount.DateValidTo.Month + "/" + Model.EditFields.Discount.DateValidTo.Year;
                    var newExpiryDate = Model.EditFields.Discount.DateValidTo.AddMonths(@Model.EditFields.Discount.RenewalTerm);
                    @Html.AntiForgeryToken()

                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                        <h3>Update Compliance Series Subscription</h3>
                    </div>
                    <div class="modal-body">

                        <input type="hidden" name="orderID" value="@Model.EditFields.Order.idOrder" />
                        Current Expiration Date:
                        <input disabled="disabled" class="input input-small;" type="text" name="currentExpiryDate" id="currentExpiryDate" value="@currentExpiryDate" />
                        <br />Renewal Term: @Html.TextBoxFor(m => m.EditFields.Discount.RenewalTerm, new { id = "RenewalTerm", disabled = "disabled", @class = "input input-sm" })
                        @Html.HiddenFor(m => m.EditFields.Discount.DateValidTo) @* Required for POST. TextBoxFor won't ModelBind *@
                        <br />New Expiration Date:
                        <input class="input input-small" type="text" name="newCPExpiryDate" id="newCPExpiryDate" value="@newExpiryDate.ToShortDateString()" />
                        <br />Sage Invoice Number:
                        @Html.TextBoxFor(m => m.EditFields.Order.SageInvoiceId, new { id = "SageInvoiceId", @class = "input input-small" })
                        <br />Notes:
                        @Html.TextAreaFor(m => m.EditFields.Discount.Notes)
                    </div>
                    <div class="modal-footer">
                        <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
                        <button id="updateCPSubscriptionButton" name="moveOne" class="btn btn-primary">Update Subscription</button>
                    </div>
                    <div>
                        @Html.HiddenFor(m => m.EditFields.Order.idOrder)
                        @Html.HiddenFor(m => m.EditFields.WebUser.idUser)
                        @Html.HiddenFor(m => m.EditFields.WebinarId)
                        @Html.HiddenFor(m => m.EditFields.DisplayRowPriceViewModel.Price)
                        @Html.HiddenFor(m => m.EditFields.DisplayRowPriceViewModel.RowPrice)
                    </div>

                }
            </div>
        }
        @if (Model.EditFields.Discount != null)
        {
            <div id="editNotes" class="modal hide fade">
                @using (Html.BeginForm("UpdateDiscountNotes", "Account", FormMethod.Post, new { id = "frmUpdateDiscountNotes" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                        <h3>Update Notes</h3>
                    </div>
                    <div class="modal-body">

                        <input type="hidden" name="orderID" value="@Model.EditFields.Order.idOrder" />
                        <br />Notes:
                        <div>
                            <textarea class="form-control" style="min-width: 100%">"@Model.EditFields.Discount.Notes</textarea>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
                        <button id="updateDiscountNotesButton" name="moveOne" class="btn btn-primary">Update Notes</button>
                    </div>
                    <div>
                        @Html.HiddenFor(m => m.EditFields.Order.idOrder)
                        @Html.HiddenFor(m => m.EditFields.WebUser.idUser)
                        @Html.HiddenFor(m => m.EditFields.WebinarId)
                        @Html.HiddenFor(m => m.EditFields.DisplayRowPriceViewModel.Price)
                        @Html.HiddenFor(m => m.EditFields.DisplayRowPriceViewModel.RowPrice)
                    </div>
                }
            </div>
        }

        <div id="changeAssignedUser" class="modal hide fade">
            @using (Html.BeginForm("SetUserAssignedToOrder", "Admin", FormMethod.Post, new { id = "frmSetUserAssignedToOrder" }))
            {
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h3>Change User Assigned To Order:</h3>
                </div>
                <div class="modal-body">

                    <input type="hidden" name="orderID" value="@Model.EditFields.Order.idOrder" />
                    <input type="hidden" name="migrateOrder" value="one" />
                    <input type="text" id="targetUserID" name="targetUserID" placeholder="Targeted User ID" />

                </div>
                <div class="modal-footer">
                    <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
                    <button id="changeUserOrderButton" name="moveOne" class="btn btn-primary">Just This Order</button>
                    <button id="changeUserOrdersButton" name="moveAll" class="btn btn-primary">Change All</button>
                </div>
            }
        </div>


        <div id="ExtendPostEventAccessModal" class="modal hide fade">
            @using (Html.BeginForm("ExtendPostEventAccess", "Admin", FormMethod.Post, new { id = "frmExtendPostEventAccess" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary("Please address the following error/s:", new { id = "extendPostEventAccessValSummary" })

                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h3>Enter Expiration Date:</h3>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="orderID" value="@Model.EditFields.Order.idOrder" />
                    <input type="text" id="newExpiryDate" name="newExpiryDate" placeholder="Expires On" /> <span class="text text-info">@Model.EditFields.PostEventClaim.OnDemandCode</span>
                    <div class="btn-group">
                        <button id="Add6MonthsButton" class="btn btn-mini">Add 6 months</button>
                        <button id="Add5DaysButton" class="btn btn-mini">Add 5 days</button>
                        <button id="AdInfinitumButton" class="btn btn-mini">Custom</button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
                    <button id="extendEventAccessButton" class="btn btn-primary">Submit</button>
                </div>
            }
        </div>

        <div id="DiscountModal" class="modal hide fade">
            @using (Html.BeginForm("EditDiscount", "Admin", FormMethod.Post, new { id = "frmEditDiscount" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary("Please address the following error/s:", new { id = "editDiscountSummary" })

                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h3>Enter Expiration Date:</h3>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="orderID" value="@Model.EditFields.Order.idOrder" />
                    <input type="text" id="newExpiryDate" name="newExpiryDate" placeholder="Expires On" /> <span class="text text-info">Insert Date to Expire</span>

                </div>
                <div class="modal-footer">
                    <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
                    <button id="editDiscountButton" class="btn btn-primary">Submit</button>
                </div>
            }
        </div>

        <div id="PayByMonerisModal" class="modal hide fade">

            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h3>Submit Payment</h3>
            </div>
            <div class="modal-body">
                @*<input type="hidden" name="orderID" value="@Model.EditFields.Order.idOrder" />
                    @{
                        Html.RenderPartial("~/Views/Cart/Partials/_PayByMoneris.cshtml", Model.EditFields.Order);
                    }*@

            </div>
            <div class="modal-footer">
                <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
                <button id="editDiscountButton" class="btn btn-primary">Submit</button>
            </div>
        </div>
    </div>
</div>


