@using CUWebinars.Web.Core
@model  CUWebinars.Web.Models.DataTablesModels.EditOrderInfoModel
@{

    GlobalConfig _globalConfig = GlobalConfig.GlobalConfigSingleton;
    var row = Model.EditFields.Order.OrderRows.SingleOrDefault(r => r.RowStatus == OrderRowStatus.Active);
    var joinURL = "";
    var ttsJoinURL = "";
    var onDemandCode = "";
    var certificate = "";

    if (!ReferenceEquals(row, null))
    {
        if (row.Webinar.Status == WebinarStatus.InProgress || row.Webinar.Status == WebinarStatus.Active || row.Webinar.Status == WebinarStatus.Scheduled)
        {
            if (!ReferenceEquals(row.CitrixJoinUrl, null))
            {
                joinURL = row.CitrixJoinUrl;
            }
            if (!ReferenceEquals(row.TtsJoinUrl, null))
            {
                ttsJoinURL = _globalConfig.TenantURL + "/j/" + row.TtsJoinUrl;
            }
        }
        if (row.Webinar.Status == WebinarStatus.Recorded)
        {
            
            if (!ReferenceEquals(row.OnDemandCode, null))
            {
                onDemandCode = _globalConfig.TenantURL + "/o/" + row.idOrder + '-' + row.OnDemandCode;
            }
            else
            {
                <div>OnDemandCode is null</div>
            }
        }
        if (row.Webinar.Status == WebinarStatus.Archived || row.Webinar.Status == WebinarStatus.Recorded)
        {
            if (!ReferenceEquals(row.OnDemandCode, null))
            {
                certificate = _globalConfig.TenantURL + "/Account/MyCertificate?orderID=" + row.idOrder;
            }
        }


    }
}
@Html.HiddenFor(model => model.EditFields.idOrderRow)
<style>
    .form-horizontal .control-group {
        margin-bottom: 5px;
    }

        .form-horizontal .control-group input {
            border-radius: 0px;
            padding: 1px 6px;
        }
</style>


<div class="row-fluid">
    <div class="span7 offset1 control-group">
        <span class="control-label">Links:</span>
        <div class="controls">
            @joinURL<br/>
            @ttsJoinURL<br/>
            @onDemandCode<br/>
            @certificate
        </div>
    </div>


</div>
