@* this partial view is intended for use in a DataTables.net table. *@
@* magic strings [ORDERSTATUS] and [ORDERID] are replaced in client-side script for each Row *@
@* class derives the the above to:
    magic strings [DISCOUNT] and [DISCOUNTID] are replaced in client-side script for each Row *@      
@{
    var isAffiliate = "hidden";
}
<form class="form-compact compact-order-status-edit-form" novalidate="novalidate">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" />
    <input type="hidden" name="Discount" />
    <input type="hidden" name="note" />

    <div class="dropdown">

        <a class="dropdown-toggle btn btn-mini" role="button" href="#" data-toggle="dropdown">[DISCOUNT]&nbsp;<b class="caret"></b></a>
        <ul class="dropdown-menu" role="menu">
            @foreach (string name in Enum.GetNames(typeof(DiscountType)))
            {
                <li class="@isAffiliate" role="presentation"><a tabindex="-1" role="menuitem" href="#" onclick="updateDiscount(this, [DISCOUNTID], '@name'); return false;">@name</a></li>
            }
            @*<li class="divider" role="presentation"></li>
                <li role="presentation"><a tabindex="-1" role="menuitem" href="/Admin/manageOrder/[ORDERID]" target="_new">Edit Order</a></li>*@
        </ul>
    </div>
</form>

