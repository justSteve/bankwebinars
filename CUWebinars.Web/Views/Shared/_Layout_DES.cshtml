<body class="@PageStyleType">
    <!-- begin accesibility skip to nav skip content -->
    <ul class="visuallyhidden" id="top">
        <li><a href="#nav" title="Skip to navigation" accesskey="n">Skip to navigation</a></li>
        <li><a href="#page" title="Skip to content" accesskey="c">Skip to content</a></li>
    </ul>
    <!-- end /.visuallyhidden accesibility-->
    <!-- mobile navigation trigger-->
    <h5 class="mobile_nav"><a href="javascript:void(0)">&nbsp;<span></span></a></h5>
    <!--end mobile navigation trigger-->
    <section class="preheader">
        <section class="container">

            <!--this is the login for the user-->
            <div id="loginContainer">
                @Html.Partial("_LoginPartialDES")
            </div>


            <ul class="social">
                <li><span id="preheaderIcon"><a href="http://www.ttstrain.com?from=tenant" target="_blank" data-placement="bottom" title="A TTS Production"><img src="~/Content/images/TTS-logoPreHeaderReverse.png" /></a></span></li>
                <li><a class="socicon small facebook" href="https://www.facebook.com/home.php#!/pages/Total-Training-Solutions/300546163412" target="_blank" data-placement="bottom" title="Follow us on Facebook"></a></li>
                <li><a class="socicon small twitterbird" href="https://twitter.com/#!/ttstrain" target="_blank" data-placement="bottom" title="Follow us on Twitter"></a></li>
                <li><a class="socicon small linkedin" href="https://www.linkedin.com/company/bankwebinars-com" target="_blank" data-placement="bottom" title="Follow us on LinkedIn"></a></li>
                <li>
                    <div id="search-wrapper" class="search-wrapper">
                        <form class="search" method="post" action="/webinar/search">
                            <ul>
                                <li><i class="icon-search"></i></li>
                                <input id="search-box" name="searchTerm" type="text" placeholder="Search for?">
                            </ul>
                        </form>
                    </div>
                </li>
            </ul>
        </section>
    </section>

    <!-- begin .header-->
    <header class="header  clearfix" style="margin-bottom: 0px; padding-bottom: 0; ">
        <div class="container">
            <div class="row-fluid">
                <!-- begin #logo-->
                <a href="/">
                    <div id="logo" class="span4" style='margin-top: 14px; margin-bottom: -14px; background: url("@currentAffiliate.Logo") no-repeat scroll 0 0 rgba(0, 0, 0, 0)'></div>
                </a>
                <!-- end #logo -->
                <!-- begin #main_menu -->
                <nav id="main_menu" class="span8">
                    <ul class="primary_menu">
                        @*<li class="parent"><a href="/webinar/calendar">calendar</a></li>*@
                        <li class="parent">
                            <a href="javascript:void(0)">topics<i></i></a>
                            <ul>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/41">Accounting/Financials</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/42">Auditing/Reporting</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/43">BSA/AML</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/44">Compliance/Regulations</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/23">Human Resources</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/22">Lending</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/19">Operations</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/45">Other</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/46">Risk Management</a></li>
                                <li role="presentation"><a role="menuitem" tabindex="-1" href="/Webinar/ListByTopic/47">Technology/Security</a></li>

                            </ul>
                        </li>

                        <li class="parent">
                            <a href="javascript:void(0)">Course Catalog<i></i></a>
                            <ul>@Html.Action("GetDESModules", "Navigation")</ul>
                        </li>
                        <li role="presentation"><a role="menuitem" tabindex="-1" href="https://ttsimages.blob.core.windows.net/$root/DSFutureReleases.pdf">Future Releases</a></li>
                        <li role="presentation"><a role="menuitem" tabindex="-1" href="/Home/learnmore">Learn More</a></li>
                        @if (Request.IsAuthenticated)
                        {
                            <li><a href="/Account/MyWebinars">My Webinars</a></li>
                        }

                    </ul>
                </nav>
                <!-- close / #main_menu -->
            </div>
        </div>
        <!-- close / .container-->
    </header>
    <!-- close /.header -->
    <div id="page">
        @RenderBody()
    </div>
    <!--begin footer -->
    <footer id="footer" class="clearfix">
        <div class="container">
            <!--footer container-->
            <!--footer container-->
            <div class="row-fluid">
                <div class="span4">
                    <section>
                        <h4>Stay Updated</h4>
                        @{Html.RenderPartial("Partials/_AddToMailingBox");}
                    </section>
                </div>
                <!-- close .span4 -->
                <div class="span4">
                    <section>
                        <h4>Contact Us</h4>
                        <div class="affFooter">   @Html.Raw(footAddress)</div>
                    </section>
                    <!--close section-->
                </div>
                <!-- close .span4 -->
                <div class="span4">
                    <section>
                        <h4>Follow Us</h4>
                        @Html.Raw(footSocial)

                        @{
                            if (currentAffiliate.idUserAff > 19)
                            {
                                if (@currentAffiliate.DisplayTitle == "Total Training Solutions")
                                {
                                    <p style="margin-top: 10px;" align="center">This site is brought to you by @globalConfig.TenantDomain and Total Training Solutions - TTSTrain.com.</p>
                                }
                                else
                                {
                                    <p style="margin-top: 10px;" align="center">This site is managed for @currentAffiliate.DisplayTitle by @globalConfig.TenantDomain and Total Training Solutions - TTSTrain.com.</p>
                                }
                            }
                        }
                    </section>

                </div>
                <!-- close .span4 -->
            </div>
            <!-- close .row-fluid-->
        </div>
        <!-- close footer .container-->
        <section class="footerCredits">
            <div class="container">
                <ul class="clearfix">
                    <li style="text-align: right;">@globalConfig.TenantDomain is © 2017 & All Rights Reserved By Total Training Solutions. <br /></li>
                    <li style="text-align: left;"><a href="/home/privacystatement">Privacy Statement</a><br />For financial institution training visit<a href="http://www.ttstrain.com/?s=cuwebinars" target="_new"> TTSTrain.com </a></li>
                </ul>
            </div>
            <!--footerCredits container-->
        </section>
        <!--close section-->
    </footer>
    <!--/.footer-->
    @*<span class="backToTop"><a href="#top">back to top</a></span>*@
    <!-- close #page-->

    <div class="modal hide fade in" id="DisplayErrorModal">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h3 id="CreateUserHeader">Error Condition Detected</h3>
        </div>
        <div id="DisplayErrorBody" class="modal-body">
            <div id="ErrorBody"></div>
        </div>
        <div class="modal-footer">
            <a href="#" id="ErrorSubmitter" class="btn btn-primary">Continue</a>
        </div>
    </div>

    <div id="PayByCCModal" class="modal hide fade">

        <input type="hidden" name="id" />

        <div class="modal-header">
            <h3 id="confirmCaption"></h3>
        </div>
        <div id="PayByCCModalOrderDetails" class="modal-body">
            <div>
                <div class="legendImitator">
                    Credit Card Processing Redirect
                </div>

                <div style="margin-bottom: 10px;">
                    We will now redirect your browser to our credit card processor - https://www.paytrace.com - for entry of credit card information.
                </div>

                <div class="pull-right">

                    <button class="btn" data-dismiss="modal" aria-hidden="true">Cancel</button>
                    <button class="btn btn-success" name="btnSubmitCCForm" id="btnSubmitCCForm">Continue</button>

                </div>
            </div>
        </div>
    </div>
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/CrispApp")

    <script type="text/javascript">
                $(document).ready(function () {


                });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
