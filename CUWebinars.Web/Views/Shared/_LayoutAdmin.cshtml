    {
        ShowWebinarColumn = "true";
    }
    <script type="text/javascript">
        var showWebinarColumn = @ShowWebinarColumn;
        var showRoyaltyColumn = false;
        var affiliateId = @currentAffiliate.idUserAff;
        var showAffiliateColumn = true;
        var currentAffiliateId = "@currentAffiliate.idUserAff";
