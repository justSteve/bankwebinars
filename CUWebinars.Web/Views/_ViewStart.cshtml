@using CUWebinars.Web.Core
@{
    GlobalConfig _globalConfig = GlobalConfig.GlobalConfigSingleton;

    if (_globalConfig.Tenant == "DirectorSeries")
    {
        Layout = "~/Views/Shared/_Layout_DES.cshtml";

    } else if (_globalConfig.Tenant == "CCS")
    {
        Layout = "~/Views/Shared/_Layout_Ccs.cshtml";

    }
    else
    {
        Layout = "~/Views/Shared/_LayoutPublic.cshtml";

    }
}