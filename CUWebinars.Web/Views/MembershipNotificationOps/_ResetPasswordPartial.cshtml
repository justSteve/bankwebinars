@model ResetPasswordModel
           
@{
    Layout = null;
}

<div class="span8">
    @using (Html.BeginForm("ResetPassword", "MembershipNotificationOps", FormMethod.Post, new { id="ResetPasswordForm"}))
    {
        <fieldset>
            <legend id="ResetPassLegend">Reset Password</legend>

            <div>
                @Html.LabelFor(l => l.Email)
                @Html.TextBoxFor(t => t.Email, new { id = "ResetPassEmail" })
                @Html.ValidationMessageFor(m => m.Email)
            </div>
            <div>
                <input id="NormalResetPasswordButton" class="btn btn-default" type="submit" value="Reset Password" /><span id="PasswordResetStatus" style="color: green"></span>
            </div>
        </fieldset>
    }
</div>


