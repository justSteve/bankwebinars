@model ManualPasswordResetViewModel

@{
    Layout = null;
}

<div class="span8">
    @using (Html.BeginForm("ManualPasswordReset", "MembershipNotificationOps", FormMethod.Post, new { id = "ManualResetPasswordForm" }))
    {
        @Html.AntiForgeryToken()
        
        <fieldset>
            <legend id="ResetPassLegend">Reset Password</legend>

            <div>
                @Html.LabelFor(l => l.Email)
                @Html.TextBoxFor(t => t.Email)
                @Html.ValidationMessageFor(m => m.Email)
            </div>
            <div>
                @Html.LabelFor(l => l.NewPassword)
                @Html.PasswordFor(t => t.NewPassword)
                @Html.ValidationMessageFor(m => m.NewPassword)
            </div>
            <div>
                @Html.LabelFor(l => l.ConfirmPassword)
                @Html.PasswordFor(t => t.ConfirmPassword)
                @Html.ValidationMessageFor(m => m.ConfirmPassword)
            </div>
            <div>
                <input id="ManualResetPasswordButton" class="btn btn-default" type="submit" value="Reset Password" /><span id="PasswordResetStatus" style="color: green"></span>
            </div>
        </fieldset>
    }
    
    <div id="OperationMessage"></div>
</div>

