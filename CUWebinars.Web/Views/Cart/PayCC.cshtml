@model Order
@using System.Configuration
@{
    //Layout = "/Views/Shared/_Layout_PayCC.cshtml";
    var title = Model.OrderRows.SingleOrDefault().Webinar.Title;
    title = title.Replace("%", "");
    title = title.Replace("&", "");
    title = title.Replace("#", "");
    title = title.Replace("[", "");
    title = title.Replace("]", "");
    title = title.Replace("<", "");
    title = title.Replace(">", "");
    title = title.Replace("\"", "");
    title = title.Replace("\\", "");
    title = title.Replace("'", "");
    title = title.Replace("/", "");
}

<form method="POST" action="https://www.sagepayments.net/eftcart/forms/express.asp">
    <input type="hidden" name="M_id" value="481584571755" />
    <input type="hidden" name="T_amt" value="@Model.Total" />
    <input type="hidden" name="T_shipping" value="0" />
    <input type="hidden" name="T_tax" value="0" />
    <input type="hidden" name="T_ordernum" value="@Model.idOrder" />
    <input type="hidden" name="C_company" value="@Model.Institution" />
    <input type="hidden" name="C_fname" value="@Model.FirstName" />
    <input type="hidden" name="C_lname" value="@Model.LastName" />
    <input type="hidden" name="C_address" value="@Model.BillingAddress" />
    <input type="hidden" name="C_city" value="@Model.BillingCity" />
    <input type="hidden" name="C_state" value="@Model.BillingState" />
    <input type="hidden" name="C_zip" value="@Model.BillingZip" />
    <input type="hidden" name="C_email" value="@Model.BillingEmail" />
    <input type="hidden" name="C_telephone" value="@Model.BillingPhone" />
    <input type="hidden" name="C_telephone" value="@Model.BillingPhone" />
    <input type="hidden" name="C_memo" value="@title" />
    <h4 align="center">
        Redirecting to our credit card processor - SagePayment.net - for entry of credit card information. The result of that transaction will display here when completed.
    </h4>
    <p style="margin-left: 200px;">
        <i>Registration ID: <b>BW-@Model.idOrder</b></i><br />

        <b>
            @Model.OrderRows.SingleOrDefault().Webinar.Title<br />
    </b>
    @Model.Total.ToString("C")
</p>


<input type="submit" value="Continue" />
<input type="reset" onclick="self.close();" value="Cancel" />
</form>

