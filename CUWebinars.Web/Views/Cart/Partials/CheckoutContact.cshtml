@model RegisterViewModel

@Html.ValidationSummary(string.Empty, new { id = "valSummarySignUpInCart" })

@using (Html.BeginForm("RegisterFromCart", "Account", null, FormMethod.Post, new { id = "_CreateUserFromCartForm", name = "createUser" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="FirstName" name="FirstName" />
    <input type="hidden" id="LastName" name="LastName" />
    <input type="hidden" id="ShippingFirstName" name="ShippingFirstName" />
    <input type="hidden" id="ShippingLastName" name="ShippingLastName" />
    <input type="hidden" id="RegisterFields_BillingAddress_Country" name="RegisterFields.BillingAddress.Country" value="US" />
    <input type="hidden" id="RegisterFields_ShippingAddress_Country" name="RegisterFields.ShippingAddress.Country" value="US" />
    <input type="hidden" name="returnUrl" />
    <input type="hidden" id="emailAddress" />

    // Next 2 inputs are a bit of a hack. We are generating passwords on the Server. But we still want ModelState to be valid.
    // So, to get around having to create a fresh ViewModel that does not include passwords, just set them to a fixed value
    // which we will disregard at the server. Perhaps refactor later and use separate ViewModel with inheritance. Then can
    // remove those inputs
    <input type="hidden" id="RegisterFields_Password" name="RegisterFields.Password" value="456rty^Y" />
    <input type="hidden" id="RegisterFields.ConfirmPassword" name="RegisterFields.ConfirmPassword" value="456rty^Y" />


    <div class="tab-pane" id="contactInfo">
        <div class="accordion" id="createUserPanes">
            <div class="accordion-group">
                <div class="accordion-heading">
                    <a class="accordion-toggle" data-toggle="collapse" data-parent="#createUserPanes" href="#collapseEmail">
                        <span id="labelEmail">Email</span>
                    </a>
                </div>
                <div id="collapseEmail" class="accordion-body collapse in">
                    <div class="accordion-inner">
                        <div id="wrapEmail">
                            <div>
                                @Html.TextBoxFor(model => model.RegisterFields.Email, new { style = "width: 180px;" })<br />
                                @Html.ValidationMessageFor(model => model.RegisterFields.Email)
                            </div>
                        </div>
                        <div id="wrapZip">
                            <div>
                                Zip Code:
                                <input type="text" class="enterSubmit input-medium" name="getZip" id="getZip" />
                                <input type="button" value="Have a Non-US Address?" name="nonUSAddressBtn" id="nonUSAddressBtn" class="btn btn-mini btn-info" />
                            </div>
                        </div>
                        <div id="wrapReset">
                            <div id="LoginPart">
                                <h3>Login to existing account?</h3>
                                <div>
                                    <label>Email:</label> <input id="Email1" name="Email1" value="" type="text" class="input-large"> <br>
                                    <label>Password:</label> <input id="Password1" name="Password1" type="password" class="input-large"><br>
                                </div>
                                <p id="loginErrorSummary"></p>
                            </div>
                            <div id="resetPart" class="span6">
                                <h3>Or...</h3>
                                We can email you a link that will reset your password.
                                <p><input id="EdgeCaseResetPasswordButton" type="button" class="btn btn-danger" name="resetPass" value="Reset Password" /></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="accordion-group">
                <div class="accordion-heading">
                    <a class="accordion-toggle" data-toggle="collapse" data-parent="#createUserPanes" href="#collapseBilling">
                        Billing
                    </a>
                </div>
                <div id="collapseBilling" class="accordion-body collapse">
                    <div class="accordion-inner">
                        <div>
                            <div id="getFirstLast">
                                <label>First:</label>@Html.TextBoxFor(model => model.RegisterFields.FirstName)<br />
                                <label>Last:</label>@Html.TextBoxFor(model => model.RegisterFields.LastName)
                                @*<label>First:</label>@Html.TextBoxFor(model => model.RegisterFields.FirstName, new {@class = "input-large"})
                                    <label>Last:</label>@Html.TextBoxFor(model => model.RegisterFields.LastName, new {@class = "input-large"})*@
                            </div>
                            <div id="getFullNameBilling">
                                <label>Name:</label>
                                <input type="text" id="FullName" name="FullName" class="input-large" />
                            </div>
                        </div>
                        <div>
                            <div id="wrapTitle">
                                <label>Title:</label>@Html.TextBoxFor(model => model.RegisterFields.Title)@*, new { @class = "input-mini" })*@
                            </div>
                        </div>
                        <div>
                            <div id="wrapInstitutionBilling">
                                @*<label>Institution:</label>@Html.TextBoxFor(model => model.RegisterFields.Institution, new {@class = "input-large"})*@
                                <label>Institution:</label>@Html.TextBoxFor(model => model.RegisterFields.Institution)
                            </div>
                        </div>
                        <div>
                            <div id="wrapAddressBilling">
                                <label>Address:</label> @Html.TextBoxFor(model => model.RegisterFields.BillingAddress.StreetAddress)@*, new { @class = "input-xxlarge" })*@
                                <br />
                                <label>(2nd address optional):</label>@Html.TextBoxFor(model => model.RegisterFields.BillingAddress.StreetAddress2)@*, new { @class = "input-xxlarge" })*@
                            </div>
                        </div>
                        <div>
                            <div id="wrapCityBilling">
                                <label>City:</label> @Html.TextBoxFor(model => model.RegisterFields.BillingAddress.City, new { @class = "input-large" })
                                @Html.HiddenFor(model => model.RegisterFields.BillingAddress.TypeOfAddress)
                            </div>
                            <div id="wrapCityBilling">
                                <label>State:</label> @Html.TextBoxFor(model => model.RegisterFields.BillingAddress.State, new { @class = "input-mini" })
                                <label>Zip:</label> @Html.TextBoxFor(model => model.RegisterFields.BillingAddress.Zip, new { @class = "input-mini" })
                                @Html.HiddenFor(model => model.RegisterFields.BillingAddress.TypeOfAddress)
                            </div>
                        </div>
                        <div>
                            <div id="wrapPhone">
                                      <label>Phone:</label>
                                      @Html.TextBoxFor(model => model.RegisterFields.BillingAddress.Phone)
                                  </div>
                            <div id="wrapTimeZone">
                                <label for="TimeZone" style="display: inline-block">Time Zone:</label>
                                <select style="width: 120px" id="TimeZone" name="TimeZone">
                                    <option value="4">Eastern</option>
                                    <option value="3">Central</option>
                                    <option value="2">Mountain</option>
                                    <option value="1">Pacific</option>
                                </select>
                            </div>
                            @*TODO: Figure out how to show this only when dealing with feriners.*@
                            @*<div id="nonUSAddressInputWrap">
                                <label>&nbsp;</label>
                                <textarea name="nonUSAddressInput" rows="5" cols="100">Special Handling for Address:</textarea>
                            </div>*@
                            @Html.ValidationMessageFor(model => model.RegisterFields.FirstName)
                            @Html.ValidationMessageFor(model => model.RegisterFields.LastName)
                            @Html.ValidationMessageFor(model => model.RegisterFields.Institution)
                            @Html.ValidationMessageFor(model => model.RegisterFields.BillingAddress.Phone)
                            @Html.ValidationMessageFor(model => model.RegisterFields.BillingAddress.StreetAddress)
                            @Html.ValidationMessageFor(model => model.RegisterFields.BillingAddress.City)
                            @Html.ValidationMessageFor(model => model.RegisterFields.BillingAddress.State)
                            @Html.ValidationMessageFor(model => model.RegisterFields.BillingAddress.Zip)
                        </div>
                    </div>
                </div>
            </div>
            <div class="accordion-group">
                <div class="accordion-heading">
                    <a class="accordion-toggle" data-toggle="collapse" data-parent="#createUserPanes" href="#collapseShipping">Shipping</a>
                </div>
                <div id="collapseShipping" class=" accordion-body collapse">
                    <div class="accordion-inner">
                        <div>
                            <label>Same As Billing?</label>@Html.HiddenFor(model => model.RegisterFields.ShippingAddress.Phone, new { @class = "input-large" })

                            <input type="checkbox" name="sameAsBilling" id="sameAsBilling" />
                        </div>

                        <div>
                            <div id="getFullNameShipping">
                                <label>Name:</label>
                                <input type="text" id="FullNameShipping" name="FullName" class="input-large" />
                            </div>
                        </div>

                        <div>
                            <div id="wrapAddressShipping">
                                <label>Address:</label> @Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.StreetAddress, new { @class = "input-xxlarge" })
                                <label>(2nd address optional):</label>@Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.StreetAddress2, new { @class = "input-xxlarge" })
                            </div>
                        </div>
                        <div>
                            <div id="wrapCityShipping">
                                <label>City:</label>@Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.City, new { @class = "input-large" })
                                <label>State:</label>@Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.State, new { @class = "input-medium" })
                                <label>Zip:</label>@Html.TextBoxFor(model => model.RegisterFields.ShippingAddress.Zip, new { @class = "input-mini" })
                                @Html.HiddenFor(model => model.RegisterFields.ShippingAddress.TypeOfAddress)
                            </div>
                            @Html.ValidationMessageFor(model => model.RegisterFields.ShippingAddress.StreetAddress)&nbsp;&nbsp;
                            @Html.ValidationMessageFor(model => model.RegisterFields.ShippingAddress.City)
                            @Html.ValidationMessageFor(model => model.RegisterFields.ShippingAddress.State)
                            @Html.ValidationMessageFor(model => model.RegisterFields.ShippingAddress.Zip)
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-inline">
                <div class="btn-group span2">&nbsp;</div>
                <div class="btn-group span2">
                    <input id="TheSubmitButton" type="button" value="Register" name="TheSubmit" class="btn btn-default" />
                </div>
            </div>

        </div>
    </div>

    <!-- Modal for creation of a user -->
    <div id="modalInstitution" class="modal hide">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h3>Insitution Information</h3>
        </div>
        <div id="UserInstitutionBody" class="modal-body">
            <h5>Is this your institution?</h5>        <div id="ShowInstitution">placeholder for ajax response</div>

            <div id="instInfo">
                <p><input type="button" class="btn btn-primary" name="YesUseAddress" value="Yes, use this address." /></p>
                <p><input type="button" class="btn btn-warning" name="EnterDiffAddress" value="Yes, that's my institution but I want to enter a different address." /></p>
                <p><input type="button" class="btn btn-warning" name="NotInstitution" value="No, that's not my institution" /></p>
            </div>
        </div>
    </div>

}

@using (Html.BeginForm("CreateUserAccountFromCart", "Account", null, FormMethod.Post, new { id = "_CreateUserAccountForm", name = "createUserAccount" }))
{
    @Html.AntiForgeryToken()
}

<div id="updateOrderWithUserIdWrapper">
    @Html.Partial("Partials/_UpdateOrderWithUserId")
</div>
