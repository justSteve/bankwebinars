@model CUWebinars.Web.Core.MyWebinarsDTO
@using System.Linq
@using CUWebinars.Web.Core
@using CUWebinars.Web.Helpers
@using CUWebinars.Web.Models.JsonModels
@using Newtonsoft.Json

@{
    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;

    var nfi = new CultureInfo("en-US", false).NumberFormat;
    nfi.CurrencyDecimalDigits = 0;

    WebUser currentUser = Model.WebUser;
}

<div class="container">
    <!--begin main content-->
    <div class="row-fluid">
        <!--begin row-fluid-->
        <div class="span12">
            @foreach (var recorded in Model.Recorded.OrderByDescending(w => w.OrderRow.Order.OrderDate))
            {
                var row = recorded.OrderRow;

                if (row.Webinar.Title.Contains("Webinar Subscription Packages"))
                {
                    continue;
                }

                var onDemandClaim = new PostEventClaim();
                var onDemandClaimUrl = "Live Plus Five access is expired.";
                var showMedia = false;

                var accessPhrase = "";

                if (Model.PromptRefresh == "true")
                {
                    accessPhrase = "Please refresh your browser to view event materials.";
                }

                if (row.RegistrationType.ShowRecordingNotifications.ToString() == "No")
                {
                    accessPhrase = onDemandClaimUrl;
                }
                if (Model.MyClaims != null)
                {
                    foreach (var claim in Model.MyClaims)
                    {
                        var thisClaim = JsonConvert.DeserializeObject<PostEventClaim>(claim.ToString());
                        if (thisClaim.OnDemandCode == row.OnDemandCode)
                        {
                            onDemandClaim.OrderId = row.idOrder;
                            onDemandClaim.OnDemandCode = thisClaim.OnDemandCode;
                            onDemandClaim.ExpiryDate = thisClaim.ExpiryDate;

                            if (onDemandClaim.ExpiryDate.AddDays(1) > DateTime.Today.AddHours(23))
                            {
                                showMedia = true;
                                accessPhrase = " The recording will be accessible through " + onDemandClaim.ExpiryDate.ToShortDateString() + ".";
                                onDemandClaimUrl = "Need to share this event with a co-worker? Provide them this URL:<br />" +
                                                   "<a href=\"" + globalConfig.TenantURL + "/o/" + row.idOrder + "-" + thisClaim.OnDemandCode + "\"> <tt><b>" + globalConfig.TenantURL + "/o/" + row.idOrder + "-" + thisClaim.OnDemandCode + "</b></tt></a>";

                                //if (row.RegistrationType.ShowRecordingNotifications.ToString() == "No")
                                //{
                                //    accessPhrase = "is eligable for an upgrade.";
                                //}
                            }
                            else
                            {
                                onDemandClaimUrl = "Access to the OnDemand recording expired on " + thisClaim.ExpiryDate.ToShortDateString();
                                onDemandClaimUrl += "<br>Please note: If this expiration date appears incorrect there may be a problem with your browser's cookies. THe link below is designed to bypass cookies - in the event of continued problems you may visit us in our online chat (lower right of this page) " +
                                                    "where we can resolve the issue. <br />" +
                                                   "<a href=\"" + globalConfig.TenantURL +
                                                   "/o/" + row.idOrder + "-" + thisClaim.OnDemandCode +
                                                   "\"> <tt><b>" + globalConfig.TenantURL + "/o/" + row.idOrder + "-" + thisClaim.OnDemandCode + "?checkExpiry=" + row.idOrder + "</b></tt></a>";

                            }
                        }
                    }
                }
                <div class="container-fluid">
                    <div class="row-fluid">

                        <div class="span8">
                            <h4 style="padding-right: 30px;" id="recorded-@row.idWebinar">@row.Webinar.Title</h4>
                            <div>
                                <p>
                                    This event was recorded on @Html.DisplayDate(row.Webinar.Date)<text>.</text> @accessPhrase
                                </p>
                            </div>
                        </div>
                        <div class="span3 offset1 " id="orderSum-@row.idWebinar">
                            
                            @Html.Partial("~/Views/Shared/Partials/_OrderSumUser3.cshtml", recorded)
                        </div>
                    </div>

                    <div class="span2 pull-right">
                        <form method="GET" action="/Account/MyCertificate">
                            <input type="hidden" name="orderID" value="@row.idOrder" />
                            <input type="submit" value="My Certificate" id="ShowCertificate" class="btn btn-success pull-right btn-mini pull-left" />
                        </form>
                    </div>
                    <div class="container-fluid">
                        @if (showMedia)
                        {
                            if (row.RegistrationType.ShowRecordingNotifications == "Yes")
                            {
                                <div class="row-fluid">
                                    @if (row.Webinar.RecordingUrl != "")
                                    {
                                        <div class="span3 well well-large">
                                            <a target="_blank" href="/webinar/GetWebinarRecording/@row.Webinar.idWebinar">
                                                <span><i class="icon-facetime-video"> </i></span> OnDemand Playback
                                            </a>

                                            @{Html.RenderPartial("DisplayTemplates/HandoutsListing", row.Webinar);}
                                            @if (row.RegistrationType.ShowShippedNotifications.ToLower() == "yes")
                                            {
                                                if (row.ShipmentDate != null)
                                                {
                                                    <div>
                                                        The CD-ROM shipped @row.ShipmentDate<text>.</text>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div>
                                                        The CD-ROM is typically shipped within 5-7 days following the event.
                                                    </div>
                                                }
                                            }

                                        </div>
                                        <div class="span6">

                                            @Html.Raw(onDemandClaimUrl)

                                        </div>
                                    }
                                    else
                                    {
                                        <div>
                                            <span style="font-size: small;">(Recording not yet uploaded.)</span>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                // user has not purchased recording
                                <div class="row-fluid">
                                    @if (showMedia)
                                    {
                                        <div class="span3 well well-large">
                                            <a target="_blank" href="/webinar/GetWebinarRecording/@row.Webinar.idWebinar"><span><i class="icon-facetime-video"></i></span> Playback</a>
                                            @{Html.RenderPartial("DisplayTemplates/HandoutsListing", row.Webinar);}
                                        </div>

                                    }
                                    <div class="span6">
                                        @Html.Raw(onDemandClaimUrl)
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div><hr />
            }
        </div>
    </div>
</div>