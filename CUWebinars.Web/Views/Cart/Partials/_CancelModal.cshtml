<div id="CancelModal" class="modal hide fade">
    @using (Html.BeginForm("CancelOrder", "Cart", null, FormMethod.Post, new {id = "cancelOrder"}))
    {
        <input type="hidden" name="id" id="cancelModalOrderId"/>
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h3 id="cancelCaption">Cancel This Order?</h3>
        </div>
        <div id="cancelResult" class="modal-body">
            <p>Please confirm that you wish to delete this registration.</p>
        </div>
        <div class="modal-footer">
            <a href="#" id="rtn" class="btn btn-inverse" data-dismiss="modal">Return to checkout</a>&nbsp;&nbsp;
            <a href="/" id="continueReg" class="btn btn-success hide">Continue</a>&nbsp;&nbsp;
            <input type="submit" id="cancelRegistration" value="Delete This Registration" class="btn btn-danger" />
        </div>
    }
</div>
