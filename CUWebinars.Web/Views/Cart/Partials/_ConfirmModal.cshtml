@using CUWebinars.Web.Core
@{
    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;
    
}
<div id="ConfirmModal" class="modal hide fade">
    @using (Html.BeginForm("ConfirmOrder", "Cart", null, FormMethod.Post, new { id = "confirmOrder" }))
    {
        @Html.AntiForgeryToken()

        <input type="hidden" name="id" />
        <input type="hidden" id="Step2_BillMeFormReferred" name="referred" value="" />
        <div class="modal-header">
            <h3 id="confirmCaption"></h3>
        </div>
        <div id="orderDetails" class="modal-body">
            <h1>Thank you for your order!</h1>
            <p>We'll be in touch via email with complete information concerning your order numbered: @globalConfig.TenantPrefix </p>
        </div>
        <div class="modal-footer">
            <a href="#" id="confirmRegistration" role="button" data-dismiss="modal" class="btn btn-success">
                Continue
            </a>
        </div>

    }
</div>
