<div id="ConfirmModal" class="modal hide fade">
    @using (Html.BeginForm("ConfirmOrder", "Cart", null, FormMethod.Post, new { id = "confirmOrder" }))
    {
        @Html.AntiForgeryToken()
        
        <input type="hidden" name="id" />
        <input type="hidden" id="Step2_BillMeFormReferred" name="referred" value="" />
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h3 id="confirmCaption"></h3>
        </div>
        <div id="orderDetails" class="modal-body">
            <p>Registration is Confirmed</p>
        </div>
        <div class="modal-footer">
            <a href="#" id="confirmRegistration" role="button" class="btn btn-success">Continue</a>
        </div>

    }
</div>
