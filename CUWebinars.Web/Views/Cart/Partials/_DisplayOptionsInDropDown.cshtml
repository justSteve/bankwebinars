@model DisplayOptionsInDropDownViewModel
           
<input type="hidden" name="ID" value="@Model.OrderRowId" />
<select name="RegType" id="RegType" style="vertical-align: top;">
    @{
        foreach (var option in Model.Options)
        {
            var optionType = option.Key.GetType();
            if (optionType.Name == "RegType")
            {
                string isSelected = (int)Model.OrderRowRegistrationType.idRegType == option.Key.idRegType ? "selected='selected'" : "";

                <option class="radio" @isSelected value="@option.Key.idRegType">
                    @option.Key.OptionLabel
                </option>
            }
        }

    }
</select>
