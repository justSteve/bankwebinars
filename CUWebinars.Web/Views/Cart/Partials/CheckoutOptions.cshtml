@using CUWebinars.Business.Models
@model CUWebinars.Web.ViewModel.WebinarDetailsViewModel

<div class="tab-pane" id="signUp">

    @{
        if (Model.Order != null && Model.Order.idOrder > 0)
        {
            var breakDownRegType = Model.Order.OrderRows.FirstOrDefault().RegistrationType.ToString().Split('_');

            var RegCost = Model.Order.OrderRows.FirstOrDefault().OrderRowOptions.Where(o => o.idOption == (int)Model.Order.OrderRows.FirstOrDefault().RegistrationType).First().OptionPrice;
            var RegLabel = Model.Order.OrderRows.FirstOrDefault().OrderRowOptions.Where(o => o.idOption == (int)Model.Order.OrderRows.FirstOrDefault().RegistrationType).First().Option.OptionLabel;


            if (
                Model.Order.OrderRows.FirstOrDefault().Status == OrderRowStatus.Submitted ||
                Model.Order.OrderRows.FirstOrDefault().Status == OrderRowStatus.Paid ||
                Model.Order.OrderRows.FirstOrDefault().Status == OrderRowStatus.Billed)
            {
                @*<span><i>Order# @Model.Order.OrderRows.FirstOrDefault().Order.ID<br>@RegLabel - $@RegCost<br></i></span>*@
                if (Model.Webinar.ConnectionInfo != null)
                {
                    @*<blockquote style="margin-left: 150px; margin-right: 150px;" class="btn-success well">@Model.Order.OrderRows.FirstOrDefault().OrderRowOptions.First(o => o.idOption == Model.Order.OrderRows.FirstOrDefault().RegistrationType).Option.Stage2CheckoutConfirmationMsg.Replace(" Only", " ") </blockquote>*@
                    <blockquote style="margin-left: 150px; margin-right: 150px;" class="btn-success well">@Model.Order.OrderRows.FirstOrDefault().OrderRowOptions.Where(o => o.idOption == (int)Model.Order.OrderRows.FirstOrDefault().RegistrationType).First().Option.Stage2CheckoutConfirmationMsg.Replace(" Only", " ") </blockquote>
                }
                else
                {
                    <blockquote style="margin-left: 150px; margin-right: 150px;" class="btn-success well">@Model.Order.OrderRows.FirstOrDefault().OrderRowOptions.Where(o => o.idOption == (int)Model.Order.OrderRows.FirstOrDefault().RegistrationType).First().Option.Stage1CheckoutConfirmationMsg.Replace(" Only", " ") </blockquote>
                }
            }
            else
            {
                <span>There is a pending order for this event that requires your confirmation.</span>
                @Html.Partial(partialViewName: "~/Views/Webinar/Partials/DisplayOptions.cshtml", model: Model)
            }
        }
        else
        {
            @Html.Partial(partialViewName: "~/Views/Webinar/Partials/DisplayOptions.cshtml", model: Model)
        }
    }
</div>
