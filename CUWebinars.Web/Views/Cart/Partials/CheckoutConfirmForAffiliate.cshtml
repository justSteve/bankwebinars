@model CheckoutConfirmViewModel

@{
    var isAdmin = false;
    if (User != null && User.Identity.IsAuthenticated)
    {
        ClaimsIdentity claimsIdentityOfAuthenticatedUser = (ClaimsIdentity)User.Identity;

        if (claimsIdentityOfAuthenticatedUser.HasClaim(
            (claim) => claim.Type == CUWebinars.Business.Constants.ClaimTypes.Admin))
        {
            isAdmin = true;
        }
    }

    if (Model.OrderExists)
    {
        var orderRowID = 0;
        var orderID = 0;
        if (Model.OrderRowExists && Model.OrderRowHasId)
        {
            if (Model.OrderStatus != OrderStatus.Error)
            {
                <b>Please review this order summary and and choose billing method.</b>

                <div class="row">
                    <div class="offset1 span10">Primary Contact:</div>
                    <div id="userDetailsSummed" class="span10 offset2">
                        <p>
                            @Html.Raw(@Model.UserDetails)
                            @if (isAdmin)
                            {
                                @*<button id="showSetAssignedAffiliate" class="btn btn-link" tabindex="-1">Affiliate: @Model.Affiliate.ttsDomain</button>*@

                                @*<a id="editUserDetails" role="button" class="btn btn-mini"> Edit?</a>*@
                                <div id="setAssignedAffiliate_">
                                    @using (Html.BeginForm("SetAffiliateAssignedToOrder", "Admin", FormMethod.Post, new { id = "frmChangeAffiliate_" }))
                                    {
                                        <span class="form-body">
                                            @* content will be loaded here*@
                                        </span>
                                        <span class="result">
                                            @* content will be loaded here*@
                                        </span>
                                        
                                    }
                                </div>
                            }
                        </p>
                    </div>
                </div>
                <div id="AdjustUserDetails" class="row initialHide">
                    @using (Html.BeginForm("UpdateUserByAffiliate", "Account", FormMethod.Post, new { id = "UserDetailsAdjustForm", @class = "form form-horizontal" }))
                    {
                        @Html.EditorFor(m => m.AdjustUserDetailsPanel)
                        <div class="control-group">
                            <div class="controls">
                                @*<button id="SubmitUserDetailEdits" class="btn btn-default btn-mini btn-primary">apply edits</button>*@
                            </div>
                        </div>
                    }
                </div>
                <div id="AdjustDiscount" class="row initialHide">
                    <div class="offset2 span9 ">
                        <div id="EnterDiscountCode" class="clear pull-right">
                            @Html.TextBoxFor(m => m.CheckoutDiscountCode, new { @class = "input input-medium", placeholder = "Enter Discount Code" })
                            <button class="btn btn-mini btn-primary" role="button" id="SubmitDiscountCode">Apply Code</button>
                        </div>
                    </div>
                </div>
                <div id="AdjustAddLoc" class="row initialHide">
                    <div class="offset2 span9 ">
                        <div id="additionalLocationsCaption" class="clear pull-right">
                            Additional Locations: <button id="addAnotherAddLoc" class="btn btn-mini">add</button>

                            @using (Html.BeginForm("UpdateAdditionalLocations", "Cart", FormMethod.Post, new { id = "AdjustAddLocsForm" }))
                            {
                                <div id="additionalLocationsList">
                                    @* List of additional location inputs gets copied here. *@

                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div id="AdjustOrder" class="row initialHide">
                    <div class="offset2 span9 ">
                        <div id="RegTypeChanger" class="clear pull-right">
                            @{
                                Html.RenderPartial("~/Views/Cart/Partials/_DisplayOptionsInDropDown.cshtml", Model.DisplayOptionsInDropDownViewModel);
                            }
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div id="inProcCart" class="well text-center">
                        <div id="showCartPrice">
                            @{ Html.RenderPartial("~/Views/Cart/Partials/_DisplayRowPrice.cshtml", Model.DisplayRowPriceViewModel); }
                        </div>
                    </div>
                </div>
            }

            @*if (Model.OrderStatus != OrderStatus.InProcess)
            {
                <div id="postCheckout" class="well pull-right">
                    <div id="showCartPrice">@{ Html.RenderPartial("~/Views/Cart/Partials/_DisplayRowPrice.cshtml", Model.DisplayRowPriceViewModel); }</div>
                    @if (Model.OrderStatus != OrderStatus.Paid)
                    {
                        <span style="font-size: small; text-align: center;">
                            To be invoiced after the event or
                        </span>
                        <button class="btn btn-mini btn-success" id="ConfirmRegistrationPayByCC">Pay By Credit Card</button>
                        <br />
                    }
                </div>
                <div class="row">
                    <div class="span2 offset1 alignright">
                        Primary Contact:<br />
                        <br />

                        Type:<br />

                    </div>
                    <div class="span4">
                        @Html.Raw(@Model.UserDetails)<br />

                        @Model.OptionLabel<br />
                    </div>
                </div>
                <div class="row">
                    <div class="pull-right">
                        <a class="btn btn-mini btn-success" href="#ResendConfirmationModal" data-toggle="modal" id="ConfirmationResender">Resend/Forward Order Summary</a>
                    </div>
                </div>
            }*@
        }
    }
}

@{
    Html.RenderPartial("~/Views/Cart/Partials/_ConfirmModalForAffiliate.cshtml");
    if (ViewBag.Order != null)
    {
        ViewBag.NoteVersion = "03";
        Html.RenderPartial("~/Views/Cart/Partials/_PayByMoneris.cshtml", (Order)ViewBag.Order);

        Html.RenderPartial("~/Views/Cart/Partials/_CancelModal.cshtml", (Order)ViewBag.Order);
    }
    //Html.RenderPartial("~/Views/Cart/Partials/_UserDetailsModal.cshtml", Model.ShippingDetailsModel);
}

<script type="text/javascript">
    $(function() {
        // permits Admin to choose which affiliate will be credited with order

        $('#frmChangeAffiliate_ > span.form-body').load('/Admin/GetAffiliates', function () {

            $('#SelectedAffiliate').val(currentAffiliateId);

            $('#frmChangeAffiliate_').on('change', function (e) {

                e.preventDefault();

                var self = this;

                var payload = {
                    idAffiliate: $('#SelectedAffiliate').val(),
                    idOrder: OCA.cartStateManager.getOrderId()
                };
                var url = $('#frmChangeAffiliate_').attr('action');

                $.ajax({
                    type: 'POST',
                    contentType: constants.JsonContentType,
                    cache: false,
                    url: url,
                    dataType: constants.JsonDataType,
                    data: JSON.stringify(payload),
                    beforeSend: function () {
                        $(self).append('<span id="changeAffSpinner">&nbsp;<i class="icon-spinner icon-spin"></i></span>');
                        $(self).attr('disabled', 'disabled');
                        $('#resultLabel').remove();
                    }
                }).done(function (data) {
                    if (data.Result === 'Success') {
                        $('#setAssignedAffiliate_').find('span[class="result"]').prepend('<span id="resultLabel" class="label label-success"><span>&nbsp;<i class="icon icon-thumbs-up"></i>&nbsp;Affiliate updated successfully.</span>&nbsp;</span>');
                        $('#changeAffSpinner').remove();
                    } else {
                        $('#setAssignedAffiliate_').find('span[class="result"]').prepend('<span id="resultLabel" class="label label-danger"><span>&nbsp;<i class="icon icon-thumbs-down"></i>&nbsp;Affiliate update failed.</span>&nbsp;</span>');
                        $('#changeAffSpinner').remove();                        
                    }
                });
            });
        });

        $('#setAssignedAffiliate').on('hidden', function (e) {
            $('#submitChangeAffilate').off('click');
            modalFormOptions = null;
            $('#resultLabel').remove();
        });

        $('#setAssignedAffiliate').on('shown', function (e) {
            $('#loadAffModal').remove();
            $('#resultLabel').remove();
        });

        var anyAddLocs = @(string.IsNullOrWhiteSpace(Model.AdditionalLocationCaption) ? "false" : "true");
    });
</script>
