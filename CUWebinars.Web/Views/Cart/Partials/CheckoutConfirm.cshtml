    <div id="ConfirmModal" class="modal hide fade">
        <form action="/cart/confirmOrder/@orderRowID" method="post" id="confirmOrder">
            <input type="hidden" name="id" value="@orderRowID" />
            <input type="hidden" id="Step2_BillMeFormReferred" name="referred" value="" />
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h3 id="confirmCaption"></h3>
            </div>
            <div id="confirmResult" class="modal-body">
                <p>Registration is Confirmed</p>
            </div>
            <div class="modal-footer">
                <a href="#" id="confirmRegistration" role="button" class="btn btn-success">Continue</a>
            </div>

        </form>

    </div>

    <div id="CancelModal" class="modal hide fade">
        <form action="/cart/cancelOrder/@orderRowID" method="post" id="cancelOrder">

            <input type="hidden" name="id" value="@orderRowID" />
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h3 id="cancelCaption">Cancel This Order?</h3>
            </div>
            <div id="cancelResult" class="modal-body">
                <p>Please confirm that you wish to delete this registration.</p>
            </div>
            <div class="modal-footer">
                <a href="#" id="rtn" class="close btn btn-inverse" data-dismiss="modal">Return to checkout</a>&nbsp;&nbsp;
                <a href="/" id="continueReg" class="btn btn-success hide">Continue</a>&nbsp;&nbsp;
                <input type="submit" id="cancelRegistration" value="Delete This Registration" class="btn btn-danger" />
            </div>
        </form>
    </div>


    <div id="AddCCModal" class="modal hide fade">
