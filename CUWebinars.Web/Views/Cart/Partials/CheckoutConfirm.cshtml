@using Ninject
@model CheckoutConfirmViewModel

    @{
        if (Model.OrderExists)
        {
            var orderRowID = 0;
            var orderID = 0;
            if (Model.OrderRowExists && Model.OrderRowHasId)
            {

                //if (!string.IsNullOrEmpty(row.AlternateEmail))
                //{
                //    CCUserDetails = row.AlternateEmail;
                //}
                
                <div style="font-size: smaller;">@{ Html.RenderPartial("~/Views/Account/Partials/OrderHasAdditionalLocations.cshtml", Model.OrderHasAdditionalLocationsViewModel); }</div>
                //TODO: Handle Discounts

                if (Model.OrderStatus == OrderStatus.InProcess)
                {
                    <div id="inProcCart" class="well pull-right">
                        <div id="showCartPrice">
                            @{ Html.RenderPartial("Partials/_DisplayRowPrice", Model.DisplayRowPriceViewModel); }
                        </div>

                        <div style="font-size: x-small; text-align: center;">
                            <button class="btn btn-success" role="button" id="ConfirmRegistrationBillMe" onclick=" PlaceOrder(); ">Bill Me!</button>
                            <button class="btn btn-success" id="ConfirmRegistrationPayByCC">Pay By Credit Card</button><br />
                            <a href="#CancelModal" data-toggle="modal" class="btn" id="Canceller">Cancel Registration</a><br />
                            Sales tax may be added to orders in Wisconsin or Illinois.
                        </div>
                    </div>
                    <div><b>Please review this order summary and and choose billing method.</b></div>
                    <div class="row">
                        <div class="span2 offset1 alignright">
                            Primary Contact:<br />
                            <br />
                            CC Notifications:<br />
                            Type:<br />
                            Additional Locations:
                        </div>
                        <div class="span5">
                            @Html.Raw(@Model.UserDetails)<br />@Html.Raw(@Model.CCUserDetails)<br />
                            @{ Html.RenderPartial("Partials/_DisplayOptionsInDropDown", Model.DisplayOptionsInDropDownViewModel); }
                            <br />
                            @*@Html.Raw(addLocCaption)*@
                        </div>
                    </div>

                    <div class="row">
                        <div class="span5">
                            <input size="350" type="text" placeholder="How did you hear about this webinar?" name="referred" id="tbReferred" value="" />
                            @Html.Raw(Model.UserComments)
                            @Html.Raw(Model.AffiliateComments)
                            @if (Model.UserType == UserType.Admin)
                            {
                                <br />
                                @Html.Raw(Model.AdminComments)
                                <br />
                                @Html.Raw(Model.Origin)
                            }
                        </div>
                        <div class="span2">&nbsp;</div>
                    </div>
                    <div class="row">
                        <div class="span2 offset1 alignright">
                            Have a comment or question for our staff?<br />
                        </div>
                    </div>
                }



                if (Model.OrderStatus != OrderStatus.InProcess)
                {
                    Model.UserDetails += " - <a role=\"button\" class=\"btn btn-mini\" target=\"new\" href='/account/manage/" + Model.idUser + "' > Edit?</a> ";

                    <div id="postCheckout" class="well pull-right">
                        <div id="showCartPrice">@{ Html.RenderPartial("Partials/_DisplayRowPrice", Model.DisplayRowPriceViewModel); }</div>
                        @if (Model.OrderStatus != OrderStatus.Paid)
                        {
                            <span style="font-size: small; text-align: center;">
                                Invoice mailed following the event.<br />
                                Optionally you can
                            </span>
                            <button class="btn btn-mini btn-success" id="ConfirmRegistrationPayByCC">Pay By Credit Card</button>
                            <br />
                        }
                    </div>
                    <div class="row">
                        <div class="span2 offset1 alignright">
                            Primary Contact:<br />
                            <br />
                            CC Notifications:<br />
                            Type:<br />

                        </div>
                        <div class="span4">
                            @Html.Raw(@Model.UserDetails)<br />
                            @Html.Raw(@Model.CCUserDetails)<br />
                            @Model.OptionLabel<br />
                            Additional Locations:<br />@Html.Raw(Model.AdditionalLocationCaption)
                        </div>
                    </div>
                    <div class="row">
                        <div class="pull-right">
                            <a class="btn btn-mini btn-success" href="#ResendConfirmationModal" data-toggle="modal" id="ConfirmationResender">Resend/Forward Order Summary</a>
                        </div>
                    </div>
                }
            }

        }
    }

    @*
        @{
            if (orderRowID > 0)
            {
                <div id="AddLocation_@(orderRowID)" class="modal hide fade">
                    @Html.Partial("~/Views/Shared/AddLocationsView.cshtml", row)
                </div>
                if (Model.Order.OrderStatus != OrderStatus.InProcess)
                {
                    <div id="ResendConfirmationModal" class="modal hide fade">
                        @Html.Partial("~/Views/Shared/ResendConfirmationView.cshtml", row)
                    </div>
                }
            }
        }*@



<script type="text/javascript" language="javascript">
    var confirmOrderForm = $("#confirmOrder");
    var cancelOrderForm = $("#cancelOrder");

    function PlaceOrder() {
        $("#Step2_BillMeFormReferred").val($("#tbReferred").val());
        confirmOrderForm.submit();
    }

    $(document).ready(function () {
        @*formID = @(orderRowID);*@


        //$("#cancelRegistration").bind("click", cancelOrderForm.submit());

        confirmOrderForm.submit(function (e) {
            console.log("submitting ConfirmOrder");
            e.preventDefault();
            $("#ProgressDialogBS").modal('show');
            var data = confirmOrderForm.serialize();
            $.post(confirmOrderForm.attr("action"), data, function (result, status) {
                if (result.success) {
                    orderRowID = result.orderRowID;

                    $("#confirmResult").html(result.msg);
                    $("#confirmRegistration").attr("href", "javascript:location.reload();");
                    //$.get("/cart/checkoutConfirm/" + orderRowID, function (dataConfirm) {
                    //    $('#confirmation').replaceWith(dataConfirm);
                    //});
                    //$("#signUpTab").show();
                    //$("#contactInfoTab").show();

                    CheckoutInProcess = false;

                    $("#ProgressDialogBS").modal('hide');
                    $('#ConfirmModal').modal('show');
                } else {
                    $('.signupErrors').html("Invalid Data. Try again or call 800-831-0678 ext 706 for immediate assistance! ");
                }
            }, "json");
            return false;

        });

        cancelOrderForm.submit(function (e){
            console.log("Submitting Cancel Order");
            e.preventDefault();
            var data = cancelOrderForm.serialize();
            $.post(cancelOrderForm.attr("action"), data, function (result, status) {
                if (result.success) {

                    $('#cancelCaption').text("Order is canceled");
                    $("#cancelRegistration").unbind("click");
                    $("#rtn").hide();
                    $("#continueReg").show();
                    $("#cancelResult").hide();
                    $("#cancelRegistration").hide();
                    //$("#continueReg").attr("href", "/");

                } else {
                    alert("else");
                    $('.signupErrors').html("Invalid Data. Try again?");
                }
            }, "json");
            return false;
        });
    });

</script>
