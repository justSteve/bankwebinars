@using Ninject
@model CheckoutConfirmViewModel

@{
    if (Model.OrderExists)
    {
        var orderRowID = 0;
        var orderID = 0;
        if (Model.OrderRowExists && Model.OrderRowHasId)
        {

            //if (!string.IsNullOrEmpty(row.AlternateEmail))
            //{
            //    CCUserDetails = row.AlternateEmail;
            //}

            <div style="font-size: smaller;">@{ Html.RenderPartial("~/Views/Account/Partials/OrderHasAdditionalLocations.cshtml", Model.OrderHasAdditionalLocationsViewModel); }</div>
             //TODO: Handle Discounts

             if (Model.OrderStatus == OrderStatus.InProcess)
             {
                <div id="inProcCart" class="well pull-right">
                    <div id="showCartPrice">
                        @{ Html.RenderPartial("Partials/_DisplayRowPrice", Model.DisplayRowPriceViewModel); }
                    </div>

                    <div style="font-size: x-small; text-align: center;">
                        <button class="btn btn-success" role="button" id="ConfirmRegistrationBillMe">Bill Me!</button>
                        <button class="btn btn-success" id="ConfirmRegistrationPayByCC">Pay By Credit Card</button><br />
                        <a class="btn" id="Canceller">Cancel Registration</a><br />
                        Sales tax may be added to orders in Wisconsin or Illinois.
                    </div>
                </div>
                <div><b>Please review this order summary and and choose billing method.</b></div>
                <div class="row">
                    <div class="span3 text-right" style="margin-left: 20px">Primary Contact:</div><div id="userFullname" class="span3 text-left">@Model.UserFullname</div>
                    <div class="span3 text-right">Type:</div><div id="chosenRegType" class="span3 text-left">@Model.OptionLabel</div>
                    <div class="span3 text-right">Additional Locations:</div>
                    <div class="span3 text-left">
                        @{
                 if (string.IsNullOrWhiteSpace(Model.AdditionalLocationCaption))
                 {
                    <text>None</text>
                 }
                 else
                 {
                    @Model.AdditionalLocationCaption
                 }
                        }
                    </div>

                    <div id="userDetailsSummed" class="span5 offset1">
                        <p>@Html.Raw(@Model.UserDetails)</p>

                        <p>@{ Html.RenderPartial("Partials/_DisplayOptionsInDropDown", Model.DisplayOptionsInDropDownViewModel); }</p>
                        <br />
                        @*@Html.Raw(addLocCaption)*@
                    </div>
                </div>

                <div class="row">
                    <div class="span5 offset1">
                        <input class="input input-xlarge" type="text" placeholder="How did you hear about this webinar?" name="referred" id="tbReferred" value="" />
                        @Html.TextBoxFor(m => m.DiscountCode, new { @class = "input input-medium", placeholder = "Enter Discount Code" })<button class="btn btn-mini" role="button" id="SubmitDiscountCode">Apply Code</button>

                        @Html.Raw(Model.UserComments)
                        @Html.Raw(Model.AffiliateComments)
                        @if (Model.UserType == UserType.Admin)
                        {
                            <br />
                            @Html.Raw(Model.AdminComments)
                            <br />
                            @Html.Raw(Model.Origin)
                        }
                    </div>
                    <div class="span2 offset1">&nbsp;</div>
                </div>
                <div class="row">
                    <div class="span5 offset1">
                        Have a comment or question for our staff?<br />
                    </div>
                </div>
             }



             if (Model.OrderStatus != OrderStatus.InProcess)
             {
                 Model.UserDetails += " - <a id='editUserDetails' role='button' class='btn btn-mini' target='new'> Edit?</a>";

                <div id="postCheckout" class="well pull-right">
                    <div id="showCartPrice">@{ Html.RenderPartial("Partials/_DisplayRowPrice", Model.DisplayRowPriceViewModel); }</div>
                    @if (Model.OrderStatus != OrderStatus.Paid)
                    {
                        <span style="font-size: small; text-align: center;">
                            Invoice mailed following the event.<br />
                            Optionally you can
                        </span>
                        <button class="btn btn-mini btn-success" id="ConfirmRegistrationPayByCC">Pay By Credit Card</button>
                        <br />
                    }
                </div>
                <div class="row">
                    <div class="span2 offset1 alignright">
                        Primary Contact:<br />
                        <br />

                        Type:<br />

                    </div>
                    <div class="span4">
                        @Html.Raw(@Model.UserDetails)<br />

                        @Model.OptionLabel<br />
                        Additional Locations:<br />@Html.Raw(Model.AdditionalLocationCaption)
                    </div>
                </div>
                <div class="row">
                    <div class="pull-right">
                        <a class="btn btn-mini btn-success" href="#ResendConfirmationModal" data-toggle="modal" id="ConfirmationResender">Resend/Forward Order Summary</a>
                    </div>
                </div>
             }
        }

    }
}

@{
    //Html.RenderPartial("Partials/_ConfirmModal");
    Html.RenderPartial("Partials/_UserDetailsModal", Model.ManageModel);
}

@using (Html.BeginForm("SignInAfterCheckout", "Account", null, FormMethod.Post, new { id = "_SignInAfterCheckout" }))
{
    @Html.AntiForgeryToken()
}

<script type="text/javascript">var anyAddLocs = @(string.IsNullOrWhiteSpace(Model.AdditionalLocationCaption) ? "false" : "true");</script>

