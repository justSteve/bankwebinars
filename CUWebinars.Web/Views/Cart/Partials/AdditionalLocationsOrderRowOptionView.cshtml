@model CUWebinars.Web.Models.AdditionalLocationsOrderRowOption
@using CUWebinars.Business.Models
@{
    var webinar = ViewData["Webinar"] as Webinar;
    if (webinar != null && webinar.Status == WebinarStatus.Scheduled && 
        OptionsFacade.Instance.Load((int)Model.OrderRow.RegistrationType).ShowLiveNotifications=="Yes")
    {
    <tr>
        <td align="right" colspan="2">
            <div class="cartOption additionalLocationCartOption">
                <a id="AddLocCaption">Add Additional Locations?</a>
                <div class="value">
                    <div class="left">
                        @if (Model.OrderRow.Webinar.IsSubscriptionWebinar &&
                              Model.OrderRow.Webinar.Status == WebinarStatus.Scheduled)
                        {

                            foreach (OrderRowOption option in Model.OrderRow.OrderRowOptions)
                            {
                                if (option is AdditionalLocationsOrderRowOption)
                                {
                                    AdditionalLocationsOrderRowOption additionalLocationOption = (AdditionalLocationsOrderRowOption)option;
                                    List<string> addLocEmails = new List<string>();
                                    addLocEmails = (additionalLocationOption.Emails).ToList();
                    
                            <script type="text/javascript" language="javascript">
                                        addLocEmailsNum = @addLocEmails.Count;
                                        if (addLocEmailsNum == 1) {myCaption = "One additional location. Change?";}
                                        if (addLocEmailsNum > 1) {myCaption = addLocEmails + " additional locations. Change?";}
                                        if (addLocEmailsNum > 0) {$('#AddLocCaption').html(myCaption);}

                                        $('#AddLocCaption').html(myCaption);
                            </script>
                    
                                    if (addLocEmails.Count > 0)
                                    {
                                        if (addLocEmails.Count == 1)
                                        {
                            <p>
                                You have designated the following address as an additional location:<br />
                                @addLocEmails.ElementAt(0)<br />
                            </p>
                                        }
                                        else
                                        {                   
                            <p class='alignright'>
                                You have designated the following addresses as additional locations:<br />
                                @foreach (string email in addLocEmails)
                                {
                                    @email <br />
                                }</p>
                                        }
                                    } // ending (addLocEmails.Count > 0 )
                                    else
                                    {
                                        continue;

                                    }

                                }
                            }

                        } //ending test for subscription event
                        else
                        {
                            foreach (OrderRowOption option in Model.OrderRow.Options)
                            {
                                if (option is AdditionalLocationsOrderRowOption)
                                {
                                    AdditionalLocationsOrderRowOption additionalLocationOption = (AdditionalLocationsOrderRowOption)option;
                                    List<string> addLocEmails = new List<string>();

                                    addLocEmails = (additionalLocationOption.Emails).ToList();
                                
                      
                            <script type="text/javascript" language="javascript">
                                
                                        addLocEmailsNum = @addLocEmails.Count;

                                        if (addLocEmailsNum == 1){myCaption = "One additional location. Change?";}
                                        if (addLocEmailsNum > 1){myCaption = addLocEmails + " additional locations. Change?";}
                                        if (addLocEmailsNum > 0){$('#AddLocCaption').html(myCaption);}

                                         $('#AddLocCaption').html(myCaption);

                            </script>
                            
                                    if (addLocEmails.Count > 0)
                                    {
                                        if (addLocEmails.Count == 1)
                                        {
                            <p>
                                You have designated the following address as an additional location:<br />@addLocEmails.ElementAt(0)</p>
                                        }
                                        else
                                        {
                            <p class='alignright'>
                                You have designated the following addresses as additional locations:<br />
                                @foreach (string email in addLocEmails) {
                                @email
                                <br />
                                }
                            </p>
                                        }
                                    }
                                    else
                                    {
                                        continue;

                                    }
                                }
                            }
                        }
                    </div>
                    <div id="addLocationsInput" class="right">
                        <b>Additional Locations:</b>
                        <input type="text" name="AdditionalLocationsCount_Model.OrderRow.Id" onblur="javascript:setRowID(@Model.OrderRow.Id, this.value)"; value="@Model.AdditionalLocationsCount"
                        size="2" maxlength="2" id="connectionsCount" />
                        <input type="hidden" id="rowID" value = "@Model.OrderRow.Id " />
                    </div>
                    <div id="collectAdditionalLocations">
                    </div>
                    <div id="addLocSubmitter">
                        <input type="image" src="/Content/images/search-icon.png" onclick="javascript:fireUpdateCart();" /></div>
                </div>
            </div>
        </td>
    </tr>
    }
}
