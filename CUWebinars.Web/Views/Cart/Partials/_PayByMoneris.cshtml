@using CUWebinars.Web.Core
@model Order
@functions {
    private const string CurrencyFormatToken = "c";
    private const string DotAndTwoDecimals = ".00";


}
@{
    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;
    var TaxAmount = Convert.ToDecimal(ViewBag.TaxAmount);

    var note = globalConfig.Tenant + " thanks you! Watch your email for complete details. " + ViewBag.NoteVersion;

    if (ReferenceEquals(TaxAmount, null))
    {
        TaxAmount = 0;

    }
    //Layout = "/Views/Shared/_Layout_PayCC.cshtml";
    var hpp_id = globalConfig.TenantMonerisHpp_Id;
    var hpp_key = globalConfig.TenantMonerisHpp_Key;
    var order = Model;

    var myRow = order.OrderRows.Single(or => or.RowStatus == OrderRowStatus.Active);
    var RowPrice = Convert.ToDecimal(myRow.RowPrice);

    var regTypeDesc = myRow.RegistrationType.OptionLabel;

    var title = myRow.Webinar.Title;
    title = title.Replace("%", "");
    title = title.Replace("&", "");
    title = title.Replace("#", "");
    title = title.Replace("[", "");
    title = title.Replace("]", "");
    title = title.Replace("<", "");
    title = title.Replace(">", "");
    title = title.Replace("\"", "");
    title = title.Replace("\\", "");
    title = title.Replace("'", "");
    title = title.Replace("/", "");

    if (myRow.AdditionalLocation.Count > 0)
    {
        if (myRow.AdditionalLocation.Count == 1)
        {
            regTypeDesc += " Includes 1 Additional Location";
        }
        else
        {
            regTypeDesc += " Includes " + myRow.AdditionalLocation.Count + " Addition Locations.";
        }
    }

    <script type="text/javascript" language="javascript">
        function SubmitCCForm () {

            $("#PayByCCForm").submit();
        }

        $(function() {
            var idOrder = @Model.idOrder;
            var updatedTotal = @Model.Total;

            $('#PayByCCModal').on('show', function () {

                $.ajax({

                    datatype: "text/plain",
                    type: "GET",
                    url: '/cart/IniMonerisModal?idOrder='+idOrder,
                    cache: false,
                    success: function (data) {

                        //moneris requires that cents are included:

                        amount2Charge = data.total;

                        if (amount2Charge.toString().indexOf(".") == -1) {
                            amount2Charge = amount2Charge + ".00";
                        }

                        $("#PayByCCForm input[name='amount']").val( amount2Charge);
                        $("input[name='li_price1']").val( amount2Charge);

                        $("#PayByCCForm input[name='hpp_id']").val("@globalConfig.TenantMonerisHpp_Id");
                        $("#PayByCCForm input[name='hpp_key']").val("@globalConfig.TenantMonerisHpp_Key");
                        @*$("#PayByCCForm input[name='amount']").val("9.00">*@

                        $("#PayByCCForm input[name='li_id1']").val("@order.idOrder");
                        $("#PayByCCForm input[name='li_description1']").val("@title - @regTypeDesc");
                        $("#PayByCCForm input[name='li_quantity1']").val("1");
                        
                        $("#PayByCCForm input[name='li_taxes']").val("@Math.Round(TaxAmount,2)");
                        $("#PayByCCForm input[name='li_taxamount']").val("@Math.Round(TaxAmount, 2)");
                        $("#PayByCCForm input[name='li_invoice']").val("@globalConfig.TenantPrefix@order.idOrder");
                        $("#PayByCCForm input[name='cust_id']").val("@order.BillingEmail");
                        $("#PayByCCForm input[name='order_no']").val("@globalConfig.TenantPrefix@order.idOrder");
                        $("#PayByCCForm input[name='client_email']").val("@order.BillingEmail");
                        $("#PayByCCForm input[name='note']").val("@note");

                        $("#PayByCCForm input[name='od_bill_firstname']").val("@order.FirstName");
                        $("#PayByCCForm input[name='od_bill_lastname']").val("@order.LastName");
                        $("#PayByCCForm input[name='od_bill_company']").val("@order.Institution");
                        $("#PayByCCForm input[name='od_bill_address']").val("@order.BillingAddress");
                        $("#PayByCCForm input[name='od_bill_city']").val("@order.BillingCity");
                        $("#PayByCCForm input[name='od_bill_state']").val("@order.BillingState");
                        $("#PayByCCForm input[name='od_bill_zipcode']").val("@order.BillingZip");

                        $("#PayByCCForm input[name='od_bill_phone']").val("@order.BillingPhone");

                        $("#PayByCCForm input[name='od_ship_firstname']").val("@order.ShippingFirstName");
                        $("#PayByCCForm input[name='od_ship_lastname']").val("@order.ShippingLastName");
                        $("#PayByCCForm input[name='od_ship_company']").val("@order.Institution");
                        $("#PayByCCForm input[name='od_ship_address']").val("@order.ShippingAddress");
                        $("#PayByCCForm input[name='od_ship_city']").val("@order.ShippingCity");
                        $("#PayByCCForm input[name='od_ship_state']").val("@order.ShippingState");
                        $("#PayByCCForm input[name='od_ship_zipcode']").val("@order.ShippingZip");

                        $("#PayByCCForm input[name='od_ship_phone']").val("@order.ShippingPhone");


                        $("#btnSubmitCCForm").click(function() {
                            SubmitCCForm();
                        });
                    }
                });
            });
            //
        });

    </script>
}

<div id="PayByCCModal" class="modal hide fade">

    <input type="hidden" name="id" />
    <input type="hidden" id="Step2_BillMeFormReferred" name="referred" value="" />
    <div class="modal-header">
        <h3 id="confirmCaption"></h3>
    </div>
    <div id="PayByCCModalOrderDetails" class="modal-body">
        <div>

            <div class="legendImitator">
                Credit Card Processing Redirect
            </div>

            <div style="margin-bottom:10px;">
                We will now redirect your browser to our credit card processor - https://esplusqa.moneris.com - for entry of credit card information.
                @*Direct credit card processing is temporarily offline. We apologize for the inconvenience. Please choose the 'Bill Me' option or call us at 800-831-0678 to post immediate payment with our customer service staff.*@
            </div>


            <div class="pull-right">


                <button class="btn" data-dismiss="modal" aria-hidden="true">Cancel</button>
                <button class="btn btn-success" name="btnSubmitCCForm" id="btnSubmitCCForm">Submit</button>
            </div>
        </div>


    </div>
</div>
