@using System.Text
@model DisplayRowPriceViewModel

@functions {
    private decimal CalculateOptionsPrice(OrderRow row)
    {
        return 0;
    }

}
@{
    if (Model != null)
    {
        var verbose = false;
        if (ViewData.ContainsKey("verbose"))
        {
            if (!String.IsNullOrEmpty(ViewData["verbose"].ToString()))
            {
                verbose = (bool)ViewData["verbose"];
            }
        }

        //decimal optionsTotal = CalculateOptionsPrice(Model);
        decimal optionsTotal = 0.0M; //TODO: fix this. Push to Controller.
        var rowAmount = new StringBuilder();

        Model.Discount = new Discount //todo: come back to this when we get to the discount stuff
        {
            code = "abc", flatOff = 10.0M
        };
        
        if (Model.Discount.flatOff != 0.0M || Model.Discount.percentOff != 0.0M || optionsTotal != 0.0M)
        {
            rowAmount.Append("Base Cost: " + Model.RegistrationType.Price.ToString("c0") + "<br />");
        }
        else if (verbose == true)
        {
            rowAmount.Append("Base Cost: " + Model.RegistrationType.Price.ToString("c0") + "<br />");
        }

        if (Model.Discount.flatOff != 0.0M)
        {
            rowAmount.Append("Discounted: " + Model.Discount.flatOff.ToString("c") + " (" + Model.Discount.code + ")<br />");
        }
        else if (verbose == true)
        {
            rowAmount.Append("Discounted: " + Model.Discount.flatOff.ToString("c") + " (" + Model.Discount.code + ")<br />");
        }
        if (optionsTotal != 0.0M)
        {
            if (Model.NumberOfAdditionalLocations == 1)
            {
                rowAmount.Append("One Additional Location: " + optionsTotal.ToString("c").Replace(".00", "") + "<br>");
            }
            else
            {
                rowAmount.Append(Model.NumberOfAdditionalLocations.ToString() + " Additional Locations: " + optionsTotal.ToString("c").Replace(".00", "") + "<br>");
            }
        }
        else if (verbose == true)
        {
            if (Model.NumberOfAdditionalLocations == 1)
            {
                rowAmount.Append("One Additional Location: " + optionsTotal.ToString("c").Replace(".00", "") + "<br>");
            }
            else
            {
                rowAmount.Append(Model.NumberOfAdditionalLocations.ToString() + " Additional Locations: " + optionsTotal.ToString("c").Replace(".00", "") + "<br>");
            }
        }
        rowAmount.Append("Total Cost: " + Model.RowPrice.ToString("c").Replace(".00", ""));

        <div id="billingDetails" class="well" style="text-align: right;">
            @Html.Raw(rowAmount.ToString())<br />

            @{
        var statusLabel = "";
        switch (Model.OrderStatus)
        {
            case OrderStatus.InProcess:
                <span class="label label-warning">@OrderStatus.InProcess</span>
                break;

            case OrderStatus.Submitted:
            <span class="label label-info">@OrderStatus.Submitted</span>
                break;

            case OrderStatus.Paid:
            <span class="label label-success">@OrderStatus.Paid</span>
                break;

            case OrderStatus.AwaitingVerification:
            <span class="label label-warning">@OrderStatus.AwaitingVerification</span>
                break;
        }
            }
        </div>
    }
}