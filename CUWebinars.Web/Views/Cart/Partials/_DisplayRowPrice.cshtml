@using CUWebinars.Business.Core.Helpers
@using OpenQA.Selenium
@model DisplayRowPriceViewModel

@functions {
    private const string CurrencyFormatToken = "c";
    private const string DotAndTwoDecimals = ".00";

    private string GetDiscountedTextSpan()
    {
        var outerSpan = new TagBuilder("span");
        outerSpan.GenerateId("discountedText");

        var totalDiscountElement = new TagBuilder("span");
        totalDiscountElement.GenerateId("totalDiscount");
        totalDiscountElement.SetInnerText(Model.PricesAndDiscounts.TotalDiscount.ToString(CurrencyFormatToken));
        if (Model.PricesAndDiscounts.TotalDiscount == 0)
        {
            outerSpan.AddCssClass("muted");
        }
        else
        {
            //not really error
            totalDiscountElement.AddCssClass("text-error");
        }

        outerSpan.InnerHtml = string.Concat("Discounted: <span style=\"color: red;\">", totalDiscountElement.ToString(TagRenderMode.Normal), "<br></span>");

        return outerSpan.ToString(TagRenderMode.Normal);
    }

    private string GetAdditionalLocationsTextSpan()
    {
        var outerSpan = new TagBuilder("span");
        outerSpan.GenerateId("addLocsText");

        if (Model.PricesAndDiscounts.TotalCostOfOptions == 0)
            outerSpan.AddCssClass("muted");

        var additionalLocsPriceElement = new TagBuilder("span");
        additionalLocsPriceElement.GenerateId("totalAdLocsPrice");
        additionalLocsPriceElement.SetInnerText(Model.PricesAndDiscounts.TotalCostOfOptions.ToString(CurrencyFormatToken));

        if (Model.NumberOfAdditionalLocations == 0)
        {
            outerSpan.InnerHtml = "";
        }
        else
        {


            outerSpan.InnerHtml = string.Concat(Model.NumberOfAdditionalLocations, " Additional Locations: ", additionalLocsPriceElement.ToString(TagRenderMode.Normal), "</br>");
        }

        return outerSpan.ToString(TagRenderMode.Normal);
    }

    private string GetStatusLabel(OrderStatus orderStatus)
    {
        var statusLabelSpan = new TagBuilder("span");

        statusLabelSpan.GenerateId("orderStatusLabel");
        statusLabelSpan.AddCssClass("label");

        switch (orderStatus)
        {
            case OrderStatus.InProcess:
                statusLabelSpan.AddCssClass("label-warning");
                statusLabelSpan.SetInnerText(OrderStatus.InProcess.ToString());
                break;

            case OrderStatus.Error:
                statusLabelSpan.AddCssClass("label-warning");
                statusLabelSpan.SetInnerText(OrderStatus.InProcess.ToString());
                break;

            case OrderStatus.Submitted:
                statusLabelSpan.AddCssClass("label-info");
                statusLabelSpan.SetInnerText(@OrderStatus.Submitted.ToString());
                break;

            case OrderStatus.Paid:
                statusLabelSpan.AddCssClass("label-success");
                statusLabelSpan.SetInnerText(@OrderStatus.Paid.ToString());
                break;

            case OrderStatus.AwaitingVerification:
                statusLabelSpan.AddCssClass("label-warning");
                statusLabelSpan.SetInnerText(@OrderStatus.AwaitingVerification.ToString());
                break;

            case OrderStatus.Canceled:
                statusLabelSpan.AddCssClass("label-warning");
                statusLabelSpan.SetInnerText(@OrderStatus.Canceled.ToString());
                break;

            case OrderStatus.Billed:
                statusLabelSpan.AddCssClass("label-success");
                statusLabelSpan.SetInnerText(@OrderStatus.Billed.ToString());
                break;

            case OrderStatus.OutstandingBalance:
                statusLabelSpan.AddCssClass("label-important");
                statusLabelSpan.SetInnerText("Outstanding Balance");
                break;
        }

        return statusLabelSpan.ToString(TagRenderMode.Normal);
    }
}

@{
    if (Model != null)
    {
        string discountCaption = "";
        if (!ReferenceEquals(ViewBag.DiscountCaption, null))
        {
            discountCaption = ViewBag.DiscountCaption.ToString();
        }
        var discResult = "success";
        if (discountCaption != "" && (discountCaption.Contains("Insufficient") || discountCaption.Contains("expired")))
        {
            discResult = "danger";
        }
        var confirmButtonLabel = "Bill Me!";

        var rowAmount = new StringBuilder();

        if (Model.RegistrationType.ShowShippedNotifications.ToLower() == "yes")
        {
            rowAmount.Append("<div class=\"well well-sm\" style=\"color: green; text-align: center;\">We have gone eco-friendly! The handouts can be downloaded from the CD.  If you prefer paper handouts, please check this box. " +
                             "<input type=\"checkbox\" id=\"SendHardcopy\"  /></div>");

            var cbSendHardcopy = "";
            if (Model.SendHardcopy)
            {
                <script language="javascript" type="text/javascript">

                    $(function () {
                        $('#SendHardcopy').prop('checked', true);

                    });


                </script>
            }

        }

        rowAmount.Append("<button id='revealOptions' class='btn btn-mini btn-default'> change?</button> <span id='optionLabel'>"
+ Model.RegistrationType.OptionLabel + "</span>: <span id='baseCost'>"
+ Model.PricesAndDiscounts.UnitPrice.ToString(CurrencyFormatToken) + "</span><br />");

        if (Model.PricesAndDiscounts.Discount == null)
        {
            if (!Model.RegistrationType.OptionLabel.Contains("Streaming")
                && !Model.RegistrationType.OptionLabel.Contains("Module"))
            {
                rowAmount.Append("<button id='revealDiscountInput' class='btn btn-mini btn-default'> add discount?</button> "
                                 + GetDiscountedTextSpan() + "<br />");
            }
            else
            {
                rowAmount.Append("<br />");
            }
        }
        else
        {

            if (!Model.RegistrationType.OptionLabel.Contains("Streaming")
                && !Model.RegistrationType.OptionLabel.Contains("Module")
                && !Model.RegistrationType.SKU.Contains("WSP")
                && Model.RegistrationType.CreditCost > 0
                )
            {
                rowAmount.Append(GetDiscountedTextSpan());
                if (!rowAmount.ToString().Contains("Insufficient"))
                {
                    confirmButtonLabel = "Use My Credits!";
                }

            }
        }
        rowAmount.Append("<button id='revealAddLocsPanel' class='btn btn-mini btn-default'>share or add location?</button> " + GetAdditionalLocationsTextSpan() + "<br>");

        if (Model.PricesAndDiscounts.TaxAmount > 0)
        {
            rowAmount.Append("<span  id='showTax'>Tax: <span id='taxAmt'>" + Model.PricesAndDiscounts.TaxAmount.ToString(CurrencyFormatToken) + "<br></span></span><br />");
        }
        else
        {
            rowAmount.Append("<span class='hidden' id='showTax'>Tax: <span id='taxAmt'></span></span><br />");
        }

        rowAmount.Append("<span id='showTotalPrice'>Total Cost: <span id='totalPrice'>"
            + (Model.PricesAndDiscounts.UnitPrice + Model.PricesAndDiscounts.TotalCostOfOptions + Model.PricesAndDiscounts.TaxAmount - Model.PricesAndDiscounts.TotalDiscount).ToString(CurrencyFormatToken) + "</span></span>");

        if (Model.PricesAndDiscounts.TotalPaid != 0)
        {
            rowAmount.Append("<br><span  style='color: green;' id='showPaid'>Paid: <span id='totalPaid'>" + Model.PricesAndDiscounts.TotalPaid.ToString(CurrencyFormatToken) + "</span></span>");
            if (Model.PricesAndDiscounts.TotalOrderPrice > 0)
            {
                rowAmount.Append("<br><span  style='color: red;' id='showOutstandingBalance'>Due: <span id='outstandingBalance'>" + Model.PricesAndDiscounts.TotalOrderPrice.ToString(CurrencyFormatToken) + "</span></span>");
            }
            else
            {
                rowAmount.Append("<br><span  style='color: Green;' id='showOutstandingBalance'>Due: <span id='outstandingBalance'>" + Model.PricesAndDiscounts.TotalOrderPrice.ToString(CurrencyFormatToken) + "</span></span>");
            }

        }
        if (Model.Origin != null && Model.Origin.ToLower() != "cart")
        {
            <script language="javascript" type="text/javascript">
                 $(function () {
                     $('#ConfirmRegistrationBillMe').on('click',
                         function(e) {

                             //var self = $(this);
                             //self.find('input[name="id"]').val(orderRowId);

                             e.preventDefault();
                             var confirmOrderForm = $('#confirmOrder');

                             confirmOrderForm.find('input[name="id"]').val(@Model.idOrder);

                             var confirmRegistrationBillMe = $('#ConfirmRegistrationBillMe');

                             confirmRegistrationBillMe.prepend(
                                 '<i id="finalLoadingSpinner" class="icon-spinner icon-spin"></i>&nbsp;');
                             confirmRegistrationBillMe.attr('disabled', 'disabled');

                             confirmOrderForm.submit();
                         });
                 });
            </script>

        }
        <div id="billingDetails" style="text-align: right;">

            <div id="flyUpdateSuccessFlag"></div>
            @Html.Raw(rowAmount.ToString())

            <div id="showOrderStatus" style="padding-top: 10px;">
                Order Status:
                @Html.Raw(GetStatusLabel(Model.OrderStatus))
            </div>

            @if (!string.IsNullOrWhiteSpace(ViewBag.DiscountCaption))
            {
                <div class="@discResult" style="margin: 8px; text-align: center; padding: 7px 40px 7px 40px; width: 75%;"
                     id="discountCaption"><b>@Html.Raw(ViewBag.DiscountCaption.ToString())</b></div>
                }
                @*//following it for Multi-event checkout*@
            @if (!Request.Url.PathAndQuery.ContainsIgnoreCase("/webinar/geteditincartjson")) // i don't love this as our logic gate, is there something else we can use / invent?
            {
                <div id="payment" style="text-align: center; margin-top: 10px;">
                    @if (Model.OrderStatus != OrderStatus.Paid || Model.OrderStatus != OrderStatus.Submitted || Model.OrderStatus != OrderStatus.Billed)
                    {
                        <span>
                            @if (User.Identity.IsAuthenticated)
                            {
                                <button class="btn btn-success" data-toggle="modal" role="button" data-target="#ContinueShoppingModal" id="ContinueShoppingButton">Continue Shopping</button>
                            }
                            &nbsp;
                            &nbsp;
                            &nbsp;
                            @if (!Model.RegistrationType.OptionLabel.StartsWith("1-Month")
                                 && !Model.RegistrationType.OptionLabel.StartsWith("6-Month")
                                 && !Model.RegistrationType.OptionLabel.StartsWith("12-Month"))
                            {
                                <button class="btn btn-success" role="button" id="ConfirmRegistrationBillMe">@confirmButtonLabel</button>
                            }
                            &nbsp;
                            &nbsp;
                            &nbsp;
                        </span>
                    }
                    @if (Model.OrderStatus != OrderStatus.Paid)
                    {
                        <span>
                            @*<button data-toggle="modal" role="button" data-target="#PayByCCModal" class="btn btn-success" id="ShowPayByCCModal">Pay By Credit Card</button><br />*@
                            <button role="button" class="btn btn-success" id="ShowPayByCCModal">Pay By Credit Card</button><br />
                        </span>
                    }

                    <div class="pull-right">
                        <br />
                        <div class="label label-warning large" role="button" id="Canceller">
                            <span style="color: black"> &nbsp;&nbsp;Place cart on-hold or<br /> <i>Cancel</i> this checkout &nbsp;&nbsp;</span>
                        </div>
                    </div>

                </div>
            }
        </div>
    }
    <script type="text/javascript" language="javascript">

        var applySendHardcopy = function (e) {
            e.preventDefault();
            //var self = $(this);

            //

            var url = "/cart/SendHardcopy";

            var formData = {
                idOrder: @Model.idOrder
            };

            $.ajax({
                type: 'POST',
                contentType: "application/x-www-form-urlencoded",
                cache: false,
                url: url,
                dataType: 'json',
                data: formData,
                beforeSend: function () {
                    console.log("self");

                    //self.append('<span id="waitSpinner">&nbsp;<i class="icon-spinner icon-spin"></i></span>');
                }
            }).done(function(data) {
                if (data) {
                    var result = data.UpdateCaption.includes(" not ");
                    $('#flyUpdateSuccessFlag').html(data.UpdateCaption).show();
                    alert(data.UpdateCaption);
                    console.log(result);
                    if (result) {
                        $('#SendHardcopy').prop('checked', false);
                    } else {
                        $('#SendHardcopy').prop('checked', true);
                    }

                } else {
                    alert("Failed to update");
                }
                $('#waitSpinner').remove();
            });
        };

        $(function() {
            $('#SendHardcopy').on('click', applySendHardcopy);
        });
    </script>
}
