@model DisplayRowPriceViewModel

@functions {
        private const string CurrencyFormatToken = "c";
        private const string DotAndTwoDecimals = ".00";
}

@{
    if (Model != null)
    {
        //decimal optionsTotal = CalculateOptionsPrice(Model);
        decimal optionsTotal = 0.0M; //TODO: fix this. Push to Controller.
        var rowAmount = new StringBuilder();

        Model.Discount = new Discount //todo: come back to this when we get to the discount stuff
        {
            code = "abc",
            flatOff = 10.0M
        };
        
        rowAmount.Append("Base Cost: <span id='baseCost'>" + Model.PricesAndDiscounts.UnitPrice.ToString("c0") + "</span><br />");

        rowAmount.Append("<span id='discountedText'>Discounted: <span id='totalDiscount'>" + Model.Discount.flatOff.ToString(CurrencyFormatToken) + "</span> (" + Model.Discount.code + ")</span><br />");

        if (Model.NumberOfAdditionalLocations == 1)
        {
            rowAmount.Append("<span id='addLocsText'>One Additional Location: <span id='totalAdLocsPrice'>" + Model.PricesAndDiscounts.TotalOptions.ToString(CurrencyFormatToken).Replace(DotAndTwoDecimals, "") + "</span></span><br>");
        }
        else
        {
            rowAmount.Append("<span id='addLocsText'>" + Model.NumberOfAdditionalLocations + " Additional Locations: <span id='totalAdLocsPrice'>" + Model.PricesAndDiscounts.TotalOptions.ToString(CurrencyFormatToken).Replace(DotAndTwoDecimals, "") + "</span></span><br>");
        }

        rowAmount.Append("Total Cost: <span id='totalPrice'>" + Model.PricesAndDiscounts.TotalOrderPrice.ToString(CurrencyFormatToken).Replace(DotAndTwoDecimals, "") + "</span>");

        <div id="billingDetails" class="well" style="text-align: right;">
            @Html.Raw(rowAmount.ToString())<br />

            @{
                switch (Model.OrderStatus)
                {
                    case OrderStatus.InProcess:
                        <span id="orderStatusLabel" class="label label-warning">@OrderStatus.InProcess</span>
                        break;

                    case OrderStatus.Submitted:
                        <span id="orderStatusLabel" class="label label-info">@OrderStatus.Submitted</span>
                        break;

                    case OrderStatus.Paid:
                        <span id="orderStatusLabel" class="label label-success">@OrderStatus.Paid</span>
                        break;

                    case OrderStatus.AwaitingVerification:
                        <span id="orderStatusLabel" class="label label-warning">@OrderStatus.AwaitingVerification</span>
                        break;
                }
            }
        </div>
    }
}