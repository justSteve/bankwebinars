@model DisplayRowPriceViewModel

@functions {
    private const string CurrencyFormatToken = "c";
    private const string DotAndTwoDecimals = ".00";

    private string GetDiscountedTextSpan()
    {
        var outerSpan = new TagBuilder("span");
        outerSpan.GenerateId("discountedText");

        if (Model.PricesAndDiscounts.TotalDiscount == 0)
            outerSpan.AddCssClass("muted");

        var totalDiscountElement = new TagBuilder("span");
        totalDiscountElement.GenerateId("totalDiscount");
        totalDiscountElement.SetInnerText(Model.PricesAndDiscounts.TotalDiscount.ToString(CurrencyFormatToken));

        outerSpan.InnerHtml = string.Concat("Discounted: ", totalDiscountElement.ToString(TagRenderMode.Normal), (Model.Discount == null ? string.Empty : string.Concat(" (", Model.Discount.DiscountCode, ")")));

        return outerSpan.ToString(TagRenderMode.Normal);
    }

    private string GetAdditionalLocationsTextSpan()
    {
        var outerSpan = new TagBuilder("span");
        outerSpan.GenerateId("addLocsText");

        if (Model.PricesAndDiscounts.TotalCostOfOptions == 0)
            outerSpan.AddCssClass("muted");

        var additionalLocsPriceElement = new TagBuilder("span");
        additionalLocsPriceElement.GenerateId("totalAdLocsPrice");
        additionalLocsPriceElement.SetInnerText(Model.PricesAndDiscounts.TotalCostOfOptions.ToString(CurrencyFormatToken).Replace(DotAndTwoDecimals, ""));

        if (Model.NumberOfAdditionalLocations == 0)
        {
            outerSpan.InnerHtml = "";
        }
        else if (Model.NumberOfAdditionalLocations == 1)
        {
            outerSpan.InnerHtml = string.Concat("One Additional Location: ", additionalLocsPriceElement.ToString(TagRenderMode.Normal), "<br>", Model.AddressesForAdditionalLocations);
        }
        else
        {
            outerSpan.InnerHtml = string.Concat(Model.NumberOfAdditionalLocations, " Additional Locations: ", additionalLocsPriceElement.ToString(TagRenderMode.Normal));
        }



        return outerSpan.ToString(TagRenderMode.Normal);
    }


    private string GetStatusLabel(OrderStatus orderStatus)
    {
        var statusLabelSpan = new TagBuilder("span");

        statusLabelSpan.GenerateId("orderStatusLabel");
        statusLabelSpan.AddCssClass("label");

        switch (orderStatus)
        {
            case OrderStatus.InProcess:
                statusLabelSpan.AddCssClass("label-warning");
                statusLabelSpan.SetInnerText(@OrderStatus.InProcess.ToString());
                break;

            case OrderStatus.Submitted:
                statusLabelSpan.AddCssClass("label-info");
                statusLabelSpan.SetInnerText(@OrderStatus.Submitted.ToString());
                break;

            case OrderStatus.Paid:
                statusLabelSpan.AddCssClass("label-success");
                statusLabelSpan.SetInnerText(@OrderStatus.Paid.ToString());
                break;

            case OrderStatus.AwaitingVerification:
                statusLabelSpan.AddCssClass("label-warning");
                statusLabelSpan.SetInnerText(@OrderStatus.AwaitingVerification.ToString());
                break;
        }

        return statusLabelSpan.ToString(TagRenderMode.Normal);
    }

}

@{
    if (Model != null)
    {
        var rowAmount = new StringBuilder();

        rowAmount.Append("<button id='revealOptions' class='btn btn-mini btn-default'> change?</button> " + Model.RegistrationType.OptionLabel + ": <span id='baseCost'>" + Model.PricesAndDiscounts.UnitPrice.ToString("c0") + "</span><br />");

        if (Model.Discount == null)
        {
            rowAmount.Append("<button id='revealDiscountInput' class='btn btn-mini btn-default'> add discount?</button> " + GetDiscountedTextSpan() + "<br />");
        }

        //if (Model.NumberOfAdditionalLocations == 0)
        //{
        //    rowAmount.Append("<button id='revealAddLocsPanel' class='btn btn-mini btn-default'> add?</button> " + GetAdditionalLocationsTextSpan() + "<br>");
        //}
        if (Model.NumberOfAdditionalLocations > 0)
        {
            rowAmount.Append(GetAdditionalLocationsTextSpan() + "<br>");
            //rowAmount.Append("<button id='revealAddLocsPanel' class='btn btn-mini btn-default'> edit?</button> " + GetAdditionalLocationsTextSpan() + "<br>");
        }
        if (Model.PricesAndDiscounts.TaxAmount > 0)
        {
            rowAmount.Append("<span id='subTotal'>" + Model.RowPrice.ToString(CurrencyFormatToken).Replace(DotAndTwoDecimals, "") + "</span> <span id='tax'><br>Tax: <span id='taxAmt'>" + Model.PricesAndDiscounts.TaxAmount.ToString(CurrencyFormatToken).Replace(DotAndTwoDecimals, "") + "<br></span></span>");
        }
        rowAmount.Append("<span id='totalPriceText'>Total Cost: <span id='totalPrice'>" + Model.PricesAndDiscounts.TotalOrderPrice.ToString(CurrencyFormatToken) + "</span></span>");

        <div id="billingDetails" class="well" style="text-align: right;">
            @Html.Raw(rowAmount.ToString())<br />

            @{
                @Html.Raw(GetStatusLabel(Model.OrderStatus))
            }
        </div>
    }
}