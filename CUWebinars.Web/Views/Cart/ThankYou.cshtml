@using CUWebinars.Web.Core
@model Order

@{
    ViewBag.Title = "ThankYou";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";

    GlobalConfig _globalConfig = GlobalConfig.GlobalConfigSingleton;

    var idOrder = 0;

        idOrder = Model.idOrder;

    <script type="text/javascript" language="javascript">
        var dataParamList = 0;

        function SubmitCCForm () {
            $("#PayByCCFormPTMulti input[name='parmList']").val(dataParamList);

            $("#PayByCCFormPTMulti").submit();
        }

        $(function() {

            var idOrder = @idOrder;

            $('#PayByPayTraceModal').on('show', function () {

                $.ajax({

                    datatype: "text/plain",
                    type: "GET",
                    url: '/cart/PayTraceModalIni?idOrder='+idOrder,
                    cache: false,
                    success: function (data) {
                        console.log(data);
                        dataParamList = data.paramList;

                        $("#btnSubmitPayTraceForm").click(function() {
                            SubmitCCForm();
                        });
                    }
                });
            });
        });

    </script>
    <div id="LogInContainer" class="container">
        <div id="reset">

            <div class="legendImitator">
                <b>Thank you for your order!</b>

            </div>
            <div id="OrderSummaryContainer">
                You order has been recorded and an invoice for payment will be sent to your billing address.
                Alternately you may wish to submit a credit card payment.<br/>
                <span>
                    <button data-toggle="modal" role="button" data-target="#PayByCCModal" class="btn btn-success" id="ShowPayByCCModal">Pay By Credit Card</button><br />`
                </span><br/>
                Please check your email for complete details!<br/>@Html.ActionLink("Continue to MyWebinars", "MyWebinars", "Account")
            </div>
            <div id="OrderSummaryContainer">
                @Html.Partial("~/Views/Shared/Partials/_OrderSumUser.cshtml", Model)
            </div>



            <div id="FeedbackContainer" class="span6">
                <section>
                    <h4>Feedback</h4>
                    @{ Html.RenderPartial("Partials/_CheckoutFeedback"); }
                </section>
            </div>
        </div>
        @Html.Partial("~/Views/Cart/Partials/_PayByPayTrace.cshtml", Model);

    </div>
}