@using CUWebinars.Web.Core
@using CUWebinars.Web.Helpers
@model ExpressCheckoutModel
@{

    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;

    ViewBag.Title = "Express Checkout";
    Layout = "~/Views/Shared/_LayoutJotForm.cshtml";
    var form_readonly = "read-only";
    var inputReadOnly = " readonly=\"readonly\"";
    if (Model.q5_email5.Contains("notauthenticated.com"))
    {
        inputReadOnly = "";
        form_readonly = "";
        Model.q5_email5 = " ";
        Model.q14_address14.addr_line1 = "";
        Model.q14_address14.addr_line2 = "";
        Model.q14_address14.city = "";
        Model.q14_address14.state = "";
        Model.q14_address14.postal = "";
        Model.q4_name.first = "";
        Model.q4_name.last = "";
        Model.q8_institution = "";
        Model.q6_phoneNumber6.area = "";
        Model.q6_phoneNumber6.phone = "";

    }
}

<style type="text/css">
    .form-label-left {
        width: 150px !important;
    }

    .form-line {
        padding-top: 12px;
        padding-bottom: 12px;
    }

    .form-label-right {
        width: 150px !important;
    }

    .form-all {
        width: 960px;
        margin-left: 200px;
        background: #F5F5F5;
        color: #555 !important;
        font-family: 'Tahoma';
        font-size: 14px;
    }

    .form-radio-item label, .form-checkbox-item label, .form-grading-label, .form-header {
        color: #555;
    }
</style>


<script type="text/javascript">

    JotForm.init(function () {
        setTimeout(function () {
            $('input_5').hint('ex: myname@example.com');
        }, 20);

        JotForm.description('input_10', 'Please let us know how we can best serve you.');
        JotForm.description('input_19', 'Place each address on a new line. Additional Locations will impact your price.');
        JotForm.description('input_20', 'Not sure? Not a problem! Feel free to adjust an order after you complete this form so we can make necessary adjustments before payment.');

        JotForm.clearFieldOnHide = "disable";
        JotForm.onSubmissionError = "jumpToSubmit";
    });
</script>
