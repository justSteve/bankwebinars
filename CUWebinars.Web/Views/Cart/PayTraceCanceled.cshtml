@using CUWebinars.Web.Core
@*@model Order*@

@{
    ViewBag.Title = "Payment was canceled";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";

    GlobalConfig _globalConfig = GlobalConfig.GlobalConfigSingleton;

    <div id="LogInContainer" class="container">
        <div id="reset">

            <div class="legendImitator">
                <b>Payment was canceled</b>
            </div>
            <div id="OrderSummaryContainer">
                You canceled the credit card transaction. <a href="@_globalConfig.TenantURL/cart/checkout">Return to checkout</a>
            </div>
        </div>
    </div>
}