            </div>
            <div class="editor-field">
                @Html.EditorFor(model => model.LearnCaption)
                @Html.ValidationMessageFor(model => model.LearnCaption)
            </div>

            <div class="editor-label">
                @Html.LabelFor(model => model.LearnBody)
            </div>
            <div class="editor-field">
                <textarea id="ta_LearnBody" rows="10" cols="40">@Html.Raw(Model.LearnBody)</textarea>
                @*@Html.EditorFor(model => model.LearnBody)
                @Html.ValidationMessageFor(model => model.LearnBody)*@
            </div>

            <div class="editor-label">
