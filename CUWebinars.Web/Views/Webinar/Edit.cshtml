            </div>
            <div class="editor-field">
                @Html.EditorFor(model => model.RecordingUrl)
                @Html.ValidationMessageFor(model => model.RecordingUrl)
            </div>

            <div class="editor-label">
                <div>PresenterID:</div>
            </div>
            <div class="editor-field">
                <input type="text" name="idPresenter" value="@Model.idPresenter" />
                @*@Html.DropDownList("idPresenter", String.Empty)*@
                    @*@Html.ValidationMessageFor(model => model.PresenterId)*@
            </div>

            <div class="editor-label">
