@using CUWebinars.Web.Core
@model ClickToJoinViewModel

@{
    ViewBag.Title = "Gateway to Your Webinar";

    //USTimeZone timeZ = currentUser.timeZone;
    USTimeZone timeZ = Model.TimeZone;
    WebUser currentUser = Model.Order.WebUser;
    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;

    NumberFormatInfo nfi = new CultureInfo("en-US", false).NumberFormat;

    nfi.CurrencyDecimalDigits = 2;
    if (Model.Webinar.Status == WebinarStatus.Recorded)
    {
        <div>This event took place on @Model.Webinar.Date.ToShortDateString()</div>
    }
    else
    {
        if (Model.JoinCode != "0000")
        {
            if (ReferenceEquals(Model.Webinar, null))
            {
                <div class="row">
                    <div class="span4 text text-error">Unable to find webinar that corresponds to that code.</div>
                </div>
            }
            else
            {
                var row = Model.Order.OrderRows.Single(or => or.RowStatus == OrderRowStatus.Active);

                TimeSpan calcDays = row.Webinar.Date - DateTime.UtcNow;
                var numDays = Convert.ToInt32(calcDays.TotalDays);
                string remainingDays;
                if (numDays == 0)
                {
                    remainingDays = " today - <i> " + @Html.DisplayDate(row.Webinar.Date) + "</i>";
                }
                else if (numDays == 1)
                {
                    remainingDays = " tomorrow - <i>" + @Html.DisplayDate(row.Webinar.Date) + "</i>";
                }
                else
                {
                    remainingDays = " in " + Convert.ToInt32(calcDays.TotalDays).ToString() + " days on <i>" + @Html.DisplayDate(row.Webinar.Date) + "</i>";
                }
                <div class="well well-large container-fluid">
                    <div class="row-fluid center">
                        <p>
                            <br />
                            Presented by @row.Webinar.Presenter.WebUser.FullName @Html.Raw(remainingDays)
                            starting at @Html.DisplayTime(row.Webinar.Date, timeZ, true).Replace(":00 ", "").Replace("12pm ", "Noon ").
                        </p>
                        @if (row.RegistrationType.ShowLiveNotifications == "Yes")
                        {
                            if (row.CitrixJoinUrl == null)
                            {
                                <p>
                                    Awaiting connection info. Check back or watch your email for updates.
                                </p>
                                <p>
                                    <input type="submit" value="Add to Calendar" class="btn btn-mini" id="addICS" />
                                </p>

                            }
                            else
                            {
                                if (Model.Webinar.Status == WebinarStatus.InProgress)
                                {
                                    <a href="@row.CitrixJoinUrl" target="_new"><b>Webinar is Open!</b></a>
                                }
                                else
                                {
                                    <p>
                                        To join the webinar please refresh this page 15-20 minutes prior to the event.<br />
                                    </p>
                                }
                            }
                            if (Model.Webinar.WebinarFiles != null)
                            {
                                <h5>Event Materials</h5>
                                Html.RenderPartial("DisplayTemplates/HandoutsListing", row.Webinar);
                            }
                            <h5>Need Detailed Connection Instructions?</h5>
                            <p>
                                First time attendees are encouraged to review <a href="https://www.bankwebinars.com/Home/DetailedConnectionInstructions">the instructions here.</a>
                            </p>
                            <p>
                                <a href="https://care.citrixonline.com/gotowebinar/get-ready" target="_new">
                                    Test your computer's readiness for our event.
                                </a>
                            </p>
                            <p>
                                Check back here after the event for a link to the recording and your <i>Certificate of Completion</i>. 
                            </p>
                        }
                        else
                        {
                            if (row.RegistrationType.ShowShippedNotifications != "Yes")
                            {
                                <p>
                                    This registration is not currently configured to attend the live event and will not receive the connection information email. A link to the recording will be announced by email and also posted on this page within 24 hours following the event.
                                </p>

                            }
                            else
                            {
                                <p>
                                    The CD and handouts are typically shipped within 3-5 days following the event. Shipping
                                    status will be displayed here.
                                </p>
                            }
                        }

                    </div>
                </div>
            }
        }
    }
}
