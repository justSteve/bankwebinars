@model ClickToJoinViewModel

@{
    ViewBag.Title = "Gateway to Your Webinar";

    //USTimeZone timeZ = currentUser.timeZone;
    USTimeZone timeZ = USTimeZone.Central;
}

<div id="LogInContainer" class="container">
    <div style="font-size: larger; margin-left: 100px;height:310px" id="reset">

        <div class="legendImitator">Webinar Connection Details</div>

        @{
            if (Model.JoinCode != "0000")
            {
                if (ReferenceEquals(Model.Webinar, null))
                {
                    <div class="row">
                        <div class="span4 text text-error">Unable to find webinar that corresponds to that code.</div>
                    </div>
                }
                else
                {
                    <div class="row">
                        <div class="well well-small pull-right">
                            <div>
                                <b>Event Materials</b>
                                @{
                                    Html.RenderPartial("DisplayTemplates/HandoutsListing", Model.Webinar);
                                }
                            </div>
                            <div>First Timer? </div>
                        </div>
                        <table>
                            <tr><td style="text-align: right; padding-right: 5px;">Title:</td><td style="text-align: left;">@Model.Webinar.Title</td></tr>
                            <tr><td style="text-align: right; padding-right: 5px;">Presenter:</td><td style="text-align: left;">@Model.Webinar.Presenter.WebUser.FullName</td></tr>
                            <tr><td style="text-align: right; padding-right: 5px;">Date:</td><td style="text-align: left;">@Html.DisplayTime(Model.Webinar.Date, timeZ, true)</td></tr>
                            <tr><td style="text-align: right; padding-right: 5px;">Link To Webinar:</td><td style="text-align: left;"><a href="@Url.Action("OpenMeeting", "Webinar", new {joinCode = Model.JoinCode})">@Model.RedirectLinkText</a></td></tr>
                        </table>
                    </div>
                }
            }
            else
            {
                <div class="row">
                    <div class="well well-small pull-right">
                        <div>
                            <b>Event Materials</b>
                            @{
                Html.RenderPartial("DisplayTemplates/HandoutsListing", Model.Webinar);
                            }
                        </div>
                        <div>First Timer? </div>
                    </div>
                    <table>
                        <tr><td style="text-align: right; padding-right: 5px;">Title:</td><td style="text-align: left;">@Model.Webinar.Title</td></tr>
                        <tr><td style="text-align: right; padding-right: 5px;">Presenter:</td><td style="text-align: left;">@Model.Webinar.Presenter.WebUser.FullName</td></tr>
                        <tr><td style="text-align: right; padding-right: 5px;">Date:</td><td style="text-align: left;">@Html.DisplayTime(Model.Webinar.Date, timeZ, true)</td></tr>
                        <tr><td style="text-align: right; padding-right: 5px;">Link To Webinar:</td><td style="text-align: left;"><a href="@Model.Webinar.CitrixRegisterUrl">Click To Join!</a></td></tr>
                    </table>
                </div>
            }
}
    </div>
</div>

