@using CUWebinars.Web.Core
@using CUWebinars.Web.Helpers

@model WebinarDetailsViewModel

@{
    ViewBag.Title = Model.Webinar.Title + " - Presented by: " + Model.Webinar.Presenter.WebUser.FullName;
    Layout = "/Views/Shared/_LayoutAffiliate.cshtml";
    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;


}

<script type="text/javascript">
    var affiliateId = @Model.ShowOrdersViewModel.Affiliate.idUserAff;
    var checkoutInProcess = @(Model.CheckoutInProcess ? "true" : "false");
    var isUserLoggedIn = @(@Model.UserIsLoggedIn ? "true" : "false");
    var webinarId = @(@Model.Webinar.idWebinar);
    var showAffiliateColumn = false;
    var notificationsTesting = @(GlobalConfig.GlobalConfigSingleton.NotificationsTesting ? "true" : "false");
    var orderRowId = @(Model.CheckoutOptionsViewModel.OrderExists ? Model.Order.OrderRows.SingleOrDefault(r => r.RowStatus == OrderRowStatus.Active).idOrderRow : 0);
    var orderId = @(Model.CheckoutOptionsViewModel.OrderExists ? Model.Order.idOrder : 0);
    var addressVerified = @(@Model.UserAddressVerified ? "true" : "false");
</script>

@Scripts.Render("~/bundles/jqueryval")
@Scripts.Render("~/bundles/create-order-affiliate")
@Scripts.Render("~/bundles/manage-webinar-files")
@Scripts.Render("~/bundles/dataTables")
@Scripts.Render("~/bundles/display-orders")
@Scripts.Render("~/bundles/admin-notifications")
@* includes:
    ~/Scripts/app/cart/create-order-new.js
    ~/Scripts/app/cart/details-affiliate.js
*@



@Styles.Render("~/Content/create-order-details")
@Styles.Render("~/Content/data-tables")

<div class="hero-unit">
    <div id="webinarTitle" class="container">
        <div class="span2">
            <aside style="position: absolute; bottom: 0; margin-top: 30px; font-size: 12px; line-height: 1.2;">

                @if (Model.Webinar.Status == WebinarStatus.Recorded)
                {
                    <div>
                        This event was recorded on<br /><b>@Html.DisplayDate(Model.Webinar.Date)</b>.
                    </div>
                }
                else
                {
                    <b>@Html.DisplayDate(Model.Webinar.Date)</b>
                    <br />
                    <span>@Html.Raw(Model.TimeFormatDisplay)</span>
                }
            </aside>
        </div>

        <div class="span5">
            <h3 style="line-height: 1.1;">@Model.Webinar.Title</h3>
        </div>
        <div class="span4">
            <div class="btn-group pull-right" data-toggle="buttons-checkbox">
                <button id="showOrdersButton" type="button" class="btn btn-info" data-toggle="collapse" data-target="#webinarOrders">
                    Orders Grid
                </button>
                @if (Model.Webinar.Status == WebinarStatus.Scheduled || Model.Webinar.Status == WebinarStatus.InProgress || Model.Webinar.Status == WebinarStatus.Active)
                {
                    <button id="showConnInfoButton" type="button" class="btn btn-info" data-toggle="collapse" data-target="#connectionDetails">Connection Info</button>
                }
            </div>
        </div>
    </div>
</div>
<!--close hero-unit-->

<div class="container clearfix" id="main-content">
    <!--begin main content-->
    @if (Model.Webinar.Status == WebinarStatus.Scheduled || Model.Webinar.Status == WebinarStatus.InProgress || Model.Webinar.Status == WebinarStatus.Active)
    {
        <div id="connectionDetails" class="collapse">
            @Html.Partial("~/Views/Admin/Partials/_ConnectionDetails.cshtml", Model)
        </div>
    }
    <div id="webinarOrders" class="collapse">

        @Html.Partial("~/Views/Admin/Partials/_ShowOrders.cshtml", Model.ShowOrdersViewModel)

    </div>
    <div id="users" class="collapse">
        @Html.Partial("~/Views/Admin/Partials/_ShowUsers.cshtml", Model.ShowOrdersViewModel)
    </div>

    <div id="webinarContent" class="row-fluid holy-grail">
        <!--begin row-fluid-->
        <section class="span3 sidebar">
            <aside class="widget well-large">
                @{
                    <h5 class="short_headline"><span>@Model.Webinar.Presenter.WebUser.FullName</span></h5>
                    @Html.Raw(Model.Webinar.Presenter.BiographyLong)
                    @Html.Partial("Partials/_OtherEventsBySpeaker")
                }
            </aside>
            <!--close aside widget-->
        </section>
        <div class="span6">
            @{
                if (Model.Webinar.Status != WebinarStatus.Archived && Model.Webinar.Status != WebinarStatus.Deleted && Model.Webinar.Status != WebinarStatus.Pending)
                {
                    <div id="SignUpFormContainer" class="row-fluid">

                        <div class="content span12 well">
                            <ul class="nav nav-tabs" id="regTabs">
                                <li id="findUserTab" class="active"><a href="#findUserForAffiliate" data-toggle="tab">@Model.SignUpCaption</a></li>
                                @*<button class="btn btn-link" tabindex="-1" id="createNewUserButton">New User</button>*@
                                <li id="createNewUserButton"><a href="#contactInfoForAffiliate" data-toggle="tab">Create New User</a></li>
                                <li id="confirmationTabForAffiliate"><a href="#confirmationForAffiliate" data-toggle="tab">@Model.ConfirmationCaption</a></li>
                            </ul>

                            <div class="tab-content">
                                <div class="tab-pane active" id="findUserForAffiliate">
                                    <button type="button" class="btn-success btn pull-right" id="AddToCart"> Add Order </button>
                                    @Html.Partial(partialViewName: "~/Views/Cart/Partials/CheckoutOptionsForAffiliate.cshtml", model: Model.CheckoutOptionsViewModel)
                                </div>
                                <div class="tab-pane" id="contactInfoForAffiliate"></div>
                                <div class="tab-pane" id="confirmationForAffiliate"></div>
                            </div>
                        </div>


                        <!-- The following forms are positioned here so that they are not nested in the form in the CheckoutOptions View. -->
                        <form id="checkEmail">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="emailChecker" id="emailChecker" />
                        </form>
                        <form id="checkZip"><input type="hidden" name="ZipChecker" id="ZipChecker" /></form>
                        <form id="nonUSForm"><input type="hidden" name="AddressText" id="AddressText" /></form>
                        <form id="checkInstitution"><input type="hidden" name="InstitutionChecker" id="InstitutionChecker" /></form>

                    </div> <!-- closes SignUpFormContainer div-->
                }
            }
            @Html.Raw(Model.Webinar.DescriptionLong)
            <h2 class="short_headline">
                <span>
                    @Html.Raw(Model.Webinar.LearnCaption)
                </span>
            </h2>
            @Html.Raw(Model.Webinar.LearnBody)
            <h2 class="short_headline">
                <span>
                    Who Should Attend?
                </span>
            </h2>
            @Html.Raw(Model.Webinar.WhoAttend)
            <hr />
        </div>


        <div class="span3">

            @Html.Partial("Partials/_RegistrationSummary", Model.RegistrationSummaryViewModel ?? new RegistrationSummaryViewModel())

            <aside class="widget">
                <h5 class="short_headline">
                    <span>Topics</span>
                </h5>
                <ul>
                    @foreach (var webinarTopic in Model.Topics)
                    {
                        <li>
                            @webinarTopic.topicDesc
                        </li>
                    }
                </ul>
            </aside>
            <!--close aside .widget -->
            @*<aside class="widget">
                    <h5 class="short_headline"><span>Stay Updated</span></h5>
                    @{Html.RenderPartial("Partials/_AddToMailingBox");}
                </aside>*@

        </div>
        <!--close section tertiary-column sidebar span3-->
    </div>
</div> <!-- closes main-content -->
