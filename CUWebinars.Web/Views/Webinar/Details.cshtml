@using CUWebinars.Web.Core
@using CUWebinars.Web.Helpers

@model WebinarDetailsViewModel

@{
    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;
    ViewBag.Title = Model.Webinar.Title + " - Presented by: " + Model.Webinar.Presenter.WebUser.FullName;
    IStateService stateService = new StateService();
    var ExpressCheckoutURL = "ExpressCheckout";

    if (Model.UserOwnsThisEvent > 0)
    {

        <script type="text/javascript">
            function exprsOrder(idRegType) {
                alert("Please send mail to support at @globalConfig.TenantEmail  and ask to upgrade @globalConfig.TenantPrefix@Model.Order.idOrder. For immediate assistance, use our Help & Feedback button in your lower right screen.");

            };
            function upgrade(idRegType) {
                alert("Please send mail to support at @globalConfig.TenantEmail  and ask to upgrade @globalConfig.TenantPrefix@Model.Order.idOrder. For immediate assistance, use our Help & Feedback button in your lower right screen.");
            };
        </script>
    }
    if (Model.UserHasDiscount != null)
    {
        <script language="javascript" type="text/javascript">
            $(function() {
                $('#showDiscount').css('display', 'block');
                $('#discountCaption').html('@Html.Raw(ViewBag.DiscountCaption)');
            });
        </script>
    }
}
<style>
    .warnIE {
        background-color: lightgoldenrodyellow;
        padding: 8px;
        text-align: center;
    }
</style>
<script type="text/javascript">
    var checkoutInProcess = @(Model.CheckoutInProcess ? "true" : "false");
    var isUserLoggedIn = @(@Model.UserIsLoggedIn ? "true" : "false");
    var webinarId = @(@Model.Webinar.idWebinar);
    var notificationsTesting = @(GlobalConfig.GlobalConfigSingleton.NotificationsTesting ? "true" : "false");
    var orderRowId = @(Model.CheckoutOptionsViewModel.OrderExists ? Model.Order.OrderRows.SingleOrDefault(r => r.RowStatus == OrderRowStatus.Active).idOrderRow : 0);
    var orderId = @(Model.CheckoutOptionsViewModel.OrderExists ? Model.Order.idOrder : 0);
    var addressVerified = @(@Model.UserAddressVerified ? "true" : "false");

</script>

@section scripts{
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/create-order")
    @Scripts.Render("~/bundles/manage-webinar-files")
}

@Styles.Render("~/Content/create-order-details")

<div class="hero-unit">
    <div id="webinarTitle" class="container">
        <div class="span10">
            <h1>@Model.Webinar.Title</h1>
        </div>
    </div>
</div>
<!--close hero-unit-->

<div class="container clearfix" id="main-content">
    <!--begin main content-->

    <div id="webinarContent" class="row-fluid holy-grail">
        <!--begin row-fluid-->
        <section class="row-fluid span3 sidebar">
            <aside class="widget well-large">
                @{
                    if (Model.Webinar.idWebinar != 1952)
                    {
                        <h5 class="short_headline"><span>@Model.Webinar.Presenter.WebUser.FullName</span></h5>
                        @Html.Raw(Model.Webinar.Presenter.BiographyLong)
                        @Html.Partial("Partials/_OtherEventsBySpeaker")
                    }
                }
            </aside>
            <!--close aside widget-->
        </section>
        <div class="row-fluid span6">
            @if (!Model.CheckoutInProcess)
            {
                <div id="EventDescription">
                    @Html.Raw(Model.Webinar.DescriptionLong)
                    <h2 class="short_headline">
                        <span>
                            @Html.Raw(Model.Webinar.LearnCaption)
                        </span>
                    </h2>
                    @Html.Raw(Model.Webinar.LearnBody)
                    <h2 class="short_headline">
                        <span>
                            Who Should Attend?
                        </span>
                    </h2>
                    @Html.Raw(Model.Webinar.WhoAttend)
                    <hr />
                </div>
            }
            <div class="warnIE" style="display: none;" id="iePre10">
                <p>
                    <b>Please note:</b> This site employs features that may cause unexpected behavior in older versions of Internet Explorer. If you experience a problem, try refreshing your screen. If this doesn't solve the problem, click on this link.
                    <br /><a id="warnIE" class="btn btn-mini btn-success" rel="nofollow" href="/cart/@ExpressCheckoutURL?idWebinar=@Model.Webinar.idWebinar&idAffiliate=@ViewBag.currentAffiliateId&idOrder=0">Express Checkout</a>
                </p>
                <p>You may contact us by using the Online Chat button below or emailing Support@ttsTrain.com. </p>
            </div>
            @{
                if (Model.Webinar.idWebinar == 2109)
                {
                    <a id="CompSchoolSignUp" class="btn btn-mini btn-success" href="/cart/ComplianceSchoolCheckout">
                        <div id="AddToCartCompSchool" class="btn-success btn pull-right" type="button" value="Sign Up"> Sign Up </div>
                    </a>
                }
                else
                {
                    if (
                        Model.Webinar.idWebinar != 2215 &&
                        Model.Webinar.idWebinar != 2216 &&
                        Model.Webinar.idWebinar != 2217 &&
                        Model.Webinar.idWebinar != 2218 &&
                        Model.Webinar.idWebinar != 2219
                        )
                    {
                        if (
                            Model.Webinar.Status != WebinarStatus.Deleted
                            && Model.Webinar.Status != WebinarStatus.Pending
                            )
                        {
                            if (Model.UserOwnsThisEvent < 1 || Model.CheckoutInProcess
                                )
                            {
                                <div id="SignUpFormContainer">


                                    <div style="margin-bottom: 0; padding: 0 5px 0 8px;" class="well">
                                        <ul class="nav nav-tabs" id="regTabs">
                                            <li id="signUpTab" class="active"><a href="#signUp" data-toggle="tab">@Model.SignUpCaption</a></li>
                                            <li id="contactInfoTab"><a href="#contactInfo" data-toggle="tab">Contact Info</a></li>
                                            <li id="confirmationTab"><a href="#confirmation" data-toggle="tab">@Model.ConfirmationCaption</a></li>
                                        </ul>
                                        <div class="tab-content">
                                            @if (Model.UserOwnsThisEvent < 1)
                                            {
                                                <div class="tab-pane active" id="signUp">@Html.Partial(partialViewName: "~/Views/Cart/Partials/CheckoutOptions.cshtml", model: Model.CheckoutOptionsViewModel)</div>
                                                <div class="tab-pane" id="contactInfo"></div>
                                                <div class="tab-pane" id="confirmation"></div>
                                                if (Model.UserHasDiscount != null)
                                                {
                                                    if (Model.UserHasDiscount.CreditsRemain > 0)
                                                    {
                                                        if (Model.UserHasDiscount.DateValidTo > Model.UserHasDiscount.DateValidFrom)
                                                        {
                                                            <span class="label large label-success">
                                                                Your subscription will expire on @Model.UserHasDiscount.DateValidTo.ToShortDateString()<text>.</text>
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            if (Model.UserHasDiscount.CreditsRemain == 1)
                                                            {
                                                                <span class="label large label-success">Your Webinar Subscription Package has one credit available for your next order!</span>
                                                            }
                                                            else
                                                            {
                                                                <span class=" pull-right label label-success">&nbsp;<span style="font-weight: normal">Your Webinar Subscription Package has @Model.UserHasDiscount.CreditsRemain.ToString().Replace(".00", "") credits available for your next order!&nbsp;</span></span>
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            else if (Model.Order.OrderStatus == OrderStatus.AwaitingVerification || Model.Order.OrderStatus == OrderStatus.InProcess || Model.Order.OrderStatus == OrderStatus.Canceled || Model.Order.OrderStatus == OrderStatus.Submitted)
                                            {
                                                <div class="tab-pane" id="signUp"></div>
                                                <div class="tab-pane" id="contactInfo"></div>
                                                <div class="tab-pane active" id="confirmation">@Html.Partial(partialViewName: "~/Views/Cart/Partials/CheckoutConfirm.cshtml", model: Model.CheckoutConfirmViewModel)</div>
                                            }

                                        </div>
                                        <!-- The following forms are positioned here so that they are not nested in the form in the CheckoutOptions View. -->
                                        @using (Html.BeginForm("SignInFromCart", "Account", null, FormMethod.Post, new { id = "frmSignIn", name = "signIn" }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <input id="loginEmail" name="Email" type="hidden" value="">
                                            <input id="loginPassword" name="Password" type="hidden">
                                            <input id="loginRememberMe" type="hidden" value="true" name="RememberMe">
                                            <input type="hidden" name="returnUrl" value="/Webinar/Details/@Model.Webinar.idWebinar" />
                                        }
                                        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { id = "ResetPasswordForm" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input id="ResetPassEmail" name="emailForReset" type="hidden" value="">
                                        }
                                        <form id="checkEmail">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="emailChecker" id="emailChecker" />
                                        </form>
                                        <form id="checkZip">
                                            <input type="hidden" name="ZipChecker" id="ZipChecker" />
                                        </form>
                                        <form id="nonUSForm">
                                            <input type="hidden" name="AddressText" id="AddressText" />
                                        </form>
                                        <form id="checkInstitution">
                                            <input type="hidden" name="InstitutionChecker" id="InstitutionChecker" />
                                        </form>

                                    </div>
                                    <div id="EventDescription_ForResume" style="display: none;">
                                        <h2 class="short_headline">
                                            <span>
                                                Event Description
                                            </span>
                                        </h2>
                                        @Html.Raw(Model.Webinar.DescriptionLong)
                                        <h2 class="short_headline">
                                            <span>
                                                @Html.Raw(Model.Webinar.LearnCaption)
                                            </span>
                                        </h2>
                                        @Html.Raw(Model.Webinar.LearnBody)
                                        <h2 class="short_headline">
                                            <span>
                                                Who Should Attend?
                                            </span>
                                        </h2>
                                        @Html.Raw(Model.Webinar.WhoAttend)
                                        <hr />
                                    </div>
                                </div>
                                <!-- closes SignUpFormContainer div-->
                            }
                        }
                    }
                }
            }
        </div>
        <!-- opens Container div-->

        <div class="row-fluid span3">
            <aside class="widget">
                <div id="resumeOrderStatus" class="hidden"></div>
                <h5 class="short_headline"><span>Date/Time</span></h5>

                @if (Model.Webinar.Status == WebinarStatus.Recorded)
                {
                    var expiresDate = Model.Webinar.Date.AddMonths(6);
                    var remainingDays = Convert.ToInt32((expiresDate - DateTime.Now).TotalDays);

                    <div style="font-size: smaller; line-height: 1.2; text-align: center; margin-bottom: 10px;">
                        This event was recorded on <i>@Html.DisplayDate(Model.Webinar.Date)</i>.
                    </div>
                }
                else
                {
                    <b>@Html.DisplayDate(Model.Webinar.Date)</b>
                    <br />
                    <span>@Html.Raw(Model.TimeFormatDisplay)</span>
                }
                <div class="pull-right" id="ceu">
                    <a href="#" title="@Model.CeuStatement ">
                        @Html.Raw(Model.CeuShort)
                    </a>
                </div>
            </aside>
            @Html.Partial("Partials/_RegistrationSummary", Model.RegistrationSummaryViewModel ?? new RegistrationSummaryViewModel())
            <!-- close .widget -->

            <aside class="widget">
                <h5 class="short_headline">
                    <span>Topics</span>
                </h5>
                <ul>
                    @foreach (var webinarTopic in Model.Topics)
                    {
                        <li>
                            @webinarTopic.topicDesc
                        </li>
                    }
                </ul>
            </aside>
            <!--close aside .widget -->
            <aside class="widget">
                <h5 class="short_headline"><span>Stay Updated</span></h5>
                @{Html.RenderPartial("Partials/_AddToMailingBox");}
            </aside>
            <!--close aside .widget -->
            @*<aside class="widget">
                    <h5 class="short_headline"><span>Search</span></h5>
                    <form class="searchform" method="get">
                        <input type="search" class="span12" value="type and hit enter" onfocus="this.value=''" onblur="this.value='type and hit enter'" />
                    </form>
                </aside>*@
            <!--close aside widget-->
        </div>
        <!--close section tertiary-column sidebar span3-->
    </div>

</div> <!-- closes main-content -->
