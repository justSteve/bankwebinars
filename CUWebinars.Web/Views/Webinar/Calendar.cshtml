@using System.Linq
@using CUWebinars.Web.Helpers
@using CUWebinars.Business.Models


@{
    ViewBag.Title = "CUWebinars.com Calendar";
    Layout = "/Views/Shared/_LayoutPublic.cshtml";

    var identity = ((ClaimsIdentity)User.Identity)
        .Claims.FirstOrDefault(c => c.Type == CUWebinars.Business.Constants.ClaimTypes.FullName);

    if (!ReferenceEquals(null, identity))
    {
        ViewBag.LoggedInUserIdentity = identity;
    }
}

<script src="/Scripts/fullcalendar/fullcalendar.js" type="text/javascript"></script>
<link href="/Scripts/fullcalendar/fullcalendar.css" rel="stylesheet" type="text/css" />
@*<script src="/Scripts/jquery.dataTables.min.js" type="text/javascript"></script>
    <link href="/Content/css/DataTables.css" rel="stylesheet" type="text/css" />*@
@*<script type="text/javascript" src="/content/js/webinarsCalendar.js"></script>*@
<div class="container">
    <h2>
        TTS Event Calendar
    </h2>
    <p>
        (all times are displayed in Central Standard Time)
    </p>
    <script type="text/javascript">


        $(document).ready(function () {
            $('#calendar').fullCalendar({
                events: "/Webinar/CalendarData",
                timeFormat: 'h(:mm)t ',
                allDayDefault: false,
                weekends: false,
                loading: function (bool) {
                    if (bool) $('#veil').show();
                    else $('#veil').hide();
                }

            });


        });
    </script>
    @*<div id="veil">
            <p align="center">
                ... calendar data is loading ...
            </p>
        </div>*@
    <div id="calendar">
    </div>
