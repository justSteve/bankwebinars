@using System.Linq
@using CUWebinars.Web.Core
@using CUWebinars.Web.Helpers
@using CUWebinars.Business.Models
@model IEnumerable<Webinar>

@{

    Layout = "~/Views/Shared/_LayoutPublic.cshtml";

    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;
    <style>
        blockquote {
            background: url("") no-repeat scroll 0 0 rgba(0, 0, 0, 0);
            font-style: normal;
            line-height: 110%;
            font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
            margin-right: 300px;
        }

        .well-large {
            padding: 0;
        }

            .well-large p {
                padding: 0;
                line-height: 100%;
                font-size: small;
            }
    </style>

    List<Webinar> webinars = Model.ToList();

    var topic = ViewContext.Controller.ValueProvider.GetValue("ID").RawValue;
    var topicPrefix = "Bank";
    if (globalConfig.Tenant == "CUWebinars") { topicPrefix = "Credit Union"; }

    var topicCaption = "";
    var topicBody = "";
    switch (topic.ToString())
    {
        case "16":
            topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " IRA webinar training covers topics ranging from IRA terms and plan types to distributions and rollovers to distributions and beneficiaries and many more. All of our bank training webinars are led by experts from the financial industry.</blockquote>";
            topicCaption = "IRA ";
            break;
        case "15":
            topicCaption = "Compliance ";
            topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " compliance webinar training covers topics ranging from deposit and lending regulations to BSA to IRS information reporting and many more. All of our bank training webinars are led by experts from the financial industry.</blockquote>";
            break;
        case "17":
            topicCaption = "Customer Service ";
            topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " customer service webinar training covers topics ranging from excelling on the job to call center training to coaching and many more. All of our bank training webinars are led by experts from the financial industry.</blockquote>";
            break;
        case "18":
            topicCaption = "Security ";
            topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " security webinar training covers topics ranging from robbery to check fraud to cybercrime and many more. All of our bank training webinars are led by experts from the financial industry.</blockquote>";
            break;
        case "19":
            topicCaption = "Operations ";
            topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " operations webinar training covers topics ranging from check and deposit issues to new accounts manuals to underwriting and many more. All of our bank training webinars are led by experts from the financial industry.</blockquote>";
            break;
        case "20":
            topicCaption = "Auditing ";
            topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " auditing webinar training covers topics ranging from risk-based compliance audit to call reports to regulatory exam preparation and many more. All of our bank training webinars are led by experts from the financial industry.</blockquote>";
            break;
        case "21":
            topicCaption = "Sales ";
            topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " sales webinar training covers topics ranging from coaching to building a sales plan to sales teams and many more. All of our bank training webinars are led by experts from the financial industry.</blockquote>";
            break;
        case "22":
            topicCaption = "Lending ";
            topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " lending webinar training covers topics ranging from handling loan applications to accounting principles to underwriting and many more. All of our bank training webinars are led by experts from the financial industry.</blockquote>";
            break;
        case "23":
            topicCaption = "Human Resources ";
            topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " human resources webinar training covers topics ranging from background checks to employment records to improving employee performance and many more. All of our bank training webinars are led by experts from the financial industry.</blockquote>";
            break;
        case "25":
            topicCaption = "Computer Skills ";
            topicBody = "";
            break;
        case "26":
            topicCaption = "Risk Management ";
            topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " risk management webinar training covers topics ranging from BSA confidentiality to subpoenas to the allowance for loan and lease losses and many more. All of our bank training webinars are led by experts from the financial industry.</blockquote>";
            break;
        case "27":
            topicCaption = "Teller ";
            topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " teller webinar training covers topics ranging from teller security to endorsements to fraudulent cashier's checks and many more. All of our bank training webinars are led by experts from the financial industry.</blockquote>";
            break;
            ;
        default:
            topicCaption = " ";
            break;
    }


    GlobalConfig _globalConfig = GlobalConfig.GlobalConfigSingleton;
    
    IStateService stateService = new StateService();

    var currentAffiliate = stateService.GetValue<Affiliate>(WebUiConstants.CurrentAffiliate);
    var claimsIdentity = (ClaimsIdentity)User.Identity;

}

<div class="hero-unit">
    <div class="container">

        <h2>@topicPrefix @topicCaption Webinar Training</h2>
    </div>
    <!--close container-->
</div>
<div class="container">
    @Html.Raw(topicBody)
</div>
<div class="container ">

    @{
        foreach (var webinar in webinars)
        {
            var numDaysLeft = (webinar.Date.AddMonths(6) - DateTime.Now).Days;
            var showDateValue = DateTimeHelper.FormatDate(webinar.Date) + " - " +
                                DateTimeHelper.FormatTime(webinar.Date) + " Central Time Zone";
            if (webinar.Status == WebinarStatus.Recorded)
            {
                showDateValue = "This event was recorded on <i>" + DateTimeHelper.FormatDate(webinar.Date) + "</i>.";
            }

            var allTopics = webinar.WebinarTopicXrefs
                .Select(webinarTopic => webinarTopic.Topic.topicDesc)
                .Aggregate((s1, s2) => s1 + ", " + s2);

            string title = "<h3><a href='/Webinar/Details/" +
                           webinar.idWebinar + "' target='_blank'>" + webinar.Title + "</a></h3>";
            var desc = webinar.Description.Length > 300
                ? webinar.Description.Substring(0, 300) + "... <a class=\"btn  btn-primary btn-small\" href='/Webinar/Details/" + webinar.idWebinar + "'>More →</a></p>"
                : webinar.Description;

            var relatedTopics = "Related Topics: <b><i>" + string.Join(", ", allTopics) + "</i></b>";

            var affURL = "Promo URL: " + _globalConfig.TenantURL + "/Webinar/Details/" + webinar.idWebinar + "/?idAff=" + currentAffiliate.idUserAff;

            <div class="wTitle clearfix">
                @Html.Raw(title)
                <div id="eventBody" style="width: 90%; margin-left: auto; margin-right: auto;">
                    <p>
                        Presented By:<img class="pull-right" src="@webinar.Presenter.PhotoThumb" alt="Photo of @webinar.Presenter.WebUser.FullName"> @webinar.Presenter.WebUser.FullName <br />
                        <i>@Html.Raw(showDateValue)</i>
                    </p>
                    @Html.Raw(desc)
                    <p>@Html.Raw(relatedTopics)</p>
                    <p>@affURL</p>
                </div>
            </div>
        }
    }
</div>
