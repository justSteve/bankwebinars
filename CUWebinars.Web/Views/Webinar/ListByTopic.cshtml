@using System.Linq
@using CUWebinars.Web.Core
@using CUWebinars.Web.Helpers
@using CUWebinars.Business.Models
@model IEnumerable<Webinar>

@{

    Layout = "~/Views/Shared/_LayoutPublic.cshtml";

    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;
    <style>
        blockquote {
            background: url("") no-repeat scroll 0 0 rgba(0, 0, 0, 0);
            font-style: normal;
            line-height: 110%;
            font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
            margin-right: 300px;
        }

        .well-large {
            padding: 0;
        }

            .well-large p {
                padding: 0;
                line-height: 100%;
                font-size: small;
            }
    </style>

    List<Webinar> webinars = Model.ToList();

    var topic = ViewContext.Controller.ValueProvider.GetValue("ID").RawValue;
    var topicPrefix = "Bank";
    if (globalConfig.Tenant == "CUWebinars") { topicPrefix = "Credit Union"; }

    var topicCaption = "";
    var topicBody = "";
    switch (topic.ToString())
    {
        case "30": topicCaption = "BSA "; topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " BSA webinar training covers topics ranging from AML to OFAC to CIP to CDD to examinations and more. All of our " + topicPrefix.ToLower() + " training webinars are led by experts from the financial industry.</blockquote>"; break;
        case "15": topicCaption = "Compliance "; topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " compliance webinar training covers topics ranging from deposit and lending regulations to BSA to IRS and TRID information reporting and many more. All of our " + topicPrefix.ToLower() + " training webinars are led by experts from the financial industry.</blockquote>"; break;
        case "25": topicCaption = "Computer Skills "; topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " computer skills webinar training covers topics including Microsoft Excel and more. All of our " + topicPrefix.ToLower() + " training webinars are led by experts from the financial industry.</blockquote>"; break;
        case "31": topicCaption = "Deposit Accounts "; topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " deposit accounts webinar training covers topics ranging from Opening Accounts to Regulations to Fraud and more. All of our " + topicPrefix.ToLower() + " training webinars are led by experts from the financial industry.</blockquote>"; break;
        case "32": topicCaption = "Executive/Director "; topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " director/executive webinar training covers topics ranging from directors training to regulations to strategic planning and more. All of our " + topicPrefix.ToLower() + " training webinars are led by experts from the financial industry.</blockquote>"; break;
        case "23": topicCaption = "Human Resources "; topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " human resources webinar training covers topics ranging from background checks to employment records to improving employee performance and many more. All of our " + topicPrefix.ToLower() + " training webinars are led by experts from the financial industry.</blockquote>"; break;
        case "16": topicCaption = "IRAs "; topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " IRA webinar training covers topics ranging from IRA terms and plan types to distributions and rollovers to distributions and beneficiaries and many more. All of our " + topicPrefix.ToLower() + " training webinars are led by experts from the financial industry.</blockquote>"; break;
        case "22": topicCaption = "Lending "; topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " lending webinar training covers topics ranging from handling loan applications to accounting principles to underwriting to TRID and many more. All of our " + topicPrefix.ToLower() + " training webinars are led by experts from the financial industry.</blockquote>"; break;
        case "33": topicCaption = "Management/Employee Development "; topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " management/employee development webinar training covers topics ranging from coaching to sales to teller training and more. All of our " + topicPrefix.ToLower() + " training webinars are led by experts from the financial industry.</blockquote>"; break;
        case "34": topicCaption = "Reporting "; topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " reporting webinar training covers topics ranging from call reports to IRS reporting and more. All of our " + topicPrefix.ToLower() + " training webinars are led by experts from the financial industry.</blockquote>"; break;
        case "26": topicCaption = "Risk Management/Legal "; topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " risk management webinar training covers topics ranging from BSA confidentiality to subpoenas to the allowance for loan and lease losses to security and many more. All of our " + topicPrefix.ToLower() + " training webinars are led by experts from the financial industry.</blockquote>"; break;
        case "36": topicCaption = "Safe Deposit "; topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " safe deposit webinar training covers topics ranging from safe deposit security to past due boxes and more. All of our " + topicPrefix.ToLower() + " training webinars are led by experts from the financial industry.</blockquote>"; break;
        case "21": topicCaption = "Sales "; topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " sales webinar training covers topics ranging from coaching to building a sales plan to sales teams and many more. All of our " + topicPrefix.ToLower() + " training webinars are led by experts from the financial industry.</blockquote>"; break;
        case "37": topicCaption = "TRID "; topicBody = "<blockquote>Total Training Solutions' " + topicPrefix.ToLower() + " TRID webinar training covers topics ranging from Know Before You Owe to TILA to RESPA and more. All of our " + topicPrefix.ToLower() + " training webinars are led by experts from the financial industry.</blockquote>"; break;
        default:
            topicCaption = " ";
            break;
    }


    GlobalConfig _globalConfig = GlobalConfig.GlobalConfigSingleton;

    IStateService stateService = new StateService();

    var currentAffiliate = stateService.GetValue<Affiliate>(WebUiConstants.CurrentAffiliate);
    var claimsIdentity = (ClaimsIdentity)User.Identity;

}

<div class="hero-unit">
    <div class="container">

        <h2>@topicPrefix @topicCaption Webinar Training</h2>
    </div>
    <!--close container-->
</div>
<div class="container">
    @Html.Raw(topicBody)
</div>
<div class="container ">

    @{
        foreach (var webinar in webinars)
        {
            var numDaysLeft = (webinar.Date.AddMonths(6) - DateTime.Now).Days;
            var showDateValue = DateTimeHelper.FormatDate(webinar.Date) + " - " +
                                DateTimeHelper.FormatTime(webinar.Date) + " Central Time Zone";
            if (webinar.Status == WebinarStatus.Recorded)
            {
                showDateValue = "This event was recorded on <i>" + DateTimeHelper.FormatDate(webinar.Date) + "</i>.";
            }

            var allTopics = webinar.WebinarTopicXrefs
                .Select(webinarTopic => webinarTopic.Topic.topicDesc)
                .Aggregate((s1, s2) => s1 + ", " + s2);

            string title = "<h3><a href='/Webinar/Details/" +
                           webinar.idWebinar + "' target='_blank'>" + webinar.Title + "</a></h3>";
            var desc = webinar.Description.Length > 300
                ? webinar.Description.Substring(0, 300) + "... <a class=\"btn  btn-primary btn-small\" href='/Webinar/Details/" + webinar.idWebinar + "'>More →</a></p>"
                : webinar.Description;

            var relatedTopics = "Related Topics: <b><i>" + string.Join(", ", allTopics) + "</i></b>";

            var affURL = "Promo URL: " + _globalConfig.TenantURL + "/Webinar/Details/" + webinar.idWebinar + "/?idAff=" + currentAffiliate.idUserAff;

            <div class="wTitle clearfix">
                @Html.Raw(title)
                <div id="eventBody" style="width: 90%; margin-left: auto; margin-right: auto;">
                    <p>
                        Presented By:<img class="pull-right" src="@webinar.Presenter.PhotoThumb" alt="Photo of @webinar.Presenter.WebUser.FullName"> @webinar.Presenter.WebUser.FullName <br />
                        <i>@Html.Raw(showDateValue)</i>
                    </p>
                    @Html.Raw(desc)
                    <p>@Html.Raw(relatedTopics)</p>
                    <p>@affURL</p>
                </div>
            </div>
        }
    }
</div>
