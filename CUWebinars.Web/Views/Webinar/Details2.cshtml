@using CUWebinars.Web.Core
@using CUWebinars.Web.Helpers

@model WebinarDetailsViewModel

@{
    ViewBag.Title = Model.Webinar.Title + " - Presented by: " + Model.Webinar.Presenter.WebUser.FullName;
    Layout = "/Views/Shared/_LayoutPublic.cshtml";
    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;


    if (Model.UserOwnsThisEvent > 0)
    {
        <script type="text/javascript">
            function exprsOrder(idRegType) {
                alert("Please call us at 800-831-0678 ext. 3 and ask to upgrade @globalConfig.TenantPrefix@Model.Order.idOrder");

            };
            function upgrade(idRegType) {
                alert("Please call us at 800-831-0678 ext. 3 and ask to upgrade @globalConfig.TenantPrefix@Model.Order.idOrder");

            };

            $(function () {
                $("#SignUpFormContainer").hide();
            });
        </script>
    }
}

<script type="text/javascript">

    var checkoutInProcess = @(Model.CheckoutInProcess ? "true" : "false");
    var whichStep = "@(Model.WhichStep)";
    var orderRowId = 0;
    var isUserLogged = @(@Model.UserIsLoggedIn ? "true" : "false");

    $(document).ready(function() {
        JL("myLogger").info("Details loaded @Model.Webinar.idWebinar for idUser @Model.WebUser.idUser.");
    });

</script>

@section scripts{
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/createOrder")
}

@Styles.Render("~/Content/createOrderDetails")

<div class="hero-unit">
    <div id="webinarTitle" class="container">
        <div class="span10">
            <h1>@Model.Webinar.Title</h1>
        </div>    <!--close container-->
    </div>
</div>
<!--close hero-unit-->
<div class="container clearfix" id="main-content">
    <!--begin main content-->

    <div id="webinarContent" class="row-fluid holy-grail">
        <!--begin row-fluid-->
        <section class="span3 sidebar">
            <aside class="widget well-large">
                <h5 class="short_headline"><span>@Model.Webinar.Presenter.WebUser.FullName</span></h5>
                @Html.Raw(Model.Webinar.Presenter.BiographyLong)
                @Html.Partial("Partials/_OtherEventsBySpeaker")
            </aside>
            <!--close aside widget-->
        </section>
        <!--*** add class "holy-grail" to row-fluid class to make a three column skinny, fat, skinny layout ***-->
        <div class="span6">
            <div class="description">
                @Html.Raw(Model.Webinar.DescriptionLong)
            </div>
            <div class="description">
                <h2 class="short_headline">
                    <span>
                        @Html.Raw(Model.Webinar.LearnCaption)
                    </span>
                </h2>
                @Html.Raw(Model.Webinar.LearnBody)
            </div>
            <div class="description">
                <h2 class="short_headline">
                    <span>
                        Who Should Attend?
                    </span>
                </h2>
                @Html.Raw(Model.Webinar.WhoAttend)
            </div>
            <hr />
        </div>


        <div class="span3">
            <aside class="widget">
                @if (Model.Identity.HasClaim(CUWebinars.Business.Constants.ClaimTypes.Admin, CUWebinars.Business.Constants.ClaimValues.CuWebinarsAdmin))
                {
                    @Html.Partial(@"Partials/_AdminEventButtons", Model)
                }
                <h5 class="short_headline"><span>Date/Time</span></h5>

                @if (Model.Webinar.Status == WebinarStatus.Recorded)
                {
                    var expiresDate = Model.Webinar.Date.AddMonths(6);
                    var remainingDays = Convert.ToInt32((expiresDate - DateTime.Now).TotalDays);

                    <div style="font-size: smaller; text-align: center;">
                        This event was recorded on @Html.DisplayDate(Model.Webinar.Date) and is available for OnDemand Playback until @Html.DisplayDate(expiresDate)
                        - @remainingDays.ToString() more days.
                    </div>
                }
                else
                {
                    <b>@Html.DisplayDate(Model.Webinar.Date)</b>
                    <br />
                    <span>@Html.Raw(Model.TimeFormatDisplay)</span>
                }
                <div id="ceu">
                    <a href="#" title="@Model.CeuStatement ">
                        @Html.Raw(Model.CeuShort)
                    </a>
                </div>
            </aside>


            @Html.Partial("Partials/_RegistrationSummary")
            <!-- close .widget -->
            <!-- For certificate file widget -->
            <!-- Close certificat widget -->
            <!-- For Generate ics file widget -->
            @*<aside class="widget">
                    <h5 class="short_headline"><span>iCalendar</span></h5>
                    <button id="CreateICSButton" class="btn btn-primary">Generate ICS</button>
                    <div class="span12" style="display:none;"><i id="WaitIndicator" class="icon-spinner icon-spin "></i></div>
                    <div id="InputFormFields" style="margin-top: 20px;"></div>
                </aside>*@
            <!-- Close ics file widget -->
            <aside class="widget">
                <h5 class="short_headline">
                    <span>Topics</span>
                </h5>
                <ul>
                    @foreach (var webinarTopic in Model.Topics)
                    {
                        <li>
                            @webinarTopic.topicDesc
                        </li>
                    }
                </ul>
            </aside>
            <!--close aside .widget -->
            <aside class="widget">
                <h5 class="short_headline"><span>Stay Updated</span></h5>
                @{Html.RenderPartial("Partials/_AddToMailingBox");}
            </aside>
            <!--close aside .widget -->
            @*<aside class="widget">
                    <h5 class="short_headline"><span>Search</span></h5>
                    <form class="searchform" method="get">
                        <input type="search" class="span12" value="type and hit enter" onfocus="this.value=''" onblur="this.value='type and hit enter'" />
                    </form>
                </aside>*@
            <!--close aside widget-->
        </div>
        <!--close section tertiary-column sidebar span3-->
    </div>
    @{
        if (
            Model.Webinar.Status != WebinarStatus.Archived &&
            Model.Webinar.Status != WebinarStatus.Deleted &&
            Model.Webinar.Status != WebinarStatus.Pending
            && Model.UserOwnsThisEvent < 1)
        {
            <div id="SignUpFormContainer" class="row-fluid">




                    <div class="content offset2 span8 well">
                        <ul class="nav nav-tabs" id="regTabs">
                            <li id="signUpTab" class="active"><a href="#signUp" data-toggle="tab">@Model.SignUpCaption</a></li>
                            <li id="contactInfoTab"><a href="#contactInfo" data-toggle="tab">Contact Info</a></li>
                            <li id="confirmationTab"><a href="#confirmation" data-toggle="tab">@Model.ConfirmationCaption</a></li>
                        </ul>

                        <div class="tab-content">
                            <div class="tab-pane active" id="signUp">
                                <input type="button" class="btn-success btn btn-large pull-right" value=" Sign Up " id="AddToCart" />
                                @Html.Partial(partialViewName: "~/Views/Cart/Partials/CheckoutOptions.cshtml", model: Model.CheckoutOptionsViewModel)
                            </div>
                            <div class="tab-pane" id="contactInfo">
                                @*@Html.Partial(partialViewName: "~/Views/cart/Partials/CheckoutContact.cshtml", model: Model)*@
                            </div>
                            <div class="tab-pane" id="confirmation">
                                @*@Html.Partial(partialViewName: "~/Views/cart/Partials/CheckoutConfirm.cshtml", model: Model)*@
                            </div>
                        </div>
                    </div>
                
                @using (Html.BeginForm("Register", "Account", null, FormMethod.Post, new { id = "_CreateUserForm", name = "createUser" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="FirstName" name="FirstName" />
                    <input type="hidden" id="LastName" name="LastName" />
                    <input type="hidden" id="ShippingFirstName" name="ShippingFirstName" />
                    <input type="hidden" id="ShippingLastName" name="ShippingLastName" />
                    <input type="hidden" id="RegisterFields_BillingAddress_Country" name="RegisterFields.BillingAddress.Country" value="US" />
                    <input type="hidden" id="RegisterFields_ShippingAddress_Country" name="RegisterFields.ShippingAddress.Country" value="US" />
                    <input type="hidden" name="returnUrl" value="/Webinar/Details2/@Model.Webinar.idWebinar" />
                    <input type="hidden" id="emailAddress" />
                }
                @using (Html.BeginForm("SignInFromCart", "Account", null, FormMethod.Post, new { id = "frmSignIn", name = "signIn" }))
                {
                    @Html.AntiForgeryToken()

                    <input id="loginEmail" name="Email" type="hidden" value="">
                    <input id="loginPassword" name="Password" type="hidden">
                    <input id="loginRememberMe" type="hidden" value="true" name="RememberMe">
                    <input type="hidden" name="returnUrl" value="/Webinar/Details2/@Model.Webinar.idWebinar" />
                }

                <form id="checkEmail"><input type="hidden" name="emailChecker" id="emailChecker" /></form>
                <form id="checkZip"><input type="hidden" name="ZipChecker" id="ZipChecker" /></form>
                <form id="nonUSForm"><input type="hidden" name="AddressText" id="AddressText" /></form>
                <form id="checkInstitution"><input type="hidden" name="InstitutionChecker" id="InstitutionChecker" /></form>
                <form id="updateRegType" action="/Cart/SetRegistrationTypeAtCheckout" method="post" name="updateRegType"></form>

            </div>
        }
    }
</div>

<div id="ConfirmModal" class="modal hide fade">
    <form action="/cart/confirmOrder" method="post" id="confirmOrder">
        <input type="hidden" name="id" />
        <input type="hidden" id="Step2_BillMeFormReferred" name="referred" value="" />
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h3 id="confirmCaption"></h3>
        </div>
        <div id="confirmResult" class="modal-body">
            <p>Registration is Confirmed</p>
        </div>
        <div class="modal-footer">
            <a href="#" id="confirmRegistration" role="button" class="btn btn-success">Continue</a>
        </div>

    </form>

</div>

<div id="CancelModal" class="modal hide fade">
    <form action="/cart/cancelOrder" method="post" id="cancelOrder">

        <input type="hidden" name="id" />
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h3 id="cancelCaption">Cancel This Order?</h3>
        </div>
        <div id="cancelResult" class="modal-body">
            <p>Please confirm that you wish to delete this registration.</p>
        </div>
        <div class="modal-footer">
            <a href="#" id="rtn" class="close btn btn-inverse" data-dismiss="modal">Return to checkout</a>&nbsp;&nbsp;
            <a href="/" id="continueReg" class="btn btn-success hide">Continue</a>&nbsp;&nbsp;
            <input type="submit" id="cancelRegistration" value="Delete This Registration" class="btn btn-danger" />
        </div>
    </form>
</div>


<div id="AddCCModal" class="modal hide fade">
    <form action="/cart/AddCC" method="post" id="AddCC">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h3 id="AddCCCaption">Carbon Copy Notifications?</h3>
        </div>
        <div id="CCBody" class="modal-body">
            <p>
                <input type="text" name="CC" />
                <br />
                Need to forward the connection info to a co-worker?
                Insert the email address(s) (if multiple, just seperate the addresses by a comma) to be included in all future notifications related to this order.
                <br />
                <input type="text" name="CC" />

            </p>
            <p>Please note that this form is only used to forward the connection information to alternate attendees. If you would like to add Additional Locations (multiple connections by other branches, for example) we offer that optional feature on for an additional charge.  </p>
            <input type="text" name="CC" />
        </div>
        <div class="modal-footer">
            <a href="#" class="close btn" data-dismiss="modal">Cancel</a>&nbsp;&nbsp;
            <a href="#" id="SubmitCC" class="btn btn-success">Submit</a>
        </div>
    </form>
</div>

@if (Model.WebUser.UserType == UserType.Admin)
{
    <!-- Modal -->
    <div id="logsModal" class="modal hide fade" tabindex="-1" role="dialog" aria-labelledby="logsModalLabel" aria-hidden="true">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
            <h3 id="logsModalLabel">Event Logs</h3>
        </div>
        <div class="modal-body">
            <p>Logs</p>
        </div>
        <div class="modal-footer">
            <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
            <button class="btn btn-primary">Save changes</button>
        </div>
    </div>
}

<!-- Modal for creation of a user (if necessary) -->
<div id="modalInstitution" class="modal hide">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h3>Insitution Information</h3>
    </div>
    <div id="UserInstitutionBody" class="modal-body">
        <h5>Is this your institution?</h5>        <div id="ShowInstitution">placeholder for ajax response</div>

        <div id="instInfo">
            <p><input type="button" class="btn btn-primary" name="YesUseAddress" value="Yes, use this address." /></p>
            <p><input type="button" class="btn btn-warning" name="EnterDiffAddress" value="Yes, that's my institution but I want to enter a different address." /></p>
            <p><input type="button" class="btn btn-warning" name="NotInstitution" value="No, that's not my institution" /></p>
        </div>
    </div>
</div>
