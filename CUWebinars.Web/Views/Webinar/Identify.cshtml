@using CUWebinars.Web.Core
@model IdentifyModel

@{
    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;
    ViewBag.Title = "Access to OnDemand Content";
}

<div class="container">
    <div class="legendImitator">Please provide your name and email. Note that this is not a prompt for a password.</div>
    @*<p>Access to this page is governed by terms bound to order number @globalConfig.TenantPrefix@Model.idOrder<text>.</text><br/>
        By entering, you affirm that you are associated with <b>@Model.Institution</b>.
    </p>*@

    @using (Html.BeginForm("Identify", "Webinar", FormMethod.Post, new { id = "IdentifyDetailsForm", @class = "form-horizontal" }))
            {

        @Html.ValidationSummary("Please address the following issues in the form below:", new { id = "valSummaryIdentifyDetailsForm" })
                @Html.AntiForgeryToken()

                <div class="row">
                    <div class="control-group span4">
                        <div class="control-label">
                            @Html.LabelFor(m => m.FullName)
                        </div>
                        <div class="controls">
                            @Html.EditorFor(m => m.FullName)
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="control-group span4">
                        <div class="control-label">
                            @Html.LabelFor(m => m.Email)
                        </div>
                        <div class="controls">
                            @Html.EditorFor(m => m.Email)
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="control-group span4">
                        <div class="control-label">
                            @Html.HiddenFor(m => m.OnDemandCode)
                        </div>
                        <div class="controls">
                            <input type="submit" id="submitDetails" value="submit" class="btn btn-default"/>
                        </div>
                    </div>
                </div>
            }
</div>

@Scripts.Render("~/bundles/identify")