@using System.Linq
@model IEnumerable<Webinar>

@{
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
    var webinars = Model;
    var rowsData = new List<object>();
}


<div id="page">
    <div class="container visible-phone">
        <p class="right"><a class="btn btn-primary scrollto" href="#secondary-nav">Page Menu &nbsp;<i class="icon-align-justify"></i></a></p>
    </div>
    <div class="hero-unit">
        <div class="container">
            <h1 id="PageTitle">Search Results</h1>
        </div>
        <!--close container-->
    </div>
    <!--close hero-unit-->
    <div class="container clearfix" id="main-content">
        <!--begin main content-->

        <div class="row-fluid sidebar-right">
            <!--begin row-fluid-->
            <div class="span9 primary-column">

                                                @{
                    foreach (var webinar in webinars)
                    {
                        if (webinar.Status != WebinarStatus.Deleted && webinar.Status != WebinarStatus.Pending && webinar.Status != WebinarStatus.Archived)
                        {
                            var numDaysLeft = (webinar.Date.AddMonths(6) - DateTime.Now).Days;
                            var showDateValue = DateTimeHelper.FormatDate(webinar.Date) + " - " +
                                                DateTimeHelper.FormatTime(webinar.Date) + " Central Time Zone";
                            if (webinar.Status == WebinarStatus.Recorded && webinar.idWebinar != 842)
                            {
showDateValue = "This event was recorded on <i>" + DateTimeHelper.FormatDate(webinar.Date) + "</i>.";

                            }
                            var allTopics = webinar.WebinarTopicXrefs
                                .Select(webinarTopic => webinarTopic.Topic.topicDesc)
                                .Aggregate((s1, s2) => s1 + ", " + s2);

                            string title = "<a href='/Webinar/Details/" +
                                           webinar.idWebinar + "' target='_blank'>" + webinar.Title + "</a>";
                            var desc = webinar.Description.Length > 200
                                ? webinar.Description.Substring(0, 200) + "... <a class=\"btn  btn-primary btn-small\" href='/Webinar/Details/" + webinar.idWebinar + "'>More →</a></p>"
                                : webinar.Description;

                            var relatedTopics = "Related Topics: <b><i>" + string.Join(", ", allTopics) + "</i></b>";
                            <div class="wTitle clearfix">
                                <h3>@Html.Raw(title)</h3>
                                <div id="eventBody" style="width: 90%; margin-left: auto; margin-right: auto;">
                                    <p>
                                        Presented by <img class="pull-right" src="@webinar.Presenter.PhotoThumb" alt="Photo of @webinar.Presenter.WebUser.FullName" /> @webinar.Presenter.WebUser.FullName <br />
                                        <i>@Html.Raw(showDateValue)</i>
                                    </p>
                                    <span style="margin-right: 20%;">@Html.Raw(desc)</span>
                                    <p>@Html.Raw(relatedTopics)</p>
                                </div>
                            </div>
                        }
                    }
                }

            </div>
            <!-- close span9 primary-column-->

            <section class="span3 sidebar secondary-column" id="secondary-nav">
                <aside class="widget">
                    <div class="rotating-testimonials">
                        <!--"rotating-testimonials" is a required class-->
                        <h5 class="short_headline"><span>Testimonials</span></h5>
                        <div class="panels">

                            <div id="t1">
                                <blockquote>
                                    <p>We are loving the program for our Directors.  Training has now become a more regular event and the format and timing of the training is just right for the BOD.  They have found the information very helpful in understanding their roles as directors.</p>
                                    <footer>Maureen Daehn, Maple Bank</footer>
                                </blockquote>
                            </div>
                            <!--close #t5 -->
                        </div>
                        <!--close panels-->
                    </div>

                    <!--close rotating-testimonials-->
                </aside>
                <aside class="widget">
                    <h5 class="short_headline"><span>Stay Updated</span></h5>
                    @{Html.RenderPartial("Partials/_AddToMailingBox");}
                </aside>
                <!--close aside .widget -->

                <aside class="widget">
                    <h5 class="short_headline"><span>Search</span></h5>
                    <form class="searchform" method="get">
                        <input type="search" class="span12" value="type and hit enter" onfocus="this.value=''" onblur="this.value='type and hit enter'" />
                    </form>
                </aside>
                <!--close aside widget-->
            </section>
            <!--close aside .widget-->
            <!--close section sidebar span3-->
        </div>
        <!--close row-fluid-->
    </div>
</div>

