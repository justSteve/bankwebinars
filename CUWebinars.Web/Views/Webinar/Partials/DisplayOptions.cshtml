@using System.Configuration
@using System.Text
@model DisplayOptionsViewModel

@{
    var defaultCheck = "checked";
    <script language="javascript">
        function signUpv1() {
            @{
                var eventtitle = Model.EventTitle.Replace("'", "");
                if (Model.WebinarDuration > 1)
                {
                    if (Model.WebinarStatus == WebinarStatus.Scheduled ||Model.WebinarStatus == WebinarStatus.Active ||Model.WebinarStatus == WebinarStatus.InProgress)
                    {
                        <text>window.open('http://form.jotform.us/form/32525417714149?webinarid=@Model.idWebinar&webinarTitle=@eventtitle', 'blank', 'scrollbars=yes,toolbar=no,width=700,height=500');</text>
                    }
                    else
                    {
                        <text>window.open('http://form.jotform.us/form/32525008495151?webinarid=@Model.idWebinar&webinarTitle=@eventtitle', 'blank', 'scrollbars=yes,toolbar=no,width=700,height=500');</text>
                    }
                }
                if (Model.WebinarDuration < 2)
                {
                    if (Model.WebinarStatus == WebinarStatus.Scheduled || Model.WebinarStatus == WebinarStatus.Active || Model.WebinarStatus == WebinarStatus.InProgress)
                    {
                        <text>window.open('http://form.jotform.us/form/32525511772148?webinarid=@Model.idWebinar&webinarTitle=@eventtitle', 'blank', 'scrollbars=yes,toolbar=no,width=700,height=500');</text>
                    }
                    else
                    {
                        <text>window.open('http://form.jotform.us/form/32525522499156?webinarid=@Model.idWebinar&webinarTitle=@eventtitle', 'blank', 'scrollbars=yes,toolbar=no,width=700,height=500');</text>
                    }
                }
            }
        }
    </script>
}
<script type="text/javascript">
    $(document).ready(function () {
        $("[id^='regTypeID_']").on("click", function (oEvent) {
            //$("#stage_of_checkout").val("preReg");
            //BuildPreRegPrice(oEvent);
            cartStateManager.CheckIfAddLocShouldHide(oEvent.currentTarget.value);
        });
    });
</script>
@{

    var explainsOptionsBuilder = new StringBuilder();
    explainsOptionsBuilder.Append("The following choices are available for this webinar.<br>");


    //  Comment: I assume order will be null where there is no existing order for the User for that WebinarId
    //           This does not seem to have been handled in the controller as the Order is just set to null.
    //           I need to understand this.
    // REPLY: Let's explore this soon


    <div id="AttendRegTypes" class="modal hide fade">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h3>@ConfigurationManager.AppSettings["TenantDomain"]'s Attendance Options</h3>
        </div>
        <div id="ExplainRegistrationOptions" class="modal-body">
            <p>

            </p>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-success" data-dismiss="modal" aria-hidden="true">Finished</button>
        </div>
    </div>
    <span>
        Choose the attendance option that's right for you. <a href="#AttendRegTypes" data-toggle="modal">(learn more)</a>
    </span>
    if (Model.OrderRowExists)
    {
        <div class="pull-right">
            @Html.Partial("Partials/_DisplayRowPrice", Model.DisplayRowPriceViewModel)
        </div>
    }

    <div id="RegistrationType">
        <dl>
            @foreach (var myOption in Model.Options)
            {
                bool appendJustOnce = true;

                if (!myOption.SKU.Contains("Upgrade"))
                {

                    explainsOptionsBuilder.Append("<span><b>" + myOption.OptionLabel + "</b> means " + myOption.OptionExplain + " This option costs <i>$" + myOption.Price.ToString().Replace(".00", "") + "</i><br></span>");
                    //explainsOptionsBuilder.Append("<span><b>"+Html.Raw(myOption.OptionLabel)+"</b> means "+Html.Raw(myOption.OptionExplain) +" This option costs <i>$" + myOption.Price.ToString().Replace(".00", "")+"</i><br></span>");
                    <dt>
                        <input type="radio" class="checkbox" id='regTypeID_@(myOption.idRegType)' @defaultCheck name="RegistrationTypeId"
                               value="@myOption.idRegType" />
                        &nbsp;&nbsp;@myOption.OptionLabel- $@myOption.Price &nbsp;&nbsp;
                        <a onclick=javascript:void(0); data-toggle="tooltip" title="@Html.Raw(myOption.OptionExplain) ">
                            <i class="icon-question-sign"></i>
                        </a>
                        <br />
                    </dt>
                }
                else
                {
                    if (ViewBag.userOwnsThisEvent > 0)
                    {
                        if (appendJustOnce)
                        {
                            appendJustOnce = false;
                            //since the RegType hasn't been designated as an 'Upgrade'
                            // we need to display it. Only show 'Upgrades' to users
                            // who already own a registration.
                            explainsOptionsBuilder.Append("Upgrade your existing order with these options - ");

                        }
                        <dt>
                            <input type="radio" class="checkbox" id='regTypeID_@(myOption.idRegType)' @defaultCheck name="regType" value="@myOption.idRegType" />
                            &nbsp;
                            &nbsp;
                            @myOption.OptionLabel
                            - $
                            @myOption.Price &nbsp;
                            &nbsp;<a onclick=javascript:void(0); data-toggle="tooltip" title="@Html.Raw(myOption.OptionExplain) "><i class="icon-question-sign"></i></a>
                            <br />
                        </dt>
                    }
                }
                defaultCheck = string.Empty;
            }
        </dl>
        <script type="text/javascript" language="javascript">
            $(document).ready(function () {
                $("#ExplainRegistrationOptions").html("@Html.Raw(explainsOptionsBuilder.ToString())");
            });
        </script>

        @if (Model.WebinarStatus == WebinarStatus.Scheduled || Model.WebinarStatus == WebinarStatus.Active || Model.WebinarStatus == WebinarStatus.InProgress)
        {
            <div id="displayAddLoc">
                @Html.Partial("~/Views/Webinar/Partials/AdditionalLocationsView.cshtml", Model.AdditionalLocationOfferViewModel)
            </div>
        }
    </div>
}


