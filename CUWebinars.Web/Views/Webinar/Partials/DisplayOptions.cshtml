@{
    <span>Choose the attendance option that's right for you! <a href="#AttendOptions" data-toggle="modal">(learn more)</a> </span>

    <div class="pull-right">
        @*@Html.Partial("_DisplayRowPrice", new ViewDataDictionary(Model.OrderRow))
            @Html.Raw(TTSTrain.Webinars.WebEntry.Support.DisplayRowPrice.BuildRowPrice(workingRow))*@
    </div>
    <div id="ModeOptions">
        <dl>
            @foreach (var myOption in Model.Options)
            {
                if (myOption.Type == "Text")
                {
                    if (Model.OrderRow == null)
                        //||
                        //Model.OrderRow.idOrderRow < 1 ||
                        //Model.OrderRow.Status == OrderRowStatus.InProcess)
                        //&& !myOption.SKU.Contains("Upgrade")
                        
                    {
                        <dt>
                            <input type="radio" class="checkbox" id='mode_@(myOption.idOption)' name="mode" value="@myOption.idOption" />
                            &nbsp;&nbsp;@myOption.OptionLabel - $@myOption.PriceToAdd&nbsp;&nbsp;<a onclick=javascript:void(0); data-toggle="tooltip" title="@Html.Raw(myOption.OptionExplain) "><i class="icon-question-sign"></i></a>

                            <br />
                        </dt>
                    }
                    else
                    {
                        if (Model.OrderRow != null && Model.OrderRow.idOrderRow > 0 && myOption.SKU.Contains("Upgrade"))
                        {
                            <dt>
                                <input type="radio" class="checkbox" id='mode_@(myOption.idOption)' name="mode" value="@myOption.idOption" />
                                &nbsp;&nbsp;@myOption.OptionLabel - $@myOption.PriceToAdd
                                <br />
                            </dt>
                            <dd>@Html.Raw(myOption.OptionExplain) </dd>
                        }
                    }
                }
            }
        </dl>

        @*<div id="displayAddLoc">
            @Html.Partial(partialViewName: "~/Views/Webinar/Partials/AdditionalLocationsOptionView.cshtml", model: Model)
        </div>*@
    </div>
}

