@using CUWebinars.Business.Models
@model CUWebinars.Web.ViewModel.WebinarDetailsViewModel

<script type="text/javascript">

    function signUp() {

        @{
            if (Model.Webinar.Duration > 1)
            {
                if (Model.Webinar.Status == WebinarStatus.Scheduled)
                {
                    <text>window.open('http://form.jotform.us/form/32525417714149?webinarid=@Model.Webinar.idWebinar&webinarTitle=@Model.Webinar.Title', 'blank', 'scrollbars=yes,toolbar=no,width=700,height=500');</text>
                }
                else
                {
                    <text>window.open('http://form.jotform.us/form/32525008495151?webinarid=@Model.Webinar.idWebinar&webinarTitle=@Model.Webinar.Title', 'blank', 'scrollbars=yes,toolbar=no,width=700,height=500');</text>
                }
            }
            if (Model.Webinar.Duration < 2)
            {
                if (Model.Webinar.Status == WebinarStatus.Scheduled)
                {
                    <text>window.open('http://form.jotform.us/form/32525511772148?webinarid=@Model.Webinar.idWebinar&webinarTitle=@Model.Webinar.Title', 'blank', 'scrollbars=yes,toolbar=no,width=700,height=500');</text>
                }
                else
                {
                    <text>window.open('http://form.jotform.us/form/32525522499156?webinarid=@Model.Webinar.idWebinar&webinarTitle=@Model.Webinar.Title', 'blank', 'scrollbars=yes,toolbar=no,width=700,height=500');</text>
                }
            }
        }
    }

    ;
        $(document).ready(function () {
            $("[id^='mode_']").on("click", function(oEvent) {

                signUp();
