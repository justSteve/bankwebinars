@using System.Configuration
@using System.Text
@using CUWebinars.Business.Core
@using CUWebinars.Web.Core
@using Ninject
@model DisplayOptionsViewModel

@{
    var defaultCheck = "checked";

    var explainsOptionsBuilder = new StringBuilder();
    explainsOptionsBuilder.Append("The following options are available for this webinar.<br>");
}

<div id="AttendRegTypes" class="modal hide fade">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h3>@GlobalConfig.GlobalConfigSingleton.TenantDomain's Attendance Options</h3>
    </div>
    <div id="ExplainRegistrationOptions" class="modal-body">
        <p>

        </p>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-success" data-dismiss="modal" aria-hidden="true">Finished</button>
    </div>
</div>
<div id="OptionsOpener">
    @if (@Model.WebinarDuration == 1)
    {
        <span>Prices start at $155. </span>
    }
    else
    {
        <span>Prices start at $265. </span>
    }<a data-toggle="collapse" data-target="#ShowsOptions" class="linkCursor">

        Click here to find the attendance option that's right for you!
    </a>
</div>
<div id="ShowsOptions" class="collapse">
    <button type="button" class="btn-success btn pull-right" id="AddToCart"> Sign Up </button>
    @{
        if (Model.OrderRowExists)
        {
            <div class="pull-right">
                @Html.Partial("~/Views/Cart/Partials/_DisplayRowPrice.cshtml", Model.DisplayRowPriceViewModel)
            </div>
        }
    }

    <div id="RegistrationType">
        <dl>
            @foreach (var myOption in Model.Options)
            {
                bool appendJustOnce = true;

                if (!myOption.Key.SKU.Contains("Upgrade"))
                {
                    explainsOptionsBuilder.Append("<span><b>" + myOption.Key.OptionLabel + "</b> - " + myOption.Key.OptionExplain + " This option costs <i>$" + myOption.Key.Price.ToString().Replace(".00", "") + "</i><br></span>");
                    //font override to apply (days)
                    <dt style="font-weight: normal">
                        @Html.Hidden(string.Concat("IsShippingRequired_", myOption.Key.idRegType), myOption.Value.ToString())
                        <input type="radio" class="checkbox" id='regTypeID_@(myOption.Key.idRegType)' @defaultCheck name="RegistrationTypeId"
                               value="@myOption.Key.idRegType" />
                        &nbsp;&nbsp;<b>
                            @Html.Raw(myOption.Key.OptionLabel.Replace("Five", "Five </b>(days)<b>").Replace("Six", "Six </b>(months)<b>")) - $@myOption.Key.Price &nbsp;&nbsp;
                        </b>
                        <a onclick=javascript:void(0); data-html="true" rel="tooltip" href="#" data-toggle="tooltip" title='@Html.Raw(myOption.Key.OptionExplain).ToHtmlString().Replace("<i>","").Replace("</i>","")'><i class="icon-question-sign"></i></a>
                    </dt>
                }
                else
                {
                    if (ViewBag.userOwnsThisEvent > 0)
                    {
                        if (appendJustOnce)
                        {
                            appendJustOnce = false;
                            //since the RegType hasn't been designated as an 'Upgrade'
                            // we need to display it. Only show 'Upgrades' to users
                            // who already own a registration.
                            explainsOptionsBuilder.Append("Upgrade your existing order with these options - ");

                        }
                        <dt style="font-weight: normal">
                            <input type="radio" class="checkbox" id='regTypeID_@(myOption.Key.idRegType)' @defaultCheck name="regType" value="@myOption.Key.idRegType" />
                            &nbsp;&nbsp;<b>
                                @Html.Raw(myOption.Key.OptionLabel.Replace("Five", "Five </b>(days)<b>").Replace("Six", "Six </b>(months)<b>")) - $@myOption.Key.Price &nbsp;&nbsp;- $
                                @myOption.Key.Price
                            </b>&nbsp;
                            &nbsp;<a onclick=javascript:void(0); data-toggle="tooltip" title="@Html.Raw(myOption.Key.OptionExplain) "><i class="icon-question-sign"></i></a>
                            <br />
                        </dt>
                    }
                }
                defaultCheck = string.Empty;
            }
        </dl>
        <a href="#AttendRegTypes" class="btn btn-mini pull-right" data-toggle="modal">attendance options explained</a>
    </div>
    <script type="text/javascript" language="javascript">
        $(document).ready(function () {
            $("#ExplainRegistrationOptions").html("@Html.Raw(explainsOptionsBuilder.ToString())");
            $('.dt').tooltip({ selector: "a[rel=tooltip]" });

        });
    </script>

    @if (Model.WebinarStatus == WebinarStatus.Scheduled || Model.WebinarStatus == WebinarStatus.Active || Model.WebinarStatus == WebinarStatus.InProgress)
    {
        <div id="displayAddLoc">
            @Html.Partial("~/Views/Webinar/Partials/AdditionalLocationsView.cshtml", Model.AdditionalLocationOfferViewModel)
        </div>
    }

</div>
