    var defaultCheck = "checked";
}
<script type="text/javascript">
    // these js functions (all supporting the StateCart) moved to
    // create-order.js
</script>
@{


    var orderRowOption = new AdditionalLocation() { OptionDescription = "TODO: Change this is a temp description", RegTypePrice = 150.00M };
    //  TODO: also, I hard-coded 150 for the RegTypePrice. Not sure where this should come from.

    //  Comment: I assume order will be null where there is no existing order for the User for that WebinarId
    //           This does not seem to have been handled in the controller as the Order is just set to null. I need to understand this.

    //if (Model.Order != null)
    //{
    //    var order = Model.Order;
    //    if (order.OrderRows.SingleOrDefault().OrderRowRegTypes.SingleOrDefault() != null)
    //    {
    //        addLocView = order.OrderRows.SingleOrDefault().OrderRowRegTypes.SingleOrDefault();
    //    }
    //    else
    //    {
    //        order.OrderRows.SingleOrDefault().OrderRowRegTypes.Add(addLocView);
    //    }

    //}



    <span>
        Choose the attendance RegType that's right for you! <a href="#AttendRegTypes" data-toggle="modal">(learn more)</a>
    </span>

    <div class="pull-right">
        @*@Html.Partial("_DisplayRowPrice", new ViewDataDictionary(row))
            @Html.Raw(TTSTrain.Webinars.WebEntry.Support.DisplayRowPrice.BuildRowPrice(workingRow))*@
    </div>
    <div id="ModeOptions">
        <dl>
            @foreach (var myOption in Model.Options)
            {
                if (myOption.Type == "Text")
                {
                    if (!myOption.SKU.Contains("Upgrade"))
                    {
                        //since the RegType hasn't been designated as an 'Upgrade'
                        // we need to display it. Only show 'Upgrades' to users
                        // who already own a registration.
                        <dt>
                            <input type="radio" class="checkbox" id='mode_@(myOption.idRegType)' @defaultCheck name="mode" value="@myOption.idRegType" />
                            &nbsp;&nbsp;@myOption.OptionLabel - $@myOption.Price&nbsp;&nbsp;<a onclick=javascript:void(0); data-toggle="tooltip" title="@Html.Raw(myOption.OptionExplain) "><i class="icon-question-sign"></i></a>
                            <br />
                        </dt>
                    }
                    else
                    {
                        if (ViewBag.userOwnsThisEvent > 0)
                        {
                            <dt>
                                <input type="radio" class="checkbox" id='mode_@(myOption.idRegType)' @defaultCheck name="mode" value="@myOption.idRegType" />
                                &nbsp;&nbsp;@myOption.OptionLabel - $@myOption.Price&nbsp;&nbsp;<a onclick=javascript:void(0); data-toggle="tooltip" title="@Html.Raw(myOption.OptionExplain) "><i class="icon-question-sign"></i></a>
                                <br />
                            </dt>
                        }
                    }

                    defaultCheck = "";
                }
                if (myOption.Type == "additional_location")
                {


                    orderRowOption.RegType = myOption;
                    Model.AdditionalLocationViewModel = new AdditionalLocationViewModel
                    {
                        AdditionalLocation = orderRowOption,
                        Webinar = Model.Webinar
                    };
                    //Model.AdditionalEmailssViewModel.OrderRowRegType = orderRowRegType;
                    //TODO: ERROR HERE. How to correctly populate the AdditionalEmails value
                    // currently the RegType that is received by the Partial view
                    // is null.
                }
            }
        </dl>
        @{
            if (Model.Webinar.Status == WebinarStatus.Scheduled)
            {
                <div id="displayAddLoc">
                    @Html.Partial("~/Views/Webinar/Partials/AdditionalLocationView.cshtml", Model.AdditionalLocationViewModel)
                </div>
            }
        }
    </div>
}

