@model Webinar

@{
    ViewBag.Title = "Open The Webinar";

    if (Model.Status == WebinarStatus.Active)
    {
        var buttonCaption = "Open The Webinar";
        <a id="OpenTheWebinarButton">@buttonCaption</a>

        using (Html.BeginForm("OpenTheWebinar", "Webinar", FormMethod.Post, new { id = "_openTheWebinar" }))
        {            
            <input type="hidden" name="idWebinar" id="idWebinar" value="@Model.idWebinar"/>
        }
    }
} 