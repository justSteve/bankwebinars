
<style type="text/css">
    .OrderSumUser {
    }
</style>
@using CUWebinars.Web.Core
@model RegistrationSummaryViewModel

@{
    var byJoinCode = false;
    if (ViewBag.byJoinCode != null)
    {
        byJoinCode = true;
    }
    NumberFormatInfo nfi = new CultureInfo("en-US", false).NumberFormat;
    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;
    nfi.CurrencyDecimalDigits = 0;

    if (Model.OrderRow != null)
    {
        RegType orderMsgs = Model.OrderRow.RegistrationType;

        Order order = Model.OrderRow.Order;
        var showShipped = string.Empty;
        if (Model.WebinarStatus != WebinarStatus.Recorded
            || //needs to be replaced with a Claims check
            Model.OrderRow.RegistrationType.ShowRecordingNotifications == "No")
        {
            Model.RecordingLink = string.Empty;
        }
        <script language="javascript">
            var idRegType = @orderMsgs.idRegType;
        </script>

        if (Model.OrderRow.RegistrationType.ShowShippedNotifications.ToLower() == "yes" && Model.OrderRow.ShipmentDate != null)
        {
            showShipped = "<li>Shipped on: " + Model.OrderRow.ShipmentDate.Value.ToShortDateString() + "</li>";
        }
        <div id="OrderSummary">
            @{
                Debug.Assert(order != null, "order != null");
                if (Model.OrderRow.Order.OrderStatus == OrderStatus.Billed ||
                    Model.OrderRow.Order.OrderStatus == OrderStatus.Paid ||
                    Model.OrderRow.Order.OrderStatus == OrderStatus.Submitted
                    || Model.OrderRow.Order.OrderStatus == OrderStatus.OutstandingBalance)
                {
                    <aside style="width: 100%" class="widget clearfix">

                        <h5 class="short_headline"><span>Order Summary</span></h5>
                        <div class="OrderSumUser" id="idWebinar-@Model.OrderRow.idWebinar">
                            @{ Html.RenderPartial("DisplayTemplates/OrderSumUser", Model); }
                        </div>

                        <h5 style="text-align: right; background-color: darkorange; color: whitesmoke; font-weight: bold; padding-top: 2px; padding-right: 3px;" class="short_headline"><span>Connection Status</span></h5>

                        @{
                            if (Model.ClickToJoinModel != null)
                            {
                                @Html.Partial("ClickToJoin", Model.ClickToJoinModel)
                            }
                            else
                            {

                                @Html.Partial("WebinarStatus", new WebinarStatusUpdate { Webinar = Model.OrderRow.Webinar })
                            }
                        }
                    </aside>
                            }
            }
        </div>
                            }
}