@using System.Diagnostics
@using System.Text
@model WebinarDetailsViewModel
@{
    <script language="javascript">
        function exprsOrder(idRegType) {
            alert(idRegType);

        };
        function upgrade(idRegType) {
            alert(idRegType);

        };
    </script>
    Order order = null;
    OrderRow row = null;
    if (ViewBag.userOwnsThisEvent > 0)
    {
        RegType orderMsgs = Model.CheckoutOptionsViewModel.Order.OrderRows.Single(or => or.RowStatus == OrderRowStatus.Active).RegistrationType;
        row = Model.CheckoutOptionsViewModel.Order.OrderRows.Single(or => or.RowStatus == OrderRowStatus.Active);
        order = row.Order;
        string[] webinarFiles = ViewBag.WebinarFiles;
        var recording = "<a href='" + Model.Webinar.RecordingUrl + "' target=_blank /> Recording Playback</a>"; ;
        var showShipped = "";
        if (Model.Webinar.Status != WebinarStatus.Recorded)
        {
            recording = "";
        }
        var wf = new StringBuilder();


            <script language="javascript">
            var idRegType = @orderMsgs.idRegType;
            </script>


            //webinarFiles
            for (var i = 0; i < webinarFiles.Count(); i++)
            {
                string itemDesc = webinarFiles[i].Split('|')[0];
                string itemPath = webinarFiles[i].Split('|')[1];
                wf.Append("<a href='" + itemPath + "' target=_blank >" + itemDesc + "</a><br>");
            }

            if (row.RegistrationType.ShowShippedNotifications == "Yes" && row.ShipmentDate != null)
            {
                showShipped = "<li>Shipped on: " + row.ShipmentDate.Value.ToShortDateString() + "</li>";
            }
        <div id="OrderSummary" class="well">
            @{

        Debug.Assert(order != null, "order != null");
        if (row.Order.OrderStatus == OrderStatus.Billed ||
            row.Order.OrderStatus == OrderStatus.Paid ||
            row.Order.OrderStatus == OrderStatus.Submitted)
        {
            //webinarFiles ="";

            <aside style="width: 100%" class="widget clearfix">
                <div class="dropdown">
                    <a class="dropdown-toggle btn btn-success" data-toggle="dropdown" href="#">Your Order# <b>CU-@order.idOrder</b> Summary</a>
                    <ul style="width: 100%; padding-left: 10px;" class="dropdown-menu" role="menu" aria-labelledby="dLabel">
                        <li>Ordered on: @order.OrderDate.ToShortDateString()</li>
                        <li>@orderMsgs.OptionLabel</li>
                        <li>$@order.Total</li>
                        @Html.Raw(@showShipped)
                        <li><a href='#' onclick=' upgrade(idRegType); '>Upgrade order?</a></li>
                    </ul>
                </div>
            </aside>
            if (Model.Webinar.Status == WebinarStatus.Scheduled)
            {
                <h5 class="short_headline"><span>Connection Information</span></h5>
                if (orderMsgs.ShowLiveNotifications == "Yes")
                {

                    if (Model.Webinar.ConnectionInfo != null)
                    {
                        <aside style="width: 100%" class="widget clearfix">
                            <div>@Html.Raw(ViewBag.connectionText)</div>
                        </aside>
                    }
                    else
                    {
                        <aside style="width: 100%" class="widget clearfix">
                            [not yet generated]
                        </aside>
                    }
                }
                else
                {
                    <aside style="width: 100%; text-align: center;" class="widget clearfix">
                        Your order currently configured as:
                        <b><i>@orderMsgs.OptionLabel</i></b>. You'll be notified as soon as the recording is posted.
                        @{
                    if (orderMsgs.ShowShippedNotifications == "Yes")
                    {
                        <span>CD-ROMs and handouts are shipped 2-3 days following the event.</span>
                    }
                        }
                        <span><br /><i>There's still time to upgrade your order!</i></span>
                        <br /><a class="btn btn-mini btn-success" href='#' onclick=' upgrade(idRegType); '>Attend the Live Webinar?</a>
                    </aside>
                }
            }
            //webinarFiles ="";
            if (webinarFiles.Count() > 0)
            {
                <aside style="width: 100%" class="widget clearfix">
                    <h5 class="short_headline"><span>Event Materials</span></h5>
                    @Html.Raw(wf.ToString())
                    @Html.Raw(@recording)
                </aside>
            }

        }
        }
        </div>
    }
    @*else
    {// not owned state

        <aside style="width: 100%" class="widget clearfix">
            <div class="dropdown">
                <a class="dropdown-toggle btn btn-success" data-toggle="dropdown" href="#">Express SignUp!</a>
                <ul class="dropdown-menu" role="menu" aria-labelledby="dLabel">

                    @foreach (var myOption in Model.Options)
                    {

                        if (Model.CheckoutOptionsViewModel.Order == null
                            //Model.Order.idOrder < 1
                            //Model.Order.OrderRows.Single().Status == OrderStatus.InProcess

                            && !myOption.SKU.Contains("Upgrade")
                            )
                        {
                            <li>
                                <a onclick='javascript:exprsOrder("@myOption.idRegType");'>&nbsp;&nbsp;@myOption.OptionLabel - $@myOption.Price&nbsp;&nbsp;</a>
                            </li>
                        }
                    }
                </ul>
            </div>
        </aside>
    }*@
}