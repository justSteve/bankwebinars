@model ConnectionInfoEditModel

@{
    ViewBag.Title = "Update Connection Info";
        //ToDO: Integrate a 'Send This Info To' method.
        
}
<style>
    .form-horizontal .control-label {
        float: left;
        padding-top: 0;
        text-align: right;
        width: 140px;
        margin-top: 10px;
    }

    .form-horizontal .form-control {
        margin-left: 10px;
        vert-align: top;
        margin-top: 10px;
        border-radius: 4px;
        height: 20px;
    }
</style>
<script type="text/javascript">
    $(document).ready(function () {
        
        $(".control-label").append(":");
        
    });
</script>
<a id="UpdateConnectionInfoModalButton" class="btn btn-default">Set Connection Info</a>

<div id="UpdateConnectionInfoModal" class="modal modalCenterV  hide fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    @using (Html.BeginForm("UpdateConnectionInfo", "Webinar", FormMethod.Post, new { id = "_UpdateConnectionInfo" }))
    {
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
            <h3 id="myModalLabel">Update Connection Info</h3>
        </div>
        <div class="modal-body">

            @Html.AntiForgeryToken()
            @Html.EditorFor(model => model.idWebinar)
            @Html.HiddenFor(model => model.OrganizerKey)
            @Html.HiddenFor(model => model.OrganizerOAuthKey)

            <div class="form-horizontal">
                @Html.ValidationSummary("There have been some errors:", new { id = "updateConnInfoValSummary" })
                <div class="form-group">
                    Paste Citrix Page Source
                    <div>
                        @Html.EditorFor(model => model.ManageURL, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.ManageURL)
                    </div>
                </div>

                <div id="webinarFilesSelected" class="hidden">
                    @{
                        int idx = 0;
                    }
                    @foreach (var file in Model.WebinarFiles)
                    {
                            <input type="hidden" name="WebinarFiles[@idx].idWebinarFile" value="@file.idWebinarFile" />
                            <input type="hidden" name="WebinarFiles[@idx].idWebinar" value="@file.idWebinar" />
                            <input type="text" class="form-control" name="WebinarFiles[@idx].fileLocation" value="@file.fileLocation" />
                            <input type="text" class="form-control" name="WebinarFiles[@idx].fileDesc" value="@file.fileDesc" /><br />
                        idx++;
                    }
                </div>

                <div class="modal-footer">
                    <button id="saveDetailsButton" class="btn btn-default pull-left">Save</button>
                    <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
                </div>
            </div>
        </div>
    }
</div>
