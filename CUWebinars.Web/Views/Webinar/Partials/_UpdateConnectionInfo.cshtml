@model ConnectionInfoModel

@{
    ViewBag.Title = "Update Connection Info";

}
<style>
    .form-horizontal .control-label {
        float: left;
        padding-top: 0;
        text-align: right;
        width: 100px;
        margin-top: 10px;
    }

    .form-horizontal .form-control {
        margin-left: 10px;
        vert-align: top;
        margin-top: 10px;
        border-radius: 4px;
        height: 20px;
    }
</style>
<script type="text/javascript">
    $(document).ready(function () {


        $(".control-label").append(":");


    });
</script>
<div><a href="#UpdateConnectionInfoModal" role="button" class="btn" data-toggle="modal">Set Connection Info?</a></div>
@using (Html.BeginForm("UpdateConnectionInfo", "Webinar", FormMethod.Post, new { id = "_UpdateConnectionInfo" }))
{
    <div id="UpdateConnectionInfoModal" class="modal hide fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">

        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
            <h3 id="myModalLabel">Update Connection Info</h3>
        </div>
        <div class="modal-body">

            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.idWebinar)
            @Html.HiddenFor(model => model.OrganizerKey)
            @Html.HiddenFor(model => model.OrganizerOAuthKey)

            <div class="form-horizontal">
                @Html.ValidationSummary(true)
                <div class="form-group">
                    @Html.LabelFor(model => model.WebinarKey, htmlAttributes: new { @class = "control-label " })
                    <div>
                        @Html.EditorFor(model => model.WebinarKey, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.WebinarKey)
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.AccessPhonePresenter, htmlAttributes: new { @class = "control-label " })
                    <div>
                        @Html.EditorFor(model => model.AccessPhonePresenter, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.AccessPhonePresenter)
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.AccessCodeOrganizer, htmlAttributes: new { @class = "control-label " })
                    <div>
                        @Html.EditorFor(model => model.AccessCodeOrganizer, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.AccessCodeOrganizer)
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.AccessPhoneAttendee, htmlAttributes: new { @class = "control-label " })
                    <div>
                        @Html.EditorFor(model => model.AccessPhoneAttendee, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.AccessPhoneAttendee)
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.AccessCodeAttendee, htmlAttributes: new { @class = "control-label " })
                    <div>
                        @Html.EditorFor(model => model.AccessCodeAttendee, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.AccessCodeAttendee)
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.AccessPhoneAttendee, htmlAttributes: new { @class = "control-label " })
                    <div>
                        @Html.EditorFor(model => model.AccessPhoneAttendee, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.AccessPhoneAttendee)
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.AccessCodeAttendee, htmlAttributes: new { @class = "control-label " })
                    <div>
                        @Html.EditorFor(model => model.AccessCodeAttendee, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.AccessCodeAttendee)
                    </div>
                </div>

                @if (Model.WebinarFiles != null && Model.WebinarFiles.Count > 0)
                {
                    <div class="well well-large form-group">
                        <div align="center">Webinar Files</div>
                        @foreach (var file in Model.WebinarFiles)
                        {

                            <input type="hidden" name="idWebinarFile_@file.idWebinarFile" value="@file.idWebinarFile" />
                            <div>
                                <span class="control-label">File Name</span>
                                <input type="text" class="form-control" name="fileLocation_@file.idWebinarFile" value="@file.fileLocation" />
                            </div>
                            <div>
                                <span class="control-label">Label</span>
                                <input type="text" class="form-control" name="fileDesc_@file.idWebinarFile" value="@file.fileDesc" /><br />
                            </div>
                        }
                    </div>
                }

                <div class="modal-footer">
                    <input type="submit" value="Save" class="btn btn-default pull-left" />
                    <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
                </div>
            </div>
        </div>
    </div>
}