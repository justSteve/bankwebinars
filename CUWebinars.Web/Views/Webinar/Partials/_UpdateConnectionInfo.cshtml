@model ConnectionInfoEditModel

@{
    ViewBag.Title = "Update Connection Info";
        //ToDO: Integrate a 'Send This Info To' method.
        
}
<style>
    .form-horizontal .control-label {
        float: left;
        padding-top: 0;
        text-align: right;
        width: 140px;
        margin-top: 10px;
    }

    .form-horizontal .form-control {
        margin-left: 10px;
        vert-align: top;
        margin-top: 10px;
        border-radius: 4px;
        height: 20px;
    }
</style>
<script type="text/javascript">
    $(document).ready(function () {
        
        
    });
</script>
<a id="UpdateConnectionInfoModalButton">Set Connection Info</a>

<div id="UpdateConnectionInfoModal" class="modal modalCenterV  hide fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    @using (Html.BeginForm("UpdateConnectionInfo", "Webinar", FormMethod.Post, new { id = "_UpdateConnectionInfo" }))
    {
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
            <h3 id="myModalLabel">Update Connection Info</h3>
        </div>
        <div class="modal-body">

            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.idWebinar)
            @Html.HiddenFor(model => model.OrganizerKey)
            @Html.HiddenFor(model => model.OrganizerOAuthKey)

            <div class="form-horizontal">
                @Html.ValidationSummary("Error: ", new { id = "updateConnInfoValSummary" })
                <div class="form-group">
                    Paste Citrix Page Source
                    <div>
                        @Html.EditorFor(model => model.ManageURL, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.ManageURL)
                    </div>
                </div>
                @if (Model.WebinarKey != null || Model.WebinarKey != "")
                {
                    <div class="form-group">
                        Phone:
                        <div>
                            @Html.EditorFor(model => model.AccessPhone, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.AccessPhone)
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.CitrixRegisterURL, htmlAttributes: new { @class = "control-label " })
                        <div>
                            @Html.EditorFor(model => model.CitrixRegisterURL, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.CitrixRegisterURL)
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.AccessCodePresenter, htmlAttributes: new { @class = "control-label " })
                        <div>
                            @Html.EditorFor(model => model.AccessCodePresenter, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.AccessCodePresenter)
                        </div>
                    </div>
                                

                    <div class="form-group">
                        @Html.LabelFor(model => model.AccessCodeAttendee, htmlAttributes: new { @class = "control-label " })
                        <div>
                            @Html.EditorFor(model => model.AccessCodeAttendee, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.AccessCodeAttendee)
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.AccessCodeOrganizer, htmlAttributes: new { @class = "control-label " })
                        <div>
                            @Html.EditorFor(model => model.AccessCodeOrganizer, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.AccessCodeOrganizer)
                        </div>
                    </div>


                    <div class="form-group">
                        @Html.LabelFor(model => model.WebinarKey, htmlAttributes: new { @class = "control-label " })
                        <div>
                            @Html.EditorFor(model => model.WebinarKey, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.WebinarKey)
                        </div>
                    </div>

    @*<a id="GetSendConnectionInfoEventHtmlButton">Connection Info Notification</a>*@

                }
                <div class="modal-footer">
                    <button id="saveDetailsButton" class="btn btn-default pull-left">Save</button>
                    <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
                </div>
            </div>
        </div>
    }
</div>
