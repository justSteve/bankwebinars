@using CUWebinars.Web.Core
@model WebinarDetailsViewModel

@functions {

}

@{
    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;
}

<section>
    <div id="AdminButtonsContainer">
        <div><i id="WaitIndicator" class="icon-spinner icon-spin "></i></div>
        <div id="ButtonsContainer">
            @{
                //var orderRow = Model.Order.OrderRows.Single(or => or.RowStatus == OrderRowStatus.Active);
                switch (Model.Webinar.Status)
                {
                    case WebinarStatus.Recorded:
                        {
                            var recInfoModel = new PostEventInfoModel
                            {
                                idWebinar = Model.Webinar.idWebinar,
                                OrganizerKey = Model.Webinar.OrganizerKey,
                                OrganizerOAuthKey = Model.Webinar.OrganizerOAuthKey,
                                RecordingURL = Model.Webinar.RecordingUrl,
                                WebinarFiles = Model.Webinar.WebinarFiles
                            };


                            <div class="navbar">
                                <div class="navbar-inner">
                                    <ul class="nav">
                                        <li>
                                            <a href="@globalConfig.WMVRepository@Model.Webinar.RecordingUrl">@globalConfig.WMVRepository@Model.Webinar.RecordingUrl </a>
                                        </li>
                                        <li>
                                            @Html.Partial(@"Partials/_ShippingReport", recInfoModel)
                                        </li>
                                        <li>
                                                @{ Html.RenderPartial("DisplayTemplates/HandoutsListing", Model.Webinar); }
                                            
                                        </li>
                                        <li>
                                            @Html.Partial(@"Partials/_UpdateRecording")
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            break;
                        }
                    case WebinarStatus.Active:
                        {
                            var connInfoModel = new ConnectionInfoModel
                            {
                                idWebinar = Model.Webinar.idWebinar,
                                OrganizerKey = Model.Webinar.OrganizerKey,
                                OrganizerOAuthKey = Model.Webinar.OrganizerOAuthKey,
                                WebinarFiles = Model.Webinar.WebinarFiles,
                                WebinarKey = Model.Webinar.WebinarKey,
                                AccessCodeAttendee= Model.Webinar.AccessCodeAttendee,
                                AccessCodeOrganizer= Model.Webinar.AccessCodeOrganizer,
                                CitrixRegisterURL= Model.Webinar.CitrixRegisterUrl,
                                AccessPhone= Model.Webinar.AccessPhone,
                                AccessCodePresenter = Model.Webinar.AccessCodePresenter
                            };
                            //Active means the connection info has been generated. This form shows
                            // the relevant fields and offers to update them

                            <div class="navbar">
                                <div class="navbar-inner">
                                    <ul class="nav">
                                        <li class="active">
                                            @Html.Partial(@"Partials/_UpdateConnectionInfo", connInfoModel)
                                        </li>
                                        <li>
                                            @Html.Partial(@"Partials/_UpdateWebinarFiles", connInfoModel)
                                        </li>
                                        @*<li>
                                            @Html.Partial(@"Partials/_ListOrders", connInfoModel)
                                        </li>*@
                                        @*<li>
                                            @Html.Partial(@"Partials/_UpdateRecording")
                                        </li>*@

                                    </ul>
                                </div>
                            </div>
                            break;
                        }
                    case WebinarStatus.Scheduled:
                        {
                            var connInfoModel = new ConnectionInfoModel
                            {
                                idWebinar = Model.Webinar.idWebinar,
                                OrganizerKey = Model.Webinar.OrganizerKey,
                                OrganizerOAuthKey = Model.Webinar.OrganizerOAuthKey,
                                WebinarFiles = Model.Webinar.WebinarFiles
                            };
                            <div class="navbar">
                                <div class="navbar-inner">
                                    <ul class="nav">
                                        <li class="active">
                                            @Html.Partial(@"Partials/_UpdateConnectionInfo", connInfoModel)
                                        </li>
                                        <li>
                                            @Html.Partial(@"Partials/_UpdateWebinarFiles", connInfoModel)
                                        </li>
                                        <li>
                                            @Html.Partial(@"Partials/_ListOrders", connInfoModel)
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            //If session is Scheduled it's ready for the Citrix / Selenium app to run.

                            break;
                        }
                    case WebinarStatus.Archived:
                        {
                            break;
                        }
                }
            }
        </div>
    </div>
</section>

<script type="text/javascript">

    @{
    var idWebinar = Model.Webinar.idWebinar.ToString();
    }
    var EvtWebPart = {};
    EvtWebPart.RecordedWebinar = @idWebinar;
</script>
<script src="@Url.Content("~/Scripts/app/notification-ops/details-event-webpart.js")"></script>
