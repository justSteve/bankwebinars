@using CUWebinars.Web.Core
@using Microsoft.Ajax.Utilities
@model WebinarDetailsViewModel

@functions {

}
@{
    var editWebinarFiles = new WebinarFilesEditModel
    {
        idWebinar = Model.Webinar.idWebinar,
        WebinarFiles = Model.Webinar.WebinarFiles
    };

    var connectionInfoEditModel = new ConnectionInfoEditModel
    {
        idWebinar = Model.Webinar.idWebinar,
        OrganizerKey = Model.Webinar.OrganizerKey,
        OrganizerOAuthKey = Model.Webinar.OrganizerOAuthKey,
        WebinarKey = Model.Webinar.WebinarKey,
        AccessCodeAttendee = Model.Webinar.AccessCodeAttendee,
        AccessCodeOrganizer = Model.Webinar.AccessCodeOrganizer,
        CitrixRegisterURL = Model.Webinar.CitrixRegisterUrl,
        AccessPhone = Model.Webinar.AccessPhone,
        AccessCodePresenter = Model.Webinar.AccessCodePresenter,
        WebinarStatus = Model.Webinar.Status
    };

    var postEventInfoModel = new PostEventInfoModel
    {
        idWebinar = Model.Webinar.idWebinar,
        RecordingURL = Model.Webinar.RecordingUrl,
        WebinarFiles = Model.Webinar.WebinarFiles

    };

    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;

    var recordingLink =
        "<a href='" + GlobalConfig.GlobalConfigSingleton.WMVRepository + Model.Webinar.RecordingUrl +
        "' target=_blank />" + Model.Webinar.RecordingUrl + "</a>";

}
<style>
    .hero-unit li {
        line-height: 10px;
    }

    .navbar-inner {
        font-size: smaller;
        min-height: 0px;
        padding-left: 0px;
        padding-right: 0px;
    }
</style>

<section>
    <div id="AdminButtonsContainer">
        <div><i id="WaitIndicator" class="icon-spinner icon-spin "></i></div>
        <div id="ButtonsContainer">
            @{

                switch (Model.Webinar.Status)
                {
                    case WebinarStatus.Recorded:
                        {
                            <div class="navbar">
                                <div class="navbar-inner">
                                    <ul class="nav">

                                        <li>
                                            @Html.Partial(@"Partials/_UpdateWebinarFiles", editWebinarFiles)
                                        </li>
                                        <li style="margin-top: 4px;">
                                            @{
                            if (Model.Webinar.RecordingUrl.IsNullOrWhiteSpace())
                            {
                                @Html.Partial(@"Partials/_UpdateRecording")
                            }
                            else
                            {
                                @Html.Raw(recordingLink)
                            }
                                            }
                                        </li>
                                        <li>
                                            <a data-toggle="collapse" href="#webinarOrders"> Orders</a>
                                        </li>
                                        @*<li>
                                                <a data-toggle="collapse" href="#revenueReport"> Revenue Report</a>
                                            </li>*@
                                    </ul>
                                </div>
                            </div>
                            break;
                        }
                    case WebinarStatus.Active:
                        {
                            //Active means the connection info has been generated. This form shows
                            // the relevant fields and offers to update them

                            <div class="navbar" style="margin: 0 10px 0 0;">
                                <div class="navbar-inner">
                                    <ul class="nav">
                                        <li class="active">
                                            @Html.Partial(@"Partials/_UpdateConnectionInfo", connectionInfoEditModel)
                                        </li>
                                        <li>
                                            @Html.Partial(@"Partials/_UpdateWebinarFiles", editWebinarFiles)
                                        </li>
                                        <li>
                                            @Html.Partial(@"Partials/_UpdateRecording")
                                        </li>
                                        <li>
                                            <a data-toggle="collapse" href="#webinarOrders"> Orders</a>
                                        </li>
                                        @*<li>
                                                <a data-toggle="collapse" href="#revenueReport"> Revenue Report</a>
                                            </li>*@
                                    </ul>
                                </div>
                            </div>
                            break;
                        }
                    case WebinarStatus.Scheduled:
                        {
                            <div class="navbar">
                                <div class="navbar-inner">
                                    <ul class="nav">
                                        <li class="active">
                                            <button id="CreateCitrixWebinar" style="margin-top: 0;" class="btn btn-success">Create Citrix Webinar</button>
                                            @*@Html.Partial(@"Partials/_UpdateConnectionInfo", connectionInfoEditModel)*@
                                        </li>
                                        <li>
                                            @Html.Partial(@"Partials/_UpdateWebinarFiles", editWebinarFiles)
                                        </li>
                                        <li>
                                            <a data-toggle="collapse" href="#webinarOrders"> Orders</a>
                                        </li>
                                        @*<li>
                                                <a data-toggle="collapse" href="#revenueReport"> Revenue Report</a>
                                            </li>*@
                                    </ul>
                                </div>
                            </div>

                            break;
                        }
                    case WebinarStatus.Archived:
                        {
                            <div class="navbar">
                                <div class="navbar-inner">
                                    <ul class="nav">

                                        <li class="active">
                                            @Html.Partial(@"Partials/_UpdateConnectionInfo", connectionInfoEditModel)
                                        </li>
                                        <li>
                                            @Html.Partial(@"Partials/_UpdateWebinarFiles", editWebinarFiles)
                                        </li>
                                        <li>
                                            <a data-toggle="collapse" href="#webinarOrders"> Orders</a>
                                        </li>
                                        @*<li>
                                                <a data-toggle="collapse" href="#revenueReport"> Revenue Report</a>
                                            </li>*@

                                    </ul>
                                </div>
                            </div>

                            break;
                        }
                    case WebinarStatus.InProgress:
                        {
                            <div class="navbar">
                                <div class="navbar-inner">
                                    <ul class="nav">

                                        <li>
                                            <a data-toggle="collapse" href="#webinarOrders"> Orders</a>
                                        </li>
                                        <li>
                                            @Html.Partial(@"Partials/_UpdateWebinarFiles", editWebinarFiles)
                                        </li>
                                        @*<li>
                                                <a data-toggle="collapse" href="#revenueReport"> Revenue Report</a>
                                            </li>*@
                                    </ul>
                                </div>
                            </div>
                            break;
                        }
                }
            }
        </div>
    </div>
</section>



<script type="text/javascript">

    @{
    var idWebinar = Model.Webinar.idWebinar.ToString();
    }
    var EvtWebPart = {};
    EvtWebPart.RecordedWebinar = @idWebinar;
</script>
<script src="@Url.Content("~/Scripts/app/notification-ops/details-event-webpart.js")"></script>
