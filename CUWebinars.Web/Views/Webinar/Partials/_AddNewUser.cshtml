@model CUWebinars.Web.Models.DataTablesModels.EditUserModel

<div class="row-fluid">

    @using (Html.BeginForm("AdminAddNewUser", "Account", FormMethod.Post, new { id = "adminAddUserForm", @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()

        <div class="row-fluid">
            <div class="span4 control-group">
                @Html.LabelFor(model => model.FirstName, new { @class = "control-label" })
                <div class="controls">
                    @Html.TextBoxFor(model => model.FirstName, new { id = "NewUserFirstName", name = "FirstName" })
                    @Html.ValidationMessageFor(model => model.FirstName)
                </div>
            </div>
        </div>

        <div class="row-fluid">
            <div class="span4 control-group">
                @Html.LabelFor(model => model.LastName, new { @class = "control-label" })
                <div class="controls">
                    @Html.TextBoxFor(model => model.LastName, new { id = "NewUserLastName", name = "LastName" })
                    @Html.ValidationMessageFor(model => model.LastName)
                </div>
            </div>
        </div>
        <div class="row-fluid">
            <div class="span4 control-group">
                @Html.LabelFor(model => model.Email, new { @class = "control-label" })
                <div class="controls">
                    @Html.EditorFor(model => model.Email)
                    @Html.ValidationMessageFor(model => model.Email)
                </div>
            </div>
        </div>
        <div class="row-fluid">
            <div class="span4 control-group">
                @Html.LabelFor(model => model.Title, new { @class = "control-label" })
                <div class="controls">
                    @Html.EditorFor(model => model.Title)
                    @Html.ValidationMessageFor(model => model.Title)
                </div>
            </div>
        </div>
        <div class="row-fluid">
            <div class="span4 control-group">
                @Html.LabelFor(model => model.Institution, new { @class = "control-label" })
                <div class="controls">
                    @Html.EditorFor(model => model.Institution, new { @class = "control-label", disabled = "disabled" })
                </div>
            </div>
        </div>
        <div class="row-fluid">
            <div id="BillingAddressContainer">
                <div class="span5">
                    <h4>Billing Address</h4>
                    @Html.EditorFor(b => b.BillingAddress)
                </div>
            </div>
        </div>
        <div class="row-fluid">
            <div id="ShippingAddressContainer" class="initialHide">
                <div class="span5">
                    @Html.EditorFor(b => b.ShippingAddress)
                </div>
            </div>
        </div>
    }
</div>
