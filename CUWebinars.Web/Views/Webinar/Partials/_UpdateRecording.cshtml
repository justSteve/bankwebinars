@model WebinarDetailsViewModel

@{
    ViewBag.Title = "Set Recording Info";

}
<style>
    .form-horizontal .control-label {
        float: left;
        padding-top: 0;
        text-align: right;
        width: 140px;
        margin-top: 10px;
    }

    .form-horizontal .form-control {
        margin-left: 10px;
        vert-align: top;
        margin-top: 10px;
        border-radius: 4px;
        height: 20px;
    }

    #UpdateWebinarRecordingModal {
        margin: 0;
    }
</style>
@{
    var buttonCaption = "Set Recording URL";
    if (Model.Webinar.RecordingUrl != "" && Model.Webinar.RecordingUrl != null)
    {
        buttonCaption = Model.Webinar.RecordingUrl;
    }
}
<a href="#UpdateWebinarRecordingModal" data-toggle="modal">@buttonCaption</a>

<div id="UpdateWebinarRecordingModal" class="modal modalCenterV hide fade">

    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
        <h3 id="myModalLabel">Update Recording</h3>
    </div>
    <div class="modal-body">
        @using (Html.BeginForm("UpdateWebinarRecording", "Webinar", FormMethod.Post, new { enctype = "multipart/form-data", id = "_UpdateWebinarRecording" }))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(model => model.Webinar.idWebinar)

            <div class="form-horizontal">
                @Html.ValidationSummary("Error:", new { id = "updateWebinarRecordingValSummary" })

                <div id="manageRecordingsWrapper">
                        <div id="LivePlusFive" class=" pull-left">
                            <span class="control-label">Live Plus Five:&nbsp;</span>
                            @Html.TextBoxFor(m => m.Webinar.LivePlusFiveValue)

                        </div>

                        <div id="fileLocationDiv_" class=" pull-left">
                            <span class="control-label">File Name:&nbsp;</span>
                            @Html.TextBoxFor(m => m.Webinar.RecordingUrl)
                        </div>
                    </div>
                
            </div>
            <!-- closes modal-body -->

            <div class="modal-footer">
                <button id="updateWebinarRecordingButton" class="btn btn-primary">Save</button>&nbsp;
                <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
            </div>
        }
    </div>
</div>
