@model WebinarDetailsViewModel


<script type="text/javascript">
    $(function () {
        var showExpiryDate = new Date();
        //showExpiryDate = "@Model.Webinar.LivePlusFiveValue";
        //https://github.com/phstc/jquery-dateFormat
        $("#btnIncrementExpriyDate").on('click', function (e) {
            alert(showExpiryDate);
            showExpiryDate.setDate(showExpiryDate.getDate() + 1);
            $("#showExpiryDate").val($.format.date("Wed Jan 13 10:43:41 CET 2010", "dd~MM~yyyy"));
            $("#LivePlusFiveValue").val(showExpiryDate);
        });
    });
</script>
@{
    ViewBag.Title = "Set Recording Info";

}
<style>
    .form-horizontal .control-label {
        float: left;
        padding-top: 0;
        text-align: right;
        width: 140px;
        margin-top: 10px;
    }

    .form-horizontal .form-control {
        margin-left: 10px;
        vert-align: top;
        margin-top: 10px;
        border-radius: 4px;
        height: 20px;
    }

    #UpdateWebinarRecordingModal {
        margin: 0;
    }
</style>
@{
    var buttonCaption = "Set Recording URL";
    if (Model.Webinar.RecordingUrl != "" && Model.Webinar.RecordingUrl != null)
    {
        buttonCaption = Model.Webinar.RecordingUrl;
    }
}
<a href="#UpdateWebinarRecordingModal" data-toggle="modal">@buttonCaption</a>

<div id="UpdateWebinarRecordingModal" class="modal modalCenterV hide fade">

    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
        <h3 id="myModalLabel">Update Recording</h3>
    </div>
    <div class="modal-body">
        @using (Html.BeginForm("UpdateWebinarRecording", "Webinar", FormMethod.Post, new { enctype = "multipart/form-data", id = "_UpdateWebinarRecording" }))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(model => model.Webinar.idWebinar)

            <div class="form-horizontal">
                @Html.ValidationSummary("Error:", new { id = "updateWebinarRecordingValSummary" })

                <div class="well well-large form-group">
                    @*<div class="pull-right" id="LivePlusFive">
                        <span class="control-label">Live Plus Five Expires</span>

                        <input type="text" id="showExpiryDate" />
                        <button id="btnIncrementExpriyDate" type="button" class="btn btn-primary">+</button>
                        <input type="hidden" class="form-control" id="LivePlusFiveValue" name="Webinar.LivePlusFiveValue" value="@Model.Webinar.LivePlusFiveValue" />
                    </div>*@

                    <div id="manageRecordingsWrapper">
                        <div id="fileLocationDiv_">
                            <i class="icon-trash icon-white pull-left" style="cursor: pointer" id="Filedetails-delete"></i>
                            <span class="control-label">File Name</span>
                            <input type="text" class="form-control" name="Webinar.RecordingUrl" value="@Model.Webinar.RecordingUrl" />
                            @*<i class="icon-book icon-white"></i>*@
                        </div>
                    </div>

                </div>
            </div>
            <!-- closes modal-body -->

            <div class="modal-footer">
                <button id="updateWebinarRecordingButton" class="btn btn-primary pull-left">Save</button>&nbsp;
                <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
            </div>
        }
    </div>
</div>
