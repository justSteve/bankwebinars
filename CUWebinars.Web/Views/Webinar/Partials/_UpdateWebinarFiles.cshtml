@model ConnectionInfoModel

@{
    ViewBag.Title = "Manage Handouts for this event";

}
<style>
    .form-horizontal .control-label {
        float: left;
        padding-top: 0;
        text-align: right;
        width: 140px;
        margin-top: 10px;
    }

    .form-horizontal .form-control {
        margin-left: 10px;
        vert-align: top;
        margin-top: 10px;
        border-radius: 4px;
        height: 20px;
    }

    #UpdateWebinarHandoutsModal {
        margin: 0;
    }
</style>
@*<script type="text/javascript" src="/Scripts/bootstrap-filestyle.min.js"> </script>
    http://markusslima.github.io/bootstrap-filestyle/#Getstart
    *@
<a id="UpdateWebinarHandoutsModalButton" class="btn">Manage Handouts</a>

    @*<a id="UpdateWebinarHandoutsModalButton" class="btn btn-default">Manage Handouts</a>*@

    <div id="UpdateWebinarHandoutsModal" class="modal modalCenterV hide fade">

        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
            <h3 id="myModalLabel">Update Webinar Handouts</h3>
        </div>
        <div class="modal-body">
        @using (Html.BeginForm("UpdateWebinarFiles", "Webinar", FormMethod.Post, new { id = "_UpdateWebinarFiles"}))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(model => model.idWebinar)

            <p><button id="addFilesButton" class="btn btn-success">Click to Add More</button></p>

            <div class="form-horizontal">
                @Html.ValidationSummary("There have been some errors:", new { id = "updateFilesValSummary" })
                @if (Model.WebinarFiles != null && Model.WebinarFiles.Count > 0)
                {
                    <div class="well well-large form-group">
                        <div align="center">Webinar Files</div>
                        <div id="manageFilesWrapper">
                        
                        @{
                            int idx = 0;
                        }
                            @foreach (var file in Model.WebinarFiles)
                            {
                                <div id="fileDetails_@file.idWebinarFile" class="webinarFileDetails">
                                    <i class="icon-trash icon-white pull-right" style="cursor: pointer" id="@file.idWebinarFile-Filedetails-delete"></i>
                                    <input type="hidden" name="WebinarFiles[@idx].idWebinarFile" value="@file.idWebinarFile" />
                                    <input type="hidden" name="WebinarFiles[@idx].idWebinar" value="@file.idWebinar" />
                                    <div id="fileLocationDiv_@file.idWebinarFile">
                                        <span class="control-label">File Name</span>
                                        <input type="text" class="form-control" name="WebinarFiles[@idx].fileLocation" value="@file.fileLocation" />
                                        <i class="icon-book icon-white"></i>
                                    </div>
                                    <div id="fileDescDiv_@file.idWebinarFile">
                                        <span class="control-label">Label</span>
                                        <input type="text" class="form-control" name="WebinarFiles[@idx].fileDesc" value="@file.fileDesc" /><br />
                                    </div>
                                </div>
                                idx++;
                            }
                        </div><!-- closes manageFilesWrapper -->
                    </div>
                }
                else
                {
                    <div class="well well-large form-group">
                        <div align="center">Webinar Files</div>
                        <div id="manageFilesWrapper"></div>
                    </div>
                }

            </div>
        }
        </div> <!-- closes modal-body -->

        <div class="modal-footer">
        <button id="updateWebinarFilesButton" class="btn btn-primary pull-left">Save</button>&nbsp;
            <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
        </div>

    </div>

