@using System.Collections
@using CUWebinars.Business.Models
@model CUWebinars.Web.ViewModel.WebinarDetailsViewModel
@{

    var idPresenter = Model.Webinar.Presenter.idUser;

    IList<Webinar> upList = Model.Webinar.Presenter
        .Webinars
        .Where(w => (w.Status == WebinarStatus.Scheduled || w.Status == WebinarStatus.Active || w.Status == WebinarStatus.InProgress) && w.idPresenter == idPresenter
         && w.idWebinar != Model.Webinar.idWebinar).ToList();
    IList<Webinar> recList = Model.Webinar.Presenter
        .Webinars.Where(w => w.Status == WebinarStatus.Recorded && w.idPresenter == idPresenter
        ).OrderByDescending(w => w.Date).ToList();
    if (upList.Count > 1 || recList.Count > 0)
    {
        <aside class="widget clearfix">
            <h5 class="short_headline"><span>@Model.Webinar.Presenter.WebUser.FirstName's Other Events</span></h5>
            <div>
                @if (upList.Count > 0)
                {

                    <h4>Upcoming</h4>
                    <ul class="navigation small">

                        @foreach (var title in upList)
                        {
                            if (title.idWebinar != Model.Webinar.idWebinar)
                            {
                                <li>@Html.ActionLink(title.Title, "Details", "Webinar", new { id=title.idWebinar }, new { target = "_new" })</li>
                            }
                        }
                    </ul>
                }
                @if (recList.Count > 0)
                {
                    var i = 0;
                    <h4>OnDemand</h4>
                    <ul class="navigation small">
                        @foreach (var title in recList)
                        {
                            i++;
                            if (title.idWebinar != Model.Webinar.idWebinar && i < 7)
                            {
                                <li>@Html.ActionLink(title.Title, "Details", "Webinar", new { id = title.idWebinar }, new { target = "_new" })</li>
                            }
                        }
                    </ul>
                }
            </div>
        </aside>
    }
}