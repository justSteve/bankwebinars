@model AdditionalLocationOfferViewModel

<div id="AdditionalLocationsModal" class="modal hide fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">

    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
        <h3 id="myModalLabel">Additional Locations</h3>
    </div>
    <div class="modal-body">
        <p>Add users...</p>

        <p><button id="AddInputsButton" class="btn btn-success">Click to Add More</button></p>
        @{
            <div id="AdditionalLocationEmailWrapper">
                @{
                    if (Model.Order != null)
                    {
                        var emails = Model.Order.OrderRows.Single(or => or.RowStatus == OrderRowStatus.Active).AdditionalLocation.Select(al => al.Email).ToArray();

                        for (int i = 0; i < emails.Length; i++)
                        {
                            <span id="LocationSpan-@i">
                                <input id="AdditionalLocationEmail_@i" name="AddAdditionalLocationViewModel.Emails[@i]" type="text" value="@emails[i]" />
                                &nbsp;<i class="icon-trash icon-white" style="cursor: pointer" id="@i-AdditionLocationEmail-delete"></i>
                            </span>
                            <br id="@i-break" />
                        }
                    }
                }
            </div>
        }
        <button id="SumbitAdditionalLocationsForm" class="btn btn-primary">Submit</button>
    </div>
    <div class="modal-footer">
        <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
    </div>

</div>
<script src="@Url.Content("~/Scripts/app/cart/additional-location-modal.js")"></script>
