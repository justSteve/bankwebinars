@model AdditionalLocationOfferViewModel
@{
    var showPrice = string.Format("{0:C0}", @Model.Price);
}


    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
        <h3 id="myModalLabel">Additional Locations</h3>
    </div>
    <div class="modal-body">
        <div class="btn-group" data-toggle="buttons-radio">
            <button type="button" class="btn btn-primary" id="AddInputsButton">Billable - @showPrice</button>
            <button type="button" class="btn btn-success" id="AddInputsButtonCC">Notifications CC</button>
        </div>
        @{
            <div id="AdditionalLocationEmailWrapper">
                @{
                    if (Model.OrderExists)
                    {
                        for (int i = 0; i < Model.Emails.Count(); i++)
                        {
                            <span id="LocationSpan-@i">
                                <input id="AdditionalLocationEmail_@i" name="AddAdditionalLocationViewModel.Emails[@i]" type="text" value="@Model.Emails[i]" />
                                &nbsp;<i class="icon-trash icon-white" style="cursor: pointer" id="@i-AdditionLocationEmail-delete"></i>
                            </span>
                            <br id="@i-break" />
                        }
                    }
                }
            </div>
        }
    </div>
    <div class="modal-footer">
        <button id="closeButton" class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
    </div>



