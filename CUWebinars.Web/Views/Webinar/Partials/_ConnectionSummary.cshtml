@using System.Diagnostics
@using System.Text
@model OrderRow

@{
    <div id="showConnectionInfo">
        <table style="font-size: smaller;" width="250">
            <tr>
                <td colspan="2">
                    @{
                        if (@Model.CitrixJoinUrl == null)
                        {
                            <p>Please check this page a day or two prior to the scheduled start time or watch your email for complete details.</p>
                        }
                        else
                        {
                            if (Model.Webinar.Status == WebinarStatus.InProgress)
                            {
                                <a href="@Model.CitrixJoinUrl"><b>Join the webinar.</b></a>
                            }
                            else
                            {
                                <p>Please use this link 15-20 minutes prior to the scheduled start time of the event:<br /> <input type="text" width="90px" value="@Model.CitrixJoinUrl"></p>
                            }
                        }
                    }
                </td>
            </tr>
            <tr>
                <td class="audio" colspan="2"><font size="-2">Audio is delivered directly to your workstation. Or use the information below to connect via your telephone.</font></td>
            </tr>
            <tr>
                <td class="propLabel">Teleconference:</td>
                <td class="propValue">@Model.Webinar.AccessPhone</td>
            </tr>
            <tr>
                <td class="propLabel">Access Code:</td>
                <td class="propValue">@Model.Webinar.AccessCodeAttendee</td>
            </tr>
        </table>
    </div>
}