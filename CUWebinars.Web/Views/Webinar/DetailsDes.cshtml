@using CUWebinars.Web.Core
@using CUWebinars.Web.Helpers

@model WebinarDetailsViewModel

@{
    <script type="text/javascript">
        var desCheckout = true;
        $(function () {

            $('#ConfirmRegistrationBillMe').hide();
            $('#ContinueShoppingButton').hide();
            $('#linkIsOrderForCoworker').hide();
            $('#revealAddLocsPanel').hide();
            $('#revealDiscountInput').hide();
            $('#revealOptions').hide();
            $('#AttendRegTypesCaption').text("Terms & Agreement");
        });

    </script>

    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;
    ViewBag.Title = Model.Webinar.Title + " - Presented by: " + Model.Webinar.Presenter.WebUser.FullName;
    IStateService stateService = new StateService();
    var ExpressCheckoutURL = "ExpressCheckout";

    Layout = "~/Views/Shared/_Layout_DES.cshtml";
    if (Model.UserOwnsThisEvent > 0)
    {

        <script type="text/javascript">
            function exprsOrder(idRegType) {
                alert("Please send mail to support at @globalConfig.TenantEmail  and ask to upgrade @globalConfig.TenantPrefix@Model.Order.idOrder. For immediate assistance, use our Help & Feedback button in your lower right screen.");

            };

            function upgrade(idRegType) {
                alert("Please send mail to support at @globalConfig.TenantEmail  and ask to upgrade @globalConfig.TenantPrefix@Model.Order.idOrder. For immediate assistance, use our Help & Feedback button in your lower right screen.");
            };
        </script>
    }
    if (Model.UserHasDiscount != null)
    {
        <script language="javascript" type="text/javascript">
            $(function() {
                $('#showDiscount').css('display', 'block');
                $('#discountCaption').html('@Html.Raw(ViewBag.DiscountCaption)');
            });
        </script>
    }
}
<style>
    .warnIE {
        background-color: lightgoldenrodyellow;
        padding: 8px;
        text-align: center;
    }
</style>
<script type="text/javascript">
    var checkoutInProcess = @(Model.CheckoutInProcess ? "true" : "false");
    // var isUserLoggedIn = @(@Model.UserIsLoggedIn ? "true" : "false");
    // var webinarId = @(@Model.Webinar.idWebinar);
    // var notificationsTesting = @(GlobalConfig.GlobalConfigSingleton.NotificationsTesting ? "true" : "false");
    // var orderRowId = @(Model.CheckoutOptionsViewModel.OrderExists ? Model.Order.OrderRows.SingleOrDefault(r => r.RowStatus == OrderRowStatus.Active).idOrderRow : 0);
    // var orderId = @(Model.CheckoutOptionsViewModel.OrderExists ? Model.Order.idOrder : 0);
    // var addressVerified = @(@Model.UserAddressVerified ? "true" : "false");
</script>

@section scripts{
    @*@Scripts.Render("~/bundles/jqueryval")
        @Scripts.Render("~/bundles/create-order")*@
    @Scripts.Render("~/bundles/manage-webinar-files")
}

@Styles.Render("~/Content/create-order-details")

<div class="hero-unit">
    <div id="webinarTitle" class="container">
        <div class="span10">
            <h1>@Model.Webinar.Title.Replace("The Directors Education Series: ", "")</h1>
        </div>
    </div>
</div>
<!--close hero-unit-->
@if (Model.Webinar.idWebinar == 2485)
{
    <div class="container clearfix" id="main-content">

        <div id="webinarContent" class="row-fluid holy-grail">
            <!--begin row-fluid-->

            <div class="row-fluid span6 offset3">
                <p>The responsibility and liability of the Bank Director is ever increasing. It is critical your Directors stay current with the training to help them through the complexities of today's banking environment.</p>

                <p>
                    <strong>The Directors Education Series&trade;</strong><strong>&nbsp;</strong>is a Library of training modules focused on the role and expectations of the Bank Director's conduct, duties and liabilities. Our programs have been authored by a group of highly recognized, respected industry experts. Your subscription to this series will assist you with the responsibility you have to educate those who serve on your Board.
                </p>

                <p>
                    One annual subscription provides your financial institution access to&nbsp;our entire module library with a new module published each month. Features of the&nbsp;<strong>The Directors Education Series&trade;</strong>&nbsp;include:
                </p>
                <ul>
                    <li>20-25 minutes in length (<strong>Perfect for Board Meetings</strong>)</li>
                    <li>Audio, Video &amp; PowerPoint</li>
                    <li>Handouts and Discussion Questions</li>
                    <li>Course Tracking</li>
                    <li>Accessible on a variety of devices (Tablets, Mobile Devices, Laptops, etc.)</li>
                    <li>Certificates of Completion</li>
                    <li>And More!</li>
                </ul>

                @Html.Partial(partialViewName: "~/Views/Webinar/Partials/_ShoppingCartDES.cshtml", model: Model)

            </div>

        </div>
    </div>
}
else
{

    <div class="container clearfix" id="main-content">
        <!--begin main content-->

        <div id="webinarContent" class="row-fluid holy-grail">
            <!--begin row-fluid-->
            <section class="row-fluid span3 sidebar">
                <aside class="widget well-large">

                    <h5 class="short_headline"><span>@Model.Webinar.Presenter.WebUser.FullName</span></h5>
                    @Html.Raw(Model.Webinar.Presenter.BiographyLong)
                    @*@Html.Partial("Partials/_OtherEventsBySpeaker")*@


                </aside>
                <!--close aside widget-->
            </section>
            <div class="row-fluid span6">
                @if (!Model.CheckoutInProcess)
                {
                    <div id="EventDescription">
                        @Html.Raw(Model.Webinar.DescriptionLong)
                        <h2 class="short_headline">
                            <span>
                                @Html.Raw(Model.Webinar.LearnCaption)
                            </span>
                        </h2>
                        @Html.Raw(Model.Webinar.LearnBody)
                        @*<h2 class="short_headline">
                                <span>
                                    Who Should Attend?
                                </span>
                            </h2>
                            @Html.Raw(Model.Webinar.WhoAttend)
                            <hr />*@
                    </div>
                }
                <div class="warnIE" style="display: none;" id="iePre10">
                    <p>
                        <b>Please note:</b> This site employs features that may cause unexpected behavior in older versions of Internet Explorer. If you experience a problem, try refreshing your screen. If this doesn't solve the problem, click on this link.
                        <br /><a id="warnIE" class="btn btn-mini btn-success" rel="nofollow" href="/cart/@ExpressCheckoutURL?idWebinar=@Model.Webinar.idWebinar&idAffiliate=@ViewBag.currentAffiliateId&idOrder=0">Express Checkout</a>
                    </p>
                    <p>You may contact us by using the Online Chat button below. </p>
                </div>

                @Html.Partial(partialViewName: "~/Views/Webinar/Partials/_ShoppingCartDES.cshtml", model: Model)

            </div>
            <!-- opens Container div-->

            <div class="row-fluid span3">
                <aside class="widget">
                    <h5 class="short_headline">
                        <span>Publish Date</span>
                    </h5>
                    <b>@Model.Webinar.Date.ToString("MMMM") @Model.Webinar.Date.Year </b><br />

                    <div id="ceu">
                        <a href="#" title="@Model.CeuStatement ">
                            @Html.Raw(Model.CeuShort)
                        </a>
                    </div>

                </aside>

                <aside class="widget">
                    <h5 class="short_headline">
                        <span>Related Topics</span>
                    </h5>
                    <ul>
                        @foreach (var webinarTopic in Model.Topics)
                        {
                            <li>
                                @webinarTopic.topicDesc
                            </li>
                        }
                    </ul>
                </aside>
                <!--close aside .widget -->
                <aside class="widget">
                    <h5 class="short_headline"><span>Stay Updated</span></h5>
                    @{Html.RenderPartial("Partials/_AddToMailingBox");}
                </aside>
                <!--close aside .widget -->
            </div>
            <!--close section tertiary-column sidebar span3-->
        </div>

    </div> <!-- closes main-content -->
                        }
