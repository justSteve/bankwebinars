}

@Styles.Render("~/Content/create-order-details")

<div class="hero-unit">
    <div id="webinarTitle" class="container">
        <div class="span10">
            <h1>@Model.Webinar.Title.Replace("The Directors Education Series: ", "")</h1>
        </div>
    </div>
</div>
<!--close hero-unit-->
@if (Model.Webinar.idWebinar == 2485)
{
    <style>
        table {
            margin-left: 100px;
            border-width: 1px;
            border-spacing: 2px;
            border-style: solid;
            border-color: black;
        }


        tr {
            border-width: 1px;
            border-spacing: 1px;
            border-style: solid;
            border-color: black;
        }
    </style>
    <div class="container clearfix" id="main-content">

        <div id="webinarContent" class="row-fluid holy-grail">
            <!--begin row-fluid-->

            <div class="row-fluid span6 offset3">
                <div class="row-fluid span11 primary-column large">
                    <p>The responsibility and liability of the Bank Director is ever increasing. It is critical your Directors stay current with the training to help them through the complexities of today's banking environment.</p>

                    <p><strong>The Directors Education Series&trade;</strong><strong>&nbsp;</strong>is a Library of training courses focused on the role and expectations of the Bank Director's conduct, duties and liabilities. Our programs have been authored by a group of highly recognized, respected industry experts. Your subscription to this series will assist you with the responsibility you have to educate those who serve on your Board.</p>

                    <p>One annual subscription provides your financial institution access to&nbsp;our entire course library with a new course published each month. Features of the&nbsp;<strong>The Directors Education Series&trade;</strong>&nbsp;include:</p>
                    <ul>
                        <li>
                            60+ courses available 24/7
                            <ul>
                                <li>12 new courses per year (one per month)</li>
                                <li>20-25 minutes in length (Perfect for Board Meetings)</li>
                                <li>Courses contain Audio, Video &amp; PowerPoint</li>
                                <li>Handouts and Discussion Questions available for download</li>
                                <li>Notification of release sent to users and managers each month</li>
                            </ul>
                        </li>
                        <li>
                            Group Managers can:
                            <ul>
                                <li>Report on users, courses, dates of usage, etc.</li>
                                <li>Create, delete,&nbsp;and update users</li>
                                <li>Enroll/assign users in courses</li>
                            </ul>
                        </li>
                        <li>
                            Enables all board members and executives to have individual accounts
                            <ul>
                                <li>Managers can create these or we can batch upload them for you!</li>
                            </ul>
                        </li>
                        <li>
                            All usage is tracked&nbsp;and can be reported on
                            <ul>
                                <li>Users can generate their own usage reports</li>
                                <li>Users can generate their own certificates of completion</li>
                                <li>Users can enroll themselves in any course(s)</li>
                            </ul>
                        </li>
                    </ul>

                    <div align="center">
                        <a id="Request Free Trial and Demo" href="https://form.jotform.com/81704920769969"><img src="https://ttsimages.blob.core.windows.net:443/$root/button-get-my-free-trial-demo.png"></a><br />
                    </div>
                    <div align="center">
                        <a id="Course Catalog" href="https://ttsimages.blob.core.windows.net/$root/DSCourseCatalog.pdf">
                            <img src="https://ttsimages.blob.core.windows.net:443/$root/button-view-course-catalog.png">
                        </a>
                    </div>
                    <h3>Directors Education Series Pricing</h3>
                    <table width="333">

                        <tr>
                            <td>
                                Asset Size
                            </td>
                            <td>
                                Monthly Price<br />
                                (Billed Annually)
                            </td>
                        </tr>
                        <tr>
                            <td>
                                Less Than $499 M

                            </td>
