<script language="javascript" type="text/javascript">
    $(window).load(function () {

        $('.flexslider.content-slider').flexslider({
            controlNav: false,
            slideshowSpeed: 5500,
            animation: "slide",
            pauseOnAction: true,
            pauseOnHover: true,
            useCSS: false,

            start: function (slider) {
                slider.removeClass('loading');
            }
        });
    });</script>

