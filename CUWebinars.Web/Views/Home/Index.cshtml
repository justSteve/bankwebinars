@using System.Configuration
@using CUWebinars.Business.Models
@using CUWebinars.Web.Core
@model List<Webinar>
@{

    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;
    if (!(ViewBag.Msg == null || ViewBag.Msg == string.Empty))
    {
        <script type="text/javascript" language="javascript">
            alert(@ViewBag.Msg);
        </script>
    }


}
<!-- Begin Slider
    https://github.com/woothemes/FlexSlider/issues/104?source=cc -->

<div class="content-slider-wrapper clearfix dark">
    <!--add "dark" class for light colored backgrounds -->
    <div id="FlexSlider" class="flexslider loading content-slider">
        <ul class="slides">
            <!--begin slide content inside each li tag-->
            <li>
                <div class="img">
                    <div>
                        <img alt="" src="~/Content/images/menu/L/Lending.jpg">
                    </div>
                </div>
                <div class="caption">
                    <h2 align="center">Welcome!</h2>
                    <div style="margin-left: 50px;">

                        <p>Welcome to the new @globalConfig.Tenant website. If you are a first time visitor, welcome. If you have visited us before, welcome back. We hope you find what you want and that the ordering process is efficient. Be sure and let us know if you have any comments by using the Help & Feedback link below. </p>

                    </div>

                    @*<p class="more"><a class="btn btn-primary" href="~/Content/template/portfolio-single.html">Details &rarr;</a></p>*@
                </div>
            </li>
            @if (globalConfig.Tenant == "BankWebinars")
            {
                <li>
                    <div class="img">
                        <div>
                            <img alt="" src="~/Content/images/menu/L/Auditing.jpg">
                        </div>
                    </div>
                    <div class="caption">
                        <h2 align="center">New Benefit!</h2>
                        <div style="margin-left: 50px;">

                            <p>We are pleased to announce a new benefit available exclusively to Annual Compliance Perspectives subscribers - 25% off a Featured Compliance Webinar of the Month! Each month we will highlight a different event that will be sure to help you and your institution stay on top of the ever changing compliance landscape. </p>

                        </div>

                        @*<p class="more"><a class="btn btn-primary" href="~/Content/template/portfolio-single.html">Details &rarr;</a></p>*@
                    </div>
                </li>
            }
            <li>
                <div class="img">
                    @*<div><img alt="" src="~/Content/images/menu/L/Compliance.jpg"></div>*@
                    <div><img alt="" src="~/Content/images/menu/L/Compliance.jpg"></div>
                </div>
                <div class="caption">
                    <h2 align="center">Our Topics Have You Covered!</h2>
                    <div style="margin-left: 50px;">

                        <table width="100%">
                            <tr><td>Compliance</td><td>Risk Management</td></tr>
                            <tr><td>IRA</td><td>Customer Service</td></tr>
                            <tr><td>Operations</td><td>Security</td></tr>
                            <tr><td>Sales</td><td>Auditing</td></tr>
                            <tr><td>Lending</td><td>Human Resources</td></tr>
                            <tr><td>Teller</td><td></td></tr>
                        </table>

                    </div>

                    @*<p class="more"><a class="btn btn-primary" href="~/Content/template/portfolio-single.html">Details &rarr;</a></p>*@
                </div>
            </li>
            <!--add the "full" class for an image or video only slide w/o text-->
            @*<li>
                <div class="img full">

                    <div><img alt="" src="~/Content/images/menu/L/Compliance.jpg"></div>
                </div>
            </li>*@
            <li>
                <div class="img">
                    <div><img alt="" src="~/Content/images/menu/L/Security.jpg"></div>
                </div>
                <div class="caption">
                    <div class="FrontPageSubHead">
                        <h2 class="ReverseHead">OnDemand Webinars</h2>
                    </div>
                    <p style="margin-left: 20px;">
                        In addition to our live webinars, @ConfigurationManager.AppSettings["Tenant"]<text>.com</text> also offers a wide-selection
                        of recorded webinars to fit your schedule.
                        <br />
                    </p>
                    <p style="font-size: 13pt; color: #D89304;"><b>BENEFITS</b></p>
                    <blockquote>
                        <ul>
                            <li>The same great information as our live webinars</li>
                            <li>Unlimited playback for 6-months after the live date</li>
                            <li>An accompanying CD and handouts for offline viewing </li>
                        </ul>
                    </blockquote>
                </div>
            </li>

            <li>
                <div class="img">
                    <div><img alt="" src="~/Content/images/menu/L/HumanResources.jpg"></div>
                </div>
                <div class="caption">
                    <div class="FrontPageSubHead">
                        <h2 class="ReverseHead">Compliance Perspectives: Monthly Update</h2>
                    </div>
                    <p style="margin-left: 20px; margin-right: 20px;">
                        We are pleased to offer a monthly webinar
                        series to help you keep up with changes and deadlines in the compliance area.
                    </p>
                    <p class="more"><a class="btn btn-primary" target="_blank" href="http://www.CompliancePerspectives.com">Details &rarr;</a></p>
                </div>

            </li>

        </ul>
    </div> <!-- end  .flexslider.content-slider -->
</div>
<!-- end  .content-slider-wrapper dark -->
@*http://www.slidorion.com/*@


@if (!string.IsNullOrWhiteSpace(ViewBag.Message))
{
    <div class="content-wrapper">
        <hgroup class="title">
            <h2>@ViewBag.Message</h2>
        </hgroup>
    </div>
}


<script type="text/javascript">
    $(document).ready(function () {
        $('#page > div').height(497);
    });
</script>
