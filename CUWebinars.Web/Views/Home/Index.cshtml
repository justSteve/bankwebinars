<!-- Begin Slider
    https://github.com/woothemes/FlexSlider/issues/104?source=cc -->

<div class="content-slider-wrapper clearfix dark">
    <!--add "dark" class for light colored backgrounds -->
    <div class="flexslider loading content-slider">
        <ul class="slides">
            <!--begin slide content inside each li tag-->
            <li>
                <div class="img">
                    @*<div><img alt="" src="http://ttsmedia.ttstrain.com/images/menu/L/Compliance.jpg"></div>*@
                    <div><img alt="" src="http://ttsmedia.ttstrain.com/images/menu/L/Compliance.jpg"></div>
                </div>
                <div class="caption">
                    <h2 align="center">Our Topics Have You Covered!</h2>
                    <div style="margin-left: 50px;">

                        <table width="100%">
                            <tr><td>Compliance</td><td>Risk Management</td></tr>
                            <tr><td>IRA</td><td>Customer Service</td></tr>
                            <tr><td>Operations</td><td>Security</td></tr>
                            <tr><td>Sales</td><td>Auditing</td></tr>
                            <tr><td>Lending</td><td>Human Resources</td></tr>
                            <tr><td>Teller</td><td></td></tr>
                        </table>

                    </div>

                    @*<p class="more"><a class="btn btn-primary" href="~/Content/template/portfolio-single.html">Details &rarr;</a></p>*@
                </div>
            </li>
            <!--add the "full" class for an image or video only slide w/o text-->
            @*<li>
                    <div class="img full">

                        <div><img alt="" src="http://ttsmedia.ttstrain.com/images/menu/L/Compliance.jpg"></div>
                    </div>
                </li>*@
            <li>
                <div class="img">
                    <div><img alt="" src="http://ttsmedia.ttstrain.com/images/menu/L/Security.jpg"></div>
                </div>
                <div class="caption">
                    <div class="FrontPageSubHead">
                        <h2 class="ReverseHead">OnDemand Webinars</h2>
                    </div>
                    <p style="margin-left: 20px;">
                        In addition to our live webinars, @ConfigurationManager.AppSettings["Tenant"] .com also offers a wide-selection
                        of recorded webinars to fit your schedule.
                        <br />
                    </p>
                    <p style="font-size: 13pt; color: #D89304;"><b>BENEFITS</b></p>
                    <blockquote>
                        <ul>
                            <li>The same great information as our live webinars</li>
                            <li>Unlimited playback for 6-months after the live date</li>
                            <li>An accompanying CD and handouts for offline viewing </li>
                        </ul>
                    </blockquote>
                </div>
            </li>

            <li>
                <div class="img">
                    <div><img alt="" src="http://ttsmedia.ttstrain.com/images/menu/L/HumanResources.jpg"></div>
                </div>
                <div class="caption">
                    <div class="FrontPageSubHead">
                        <h2 class="ReverseHead">Compliance Perspectives: Monthly Update</h2>
                    </div>
                    <p style="margin-left: 20px; margin-right: 20px;">
                        We are pleased to offer a monthly webinar
                        series to help you keep up with changes and deadlines in the compliance area.
                    </p>
                    <p class="more"><a class="btn btn-primary" target="_blank" href="http://www.CompliancePerspectives.com">Details &rarr;</a></p>
                </div>

            </li>

        </ul>
    </div> <!-- end  .flexslider.content-slider -->
</div>
<!-- end  .content-slider-wrapper dark -->
