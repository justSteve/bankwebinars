@{
    ViewBag.Title = "Contact";
}

<hgroup class="title">
    <h1>@ViewBag.Title.</h1>
    <h2>@ViewBag.Message</h2>
</hgroup>

@section scripts
{
    
        @Scripts.Render("~/bundles/jqueryval")
    
}

<section class="contact">

    <div class="container clearfix" id="main-content">
        <div class="row-fluid reverse-order contact-page">
            <div class="span7">
                <form action="contact" method="POST" id="contact-form" class="form-horizontal">
                    <fieldset>
                        <div class="control-group">
                            <label for="name">Your Name</label>
                            <input type="text" class="span10" name="name" data-val="true" data-val-required="*" id="name" />
                            <span class="field-validation-valid" data-valmsg-for="name" data-valmsg-replace="true"></span>
                        </div>
                        <div class="control-group">
                            <label for="phone">Phone</label>
                            <input type="text" class="span10" data-val="true" data-val-required="*" name="phone" id="phone" />
                            <span class="field-validation-valid" data-valmsg-for="phone" data-valmsg-replace="true"></span>
                        </div>
                        <div class="control-group">
                            <label for="email">Email Address</label>
                            <input type="email" class="span10" data-val="true" data-val-required="Not Valid" name="email" id="email" />
                            <span class="field-validation-valid" data-valmsg-for="email" data-valmsg-replace="true"></span>
                        </div>
                        <div class="control-group">
                            <label for="message">Your Message</label>
                            <textarea class="span10" name="comment" id="comment" data-val="true" data-val-required="*" rows="3"></textarea>
                            <span class="field-validation-valid" data-valmsg-for="comment" data-valmsg-replace="true"></span>
                        </div>
                        <button type="submit" class="btn btn-primary btn-large">Send</button>
                    </fieldset>
                </form>
            </div>
            <!--close span7 -->
        </div>
        <!--close row-fluid-->
    </div>
    <!--close .container role="main-content" -->

</section>
