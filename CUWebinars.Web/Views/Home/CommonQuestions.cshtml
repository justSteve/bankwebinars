@using System.Configuration
@{
    ViewBag.Title = "Common Questions About " + ConfigurationManager.AppSettings["Tenant"] + ".com";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";

}

<style>
    .s-wrap {
        margin-right:;
    }
</style>
<div id="page">
    <div class="container visible-phone">
        <p class="right"><a class="btn btn-primary scrollto" href="#secondary-nav">Page Menu &nbsp;<i class="icon-align-justify"></i></a></p>
    </div>
    <div class="hero-unit">
        <div class="container">
            <h1>Commonly Asked Questions</h1>
        </div>
        <!--close container-->
    </div>
    <!--close hero-unit-->
    <div class="container clearfix" id="main-content">
        <!--begin main content-->

        <div class="row-fluid sidebar-right">
            <!--begin row-fluid-->
            <div class="span9 primary-column">
                <!--begin primary content
                <h4 class="trigger"><a href="#">HTML Ipsum Presents<i class="icon-plus-sign"></i></a></h4>-->
                <!--close .container id="main-content" -->
                <ul class="s-accordion faq fancy">
                    <li class="s-wrap">
                        <h4 class="trigger"><a href="#">How do I know if I already have an account on your website?<i class="icon-plus-sign"></i></a></h4>
                        <div class="s-content">
                            <p>If you have ever received a <i>Confirmation of Registration</i> message from us, it means you have an account. The account might have been created for you by TTS/@ConfigurationManager.AppSettings["Tenant"] staff or one of our affiliates.  Click the <i>Login</i> button in the upper left corner and, if you've lost track of your password (or have never visited us before), select the <i>Reset Password</i> button to have a new one sent to your current email.</p>
                        </div>
                        <!--close s-content-->
                    </li>
                    <!--close s-wrap-->
                    <li class="s-wrap">
                        <h4 class="trigger"><a href="#">How do I access the OnDemand Webinar?<i class="icon-plus-sign"></i></a></h4>
                        <div class="s-content">
                            <ul>
                                <li>Hit the "Log In" button in the upper left hand corner</li>
                                <li>Enter your email and password (If you don't know your password click on the <i>Reset Password</i> button and re-enter your email.  Your password will then be emailed to you.)</li>
                                <li>Once logged in, you will be forwarded to <i>My Webinars</i> - a page where you can see the entire list of webinars for which you have registered for.  Scroll to the webinar you are interested in and click <b>Click here to view this OnDemand Webinar</b>. The recorded webinar (.wmv file) should load and play automatically.</li>
                            </ul>
                        </div>
                        <!--close s-content-->
                    </li>
                    <!--close s-wrap-->
                    <li class="s-wrap">

                        <h4 class="trigger"><a href="#">Troubleshooting problems playing an OnDemand Webinar.<i class="icon-plus-sign"></i></a></h4>
                        <div class="s-content">
                            <ul>
                                <li>If you see an error message referencing <i>Codec Not Found</i> visit http://GoToMeeting.com/Codec for more information.</li>
                                <li>Make sure you have an updated copy of Windows Media Player installed.</li>
                                <li>Attempt to playback the recording on a different PC - are firewalls preventing the playback of media files?</li>
                            </ul>
                        </div>
                    </li>
                    <!--close s-wrap-->
                    <li class="s-wrap">
                        <h4 class="trigger"><a href="#">How do I print a certificate of completion?<i class="icon-plus-sign"></i></a></h4>
                        <div class="s-content">
                            <p>Log into your account (as above). From <i>MyWebinars</i> locate the event in question and find the <i>Generate Certificate of Attendance.</i>You are prompted to enter a single name or list of other individuals who also attended. A certificate (or list of) is generated and can be printed or forwarded as needed.</p>
                        </div>
                    </li>
                    <!--close s-wrap-->
                    <li class="s-wrap">
                        <h4 class="trigger"><a href="#">Is there a limit on the number of participants per location?<i class="icon-plus-sign"></i></a></h4>
                        <div class="s-content">
                            <p>There is no limit, however only one audio and web connection is allowed per registrant. A speaker phone can be used. </p>
                        </div>
                    </li>
                    <!--close s-wrap-->
                    <li class="s-wrap">
                        <h4 class="trigger"><a href="#">Can I connect from each of our branches or does everyone have to be at the same location?<i class="icon-plus-sign"></i></a></h4>
                        <div class="s-content"><p>The fee is per location. If you would like to connect from additional locations, an additional fee would apply. See the registration page for more details. </p></div>
                    </li>
                    <!--close s-wrap-->
                    <li class="s-wrap">
                        <h4 class="trigger"><a href="#">Will the programs be recorded and be available for purchase?<i class="icon-plus-sign"></i></a></h4>
                        <div class="s-content"><p>Yes, the programs are recorded and available for purchase either at the time of your original registration or as an upgrade following the event. Recordings come in two tiers - the '<i>OnDemand Webinar</i>' (web-based playback for 6 months following the date of the event) or '<i>CD-ROM</i>' which includes the same 6-month, web-based playback <i><b>plus</b></i> the event's recording burned to CD-ROM.  Check the registration page for pricing details.</p></div>
                    </li>
                    <!--close s-wrap-->
                    <li class="s-wrap">
                        <h4 class="trigger"><a href="#">How does the recording work and how long is it available?<i class="icon-plus-sign"></i></a></h4>
                        <div class="s-content">
                            <p>If you purchase an OnDemand Webinar, you will receive a weblink that will playback the recording of the original event. You will have unlimited access to the web recording for six months following the date of the program. </p>
                            <p>If you purchase the CD-ROM you will receive a CD with a .WMV file (plays back on your local workstation's CD-ROM drive). You also have access to the OnDemand Webinar for six months following the date of the program. </p>
                        </div>
                    </li>
                    <!--close s-wrap-->
                    <li class="s-wrap">
                        <h4 class="trigger"><a href="#">What features do webinars offer?<i class="icon-plus-sign"></i></a></h4>
                        <div class="s-content">
                            <p>Participants will be able to see the presenter's slides. Some presenters will choose to annotate the slides while speaking. Polling questions may be asked with immediate feedback to the attendees. Attendees have the ability to click an icon if they have a question to alert the presenter. Presenters also have the ability to demonstrate software applications or go on a web tour if applicable. </p>
                        </div>
                    </li>
                    <!--close s-wrap-->
                    <li class="s-wrap">
                        <h4 class="trigger"><a href="#">How can all participants see one computer screen?<i class="icon-plus-sign"></i></a></h4>
                        <div class="s-content">
                            <p>Most financial institutions will choose to project the computer image on to a larger screen. </p>
                        </div>
                    </li>
                    <!--close s-wrap-->
                    <li class="s-wrap">
                        <div class="s-content">
                            <h4 class="trigger"><a href="#">Are programs ever cancelled?<i class="icon-plus-sign"></i></a></h4>
                            <p>It is possible that a program could be cancelled for various reasons. If this does happen, an attempt will be made to reschedule the program and you will be notified of the new date. </p>
                        </div>
                    </li>
                    <!--close s-wrap-->
                    <li class="s-wrap">
                        <h4 class="trigger"><a href="#">What technology provider do you use?<i class="icon-plus-sign"></i></a></h4>
                        <div class="s-content">
                            <p>We've used the industry's top provider - Citrix's GoToWebinar.com - since the early days of internet-based conferencing. They continue to garner great reviews for both product and technical support.</p>
                        </div>
                    </li>
                    <!--close s-wrap-->
                    <li class="s-wrap">
                        <h4 class="trigger"><a href="#">What if I have some program suggestions?<i class="icon-plus-sign"></i></a></h4>
                        <div class="s-content">
                            <p>We are always looking for new topics or recommended speakers. Please call or email with any suggestions. </p>
                        </div>
                    </li>
                    <!--close s-wrap-->
                    <li class="s-wrap">
                        <h4 class="trigger"><a href="#">Who is Total Training Solutions?<i class="icon-plus-sign"></i></a></h4>
                        <div class="s-content">
                            <p>
                                The staff at TTS has been working with the financial industry since 1983. Total Training Solutions has delivered training in many formats from classroom to web-based.
                                <br />
                                <br />
                                Total Training Solutions has produced dozens of videotapes, cd-roms and self-paced online compliance training programs. These programs constantly receive high acclaim and are recognized as some of the best in the industry.
                                <br />
                                <br />
                                We have worked exclusively with the financial industry since our founding. Because of this, we understand the needs of training departments in financial institutions and are alert to changes which affect the industry. We maintain a network of consultants throughout the country who serve as subject matter experts when needed.
                            </p>
                        </div>
                    </li>
                    <!--close s-wrap-->
                    <li class="s-wrap">
                        <h4 class="trigger"><a href="#">How can I reach you?<i class="icon-plus-sign"></i></a></h4>
                        <div class="s-content">
                            <p>You can contact Kyle Bennett directly at 800-831-0678 and by email at <a href="mailto:kbennett@ttsTrain.com">kbennett@ttsTrain.com</a>. Our mailing address is PO Box 310, Waunakee, WI 53597. </p>
                        </div>
                    </li>
                    <!--close s-wrap-->
                </ul>
                <hr />
            </div>
            <!-- close span9 primary-column-->

            <section class="span3 sidebar secondary-column" id="secondary-nav">
                <aside class="widget">
                    <div class="rotating-testimonials">
                        <!--"rotating-testimonials" is a required class-->
                        <h5 class="short_headline"><span>Testimonials</span></h5>
                        <div class="panels">

                            <div id="t1">
                                <blockquote>
                                    <p>We are loving the program for our Directors.  Training has now become a more regular event and the format and timing of the training is just right for the BOD.  They have found the information very helpful in understanding their roles as directors.</p>
                                    <footer>Maureen Daehn, Maple Bank</footer>
                                </blockquote>
                            </div>
                            <!--close #t5 -->
                        </div>
                        <!--close panels-->
                    </div>
                    <!--close rotating-testimonials-->
                </aside>
                <aside class="widget">
                    <h5 class="short_headline"><span>Stay Updated</span></h5>
                    @{Html.RenderPartial("Partials/_AddToMailingBox");}
                </aside>
                <!--close aside .widget -->

                <aside class="widget">
                    <h5 class="short_headline"><span>Search</span></h5>
                    <form class="searchform" method="get">
                        <input type="search" class="span12" value="type and hit enter" onfocus="this.value=''" onblur="this.value='type and hit enter'" />
                    </form>
                </aside>
                <!--close aside widget-->
            </section>
            <!--close aside .widget-->
            <!--close section sidebar span3-->
        </div>
        <!--close row-fluid-->
    </div>
</div>

