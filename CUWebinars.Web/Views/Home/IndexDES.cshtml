        <script type="text/javascript" language="javascript">
            alert(@ViewBag.Msg);
        </script>
    }

    Layout = "~/Views/Shared/_Layout_DES.cshtml";
}

<script language="javascript" type="text/javascript">
function GoToSignup() {
    window.location = '/webinar/DetailsDes/2539';
}

    $(function () {

        $("#showLearnMore").click(
