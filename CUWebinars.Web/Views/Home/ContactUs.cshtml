@using System.Configuration
@using System.Runtime.InteropServices
@using CUWebinars.Web.Core
@{
    ViewBag.Title = "Contact Us";
    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;

}

<div id="page">
    <div class="container visible-phone">
        <p class="right"><a class="btn btn-primary scrollto" href="#secondary-nav">Page Menu &nbsp;<i class="icon-align-justify"></i></a></p>
    </div>
    <div class="hero-unit">
        <div class="container">

            <h1>@ViewBag.Title</h1>
        </div>
        <!--close container-->
    </div>
    <section class="contact">

        <div class="container clearfix" id="main-content">
            <div class="row-fluid reverse-order contact-page">
                @globalConfig.Tenant
                @if (globalConfig.Tenant == "BankWebinars" || globalConfig.Tenant == "DirectorSeries" || globalConfig.Tenant == "CCS" )
                {
                    <script type="text/javascript" src="https://form.jotform.com/jsform/43462160046952"></script>

                }

                @if (globalConfig.Tenant  == "CUWebinars")
                {
                    <div class="span7">

                        <script type="text/javascript" src="https://form.jotform.us/jsform/32686256940159"></script>
                    </div>
                }
                

            </div>



        </div>
    </section>
</div>