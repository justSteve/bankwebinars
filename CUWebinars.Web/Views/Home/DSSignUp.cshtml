@using System.Configuration
@using CUWebinars.Business.Models
@using CUWebinars.Web.Core
@model Affiliate
@{

    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;
    ViewBag.Title = "The Directors Education Series";
    Layout = "~/Views/Shared/_Layout_DES.cshtml";

}
<!-- Begin Slider
    https://github.com/woothemes/FlexSlider/issues/104?source=cc -->

<div class="content-slider-wrapper clearfix dark">
    <!--add "dark" class for light colored backgrounds -->
    <div id="FlexSlider" class="flexslider loading content-slider">
        <ul class="slides">
            <!--begin slide content inside each li tag-->
            <li>
                <div class="img">
                    <div>
                        <img alt="" src="~/Content/images/menu/L/Lending.jpg">
                    </div>
                </div>
                <div class="caption">
                    <h2 align="center">Welcome!</h2>
                    <div style="margin-left: 50px;">

                        <p>Welcome to The Directors Education Series website. Be sure and let us know if you have any comments by using the Help & Feedback link below. </p>

                    </div>

                    @*<p class="more"><a class="btn btn-primary" href="~/Content/template/portfolio-single.html">Details &rarr;</a></p>*@
                </div>
            </li>
            @if (globalConfig.Tenant == "DirectorSeries")
            {
                <li>
                    <div class="img">
                        <div>
                            <img alt="" src="~/Content/images/menu/L/Auditing.jpg">
                        </div>
                    </div>
                    <div class="caption">
                        <h2 align="center">The Directors Education Series™ is a monthly release of...</h2>
                        <div style="margin-left: 50px;">

                            <p>...training modules focused on the role and expectations of the Bank Director’s conduct, duties and liabilities. Our programs have been authored by a group of highly recognized, respected industry experts. Your subscription to this series will assist you with the responsibility you have to educate those who serve on your Board.</p>

                        </div>

                        @*<p class="more"><a class="btn btn-primary" href="~/Content/template/portfolio-single.html">Details &rarr;</a></p>*@
                    </div>
                </li>
            }
            <li>
                <div class="img">
                    @*<div><img alt="" src="~/Content/images/menu/L/Compliance.jpg"></div>*@
                    <div><img alt="" src="~/Content/images/menu/L/Compliance.jpg"></div>
                </div>
                <div class="caption">
                    <h2 align="center">Featured Speakers</h2>
                    <div style="margin-left: 50px;">
                        <table width="100%">
                            <tr><td>Bob Gregg</td><td>Carl Pry</td></tr>
                            <tr><td>Dave Adams</td><td>Deborah Crawford</td></tr>
                            <tr><td>Jeffery Johnson</td><td>Jennifer Burke</td></tr>
                            <tr><td>Joel Abramson</td><td>John Behringer</td></tr>
                            <tr><td>Patrick Neuman</td><td>Susan Costonis</td></tr>
                            <tr><td>Tim Daum</td><td>Tim Reimink</td></tr>
                        </table>

                    </div>

                    @*<p class="more"><a class="btn btn-primary" href="~/Content/template/portfolio-single.html">Details &rarr;</a></p>*@
                </div>
            </li>
            <!--add the "full" class for an image or video only slide w/o text-->
            @*<li>
                    <div class="img full">

                        <div><img alt="" src="~/Content/images/menu/L/Compliance.jpg"></div>
                    </div>
                </li>*@
            <li>
                <div class="img">
                    <div><img alt="" src="~/Content/images/menu/L/Security.jpg"></div>
                </div>
                <div class="caption">
                    <div class="FrontPageSubHead">
                        <h2 class="ReverseHead">One annual subscription...</h2>
                    </div>
                    <p>...provides your entire financial institution access to our entire module library with a new module published each month. Features of the The Directors Education Series™ include:</p>
                    <ul>
                        <li>20-25 minutes in length (Perfect for Board Meetings)</li>
                        <li>Audio, Video &amp; PowerPoint</li>
                        <li>Handouts and Discussion Questions</li>
                        <li>Monthly Viewing Reports sent to administrators</li>
                        <li>Accessible on a variety of devices (Tablets, Mobile Devices, Laptops, etc.)</li>
                        <li>Printable Certificates of Completion</li>
                        <li>12 Month Subscription $1,395</li>
                    </ul>
                </div>
            </li>

            <li>
                <div class="img">
                    <div><img alt="" src="~/Content/images/menu/L/HumanResources.jpg"></div>
                </div>
                <div class="caption">
                    <div class="FrontPageSubHead">
                        <h2 class="ReverseHead">Our module library, complete with over 50 modules consists of the following topics:</h2>
                    </div>
                    <div style="margin-left: 20px; margin-right: 20px;">
                        <table width="100%">
                            <tr><td>ALLL </td><td>Enterprise Risk Management </td></tr>
                            <tr><td>Board/Committee Composition</td><td>Conflicts of Interest</td></tr>
                            <tr><td>Board Legal Duties & Liability </td><td>Financial Statement Overview </td></tr>
                            <tr><td>BSA/AML Basics </td><td>Ratio Analysis </td></tr>
                            <tr><td>Business Valuations & M&A </td><td>Regulation Overviews </td></tr>
                            <tr><td>Cash Flow Analysis </td><td>Risk & Profitability Management</td></tr>
                            <tr><td>Compliance Management</td><td>Strategic Planning </td></tr>
                            <tr><td>Credit Risk Management </td><td>Succession Planning</td></tr>
                            <tr><td>Cyber Security </td><td>And Many More! </td></tr>



                        </table>
                    </div>
                    @*<p class="more"><a class="btn btn-primary" target="_blank" href="http://www.CompliancePerspectives.com">Details &rarr;</a></p>*@
                </div>

            </li>

        </ul>
    </div> <!-- end  .flexslider.content-slider -->
</div>
<!-- end  .content-slider-wrapper dark -->
@*http://www.slidorion.com/*@


@if (!string.IsNullOrWhiteSpace(ViewBag.Message))
{
    <div class="content-wrapper">
        <hgroup class="title">
            <h2>@ViewBag.Message</h2>
        </hgroup>
    </div>
}


<script type="text/javascript">
    $(document).ready(function () {
        $('#page > div').height(497);
    });
</script>
