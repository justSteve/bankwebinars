@using System.Configuration
@using CUWebinars.Web.Core
@using CUWebinars.Web.Helpers

@{
    ViewBag.Title = "Detailed Connection Instructions";

    GlobalConfig _globalConfig = GlobalConfig.GlobalConfigSingleton;
    if (_globalConfig.Tenant == "MortgageWebinars")
    {

        Layout = "/Views/Shared/_Layout_MW.cshtml";
    }
    else
    {
        Layout = "/Views/Shared/_LayoutPublic.cshtml";
    }

}


<div id="page">
    <div class="container visible-phone">
        <p class="right"><a class="btn btn-primary scrollto" href="#secondary-nav">Page Menu &nbsp;<i class="icon-align-justify"></i></a></p>
    </div>
    <div class="hero-unit">
        <div class="container">
            <h1 id="PageTitle">How It Works...</h1>
        </div>
        <!--close container-->
    </div>
    <!--close hero-unit-->
    <div class="container clearfix" id="main-content">
        <!--begin main content-->

        <div class="row-fluid sidebar-right">
            <!--begin row-fluid-->
            <div class="span9 primary-column">



                <blockquote>
                    <p align="center">
                        <strong>
                            First time attendees are encouraged to review the instructions on this page
                            to ensure a trouble-free connection. Total Training Solutions has a set of simple
                            procedures for logging into our Webinars. However,&nbsp; you should always feel
                            free to call tech support at 800-831-0678 x6 if you have difficulties.
                        </strong>
                    </p>
                </blockquote>
                <h4>
                    <strong>Connecting To A Webinar</strong>
                </h4>
                <p>
                    These instructions are a general outline of how to connect to our webinars. Specific information and links will be emailed by our system 2-3
                    days prior to the start of the Webinar and again, the morning of the event from <b><i>@ConfigurationManager.AppSettings["TenantEmail"]</i></b>.
                    It can be helpful to adjust spam filtering to allow mail from this address.
                </p>
                <p>
                    Of course, you can always <a href="/Account/Login?ReturnURL=MyWebinars">logon to your account</a> to find the <i>click-to-join</i> link as well as links to handouts and all other event material.
                    If you haven't recorded your password, use the <i>Reset Password</i> link and a new password
                    will be generated and emailed to the address on record. Once logged in, click on the
                    <em><strong>My Webinars</strong></em>
                    tab to see order history, up-to-date connection information, and links to prior events.
                    <h4>
                        <strong>Firewall and Software Installation</strong>
                    </h4>
                <p>
                    Total Training Solutions (the parent company of @ConfigurationManager.AppSettings["TenantDomain"]) has served tens of thousands of registrants over the years with very, very few
                    connection problems thanks to our partnership with the recognized industry leader of OnLine Events - Citrix / GoToWebinar.
                    In the small handful of instances where there is an issue, it typically traces to limited
                    permissions on the given computer or firewall configuration.
                </p>
                <p>
                    Your IT support desk may wish to review <a href="https:\\support.logmeininc.com\gotowebinar\help\system-requirements-for-attendees-g2w010003">
                        the System Requirements here.
                    </a> This <a href="https://support.logmeininc.com/gotowebinar/help/join-a-test-session-g2w060001" target="citrixtest">link permits you to connect to a test </a>GoToWebinar meeting and ensure that your computer is properly configured.
                </p>

                <h3 align="center">
                    <strong>Detailed Connection Instructions</strong>
                </h3>
                <table border="0">
                    <tbody>
                        <tr>
                            <td valign="top" colspan="2">
                                Fifteen to twenty minutes before the session starts, click the link found in our email labeled "<strong>Connect to Webinar</strong>".
                                A separate browser window will load the page seen in image below.
                                <img src="@ConfigurationManager.AppSettings["TenantURL"]/Content/images/LogOntoWebinar.jpg" />
                            </td>
                        </tr>
                        <tr>
                            <td valign="top">
                                <p>
                                    Enter your First Name, Last Name, and Email Address and click Register. That’s it, you’re in!
                                </p>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <p>
                    <strong>Connecting to the Teleconference:</strong> The audio feed of the webinar is available directly to your computer. If your computer lacks an audio card and/or speakers or if you prefer to play audio via a speaker phone you can call the toll-free teleconference number. You will be prompted for a conference room number which, like the WebinarID and password, is found in the connection instructions emailed prior to the event.
                </p>
                <p>
                    Enjoy the webinar.<br />
                    Tech Support - 800-831-0678 Ext 3
                </p>

                <hr />
            </div>
            <!-- close span9 primary-column-->

            <section class="span3 sidebar secondary-column" id="secondary-nav">
                <aside class="widget">
                    <div class="rotating-testimonials">
                        <!--"rotating-testimonials" is a required class-->
                        <h5 class="short_headline"><span>Testimonials</span></h5>
                        <div class="panels">

                            <div id="t1">
                                <blockquote>
                                    <p>We are loving the program for our Directors.  Training has now become a more regular event and the format and timing of the training is just right for the BOD.  They have found the information very helpful in understanding their roles as directors.</p>
                                    <footer>Maureen Daehn, Maple Bank</footer>
                                </blockquote>
                            </div>
                            <!--close #t5 -->
                        </div>
                        <!--close panels-->
                    </div>

                    <!--close rotating-testimonials-->
                </aside>
                <aside class="widget">
                    <h5 class="short_headline"><span>Stay Updated</span></h5>
                    @{Html.RenderPartial("Partials/_AddToMailingBox");}
                </aside>
                <!--close aside .widget -->

                <aside class="widget">
                    <h5 class="short_headline"><span>Search</span></h5>
                    <form class="searchform" method="get">
                        <input type="search" class="span12" value="type and hit enter" onfocus="this.value=''" onblur="this.value='type and hit enter'" />
                    </form>
                </aside>
                <!--close aside widget-->
            </section>
            <!--close aside .widget-->
            <!--close section sidebar span3-->
        </div>
        <!--close row-fluid-->
    </div>
</div>

