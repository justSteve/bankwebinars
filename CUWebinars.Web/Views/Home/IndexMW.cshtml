@using System.Configuration
@using CUWebinars.Business.Models
@using CUWebinars.Web.Core
@model List<Webinar>
@{

    GlobalConfig _globalConfig = GlobalConfig.GlobalConfigSingleton;
    if (!(ViewBag.Msg == null || ViewBag.Msg == string.Empty))
    {
        <script type="text/javascript" language="javascript">
            alert(@ViewBag.Msg);
        </script>
    }
    Layout = "~/Views/Shared/_Layout_MW.cshtml";
}


<div class="content-slider-wrapper clearfix dark">

    <div class="hero-unit">
        <div class="container">
            <h1>Mortgage Webinars!</h1>
        </div>
    </div>
    <div>[html content here]</div>
</div>


@if (!string.IsNullOrWhiteSpace(ViewBag.Message))
{
    <div class="content-wrapper">
        <hgroup class="title">
            <h2>@ViewBag.Message</h2>
        </hgroup>
    </div>
}


<script type="text/javascript">
    $(document).ready(function () {
        $('#page > div').height(497);
    });
</script>

<script language="javascript" type="text/javascript">
    $(window).load(function () {

    });
</script>

