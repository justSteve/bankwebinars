@using System.Configuration
@using System.Runtime.InteropServices
@using CUWebinars.Web.Core
@{
    ViewBag.Title = "Who Are We?";

    GlobalConfig globalConfig = GlobalConfig.GlobalConfigSingleton;
    if (globalConfig.Tenant == "MortgageWebinars")
    {

        Layout = "/Views/Shared/_Layout_MW.cshtml";
    }
    else
    {
        Layout = "/Views/Shared/_LayoutPublic.cshtml";
    }
}

<div id="page">
    <div class="container visible-phone">
        <p class="right"><a class="btn btn-primary scrollto" href="#secondary-nav">Page Menu &nbsp;<i class="icon-align-justify"></i></a></p>
    </div>
    <div class="hero-unit">
        <div class="container">

            <h1>@ViewBag.Title</h1>
        </div>
        <!--close container-->
    </div>
    <section class="contact">

        <div class="container clearfix" id="main-content">
            <div class="row-fluid reverse-order whoarewe-page">
                <table width="90%">
                    <tr>
                        <td width="50%"><img src="/Content/images/TTSLogoWOCLColors.png" /></td>
                        <td width="50%"><img src="/Content/images/OCLFSLogo_Color.png" /></td>
                    </tr>
                    <tr>
                        <td valign="top">
                            <p align="left" style="margin-right: 15px;">
                                Total Training Solutions (TTS), an OnCourse Learning company, is the leading provider of regulatory compliance webinars serving the training needs of the bank, credit union and mortgage industries. The TTS staff has been working in the financial services industry since 1983. This long history provides the company with an understanding of the needs of financial institutions’ training departments and makes them astute at monitoring changes affecting the industry. TTS maintains a network of consultants throughout the country to serve as subject matter experts that provide quality training. To learn more, visit TTStrain.com.
                            </p>

                        </td>
                        <td valign="top">
                            <p align="left">
                                OnCourse Learning delivers licensure, regulatory and compliance education solutions throughout the nation’s leading industries including financial services, healthcare and real estate. Through trusted industry expertise, compliance management and technology solutions, OnCourse Learning focuses on advancing the e-learning environment for individuals and businesses to help to build new careers, empower employees through knowledge and identify efficiencies in corporate training management.
                            </p>
                            <p align="left">
                                OnCourse Learning offers a full suite of educational products including state and federally approved prelicensing and continuing education programs, accredited course content, exam prep tools, publications, e-books, events and a sophisticated and customizable learning management system and course-authoring tool. To learn more, visit <a href="https://www.oncourselearning.com/financial-services/">
                                    https://OncourseLearning.com/financial-services/
                                </a>.
                            </p>
                        </td>
                    </tr>
                </table>


            </div>
        </div>
    </section>
</div>