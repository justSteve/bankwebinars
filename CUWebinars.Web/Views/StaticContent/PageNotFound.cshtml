@{
    ViewBag.Title = "Page Not Found";
    ViewBag.PageStyleType = "holy-grail-three-columns";
}

<div class="container clearfix" id="main-content">
    <!--begin main content-->

    <div id="webinarContent">
        <h2>404 Page Not Found</h2>
        <p>We couldn't identify the page you are attempting to load.</p>
        <p>@Html.ActionLink("Click here", "Index", "Home") to return to the main page.</p>
        <div id="FeedbackContainer" class="span4">
            <section>
                <h4>Can we help?</h4>
                @{Html.RenderPartial("Partials/_404Feedback");}
            </section>
        </div>
    </div>
</div>