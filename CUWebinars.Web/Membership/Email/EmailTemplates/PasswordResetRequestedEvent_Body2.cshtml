@model CUWebinars.Web.Membership.Notification

<!DOCTYPE HTML PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
@{
    string Tenant = TtsConfigHelperObject.Tenant();
    string TenantEmail = TtsConfigHelperObject.TenantEmail();
    string TenantDomain = TtsConfigHelperObject.TenantDomain();
    string TenantURL = TtsConfigHelperObject.TenantURL();
    string TenantPrefix = TtsConfigHelperObject.TenantPrefix();
    string TenantLogo = TtsConfigHelperObject.TenantLogo();
    string TenantCom = TenantDomain + ".com";

    var HeaderText = "Your New Password Reset Request";
    var BannerText = Tenant + " has received a Password Reset Request";

}
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Password Change Requested</title>
    <style type="text/css">
        .auto-style1 {
            height: 10px;
        }

        .auto-style2 {
            height: 50px;
        }
    </style>
</head>
<body style="font-family: Verdana, Arial, Helvetica, sans-serif">

    @HeaderText

    <p>
        @BannerText
    </p>

    <p>
        We've received a password reset request for your account at @TenantCom. If you didn't make this request please take no action or contact us at Tech Support - @TenantEmail).
    </p>
    <p>If you are completing an order and being prompted to check email for a Password Reset link just click this link or paste it to your browser.<b> Please note: </b> In the case of multiple emails with this same subject line, please ensure you are using the link from the most recent.</p>
    <p>
        <a href="@Model.ConfirmPasswordResetUrl">@Model.ConfirmPasswordResetUrl</a>
    </p>


</body>

</html>
