@model CUWebinars.Web.Membership.Notification

<!DOCTYPE HTML PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    @{
        string Tenant = TtsConfigHelperObject.Tenant();
        string TenantEmail = TtsConfigHelperObject.TenantEmail();
        string TenantDomain = TtsConfigHelperObject.TenantDomain();
        string TenantURL = TtsConfigHelperObject.TenantURL();
        string TenantPrefix = TtsConfigHelperObject.TenantPrefix();
        string TenantLogo = TtsConfigHelperObject.TenantLogo();
        string TenantCom = TenantDomain;

        var HeaderText = "Change of Password Confirmation";
        var BannerText = "Your password at " + TenantDomain + " has been updated.";

    }

    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Password Is Changed</title>
    <style type="text/css">
        .auto-style1 {
            height: 10px;
        }

        .auto-style2 {
            height: 50px;
        }
    </style>
</head>
<body style="font-family: Verdana, Arial, Helvetica, sans-serif">
    @HeaderText
    <p>
        @BannerText
    </p>
    <p>
        Your password with @TenantCom has been updated. If you didn't make this request please contact us at Tech Support - @TenantEmail)
    </p>

</body>

</html>
