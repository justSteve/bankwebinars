@model CUWebinars.Web.Membership.Notification


<!DOCTYPE HTML PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
@{
    string Tenant = TtsConfigHelperObject.Tenant();
    string TenantEmail = TtsConfigHelperObject.TenantEmail();
    string TenantDomain = TtsConfigHelperObject.TenantDomain();
    string TenantURL = TtsConfigHelperObject.TenantURL();
    string TenantPrefix = TtsConfigHelperObject.TenantPrefix();
    string TenantLogo = TtsConfigHelperObject.TenantLogo();
    string TenantCom = TenantDomain + ".com";

    var HeaderText = "Change of Email Request";
    var BannerText = Tenant + " has received a request to reset the email address.";

}
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Email Change Requested</title>
    <style type="text/css">
        .auto-style1 {
            height: 10px;
        }

        .auto-style2 {
            height: 50px;
        }
    </style>
</head>
<body style="font-family: Verdana, Arial, Helvetica, sans-serif">
@HeaderText
<p>
    @BannerText
</p>
<p>
    We've received a request to change the email address associated with your account at @Tenant. If you didn't request this change please take no action or contact us at @TenantEmail).
    If you didn't make this request please contact us at Tech Support - @TenantEmail
</p>
<p>
    Confirm the change request by clicking here (or paste this link to your browser): <b><a href="@Model.ConfirmPasswordResetUrl">@Model.ConfirmChangeEmailUrl</a></b><br />
</p>

</body>

</html>
