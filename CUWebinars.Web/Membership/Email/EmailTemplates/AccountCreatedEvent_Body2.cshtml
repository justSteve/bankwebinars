@model CUWebinars.Web.Membership.Notification

<!DOCTYPE HTML PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
@{
    string Tenant = TtsConfigHelperObject.Tenant();
    string TenantEmail = TtsConfigHelperObject.TenantEmail();
    string TenantDomain = TtsConfigHelperObject.TenantDomain();
    string TenantURL = TtsConfigHelperObject.TenantURL();
    string TenantPrefix = TtsConfigHelperObject.TenantPrefix();
    string TenantLogo = TtsConfigHelperObject.TenantLogo();
    string TenantCom = TenantDomain + ".com";

    var HeaderText = Model.Email + " is activated with " + Tenant;
    var BannerText = Tenant + " has confirmed your account.";

}
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>@Model.Email is activated with @Tenant. </title>
    <style type="text/css">
        .auto-style1 {
            height: 10px;
        }

        .auto-style2 {
            height: 50px;
        }
    </style>
</head>
<body style="font-family: Verdana, Arial, Helvetica, sans-serif">
    @HeaderText
    <p>
        @BannerText
    </p>
    <p style="font-family: Arial, Helvetica, sans-serif;">
        Your account with @TenantDomain is activated. Detailed connection information can be reviewed at <a href="@TenantURL/Home/DetailedConnectionInstructions">@Tenant Connecting to your Webinar</a>.
    </p>
    <p>
        We invite you to visit our FAQ page to preview our features and services. <a href="@TenantURL/Home/CommonQuestions">@Tenant FAQ</a>.
    </p>
    <p>
        Please confirm your receipt of this message by clicking: <b><a href="@Model.ConfirmChangeEmailUrl">@Model.ConfirmChangeEmailUrl</a></b>
    </p>
</body>
</html>
