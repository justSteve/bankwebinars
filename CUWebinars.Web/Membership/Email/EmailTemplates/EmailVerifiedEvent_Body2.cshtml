@model CUWebinars.Web.Membership.Notification

<!DOCTYPE HTML PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
@{
    string Tenant = TtsConfigHelperObject.Tenant();
    string TenantEmail = TtsConfigHelperObject.TenantEmail();
    string TenantDomain = TtsConfigHelperObject.TenantDomain();
    string TenantURL = TtsConfigHelperObject.TenantURL();
    string TenantPrefix = TtsConfigHelperObject.TenantPrefix();
    string TenantLogo = TtsConfigHelperObject.TenantLogo();
    string TenantCom = TenantDomain + ".com";

    var HeaderText = Model.Email + " is verified";
    var BannerText = Model.Email + " with " + Tenant + " is confirmed.";

}
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Email is Verified</title>
    <style type="text/css">
        .auto-style1 {
            height: 10px;
        }

        .auto-style2 {
            height: 50px;
        }
    </style>
</head>
<body style="font-family: Verdana, Arial, Helvetica, sans-serif">

    @HeaderText
    <p>
        @BannerText
    </p>
    <p>
        Thank you for confirming your account with @Tenant. We invite you to visit our FAQ page to preview our features and services. <a href="@TenantURL/Home/CommonQuestions">@Tenant FAQ</a>.
    </p>
</body>
</html>
