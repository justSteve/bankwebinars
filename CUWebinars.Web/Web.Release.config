            xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>

  <log4net>
    <appender name="AdoNetAppender" type="log4net.Appender.AdoNetAppender" xdt:Locator="Match(name)">
      <connectionString xdt:Transform="SetAttributes(value)" value="Data Source=tcp:kmow9uloz6.database.windows.net,1433;Initial Catalog=TTSDatabase;User Id=TTSOp@kmow9uloz6;Password=EntRisR..E121114;" />
      <commandText xdt:Transform="SetAttributes(value)" value="INSERT INTO BWLog ([Date],[Level],[Message],[Exception], [Logger]) VALUES (@log_date, @log_level, @message, @exception, @logger)" />
    </appender>
  </log4net>

  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network">
        <network defaultCredentials="false"
								 enableSsl="true"
								 host="smtp.gmail.com"
								 port="587"
								 userName="registrations@bankwebinars.com"
								 password="azza123A"
							 />
